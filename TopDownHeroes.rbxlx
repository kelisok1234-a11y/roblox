<Item class="ModuleScript" referent="RBX3">
<Properties>
<string name="Name">Config</string>
<ProtectedString name="Source"><![CDATA[-- Shared configuration (ReplicatedStorage.Config)
local Config = {}

Config.MaxLevel = 100
Config.DashCooldown = 4

Config.Classes = {
	Swordsman = {
		name = "Swordsman", kind = "melee", color = Color3.fromRGB(214, 70, 62),
		hp = 150, speed = 20, damage = 22, cooldown = 0.45, range = 8.5, arc = 140, crit = 0.05,
		desc = "Fast sword arcs hit every enemy in front of you. Highest HP.",
	},
	Archer = {
		name = "Archer", kind = "arrow", color = Color3.fromRGB(70, 168, 82),
		hp = 100, speed = 22, damage = 15, cooldown = 0.38, range = 62, projSpeed = 105, crit = 0.10,
		desc = "Long range arrows, fast shooting and the best speed.",
	},
	Mage = {
		name = "Mage", kind = "fireball", color = Color3.fromRGB(150, 84, 220),
		hp = 110, speed = 20, damage = 26, cooldown = 0.85, range = 48, projSpeed = 62, radius = 7, crit = 0.05,
		desc = "Fireballs explode and burn whole groups of enemies.",
	},
}
Config.ClassOrder = { "Swordsman", "Archer", "Mage" }

-- weapon upgrades (cost: 1 skill point per level)
Config.Stats = {
	{ id = "Damage", name = "Damage", per = 0.10, max = 30, fmt = "+10% base damage per level" },
	{ id = "Speed", name = "Attack Speed", per = 0.05, max = 30, fmt = "+5% attack speed per level" },
	{ id = "Range", name = "Range", per = 0.03, max = 30, fmt = "+3% range per level" },
	{ id = "Crit", name = "Crit Chance", per = 0.02, max = 25, fmt = "+2% crit chance per level (x2 damage)" },
}

function Config.weaponStats(cls, upg)
	local c = Config.Classes[cls]
	upg = upg or {}
	local dl, sl, rl, cl = upg.Damage or 0, upg.Speed or 0, upg.Range or 0, upg.Crit or 0
	return {
		damage = c.damage * (1 + 0.10 * dl),
		cooldown = math.max(0.12, c.cooldown / (1 + 0.05 * sl)),
		range = c.range * (1 + 0.03 * rl),
		crit = math.min(0.75, c.crit + 0.02 * cl),
	}
end

-- coin upgrades
Config.VitMax = 50
Config.SwiftMax = 20
function Config.vitCost(lv) return math.floor(60 * (lv + 1) ^ 1.5) end
function Config.swiftCost(lv) return math.floor(150 * (lv + 1) ^ 1.6) end
function Config.maxHp(cls, vit)
	local base = cls and Config.Classes[cls].hp or 100
	return base + 12 * (vit or 0)
end
function Config.walkSpeed(cls, swift)
	local base = cls and Config.Classes[cls].speed or 20
	return base + 0.25 * (swift or 0)
end

-- levelling is intentionally slow
function Config.xpNeed(level)
	if level >= Config.MaxLevel then return 999999999 end
	return math.floor(120 * level ^ 1.8)
end

Config.Difficulties = {
	{ name = "Easy", hp = 1.0, dmg = 1.0, extra = 0, reward = 1.0, color = "6bd66b" },
	{ name = "Normal", hp = 1.8, dmg = 1.5, extra = 8, reward = 2.2, color = "ffd84a" },
	{ name = "Hard", hp = 3.0, dmg = 2.2, extra = 16, reward = 4.0, color = "ff9a3c" },
	{ name = "Insane", hp = 5.0, dmg = 3.2, extra = 24, reward = 7.0, color = "ff4d4d" },
	{ name = "Impossible", hp = 8.0, dmg = 4.5, extra = 34, reward = 12.0, color = "c24dff" },
}

Config.Locations = {
	forest = {
		id = "forest", name = "Whispering Forest", short = "FOREST",
		desc = "A dark little forest full of zombies (Lv.1-5). Boss: Zombie Titan.",
		minLvl = 1, maxLvl = 5, xp = 700, coins = 250,
		enemies = {
			{ id = "Walker", name = "Zombie", kind = "zombie", weight = 40, minWave = 1, minLvl = 1, maxLvl = 4,
				hp = 60, dmg = 8, speed = 9, r = 1.7, atkCd = 1.0,
				pal = { skin = Color3.fromRGB(110, 150, 90), cloth = Color3.fromRGB(70, 80, 110), hair = Color3.fromRGB(40, 30, 25) } },
			{ id = "Runner", name = "Runner Zombie", kind = "zombie", weight = 25, minWave = 1, minLvl = 2, maxLvl = 5,
				hp = 35, dmg = 6, speed = 15, r = 1.4, atkCd = 0.7,
				pal = { skin = Color3.fromRGB(150, 160, 95), cloth = Color3.fromRGB(150, 70, 40), hair = Color3.fromRGB(60, 45, 30) } },
			{ id = "Toxic", name = "Toxic Zombie", kind = "zombie", variant = "toxic", weight = 20, minWave = 2, minLvl = 3, maxLvl = 5,
				hp = 45, dmg = 9, speed = 8, r = 1.7, atkCd = 2.0, ranged = true, projKind = "spit", projSpeed = 38, shootRange = 38, keep = 18,
				pal = { skin = Color3.fromRGB(120, 190, 70), cloth = Color3.fromRGB(80, 110, 50), hair = Color3.fromRGB(30, 60, 20) } },
			{ id = "Brute", name = "Zombie Brute", kind = "zombie", variant = "brute", weight = 15, minWave = 2, minLvl = 4, maxLvl = 5,
				hp = 190, dmg = 20, speed = 6.5, r = 2.8, atkCd = 1.4,
				pal = { skin = Color3.fromRGB(95, 125, 85), cloth = Color3.fromRGB(90, 60, 40), hair = Color3.fromRGB(25, 20, 20) } },
		},
		boss = { id = "Titan", name = "Zombie Titan", kind = "titan", boss = "titan", minLvl = 5, maxLvl = 5,
			hp = 1300, dmg = 26, speed = 7.5, r = 5.2, atkCd = 1.5, rockR = 6.5,
			pal = { skin = Color3.fromRGB(88, 120, 78), cloth = Color3.fromRGB(70, 55, 40), hair = Color3.fromRGB(30, 40, 25) } },
	},
	cave = {
		id = "cave", name = "Gloomrock Cave", short = "CAVE",
		desc = "A deep cave crawling with goblins (Lv.5-10). Boss: Goblin King.",
		minLvl = 5, maxLvl = 10, xp = 1500, coins = 600,
		enemies = {
			{ id = "Grunt", name = "Goblin Grunt", kind = "goblin", weight = 40, minWave = 1, minLvl = 5, maxLvl = 8,
				hp = 70, dmg = 12, speed = 11, r = 1.6, atkCd = 0.9,
				pal = { skin = Color3.fromRGB(110, 160, 70), cloth = Color3.fromRGB(120, 80, 45), hair = Color3.fromRGB(60, 40, 30) } },
			{ id = "Sneaker", name = "Goblin Sneaker", kind = "goblin", variant = "sneaker", weight = 25, minWave = 1, minLvl = 6, maxLvl = 9,
				hp = 45, dmg = 10, speed = 17, r = 1.4, atkCd = 0.6,
				pal = { skin = Color3.fromRGB(90, 140, 90), cloth = Color3.fromRGB(50, 50, 70), hair = Color3.fromRGB(20, 20, 30) } },
			{ id = "Slinger", name = "Goblin Slinger", kind = "goblin", variant = "slinger", weight = 20, minWave = 2, minLvl = 6, maxLvl = 10,
				hp = 55, dmg = 13, speed = 9, r = 1.6, atkCd = 1.6, ranged = true, projKind = "knife", projSpeed = 46, shootRange = 44, keep = 20,
				pal = { skin = Color3.fromRGB(130, 170, 60), cloth = Color3.fromRGB(140, 60, 50), hair = Color3.fromRGB(70, 50, 30) } },
			{ id = "Hobgoblin", name = "Hobgoblin", kind = "goblin", variant = "brute", weight = 15, minWave = 2, minLvl = 8, maxLvl = 10,
				hp = 220, dmg = 26, speed = 7.5, r = 2.8, atkCd = 1.3,
				pal = { skin = Color3.fromRGB(120, 140, 70), cloth = Color3.fromRGB(90, 90, 100), hair = Color3.fromRGB(40, 30, 20) } },
		},
		boss = { id = "King", name = "Goblin King", kind = "king", boss = "king", minLvl = 10, maxLvl = 10,
			hp = 4200, dmg = 55, speed = 17, r = 4.6, atkCd = 1.5,
			pal = { skin = Color3.fromRGB(100, 150, 60), cloth = Color3.fromRGB(110, 30, 40), hair = Color3.fromRGB(30, 25, 20) } },
	},
}
Config.LocationOrder = { "forest", "cave" }

-- Lobby: 4 identical "gates". Step into a gate to open its panel: pick a location,
-- difficulty, party size and who may join (everyone / friends only).
Config.GateMaxPlayers = 4
Config.Lobby = {
	spawn = Vector3.new(0, 4, 32),
	half = 100,
	zones = {
		{ id = "gate1", kind = "gate", n = 1, x = -72, z = -60, r = 11 },
		{ id = "gate2", kind = "gate", n = 2, x = -24, z = -60, r = 11 },
		{ id = "gate3", kind = "gate", n = 3, x = 24, z = -60, r = 11 },
		{ id = "gate4", kind = "gate", n = 4, x = 72, z = -60, r = 11 },
		{ id = "upgrade", kind = "upgrade", x = 0, z = 72, r = 13 },
	},
}

return Config
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX4">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX5">
<Properties>
<string name="Name">GameServer</string>
<ProtectedString name="Source"><![CDATA[-- GameServer: lobby, parties, dungeon runs, enemies, combat, progression
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local DataStoreService = game:GetService("DataStoreService")
local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")

local Config = require(RS:WaitForChild("Config"))
local Sprites = require(script:WaitForChild("Sprites"))
local MapBuilder = require(script:WaitForChild("MapBuilder"))

Players.CharacterAutoLoads = false
Lighting.GlobalShadows = false

pcall(function()
	PhysicsService:RegisterCollisionGroup("Heroes")
	PhysicsService:CollisionGroupSetCollidable("Heroes", "Heroes", false)
end)

-- ============================================================ NETWORK
local Net = Instance.new("Folder")
Net.Name = "Net"
local ToServer = Instance.new("RemoteEvent")
ToServer.Name = "ToServer"
ToServer.Parent = Net
local ToClient = Instance.new("RemoteEvent")
ToClient.Name = "ToClient"
ToClient.Parent = Net
Net.Parent = RS

-- ============================================================ DATA
local D = {} -- persistent profile per player
local S = {} -- session state per player
local STORE
pcall(function()
	STORE = DataStoreService:GetDataStore("TopDownHeroesV1")
end)

local function newData()
	return {
		level = 1, xp = 0, points = 0, coins = 0, vit = 0, swift = 0, wins = 0,
		unlocked = { forest = 1, cave = 1 },
		upg = { Swordsman = {}, Archer = {}, Mage = {} },
	}
end

local function merge(dst, src)
	for k, v in pairs(src) do
		if type(v) == "table" and type(dst[k]) == "table" then
			merge(dst[k], v)
		else
			dst[k] = v
		end
	end
end

local function loadData(p)
	local d = newData()
	if STORE then
		local ok, res = pcall(function()
			return STORE:GetAsync("P" .. p.UserId)
		end)
		if ok and type(res) == "table" then
			merge(d, res)
		end
	end
	return d
end

local function saveData(p)
	local d = D[p]
	if not STORE or not d then return end
	pcall(function()
		STORE:SetAsync("P" .. p.UserId, d)
	end)
end

local function pushData(p)
	local d = D[p]
	if not d then return end
	local payload = {
		level = d.level, xp = d.xp, need = Config.xpNeed(d.level), points = d.points, coins = d.coins,
		class = d.class, upg = d.upg, vit = d.vit, swift = d.swift, unlocked = d.unlocked,
	}
	p:SetAttribute("Data", HttpService:JSONEncode(payload))
end

-- ============================================================ HELPERS
local function getChar(p)
	local c = p.Character
	if not c then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if h and r then return c, h, r end
	return nil
end

local function toast(p, text, color, dur)
	ToClient:FireClient(p, "Toast", text, color or "ffffff", dur or 3)
end

local function runFx(run, name, ...)
	for _, p in ipairs(run.players) do
		ToClient:FireClient(p, name, ...)
	end
end

local function runToast(run, text, color, dur)
	for _, p in ipairs(run.players) do
		toast(p, text, color, dur)
	end
end

local damagePlayer, damageEnemy, killEnemy, spawnProj
local leaveParty, broadcastParties, sendParties, startRun
local returnToLobby, endRun, finishRun, checkDefeat, onDied, chooseClass, buildSprite

-- ============================================================ PLAYER PLATES / SPRITES
local function buildPlate(p, hrp)
	local old = hrp:FindFirstChild("Plate")
	if old then old:Destroy() end
	local g = Instance.new("BillboardGui")
	g.Name = "Plate"
	g.Size = UDim2.fromOffset(190, 50)
	g.StudsOffsetWorldSpace = Vector3.new(0, 0, -4.6)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 500
	g.Adornee = hrp
	-- name + HP are shown to everybody EXCEPT the owner
	pcall(function()
		g.PlayerToHideFrom = p
	 end)
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0, 22)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 17
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.2
	title.Parent = g
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Position = UDim2.new(0.08, 0, 0, 25)
	bar.Size = UDim2.new(0.84, 0, 0, 15)
	bar.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	bar.BackgroundTransparency = 0.2
	bar.BorderSizePixel = 0
	bar.Parent = g
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 5)
	bc.Parent = bar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(80, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0, 5)
	fc.Parent = fill
	local txt = Instance.new("TextLabel")
	txt.Name = "Txt"
	txt.Size = UDim2.fromScale(1, 1)
	txt.BackgroundTransparency = 1
	txt.Font = Enum.Font.GothamBold
	txt.TextSize = 11
	txt.TextColor3 = Color3.new(1, 1, 1)
	txt.TextStrokeTransparency = 0.4
	txt.ZIndex = 3
	txt.Parent = bar
	g.Parent = hrp
end

local function updatePlate(p)
	local c, h, r = getChar(p)
	if not c then return end
	local g = r:FindFirstChild("Plate")
	if not g then return end
	local d = D[p]
	g.Title.Text = "Lv." .. (d and d.level or 1) .. "  " .. p.DisplayName
	local frac = math.clamp(h.Health / math.max(1, h.MaxHealth), 0, 1)
	g.Bar.Fill.Size = UDim2.fromScale(frac, 1)
	g.Bar.Fill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.75, 0.95)
	g.Bar.Txt.Text = math.ceil(h.Health) .. " / " .. math.ceil(h.MaxHealth)
end

buildSprite = function(p)
	local c, h, r = getChar(p)
	if not c then return end
	local st = S[p]
	local old = c:FindFirstChild("Sprite")
	if old then old:Destroy() end
	local f = Instance.new("Folder")
	f.Name = "Sprite"
	f.Parent = c
	local cls = D[p].class
	local color = cls and Config.Classes[cls].color or Color3.fromRGB(150, 150, 160)
	st.weapon = Sprites.player(cls, color, r, f)
end

local function applyStats(p, heal)
	local c, h = getChar(p)
	if not c then return end
	local d = D[p]
	local mh = Config.maxHp(d.class, d.vit)
	h.MaxHealth = mh
	if heal then h.Health = mh end
	local sp = Config.walkSpeed(d.class, d.swift)
	h.WalkSpeed = sp
	p:SetAttribute("WalkSpeed", sp)
	updatePlate(p)
end

local function swingWeapon(st, cls, cd)
	local w = st.weapon
	if not w or not w.weld.Parent then return end
	local base = w.base
	local weld = w.weld
	st.swingTok = (st.swingTok or 0) + 1
	local tok = st.swingTok
	local function alive() return weld.Parent and st.swingTok == tok end
	local function tween(inst, t, props, style, dir)
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	end
	if cls == "Swordsman" then
		-- combo: every hit swings from the opposite side
		st.swingDir = -(st.swingDir or 1)
		local d = st.swingDir
		local a0, a1 = -1.4 * d, 1.4 * d
		if w.trail then w.trail.Enabled = true end
		-- wind-up, then a fast cut with a little forward thrust
		weld.C0 = CFrame.Angles(0, a0 * 1.12, 0) * base
		tween(weld, 0.11, { C0 = CFrame.Angles(0, a1, 0) * CFrame.new(0, 0, -0.7) * base }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		task.delay(0.13, function()
			if alive() then
				tween(weld, 0.24, { C0 = base }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			end
		end)
		task.delay(0.2, function()
			if alive() and w.trail then w.trail.Enabled = false end
		end)
	elseif cls == "Archer" then
		-- recoil, then the next arrow is nocked
		weld.C0 = base * CFrame.new(0, 0, 0.95)
		tween(weld, 0.24, { C0 = base }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		if w.arrow then
			for _, ap in ipairs(w.arrow) do ap.Transparency = 1 end
			task.delay(math.clamp((cd or 0.4) * 0.45, 0.06, 0.3), function()
				if not alive() then return end
				for _, ap in ipairs(w.arrow) do
					if ap.Parent then tween(ap, 0.12, { Transparency = 0 }, Enum.EasingStyle.Linear) end
				end
			end)
		end
	else
		-- staff: small pull-back, thrust forward, orb flares
		weld.C0 = base * CFrame.new(0, 0, 0.5)
		tween(weld, 0.07, { C0 = base * CFrame.new(0, 0, -1.3) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.08, function()
			if alive() then tween(weld, 0.28, { C0 = base }, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end
		end)
		local o = w.orb
		if o then
			o.halo.Transparency = 0.35
			o.glow.Transparency = 0.05
			o.light.Brightness = 3.2
			tween(o.halo, 0.45, { Transparency = 0.86 })
			tween(o.glow, 0.4, { Transparency = 0.45 })
			tween(o.light, 0.4, { Brightness = 1 })
			o.emitter:Emit(14)
		end
	end
end

local lobbyRng = Random.new()
local function lobbySpawnPos()
	return Config.Lobby.spawn + Vector3.new(lobbyRng:NextInteger(-8, 8), 0, lobbyRng:NextInteger(-4, 4))
end

local function setupCharacter(p, c)
	local st = S[p]
	if not st or not D[p] then return end
	local hum = c:WaitForChild("Humanoid", 10)
	local hrp = c:WaitForChild("HumanoidRootPart", 10)
	if not hum or not hrp then return end

	local function hide(d)
		if d:IsA("Accessory") or d:IsA("Clothing") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") or d:IsA("CharacterMesh") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			if d ~= hrp and not d:FindFirstAncestor("Sprite") then
				d.Transparency = 1
			end
			pcall(function()
				d.CollisionGroup = "Heroes"
			end)
		end
	end
	for _, d in ipairs(c:GetDescendants()) do hide(d) end
	c.DescendantAdded:Connect(hide)

	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.UseJumpPower = true
	hum.JumpPower = 0
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)

	local pos
	if st.run then
		local info = st.run.info
		pos = info.spawn + Vector3.new(lobbyRng:NextInteger(-8, 8), 0, lobbyRng:NextInteger(-4, 4))
	else
		pos = lobbySpawnPos()
	end
	c:PivotTo(CFrame.new(pos))
	applyStats(p, true)
	buildSprite(p)
	buildPlate(p, hrp)
	updatePlate(p)
	hum.HealthChanged:Connect(function() updatePlate(p) end)
	hum.Died:Connect(function() onDied(p, c) end)
	ToClient:FireClient(p, "Env", st.run and st.run.cfg.id or "lobby")
end

-- ============================================================ PROGRESSION
local function grantXP(p, amount)
	local d = D[p]
	if not d then return 0 end
	local ups = 0
	d.xp = d.xp + amount
	while d.level < Config.MaxLevel and d.xp >= Config.xpNeed(d.level) do
		d.xp = d.xp - Config.xpNeed(d.level)
		d.level = d.level + 1
		d.points = d.points + 1
		ups = ups + 1
	end
	if d.level >= Config.MaxLevel then d.xp = 0 end
	if ups > 0 then
		toast(p, "LEVEL UP!  Lv." .. d.level .. "  (+" .. ups .. " skill point)", "ffd84a", 3.5)
		updatePlate(p)
	end
	pushData(p)
	return ups
end

chooseClass = function(p, cls)
	local d = D[p]
	d.class = cls
	applyStats(p, false)
	local _, h = getChar(p)
	if h then h.Health = h.MaxHealth end
	buildSprite(p)
	pushData(p)
	toast(p, "Weapon selected: " .. string.upper(cls), "ffffff", 2.5)
end

-- ============================================================ LOBBY
local lobbyFolder = Instance.new("Folder")
lobbyFolder.Name = "Lobby"
lobbyFolder.Parent = Workspace
local lobbyGates = MapBuilder.lobby(lobbyFolder)

-- ============================================================ PARTIES
local parties = {}
local partySeq = 0
local runs = {}
local slots = {}

-- gate zones lookup
local gateZones = {}
for _, zn in ipairs(Config.Lobby.zones) do
	if zn.kind == "gate" then gateZones[zn.id] = zn end
end

local friendCache = {}
local function areFriends(a, b)
	if a == b then return true end
	local key = math.min(a.UserId, b.UserId) .. ":" .. math.max(a.UserId, b.UserId)
	local v = friendCache[key]
	if v == nil then
		local ok, res = pcall(function() return a:IsFriendsWith(b.UserId) end)
		v = ok and res == true or false
		friendCache[key] = v
	end
	return v
end

local function gateParty(gate)
	for _, pt in pairs(parties) do
		if pt.gate == gate then return pt end
	end
	return nil
end

local function partyView(pt)
	local names = {}
	for _, m in ipairs(pt.members) do table.insert(names, m.DisplayName) end
	return {
		id = pt.id, gate = pt.gate, loc = pt.loc, host = pt.host.DisplayName, hostId = pt.host.UserId, diff = pt.diff,
		max = pt.max, n = #pt.members, names = names, friendsOnly = pt.friendsOnly, startAt = pt.startAt,
	}
end

-- can player p join party pt? returns ok, reason
local function joinCheck(p, pt)
	if table.find(pt.members, p) then return true end
	if #pt.members >= pt.max then return false, "FULL" end
	if pt.friendsOnly and not areFriends(p, pt.host) then return false, "FRIENDS ONLY" end
	if pt.diff > ((D[p] and D[p].unlocked[pt.loc]) or 1) then return false, "LOCKED" end
	return true
end

local function updateGateSign(gate)
	local g = lobbyGates and lobbyGates[gate]
	if not g then return end
	local pt = gateParty(gate)
	if not pt then
		g.sub.Text = "FREE - step in to host a run"
		g.sub.TextColor3 = Color3.fromRGB(255, 255, 255)
		g.glow.Color = g.color
		return
	end
	local loc = Config.Locations[pt.loc]
	local tag = pt.friendsOnly and "FRIENDS ONLY" or "OPEN"
	g.sub.Text = string.upper(loc.short) .. " - " .. Config.Difficulties[pt.diff].name .. "  |  " .. #pt.members .. "/" .. pt.max .. "  |  " .. tag
	if pt.friendsOnly then
		g.sub.TextColor3 = Color3.fromRGB(120, 200, 255)
		g.glow.Color = Color3.fromRGB(90, 170, 255)
	elseif #pt.members >= pt.max then
		g.sub.TextColor3 = Color3.fromRGB(255, 110, 110)
		g.glow.Color = Color3.fromRGB(255, 80, 80)
	else
		g.sub.TextColor3 = Color3.fromRGB(255, 220, 120)
		g.glow.Color = Color3.fromRGB(255, 190, 70)
	end
end

sendParties = function(p, gate)
	local pt = gateParty(gate)
	local view = nil
	if pt then
		view = partyView(pt)
		view.mine = table.find(pt.members, p) ~= nil
		local ok, why = joinCheck(p, pt)
		view.canJoin = ok and not view.mine
		view.why = why
	end
	ToClient:FireClient(p, "Gate", gate, view)
end

broadcastParties = function(gate)
	updateGateSign(gate)
	for p, st in pairs(S) do
		if st.zone == gate then task.spawn(sendParties, p, gate) end
	end
end

leaveParty = function(p)
	local st = S[p]
	local pt = st and st.party
	if not pt then return end
	st.party = nil
	local i = table.find(pt.members, p)
	if i then table.remove(pt.members, i) end
	if #pt.members == 0 then
		parties[pt.id] = nil
	else
		if pt.host == p then pt.host = pt.members[1] end
		pt.startAt = nil
	end
	broadcastParties(pt.gate)
end

local function createParty(p, gate, loc, diff, max, friendsOnly)
	local st = S[p]
	if not st or st.run or st.party or type(gate) ~= "string" or st.zone ~= gate or not gateZones[gate] then return end
	if type(loc) ~= "string" or not Config.Locations[loc] or type(diff) ~= "number" or type(max) ~= "number" then return end
	if not D[p].class then
		toast(p, "Pick a weapon first!", "ff6060", 2.5)
		return
	end
	if gateParty(gate) then
		toast(p, "This gate is already taken!", "ff6060", 2.5)
		return
	end
	diff = math.floor(diff)
	max = math.clamp(math.floor(max), 1, Config.GateMaxPlayers)
	if diff < 1 or diff > #Config.Difficulties or diff > (D[p].unlocked[loc] or 1) then
		toast(p, "That difficulty is locked!", "ff6060", 2.5)
		return
	end
	partySeq = partySeq + 1
	local pt = {
		id = partySeq, host = p, gate = gate, loc = loc, diff = diff, max = max,
		friendsOnly = friendsOnly == true and max > 1, members = { p },
	}
	parties[pt.id] = pt
	st.party = pt
	broadcastParties(gate)
	if max == 1 then
		toast(p, "Starting solo run...", "ffffff", 1.5)
		task.delay(1.2, function()
			if parties[pt.id] then startRun(pt) end
		end)
	end
end

local function joinParty(p, id)
	local st = S[p]
	if not st or st.run or st.party or type(id) ~= "number" then return end
	local pt = parties[id]
	if not pt or st.zone ~= pt.gate then return end
	if not D[p].class then
		toast(p, "Pick a weapon first!", "ff6060", 2.5)
		return
	end
	local ok, why = joinCheck(p, pt)
	if not ok then
		if why == "FRIENDS ONLY" then
			toast(p, "This party is for the host's friends only!", "ff6060", 2.5)
		elseif why == "LOCKED" then
			toast(p, "You haven't unlocked that difficulty yet!", "ff6060", 2.5)
		else
			toast(p, "Party is full!", "ff6060", 2.5)
		end
		return
	end
	table.insert(pt.members, p)
	st.party = pt
	if #pt.members >= pt.max then
		local t = Workspace:GetServerTimeNow() + 5
		pt.startAt = t
		task.delay(5, function()
			if parties[pt.id] and pt.startAt == t then startRun(pt) end
		end)
	end
	broadcastParties(pt.gate)
end

-- ============================================================ RUNS
local function pickLevel(cfg, wave, def)
	local span = cfg.maxLvl - cfg.minLvl
	local center = cfg.minLvl + span * ((wave - 1) * 0.35 + 0.15)
	local lvl = math.floor(center + (math.random() * 2 - 1) * 1.3 + 0.5)
	return math.clamp(lvl, math.max(cfg.minLvl, def.minLvl), math.min(cfg.maxLvl, def.maxLvl))
end

local function buildQueue(run, wave)
	local cfg = run.cfg
	local pool, tw = {}, 0
	for _, def in ipairs(cfg.enemies) do
		if def.minWave <= wave then
			table.insert(pool, def)
			tw = tw + def.weight
		end
	end
	local q = {}
	if wave == 3 then
		table.insert(q, { def = cfg.boss, lvl = cfg.boss.maxLvl, boss = true })
	end
	for _ = 1, run.waveCounts[wave] do
		local r = math.random() * tw
		local pick = pool[1]
		for _, def in ipairs(pool) do
			r = r - def.weight
			if r <= 0 then pick = def break end
		end
		table.insert(q, { def = pick, lvl = pickLevel(cfg, wave, pick) })
	end
	return q
end

local function schedule(run, t, fn)
	table.insert(run.events, { t = t, fn = fn })
end

local function buildEnemyGui(e, root)
	local boss = e.boss
	local g = Instance.new("BillboardGui")
	g.Size = boss and UDim2.fromOffset(300, 46) or UDim2.fromOffset(120, 34)
	g.StudsOffsetWorldSpace = Vector3.new(0, 0, -(e.r + (boss and 3.2 or 2.2)))
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 400
	g.Adornee = root
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, boss and 24 or 16)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = boss and 20 or 13
	title.Text = "Lv." .. e.lvl .. " " .. e.def.name
	title.TextColor3 = boss and Color3.fromRGB(255, 200, 70) or Color3.fromRGB(255, 255, 255)
	title.TextStrokeTransparency = 0.2
	title.Parent = g
	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0.08, 0, 0, boss and 26 or 17)
	bar.Size = UDim2.new(0.84, 0, 0, boss and 14 or 8)
	bar.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	bar.BorderSizePixel = 0
	bar.Parent = g
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = boss and Color3.fromRGB(230, 50, 50) or Color3.fromRGB(220, 70, 70)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	g.Parent = root
	e.fill = fill
end

local function spawnEnemy(run, def, lvl, x, z)
	local dc = run.dcfg
	local n = #run.players
	local boss = def.boss ~= nil
	local hpMul = (1 + 0.22 * (lvl - 1)) * dc.hp * (1 + (boss and 0.6 or 0.35) * (n - 1))
	local dmgMul = boss and dc.dmg or ((1 + 0.12 * (lvl - 1)) * dc.dmg)
	local e = {
		def = def, lvl = lvl, x = x, z = z, r = def.r, boss = boss,
		maxHp = math.floor(def.hp * hpMul), dmg = def.dmg * dmgMul, speed = def.speed,
		nextAtk = os.clock() + 1, fx = 0, fz = -1,
	}
	e.hp = e.maxHp
	local model = Instance.new("Model")
	model.Name = def.name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.CFrame = CFrame.new(x, 0.2, z)
	root.Parent = model
	model.PrimaryPart = root
	e.weapon = Sprites.enemy(def, root, model)
	e.model, e.root = model, root
	buildEnemyGui(e, root)
	if boss then
		e.nextRock = os.clock() + 3
		e.nextSlam = os.clock() + 4
		e.nextSweep = os.clock() + 3
	end
	model.Parent = run.enemyFolder
	table.insert(run.enemies, e)
	if boss then run.boss = e end
	return e
end

local function pickSpawn(run)
	local info = run.info
	local half = info.half
	local first
	for _ = 1, 14 do
		local side = math.random(1, 3)
		local x, z
		if side == 1 then
			x = info.ox + (math.random() * 2 - 1) * (half - 8)
			z = -half + 8
		elseif side == 2 then
			x = info.ox - half + 8
			z = (math.random() * 2 - 1) * (half - 12)
		else
			x = info.ox + half - 8
			z = (math.random() * 2 - 1) * (half - 12)
		end
		first = first or { x, z }
		local ok = true
		for _, o in ipairs(info.obstacles) do
			local dx, dz = x - o.x, z - o.z
			if dx * dx + dz * dz < (o.r + 3) * (o.r + 3) then ok = false break end
		end
		if ok then
			for _, t in ipairs(run.targets) do
				local dx, dz = x - t.x, z - t.z
				if dx * dx + dz * dz < 1225 then ok = false break end
			end
		end
		if ok then return x, z end
	end
	return first[1], first[2]
end

local function moveEnemy(run, e, dx, dz)
	local nx, nz = e.x + dx, e.z + dz
	local info = run.info
	local collided = false
	for _, o in ipairs(info.obstacles) do
		local ddx, ddz = nx - o.x, nz - o.z
		local minD = o.r + e.r * 0.7
		local d2 = ddx * ddx + ddz * ddz
		if d2 < minD * minD then
			local d = math.sqrt(d2)
			if d < 0.01 then d = 0.01 ddx = 1 end
			nx = o.x + ddx / d * minD
			nz = o.z + ddz / d * minD
			-- slide around the obstacle
			local len = math.sqrt(dx * dx + dz * dz)
			nx = nx + (-ddz / d) * (e.side or 1) * len * 0.8
			nz = nz + (ddx / d) * (e.side or 1) * len * 0.8
			collided = true
		end
	end
	local lim = info.half - e.r - 1
	e.x = math.clamp(nx, info.ox - lim, info.ox + lim)
	e.z = math.clamp(nz, -lim, lim)
	return collided
end

local function areaDamage(run, x, z, r, dmg)
	for _, p in ipairs(run.players) do
		local _, h, hrp = getChar(p)
		if h and h.Health > 0 then
			local dx, dz = hrp.Position.X - x, hrp.Position.Z - z
			if dx * dx + dz * dz <= (r + 0.8) * (r + 0.8) then
				damagePlayer(p, dmg)
			end
		end
	end
end

local function throwRock(run, e, tx, tz, dur, radius, dmg)
	runFx(run, "Tele", tx, tz, radius, dur)
	runFx(run, "Rock", e.x, e.z, tx, tz, dur)
	schedule(run, os.clock() + dur, function()
		areaDamage(run, tx, tz, radius, dmg)
		runFx(run, "Boom", tx, tz, radius)
	end)
end

local function swingBossSword(e)
	local w = e.weapon
	if not w then return end
	task.spawn(function()
		local t0 = os.clock()
		if w.trail then w.trail.Enabled = true end
		while w.weld.Parent do
			local t = os.clock() - t0
			if t > 0.9 then break end
			local a
			if t < 0.45 then
				a = -0.9 * (t / 0.45)
			else
				a = -0.9 + ((t - 0.45) / 0.4) * (math.pi * 2 + 0.9)
			end
			w.weld.C0 = CFrame.Angles(0, a, 0) * w.base
			task.wait()
		end
		if w.trail then w.trail.Enabled = false end
		if w.weld.Parent then w.weld.C0 = w.base end
	end)
end

local function stepBoss(run, e, dist, nx, nz, dt, now)
	local def = e.def
	local pct = e.hp / e.maxHp
	if e.busyUntil and now < e.busyUntil then return end
	local step = e.speed * dt
	if def.boss == "titan" then
		if now >= e.nextRock then
			e.nextRock = now + (pct < 0.5 and 3.0 or 4.5)
			local n = pct < 0.5 and 3 or 2
			for _ = 1, n do
				local t = run.targets[math.random(#run.targets)]
				throwRock(run, e, t.x + (math.random() - 0.5) * 10, t.z + (math.random() - 0.5) * 10, 1.4, def.rockR, e.dmg * 0.9)
			end
			e.busyUntil = now + 0.6
			return
		end
		if dist < e.r + 6 and now >= e.nextSlam then
			e.nextSlam = now + 3.5
			local sx, sz, rad = e.x, e.z, e.r + 7
			runFx(run, "Tele", sx, sz, rad, 0.9)
			schedule(run, now + 0.9, function()
				areaDamage(run, sx, sz, rad, e.dmg * 1.4)
				runFx(run, "Boom", sx, sz, rad)
			end)
			e.busyUntil = now + 1.1
			return
		end
	else
		if dist < e.r + 9 and now >= e.nextSweep then
			e.nextSweep = now + (pct < 0.5 and 2.4 or 3.2)
			local sx, sz, rad = e.x, e.z, e.r + 9
			runFx(run, "Tele", sx, sz, rad, 0.8)
			swingBossSword(e)
			schedule(run, now + 0.8, function()
				areaDamage(run, sx, sz, rad, e.dmg)
				runFx(run, "Boom", sx, sz, rad * 0.8)
			end)
			e.busyUntil = now + 1.0
			return
		end
	end
	if dist > e.r + 1.5 then
		moveEnemy(run, e, nx * step, nz * step)
	end
end

local function stepEnemy(run, e, dt, now)
	local targets = run.targets
	if #targets == 0 then return end
	local best, bd = nil, math.huge
	for _, t in ipairs(targets) do
		local dx, dz = t.x - e.x, t.z - e.z
		local d2 = dx * dx + dz * dz
		if d2 < bd then bd = d2 best = t end
	end
	local dist = math.sqrt(bd)
	local nx, nz = 0, -1
	if dist > 0.001 then nx, nz = (best.x - e.x) / dist, (best.z - e.z) / dist end
	e.fx, e.fz = nx, nz
	if e.boss then
		stepBoss(run, e, dist, nx, nz, dt, now)
		return
	end
	local def = e.def
	local step = e.speed * dt
	if def.ranged then
		if dist > def.keep + 4 then
			moveEnemy(run, e, nx * step, nz * step)
		elseif dist < def.keep - 6 then
			moveEnemy(run, e, -nx * step * 0.8, -nz * step * 0.8)
		end
		if dist <= def.shootRange and now >= e.nextAtk then
			e.nextAtk = now + def.atkCd
			spawnProj(run, { kind = def.projKind, x = e.x, z = e.z, dx = nx, dz = nz, speed = def.projSpeed, range = def.shootRange + 8, dmg = e.dmg, enemy = true, hitR = 0.9 })
		end
	else
		if dist > e.r + 2.2 then
			moveEnemy(run, e, nx * step, nz * step)
		elseif now >= e.nextAtk then
			e.nextAtk = now + def.atkCd
			damagePlayer(best.p, e.dmg)
		end
	end
end

local projSeq = 0
spawnProj = function(run, t)
	projSeq = projSeq + 1
	t.id = projSeq
	t.left = t.range
	table.insert(run.projs, t)
	runFx(run, "Proj", t.id, t.kind, t.x, t.z, t.dx, t.dz, t.speed, t.range)
end

local function enemiesInCircle(run, x, z, r)
	local out = {}
	for _, e in ipairs(run.enemies) do
		local dx, dz = e.x - x, e.z - z
		local m = r + e.r
		if dx * dx + dz * dz <= m * m then table.insert(out, e) end
	end
	return out
end

local function stepProjectiles(run, dt)
	for i = #run.projs, 1, -1 do
		local pr = run.projs[i]
		local step = pr.speed * dt
		pr.x = pr.x + pr.dx * step
		pr.z = pr.z + pr.dz * step
		pr.left = pr.left - step
		local ended, explode, hit = false, false, nil
		if pr.enemy then
			for _, t in ipairs(run.targets) do
				local dx, dz = t.x - pr.x, t.z - pr.z
				if dx * dx + dz * dz < (pr.hitR + 1.2) * (pr.hitR + 1.2) then
					damagePlayer(t.p, pr.dmg)
					ended = true
					break
				end
			end
		else
			for _, e in ipairs(run.enemies) do
				local dx, dz = e.x - pr.x, e.z - pr.z
				local m = e.r + pr.hitR
				if dx * dx + dz * dz < m * m then hit = e break end
			end
			if hit then
				ended = true
				if pr.radius then
					explode = true
				else
					damageEnemy(run, hit, pr.dmg, pr.owner, pr.crit)
					if not hit.dead and not hit.boss then moveEnemy(run, hit, pr.dx * 0.8, pr.dz * 0.8) end
				end
			end
		end
		if not ended and pr.left <= 0 then
			ended = true
			if pr.radius then explode = true end
		end
		if ended then
			table.remove(run.projs, i)
			if explode then
				local victims = enemiesInCircle(run, pr.x, pr.z, pr.radius)
				for _, e in ipairs(victims) do
					damageEnemy(run, e, pr.dmg, pr.owner, pr.crit)
				end
			end
			runFx(run, "ProjEnd", pr.id, pr.x, pr.z, pr.kind, pr.radius or 0)
		end
	end
end

-- combat -----------------------------------------------------
damagePlayer = function(p, amount)
	local st = S[p]
	if not st or st.dead then return end
	if st.invUntil and st.invUntil > os.clock() then return end
	local _, h, hrp = getChar(p)
	if not h or h.Health <= 0 then return end
	amount = math.max(1, math.floor(amount))
	h.Health = h.Health - amount
	ToClient:FireClient(p, "Hurt")
	if st.run then
		runFx(st.run, "Dmg", hrp.Position.X, hrp.Position.Z, amount, false, true)
	end
end

damageEnemy = function(run, e, amount, killer, crit)
	if e.dead then return end
	amount = math.max(1, math.floor(amount))
	e.hp = e.hp - amount
	runFx(run, "Dmg", e.x, e.z, amount, crit and true or false, false)
	e.fill.Size = UDim2.fromScale(math.clamp(e.hp / e.maxHp, 0, 1), 1)
	if e.hp <= 0 then killEnemy(run, e, killer) end
end

killEnemy = function(run, e, killer)
	if e.dead then return end
	e.dead = true
	local idx = table.find(run.enemies, e)
	if idx then table.remove(run.enemies, idx) end
	runFx(run, "Death", e.x, e.z, e.r, e.def.kind)
	e.model:Destroy()
	if killer and D[killer] and run.gain[killer] then
		local mult = e.boss and 12 or 1
		local xp = math.floor(e.lvl * 2 * run.dcfg.reward * mult)
		local coins = math.max(1, math.floor(e.lvl * run.dcfg.reward * 0.5 * mult))
		D[killer].coins = D[killer].coins + coins
		local g = run.gain[killer]
		g.xp = g.xp + xp
		g.coins = g.coins + coins
		g.kills = g.kills + 1
		grantXP(killer, xp)
	end
end

local function playerAttack(p, aim)
	local st = S[p]
	local run = st and st.run
	if not run or run.over or st.dead then return end
	local d = D[p]
	local cls = d.class
	if not cls then return end
	local c, h, hrp = getChar(p)
	if not c or h.Health <= 0 then return end
	local now = os.clock()
	if now < (st.nextAtk or 0) - 0.03 then return end
	local ws = Config.weaponStats(cls, d.upg[cls])
	local cdef = Config.Classes[cls]
	st.nextAtk = now + ws.cooldown
	local crit = math.random() < ws.crit
	local dmg = ws.damage * (0.92 + math.random() * 0.16) * (crit and 2 or 1)
	local px, pz = hrp.Position.X, hrp.Position.Z
	local dx, dz = aim.X - px, aim.Z - pz
	local m = math.sqrt(dx * dx + dz * dz)
	if m < 0.01 then
		local lv = hrp.CFrame.LookVector
		dx, dz = lv.X, lv.Z
		m = math.sqrt(dx * dx + dz * dz)
		if m < 0.01 then dx, dz, m = 0, -1, 1 end
	end
	dx, dz = dx / m, dz / m
	swingWeapon(st, cls, ws.cooldown)
	if cdef.kind == "melee" then
		runFx(run, "Slash", px, pz, dx, dz, ws.range, cdef.arc, crit, st.swingDir or 1)
		local cosA = math.cos(math.rad(cdef.arc) / 2)
		local hits = {}
		for _, e in ipairs(run.enemies) do
			local ex, ez = e.x - px, e.z - pz
			local dist = math.sqrt(ex * ex + ez * ez)
			if dist <= ws.range + e.r then
				local dot = dist < 0.5 and 1 or (ex * dx + ez * dz) / dist
				if dot >= cosA or dist < e.r + 1.2 then table.insert(hits, e) end
			end
		end
		for _, e in ipairs(hits) do
			damageEnemy(run, e, dmg, p, crit)
			if not e.dead and not e.boss then moveEnemy(run, e, dx * 1.6, dz * 1.6) end
		end
	elseif cdef.kind == "arrow" then
		spawnProj(run, { kind = "arrow", x = px + dx * 2, z = pz + dz * 2, dx = dx, dz = dz, speed = cdef.projSpeed, range = ws.range, dmg = dmg, owner = p, crit = crit, hitR = 0.8 })
	else
		spawnProj(run, { kind = "fireball", x = px + dx * 2.5, z = pz + dz * 2.5, dx = dx, dz = dz, speed = cdef.projSpeed, range = ws.range, dmg = dmg, owner = p, crit = crit, hitR = 1.3, radius = cdef.radius })
	end
end

-- run update -------------------------------------------------
local function updateRun(run, dt, now)
	local targets = {}
	for _, p in ipairs(run.players) do
		local st = S[p]
		if st and not st.dead then
			local _, h, hrp = getChar(p)
			if h and h.Health > 0 then
				table.insert(targets, { p = p, x = hrp.Position.X, z = hrp.Position.Z })
			end
		end
	end
	run.targets = targets

	for i = #run.events, 1, -1 do
		local ev = run.events[i]
		if ev and now >= ev.t then
			table.remove(run.events, i)
			local ok, err = pcall(ev.fn)
			if not ok then warn(err) end
		end
	end

	if #run.queue > 0 and now >= run.nextSpawn and #run.enemies < run.cap then
		local item = table.remove(run.queue, 1)
		local x, z
		if item.boss then
			x, z = run.info.ox, -run.info.half + 22
		else
			x, z = pickSpawn(run)
		end
		spawnEnemy(run, item.def, item.lvl, x, z)
		run.nextSpawn = now + 0.45
	end

	local list = run.enemies
	for _, e in ipairs(list) do
		stepEnemy(run, e, dt, now)
	end
	for i = 1, #list do
		for j = i + 1, #list do
			local a, b = list[i], list[j]
			local dx, dz = b.x - a.x, b.z - a.z
			local m = (a.r + b.r) * 0.85
			local d2 = dx * dx + dz * dz
			if d2 < m * m and d2 > 0.0001 then
				local d = math.sqrt(d2)
				local push = (m - d) * 0.5
				local ux, uz = dx / d, dz / d
				if not a.boss then a.x = a.x - ux * push a.z = a.z - uz * push end
				if not b.boss then b.x = b.x + ux * push b.z = b.z + uz * push end
			end
		end
	end
	for _, e in ipairs(list) do
		if e.root and e.root.Parent then
			local pos = Vector3.new(e.x, 0.2, e.z)
			e.root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(e.fx, 0, e.fz))
		end
	end

	stepProjectiles(run, dt)

	if now >= run.nextHud then
		run.nextHud = now + 0.4
		local boss = nil
		if run.boss and not run.boss.dead then
			boss = { name = run.boss.def.name, hp = run.boss.hp, max = run.boss.maxHp }
		end
		runFx(run, "Run", { wave = run.wave, waves = 3, left = #run.enemies + #run.queue, boss = boss, loc = run.cfg.name, diff = run.dcfg.name })
	end
end

local function reviveDead(run)
	for _, p in ipairs(run.players) do
		local st = S[p]
		if st and st.dead then
			st.dead = false
			task.spawn(function()
				p:LoadCharacter()
			end)
		end
	end
end

local function healAll(run, frac)
	for _, p in ipairs(run.players) do
		local _, h = getChar(p)
		if h and h.Health > 0 then
			h.Health = math.min(h.MaxHealth, h.Health + h.MaxHealth * frac)
		end
	end
end

local function runMain(run)
	task.wait(3)
	for w = 1, 3 do
		if run.over then return end
		run.wave = w
		run.queue = buildQueue(run, w)
		run.nextSpawn = os.clock() + 1
		if w == 3 then
			runToast(run, "FINAL WAVE 3 / 3  -  BOSS!", "ff4d4d", 4)
		else
			runToast(run, "WAVE " .. w .. " / 3", "ffd84a", 3)
		end
		while not run.over do
			task.wait(0.3)
			if #run.queue == 0 and #run.enemies == 0 then break end
		end
		if run.over then return end
		if w < 3 then
			runToast(run, "WAVE " .. w .. " CLEARED!", "6bd66b", 3)
			reviveDead(run)
			healAll(run, 0.5)
			task.wait(7)
		end
	end
	if not run.over then finishRun(run, true) end
end

local function createRun(locId, diff, members)
	local cfg = Config.Locations[locId]
	local dcfg = Config.Difficulties[diff]
	local slot = 1
	while slots[slot] do slot = slot + 1 end
	local ox = 3000 + slot * 400
	local folder = Instance.new("Folder")
	folder.Name = "Run" .. slot
	folder.Parent = Workspace
	local info = MapBuilder.arena(locId, ox, folder, os.time() + slot * 17)
	local ef = Instance.new("Folder")
	ef.Name = "Enemies"
	ef.Parent = folder
	local total = math.clamp(50 + (#members - 1) * 8 + dcfg.extra, 50, 100)
	local w1 = math.floor(total * 0.3)
	local w2 = math.floor(total * 0.35)
	local run = {
		cfg = cfg, dcfg = dcfg, diff = diff, slot = slot, folder = folder, enemyFolder = ef, info = info,
		players = {}, enemies = {}, projs = {}, queue = {}, events = {}, targets = {}, gain = {},
		wave = 0, total = total, waveCounts = { w1, w2, total - w1 - w2 },
		cap = math.min(36, 18 + 6 * #members), nextSpawn = 0, nextHud = 0, over = false,
	}
	slots[slot] = run
	table.insert(runs, run)
	for _, p in ipairs(members) do
		local st = S[p]
		st.run = run
		st.zone = nil
		st.party = nil
		st.dead = false
		table.insert(run.players, p)
		run.gain[p] = { xp = 0, coins = 0, kills = 0 }
		p:SetAttribute("InRun", true)
		ToClient:FireClient(p, "Zone", nil)
		ToClient:FireClient(p, "Env", locId)
		local c = p.Character
		if c then
			c:PivotTo(CFrame.new(info.spawn + Vector3.new(math.random(-8, 8), 0, math.random(-4, 4))))
			applyStats(p, true)
		end
		toast(p, cfg.name .. "  -  " .. dcfg.name, dcfg.color, 3.5)
	end
	task.spawn(runMain, run)
end

startRun = function(pt)
	if not parties[pt.id] then return end
	parties[pt.id] = nil
	local members = {}
	for _, p in ipairs(pt.members) do
		local st = S[p]
		if st then
			st.party = nil
			local c, h = getChar(p)
			if c and h.Health > 0 and p.Parent then table.insert(members, p) end
		end
	end
	if #members > 0 then
		createRun(pt.loc, pt.diff, members)
	end
	broadcastParties(pt.gate)
end

returnToLobby = function(p)
	local st = S[p]
	if not st then return end
	local run = st.run
	st.run = nil
	st.zone = nil
	st.dead = false
	p:SetAttribute("InRun", false)
	if run then
		local i = table.find(run.players, p)
		if i then table.remove(run.players, i) end
	end
	ToClient:FireClient(p, "Env", "lobby")
	ToClient:FireClient(p, "RunEnd")
	local c, h, hrp = getChar(p)
	if c and h.Health > 0 and not hrp.Anchored then
		applyStats(p, true)
		c:PivotTo(CFrame.new(lobbySpawnPos()))
	else
		task.spawn(function()
			p:LoadCharacter()
		end)
	end
	pushData(p)
end

endRun = function(run)
	if run.destroyed then return end
	run.destroyed = true
	run.over = true
	for i = #run.players, 1, -1 do
		returnToLobby(run.players[i])
	end
	if run.folder then run.folder:Destroy() end
	if slots[run.slot] == run then slots[run.slot] = nil end
end

finishRun = function(run, won)
	if run.over then return end
	run.over = true
	local cfg, dc = run.cfg, run.dcfg
	for _, p in ipairs(run.players) do
		local d = D[p]
		if d then
			local xp, coins, unlockedName = 0, 0, nil
			if won then
				xp = math.floor(cfg.xp * dc.reward)
				coins = math.floor(cfg.coins * dc.reward)
				d.coins = d.coins + coins
				d.wins = (d.wins or 0) + 1
				if run.diff == (d.unlocked[cfg.id] or 1) and run.diff < #Config.Difficulties then
					d.unlocked[cfg.id] = run.diff + 1
					unlockedName = Config.Difficulties[run.diff + 1].name
				end
				grantXP(p, xp)
			end
			local g = run.gain[p]
			ToClient:FireClient(p, "Result", {
				won = won, xp = xp + g.xp, coins = coins + g.coins, kills = g.kills, unlocked = unlockedName,
				level = d.level, loc = cfg.name, diff = dc.name,
			})
			pushData(p)
			task.spawn(saveData, p)
		end
	end
	task.delay(won and 20 or 10, function()
		endRun(run)
	end)
end

checkDefeat = function(run)
	if run.over then return end
	for _, p in ipairs(run.players) do
		local st = S[p]
		if st and not st.dead then return end
	end
	finishRun(run, false)
end

onDied = function(p, char)
	local st = S[p]
	if not st then return end
	st.dead = true
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Anchored = true end
	local sp = char:FindFirstChild("Sprite")
	if sp then
		for _, d in ipairs(sp:GetDescendants()) do
			if d:IsA("BasePart") then d.Transparency = math.max(d.Transparency, 0.7) end
		end
	end
	ToClient:FireClient(p, "Down")
	if st.run then
		checkDefeat(st.run)
	else
		task.delay(2, function()
			if S[p] and S[p].dead then
				S[p].dead = false
				p:LoadCharacter()
			end
		end)
	end
end

-- ============================================================ REMOTES
ToServer.OnServerEvent:Connect(function(p, action, a, b, c, d, e)
	local st = S[p]
	if not st or type(action) ~= "string" then return end
	if action == "Attack" then
		if typeof(a) == "Vector3" then playerAttack(p, a) end
	elseif action == "Dash" then
		local now = os.clock()
		if now < (st.dashAt or 0) or st.dead then return end
		st.dashAt = now + Config.DashCooldown - 0.2
		st.invUntil = now + 0.3
		local _, _, hrp = getChar(p)
		if hrp then
			ToClient:FireAllClients("DashFx", hrp.Position.X, hrp.Position.Z)
		end
	elseif action == "ChooseClass" then
		if not st.run and not st.party and type(a) == "string" and Config.Classes[a] then
			if D[p].class ~= a then chooseClass(p, a) end
		end
	elseif action == "CreateParty" then
		createParty(p, a, b, c, d, e)
	elseif action == "JoinParty" then
		joinParty(p, a)
	elseif action == "LeaveParty" then
		leaveParty(p)
	elseif action == "StartParty" then
		local pt = st.party
		if pt and pt.host == p then startRun(pt) end
	elseif action == "Upgrade" then
		if st.zone ~= "upgrade" or type(a) ~= "string" or type(b) ~= "string" then return end
		local d = D[p]
		if not Config.Classes[a] then return end
		local def
		for _, s in ipairs(Config.Stats) do
			if s.id == b then def = s end
		end
		if not def then return end
		d.upg[a] = d.upg[a] or {}
		local lv = d.upg[a][b] or 0
		if lv >= def.max or d.points < 1 then return end
		d.points = d.points - 1
		d.upg[a][b] = lv + 1
		pushData(p)
	elseif action == "BuyVit" then
		local d = D[p]
		if st.zone ~= "upgrade" or d.vit >= Config.VitMax then return end
		local cost = Config.vitCost(d.vit)
		if d.coins < cost then return end
		d.coins = d.coins - cost
		d.vit = d.vit + 1
		local _, h = getChar(p)
		applyStats(p, false)
		if h then h.Health = math.min(h.MaxHealth, h.Health + 12) end
		pushData(p)
	elseif action == "BuySwift" then
		local d = D[p]
		if st.zone ~= "upgrade" or d.swift >= Config.SwiftMax then return end
		local cost = Config.swiftCost(d.swift)
		if d.coins < cost then return end
		d.coins = d.coins - cost
		d.swift = d.swift + 1
		applyStats(p, false)
		pushData(p)
	elseif action == "ReturnLobby" then
		if st.run and st.run.over then returnToLobby(p) end
	end
end)

-- ============================================================ PLAYERS
local function onPlayer(p)
	S[p] = { zone = nil, run = nil, party = nil, nextAtk = 0, dashAt = 0, invUntil = 0, dead = false }
	D[p] = loadData(p)
	p:SetAttribute("InRun", false)
	pushData(p)
	p.CharacterAdded:Connect(function(c)
		task.spawn(setupCharacter, p, c)
	end)
	p:LoadCharacter()
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, p)
end

Players.PlayerRemoving:Connect(function(p)
	local st = S[p]
	if st then
		leaveParty(p)
		local run = st.run
		if run then
			local i = table.find(run.players, p)
			if i then table.remove(run.players, i) end
			if #run.players == 0 then
				endRun(run)
			else
				checkDefeat(run)
			end
		end
	end
	saveData(p)
	S[p] = nil
	D[p] = nil
end)

game:BindToClose(function()
	for p in pairs(D) do
		saveData(p)
	end
end)

-- zone detection (lobby)
task.spawn(function()
	while true do
		task.wait(0.15)
		for p, st in pairs(S) do
			if not st.run then
				local zone
				local _, h, hrp = getChar(p)
				if hrp and h.Health > 0 and not st.dead then
					local pos = hrp.Position
					for _, zn in ipairs(Config.Lobby.zones) do
						local dx, dz = pos.X - zn.x, pos.Z - zn.z
						if dx * dx + dz * dz <= zn.r * zn.r then
							zone = zn
							break
						end
					end
				end
				local zid = zone and zone.id or nil
				if zid ~= st.zone then
					st.zone = zid
					if st.party and st.party.gate ~= zid then leaveParty(p) end
					ToClient:FireClient(p, "Zone", zid)
					if zid and gateZones[zid] then task.spawn(sendParties, p, zid) end
				end
			end
		end
	end
end)

-- autosave
task.spawn(function()
	while true do
		task.wait(90)
		for p in pairs(D) do
			task.spawn(saveData, p)
		end
	end
end)

-- main simulation loop
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	dt = math.min(dt, 0.1)
	for i = #runs, 1, -1 do
		local run = runs[i]
		if run.destroyed then
			table.remove(runs, i)
		elseif not run.over then
			local ok, err = pcall(updateRun, run, dt, now)
			if not ok then warn("[Run error] " .. tostring(err)) end
		end
	end
end)

print("[TopDownHeroes] server ready")
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX6">
<Properties>
<string name="Name">Sprites</string>
<ProtectedString name="Source"><![CDATA[-- Flat "2D sprite" builder: everything is made from thin discs / blocks seen from above
local TweenService = game:GetService("TweenService")

local Sprites = {}
Sprites.__index = Sprites

local BLACK = Color3.fromRGB(0, 0, 0)
local NEON = Enum.Material.Neon
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.Wood
local SLATE = Enum.Material.Slate

local function mkPart(parent, shape, size, cf, color, mat, trans)
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Transparency = trans or 0
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
	return w
end

function Sprites.new(root, parent, baseY, scale)
	return setmetatable({ root = root, parent = parent, baseY = baseY or 0, k = scale or 1 }, Sprites)
end

-- flat circle. x/z offset in local space (forward = -z), y = layer height
function Sprites:disc(d, color, x, z, y, mat, trans, thick)
	local k = self.k
	local cf = self.root.CFrame * CFrame.new(x * k, self.baseY + y * k, z * k) * CFrame.Angles(0, 0, math.pi / 2)
	local p = mkPart(self.parent, Enum.PartType.Cylinder, Vector3.new((thick or 0.3) * k, d * k, d * k), cf, color, mat, trans)
	weld(self.root, p)
	return p
end

function Sprites:block(sx, sz, color, x, z, y, rot, mat, trans, sy)
	local k = self.k
	local cf = self.root.CFrame * CFrame.new(x * k, self.baseY + y * k, z * k) * CFrame.Angles(0, rot or 0, 0)
	local p = mkPart(self.parent, Enum.PartType.Block, Vector3.new(sx * k, (sy or 0.3) * k, sz * k), cf, color, mat, trans)
	weld(self.root, p)
	return p
end

function Sprites:light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = part
end

local function radialRot(vx, vz)
	return math.atan2(vx, vz)
end

-- ===================== WEAPONS =====================
local function C(r, g, b) return Color3.fromRGB(r, g, b) end

local function darker(c, m)
	return Color3.new(c.R * m, c.G * m, c.B * m)
end

local function attach(part, x, y, z, k)
	local a = Instance.new("Attachment")
	a.Position = Vector3.new(x * k, y * k, z * k)
	a.Parent = part
	return a
end

local function mkTrail(part, a0, a1, c0, c1, life)
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = life or 0.2
	t.Color = ColorSequence.new(c0, c1 or c0)
	t.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.5, 0.65),
		NumberSequenceKeypoint.new(1, 1),
	})
	t.LightEmission = 0.7
	t.LightInfluence = 0
	t.MinLength = 0.05
	t.FaceCamera = false
	t.Enabled = false
	t.Parent = part
	return t
end

-- builds a weapon on an invisible pivot welded to root with an animatable Weld
-- returns { pivot, weld, base, trail?, arrow?, orb? }
function Sprites.weapon(kind, root, parent, handCF, scale, pal)
	pal = pal or {}
	local k = scale or 1
	local pivot = mkPart(parent, Enum.PartType.Block, Vector3.new(0.3, 0.3, 0.3), root.CFrame * handCF, Color3.new(1, 1, 1), nil, 1)
	local w = Instance.new("Weld")
	w.Part0 = root
	w.Part1 = pivot
	w.C0 = handCF
	w.Parent = pivot
	local s = Sprites.new(pivot, parent, 0, k)
	local out = { pivot = pivot, weld = w, base = handCF, kind = kind }

	if kind == "Swordsman" then
		local edge = pal.blade or C(168, 180, 198)
		local face = pal.fuller or C(222, 230, 241)
		local gold = pal.guard or C(212, 168, 72)
		local goldDark = darker(gold, 0.68)
		local grip = pal.grip or C(84, 54, 34)
		local gemC = pal.gem or C(186, 52, 66)

		-- grip with leather wraps
		s:block(0.42, 1.7, grip, 0, 0.25, 0.02, 0, FABRIC, 0, 0.3)
		for i = 0, 3 do
			s:block(0.5, 0.12, darker(grip, 0.55), 0, -0.4 + i * 0.4, 0.04, 0, FABRIC, 0, 0.3)
		end
		-- pommel
		s:disc(0.82, goldDark, 0, 1.2, 0.02, METAL, 0, 0.36)
		s:disc(0.44, gold, 0, 1.2, 0.04, METAL, 0, 0.4)
		-- crossguard
		s:block(2.8, 0.54, goldDark, 0, -0.75, 0.06, 0, METAL, 0, 0.3)
		s:block(2.4, 0.3, gold, 0, -0.75, 0.1, 0, METAL, 0, 0.32)
		s:disc(0.66, goldDark, -1.4, -0.75, 0.06, METAL, 0, 0.34)
		s:disc(0.66, goldDark, 1.4, -0.75, 0.06, METAL, 0, 0.34)
		s:disc(0.38, gold, -1.4, -0.75, 0.1, METAL, 0, 0.38)
		s:disc(0.38, gold, 1.4, -0.75, 0.1, METAL, 0, 0.38)
		s:disc(0.62, goldDark, 0, -0.75, 0.2, METAL, 0, 0.14)
		s:disc(0.4, gemC, 0, -0.75, 0.26, nil, 0, 0.14)
		s:disc(0.14, C(255, 190, 200), 0, -0.82, 0.34, NEON, 0.2, 0.06)
		-- blade: steel edge + bright face + fuller + rune glints
		local bladeEdge = s:block(0.96, 5.3, edge, 0, -3.5, 0.05, 0, METAL, 0, 0.2)
		s:block(0.62, 5.0, face, 0, -3.5, 0.1, 0, METAL, 0, 0.2)
		s:block(0.14, 3.9, C(118, 132, 156), 0, -3.4, 0.18, 0, METAL, 0, 0.08)
		s:block(0.06, 4.9, C(255, 255, 255), 0.27, -3.5, 0.2, 0, METAL, 0, 0.06)
		s:block(0.06, 4.9, C(150, 162, 184), -0.27, -3.5, 0.2, 0, METAL, 0, 0.06)
		for _, z in ipairs({ -2.3, -3.4, -4.5 }) do
			s:block(0.1, 0.42, C(150, 205, 255), 0, z, 0.23, 0, NEON, 0.3, 0.05)
		end
		s:block(0.68, 0.68, edge, 0, -6.1, 0.05, math.pi / 4, METAL, 0, 0.2)
		s:block(0.42, 0.42, face, 0, -6.1, 0.1, math.pi / 4, METAL, 0, 0.2)
		-- swing trail (enabled by the server while attacking)
		local a0 = attach(bladeEdge, 0, 0, -2.65, k)
		local a1 = attach(bladeEdge, 0, 0, -0.2, k)
		out.trail = mkTrail(bladeEdge, a0, a1, C(225, 240, 255), C(120, 170, 235), 0.2)

	elseif kind == "Archer" then
		local wood = pal.wood or C(124, 80, 42)
		local woodHi = C(166, 116, 66)
		local gold = C(212, 168, 72)
		local R = 3.0
		local prev
		for i = -5, 5 do
			local th = math.rad(i * 15)
			local pt = Vector2.new(R * math.sin(th), R * (1 - math.cos(th)))
			if prev then
				local v = pt - prev
				local len = v.Magnitude
				local mid = (pt + prev) / 2
				local rot = radialRot(v.X, v.Y)
				s:block(0.5, len + 0.14, darker(wood, 0.75), mid.X, mid.Y, 0.08, rot, WOOD, 0, 0.3)
				s:block(0.3, len + 0.1, wood, mid.X, mid.Y, 0.14, rot, WOOD, 0, 0.3)
				s:block(0.1, len + 0.06, woodHi, mid.X + 0.04, mid.Y, 0.3, rot, WOOD, 0, 0.1)
			end
			prev = pt
		end
		local tipZ = R * (1 - math.cos(math.rad(75)))
		local tipX = R * math.sin(math.rad(75))
		-- limb tips
		s:disc(0.6, gold, tipX, tipZ, 0.1, METAL, 0, 0.36)
		s:disc(0.6, gold, -tipX, tipZ, 0.1, METAL, 0, 0.36)
		s:disc(0.26, darker(gold, 0.6), tipX, tipZ, 0.3, METAL, 0, 0.1)
		s:disc(0.26, darker(gold, 0.6), -tipX, tipZ, 0.3, METAL, 0, 0.1)
		-- riser grip with gold rings
		s:block(0.66, 1.3, C(66, 42, 28), 0, 0, 0.3, 0, FABRIC, 0, 0.3)
		s:block(0.78, 0.14, gold, 0, -0.6, 0.34, 0, METAL, 0, 0.3)
		s:block(0.78, 0.14, gold, 0, 0.6, 0.34, 0, METAL, 0, 0.3)
		-- string (drawn back slightly in the middle)
		local nockZ = tipZ + 0.55
		local sv = Vector2.new(tipX, nockZ - tipZ)
		local slen = sv.Magnitude
		local strC = C(238, 233, 214)
		s:block(0.07, slen, strC, tipX / 2, (tipZ + nockZ) / 2, 0.1, radialRot(-sv.X, sv.Y), FABRIC, 0, 0.07)
		s:block(0.07, slen, strC, -tipX / 2, (tipZ + nockZ) / 2, 0.1, radialRot(sv.X, sv.Y), FABRIC, 0, 0.07)
		-- nocked arrow (kept in a list so it can be hidden while "reloading")
		local arrow = {}
		local headZ = -3.4
		local aLen = nockZ - headZ
		local shaftZ = (nockZ + headZ) / 2
		table.insert(arrow, s:block(0.14, aLen, C(232, 222, 188), 0, shaftZ, 0.32, 0, WOOD, 0, 0.12))
		table.insert(arrow, s:block(0.56, 0.56, C(176, 188, 206), 0, headZ, 0.32, math.pi / 4, METAL, 0, 0.12))
		table.insert(arrow, s:block(0.32, 0.32, C(228, 234, 242), 0, headZ, 0.36, math.pi / 4, METAL, 0, 0.08))
		table.insert(arrow, s:block(0.14, 0.7, C(196, 62, 62), -0.2, nockZ - 0.3, 0.34, 0.3, FABRIC, 0, 0.08))
		table.insert(arrow, s:block(0.14, 0.7, C(196, 62, 62), 0.2, nockZ - 0.3, 0.34, -0.3, FABRIC, 0, 0.08))
		table.insert(arrow, s:block(0.14, 0.6, C(236, 236, 236), 0, nockZ - 0.9, 0.34, 0, FABRIC, 0, 0.08))
		out.arrow = arrow

	elseif kind == "Mage" then
		local wood = pal.wood or C(82, 56, 38)
		local woodHi = C(122, 88, 58)
		local gold = C(212, 168, 72)
		local glow = pal.orb or C(120, 180, 245)
		local orbZ = -5.9
		-- shaft
		s:block(0.5, 8.0, wood, 0, -1.6, 0.05, 0, WOOD, 0, 0.3)
		s:block(0.14, 7.8, woodHi, 0.12, -1.6, 0.2, 0, WOOD, 0, 0.08)
		for _, z in ipairs({ 0.4, -1.4, -3.2 }) do
			s:block(0.8, 0.3, darker(gold, 0.65), 0, z, 0.1, 0, METAL, 0, 0.36)
			s:block(0.8, 0.12, gold, 0, z, 0.14, 0, METAL, 0, 0.38)
		end
		for _, z in ipairs({ -0.5, -2.3, -4.3 }) do
			s:block(0.1, 0.36, glow, 0, z, 0.22, 0, NEON, 0.35, 0.05)
		end
		s:disc(0.86, darker(gold, 0.65), 0, 2.4, 0.05, METAL, 0, 0.35)
		s:disc(0.5, gold, 0, 2.4, 0.07, METAL, 0, 0.4)
		-- head: gold ring + four spikes around the orb
		for i = 0, 9 do
			local a = i * math.pi / 5
			local vx, vz = math.cos(a), math.sin(a)
			s:block(0.34, 0.62, gold, vx * 1.5, orbZ + vz * 1.5, 0.12, radialRot(-vz, vx), METAL, 0, 0.3)
		end
		for i = 0, 3 do
			local a = math.rad(45 + i * 90)
			local vx, vz = math.cos(a), math.sin(a)
			s:block(0.24, 1.0, darker(gold, 0.8), vx * 2.0, orbZ + vz * 2.0, 0.1, radialRot(vx, vz), METAL, 0, 0.3)
		end
		-- orb
		local halo = s:disc(3.7, glow, 0, orbZ, 0.04, NEON, 0.86, 0.1)
		local mid = s:disc(2.4, glow, 0, orbZ, 0.15, NEON, 0.45, 0.4)
		local core = s:disc(1.2, C(228, 242, 255), 0, orbZ, 0.4, NEON, 0, 0.3)
		local lt = Instance.new("PointLight")
		lt.Color = glow
		lt.Range = 14
		lt.Brightness = 1
		lt.Shadows = false
		lt.Parent = mid
		-- floating sparks
		local em = Instance.new("ParticleEmitter")
		em.Rate = 10
		em.Lifetime = NumberRange.new(0.7, 1.3)
		em.Speed = NumberRange.new(0.6, 1.8)
		em.SpreadAngle = Vector2.new(180, 180)
		em.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5 * k),
			NumberSequenceKeypoint.new(1, 0),
		})
		em.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		em.Color = ColorSequence.new(C(235, 245, 255), glow)
		em.LightEmission = 1
		em.LightInfluence = 0
		em.Parent = core
		-- gentle idle pulse
		pcall(function()
			TweenService:Create(halo, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.68 }):Play()
		end)
		out.orb = { halo = halo, glow = mid, core = core, light = lt, emitter = em }

	elseif kind == "Club" then
		local wood = pal.wood or C(100, 68, 40)
		s:block(0.55, 4.4, wood, 0, -1.4, 0.05, 0, WOOD, 0, 0.35)
		s:disc(1.9, C(80, 55, 35), 0, -4.0, 0.08, WOOD, 0, 0.45)
		for i = 0, 6 do
			local a = math.rad(i * 51)
			local vx, vz = math.cos(a), math.sin(a)
			s:block(0.3, 0.9, C(170, 170, 180), vx * 1.0, -4.0 + vz * 1.0, 0.2, radialRot(vx, vz), METAL, 0, 0.25)
		end
	end
	return out
end

-- ===================== PLAYER =====================
local SKIN = Color3.fromRGB(242, 200, 160)

local HANDS = {
	Swordsman = CFrame.new(1.9, 0, -0.9) * CFrame.Angles(0, -0.12, 0),
	Archer = CFrame.new(0, 0, -2.7),
	Mage = CFrame.new(2.0, 0, -0.5) * CFrame.Angles(0, -0.05, 0),
}

function Sprites.player(cls, color, root, parent)
	local base = -2.8
	local s = Sprites.new(root, parent, base, 1)
	local torso = color or Color3.fromRGB(120, 120, 130)
	local dark = Color3.new(torso.R * 0.6, torso.G * 0.6, torso.B * 0.6)
	local hairC = Color3.fromRGB(70, 45, 28)

	s:disc(4.2, BLACK, 0.2, 0.3, 0.05, nil, 0.6, 0.05)
	-- boots
	s:block(0.8, 1.2, Color3.fromRGB(50, 38, 30), -0.6, -0.5, 0.1, 0, nil, 0, 0.3)
	s:block(0.8, 1.2, Color3.fromRGB(50, 38, 30), 0.6, -0.5, 0.1, 0, nil, 0, 0.3)
	-- torso
	s:block(3.0, 1.7, torso, 0, 0.1, 0.5, 0, FABRIC, 0, 0.6)
	s:block(1.2, 1.75, dark, 0, 0.1, 0.84, 0, FABRIC, 0, 0.1)
	s:block(3.05, 0.25, Color3.fromRGB(60, 40, 25), 0, 0.55, 0.86, 0, nil, 0, 0.1)
	-- off hand
	s:disc(0.85, SKIN, -1.7, -0.7, 0.62)
	-- head
	s:disc(1.95, SKIN, 0, -0.05, 1.0, nil, 0, 0.8)
	s:disc(0.5, SKIN, -1.0, 0, 1.0, nil, 0, 0.5)
	s:disc(0.5, SKIN, 1.0, 0, 1.0, nil, 0, 0.5)
	s:disc(0.34, Color3.fromRGB(225, 175, 140), 0, -1.0, 1.0, nil, 0, 0.4)

	local weapon
	if cls == "Swordsman" then
		s:disc(1.8, Color3.fromRGB(172, 178, 192), 0, 0.0, 1.5, METAL, 0, 0.4)
		s:block(0.4, 2.0, Color3.fromRGB(205, 50, 50), 0, 0.15, 1.78, 0, FABRIC, 0, 0.18)
		s:block(1.3, 0.14, Color3.fromRGB(30, 30, 35), 0, -0.7, 1.72, 0, nil, 0, 0.12)
		s:disc(1.45, Color3.fromRGB(150, 156, 170), -1.7, 0.15, 0.85, METAL, 0, 0.35)
		s:disc(1.45, Color3.fromRGB(150, 156, 170), 1.7, 0.15, 0.85, METAL, 0, 0.35)
		s:disc(0.5, Color3.fromRGB(235, 185, 60), -1.7, 0.15, 1.1, METAL, 0, 0.15)
		s:disc(0.5, Color3.fromRGB(235, 185, 60), 1.7, 0.15, 1.1, METAL, 0, 0.15)
		s:disc(0.85, SKIN, 1.9, -0.9, 0.9)
		weapon = Sprites.weapon("Swordsman", root, parent, HANDS.Swordsman * CFrame.new(0, base + 1.1, 0), 1)
	elseif cls == "Archer" then
		s:disc(2.3, Color3.fromRGB(46, 112, 58), 0, 0.15, 1.5, FABRIC, 0, 0.5)
		s:disc(1.3, Color3.fromRGB(34, 86, 44), 0, 0.7, 1.82, FABRIC, 0, 0.2)
		s:disc(1.05, SKIN, 0, -0.75, 1.6, nil, 0, 0.3)
		s:block(0.9, 2.1, Color3.fromRGB(110, 72, 40), 0.8, 1.0, 1.0, 0.25, FABRIC, 0, 0.35)
		for i = 0, 2 do
			s:disc(0.32, Color3.fromRGB(215, 60, 60), 0.55 + i * 0.28, 1.8 - i * 0.12, 1.25, FABRIC, 0, 0.1)
		end
		s:disc(0.85, SKIN, -0.7, -2.0, 0.9)
		s:disc(0.85, SKIN, 0.7, -2.0, 0.9)
		weapon = Sprites.weapon("Archer", root, parent, HANDS.Archer * CFrame.new(0, base + 1.0, 0), 1)
	elseif cls == "Mage" then
		local purple = Color3.fromRGB(100, 58, 170)
		s:disc(3.6, Color3.fromRGB(70, 38, 120), 0, 0.0, 1.45, FABRIC, 0, 0.25)
		s:disc(2.4, purple, 0, 0.0, 1.7, FABRIC, 0, 0.35)
		s:disc(1.5, Color3.fromRGB(125, 80, 200), 0, 0.0, 2.0, FABRIC, 0, 0.3)
		s:disc(0.6, Color3.fromRGB(255, 215, 80), 0, 0.0, 2.25, NEON, 0, 0.2)
		s:disc(3.45, Color3.fromRGB(255, 215, 80), 0, 0.0, 1.58, NEON, 0.55, 0.05)
		s:disc(0.85, SKIN, 2.0, -0.5, 0.9)
		weapon = Sprites.weapon("Mage", root, parent, HANDS.Mage * CFrame.new(0, base + 1.0, 0), 1)
	else
		s:disc(1.85, hairC, 0, 0.25, 1.5, nil, 0, 0.3)
	end
	if cls == nil then
		s:disc(1.85, hairC, 0, 0.25, 1.5, nil, 0, 0.3)
	end
	return weapon
end

-- ===================== ENEMIES =====================
local function shadow(s, r)
	s:disc(r * 2.7, BLACK, 0.1 * r, 0.18 * r, 0.04, nil, 0.6, 0.05)
end

local function zombie(s, def, r)
	local p = def.pal
	local RED = Color3.fromRGB(255, 40, 40)
	shadow(s, r)
	s:block(r * 2.0, r * 1.15, p.cloth, 0, r * 0.25, 0.3, 0, FABRIC, 0, 0.45)
	s:block(r * 0.5, r * 0.45, p.skin, r * 0.5, r * 0.55, 0.56, 0.3, nil, 0, 0.08)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.5, r * 1.7, p.skin, sx * r * 1.05, -r * 0.55, 0.45, sx * 0.12, nil, 0, 0.35)
		s:disc(r * 0.62, p.skin, sx * r * 1.15, -r * 1.45, 0.5, nil, 0, 0.4)
		s:disc(r * 0.2, Color3.fromRGB(200, 200, 190), sx * r * 1.15, -r * 1.7, 0.7, nil, 0, 0.1)
	end
	s:disc(r * 1.2, p.skin, 0, -r * 0.1, 0.55, nil, 0, 0.7)
	s:disc(r * 0.8, p.hair, 0, r * 0.25, 0.95, nil, 0, 0.12)
	s:disc(r * 0.2, RED, -r * 0.28, -r * 0.5, 0.97, NEON, 0, 0.1)
	s:disc(r * 0.2, RED, r * 0.28, -r * 0.5, 0.97, NEON, 0, 0.1)
	s:disc(r * 0.3, Color3.fromRGB(120, 20, 20), r * 0.35, -r * 0.05, 0.98, nil, 0, 0.08)
	if def.variant == "toxic" then
		s:disc(r * 2.6, Color3.fromRGB(110, 255, 60), 0, 0, 0.06, NEON, 0.82, 0.05)
		for i = 0, 3 do
			local a = i * 1.6
			s:disc(r * 0.45, Color3.fromRGB(140, 255, 70), math.cos(a) * r * 0.6, r * 0.55 + math.sin(a) * r * 0.2, 0.62, NEON, 0.1, 0.25)
		end
	elseif def.variant == "brute" then
		local bone = Color3.fromRGB(215, 205, 180)
		for _, sx in ipairs({ -1, 1 }) do
			s:disc(r * 0.95, Color3.fromRGB(120, 120, 125), sx * r * 0.95, r * 0.2, 0.75, SLATE, 0, 0.35)
			for i = 0, 2 do
				s:block(r * 0.18, r * 0.5, bone, sx * (r * 1.1 + i * r * 0.1), r * 0.05 + i * r * 0.22, 0.95, sx * (0.5 + i * 0.3), nil, 0, 0.12)
			end
		end
		s:disc(r * 0.5, bone, 0, r * 0.7, 0.62, nil, 0, 0.2)
	end
end

local function goblin(s, def, r, root, parent)
	local p = def.pal
	local v = def.variant
	local YEL = Color3.fromRGB(255, 230, 60)
	shadow(s, r)
	s:block(r * 1.8, r * 1.0, p.cloth, 0, r * 0.25, 0.3, 0, FABRIC, 0, 0.45)
	s:block(r * 1.85, r * 0.2, Color3.fromRGB(40, 30, 25), 0, r * 0.3, 0.56, 0, nil, 0, 0.1)
	s:disc(r * 0.25, Color3.fromRGB(230, 190, 60), 0, r * 0.3, 0.64, METAL, 0, 0.08)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.4, r * 1.3, p.skin, sx * r * 0.95, -r * 0.3, 0.45, sx * 0.15, nil, 0, 0.3)
		s:disc(r * 0.5, p.skin, sx * r * 1.0, -r * 0.95, 0.5, nil, 0, 0.35)
		local vx, vz = sx * 1.0, 0.35
		s:block(r * 0.3, r * 1.1, p.skin, sx * r * 0.7 + vx * r * 0.5, vz * r * 0.5 - r * 0.05, 0.85, radialRot(vx, vz), nil, 0, 0.1)
		s:disc(r * 0.18, Color3.fromRGB(235, 160, 160), sx * r * 0.7 + vx * r * 0.5, vz * r * 0.5 - r * 0.05, 0.92, nil, 0, 0.05)
	end
	s:disc(r * 1.3, p.skin, 0, -r * 0.1, 0.55, nil, 0, 0.7)
	s:block(r * 0.28, r * 0.9, p.hair, 0, r * 0.15, 0.95, 0, nil, 0, 0.14)
	s:disc(r * 0.34, Color3.new(p.skin.R * 0.8, p.skin.G * 0.8, p.skin.B * 0.8), 0, -r * 0.75, 0.95, nil, 0, 0.15)
	s:disc(r * 0.22, YEL, -r * 0.32, -r * 0.45, 0.97, NEON, 0, 0.08)
	s:disc(r * 0.22, YEL, r * 0.32, -r * 0.45, 0.97, NEON, 0, 0.08)
	local hand = CFrame.new(r * 1.0, 0.75, -r * 0.95)
	if v == "slinger" then
		s:disc(r * 0.8, Color3.fromRGB(110, 75, 45), r * 1.0, -r * 1.0, 0.8, FABRIC, 0, 0.3)
		s:disc(r * 0.4, Color3.fromRGB(130, 130, 135), r * 0.9, -r * 1.1, 1.0, SLATE, 0, 0.2)
		s:disc(r * 0.4, Color3.fromRGB(110, 110, 115), r * 1.15, -r * 0.9, 1.0, SLATE, 0, 0.2)
	elseif v == "brute" then
		s:disc(r * 1.25, Color3.fromRGB(125, 125, 135), 0, r * 0.2, 0.75, METAL, 0, 0.25)
		s:disc(r * 0.55, Color3.fromRGB(95, 95, 105), 0, r * 0.2, 0.92, METAL, 0, 0.12)
		for _, sx in ipairs({ -1, 1 }) do
			s:disc(r * 0.8, Color3.fromRGB(110, 110, 120), sx * r * 1.0, r * 0.1, 0.8, METAL, 0, 0.3)
		end
		return Sprites.weapon("Club", root, parent, hand, r / 2.4)
	elseif v == "sneaker" then
		s:disc(r * 1.9, Color3.fromRGB(30, 30, 45), 0, r * 0.5, 0.7, FABRIC, 0.1, 0.1)
		Sprites.weapon("Swordsman", root, parent, hand * CFrame.Angles(0, -0.1, 0), r / 5, { blade = Color3.fromRGB(170, 180, 190), guard = Color3.fromRGB(80, 60, 40) })
		Sprites.weapon("Swordsman", root, parent, CFrame.new(-r * 1.0, 0.75, -r * 0.95) * CFrame.Angles(0, 0.1, 0), r / 5, { blade = Color3.fromRGB(170, 180, 190), guard = Color3.fromRGB(80, 60, 40) })
	else
		Sprites.weapon("Swordsman", root, parent, hand, r / 4.2, { blade = Color3.fromRGB(150, 140, 130), guard = Color3.fromRGB(110, 80, 40), gem = Color3.fromRGB(110, 80, 40) })
	end
	return nil
end

local function titan(s, def, r)
	local p = def.pal
	local rock = Color3.fromRGB(122, 122, 128)
	shadow(s, r)
	s:disc(r * 2.4, Color3.fromRGB(70, 110, 55), 0, r * 0.15, 0.08, Enum.Material.Grass, 0.3, 0.1)
	s:block(r * 2.1, r * 1.3, p.cloth, 0, r * 0.2, 0.4, 0, FABRIC, 0, 0.6)
	s:disc(r * 1.9, p.skin, 0, r * 0.1, 0.7, SLATE, 0, 0.8)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.7, r * 1.9, p.skin, sx * r * 1.15, -r * 0.55, 0.6, sx * 0.1, SLATE, 0, 0.6)
		s:disc(r * 0.9, rock, sx * r * 1.2, -r * 1.65, 0.9, SLATE, 0, 0.8)
		s:disc(r * 0.4, Color3.fromRGB(95, 95, 100), sx * r * 1.1, -r * 1.7, 1.35, SLATE, 0, 0.3)
		s:disc(r * 1.0, rock, sx * r * 1.0, r * 0.1, 1.15, SLATE, 0, 0.6)
	end
	for i = 0, 5 do
		local a = i * 1.1 + 0.4
		s:disc(r * (0.45 + (i % 3) * 0.12), rock, math.cos(a) * r * 0.55, r * 0.55 + math.sin(a) * r * 0.25, 1.3 + (i % 2) * 0.15, SLATE, 0, 0.5)
	end
	for i = 0, 4 do
		s:disc(r * 0.4, Color3.fromRGB(60 + i * 12, 130, 50), -r * 0.7 + i * r * 0.35, r * 0.1 - (i % 2) * r * 0.3, 1.62, Enum.Material.Grass, 0, 0.2)
	end
	s:disc(r * 1.0, p.skin, 0, -r * 0.4, 1.5, SLATE, 0, 0.9)
	s:block(r * 0.9, r * 0.2, Color3.fromRGB(40, 50, 35), 0, -r * 0.65, 1.97, 0, nil, 0, 0.15)
	s:disc(r * 0.22, Color3.fromRGB(255, 140, 30), -r * 0.25, -r * 0.62, 2.05, NEON, 0, 0.1)
	s:disc(r * 0.22, Color3.fromRGB(255, 140, 30), r * 0.25, -r * 0.62, 2.05, NEON, 0, 0.1)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.14, r * 0.35, Color3.fromRGB(235, 230, 205), sx * r * 0.3, -r * 0.92, 1.9, 0, nil, 0, 0.12)
	end
	s:disc(r * 2.9, Color3.fromRGB(120, 255, 80), 0, 0, 0.06, NEON, 0.9, 0.05)
end

local function king(s, def, r, root, parent)
	local p = def.pal
	local gold = Color3.fromRGB(240, 190, 50)
	shadow(s, r)
	s:block(r * 1.9, r * 1.9, p.cloth, 0, r * 0.95, 0.2, 0, FABRIC, 0, 0.12)
	s:block(r * 1.9, r * 0.2, gold, 0, r * 1.85, 0.3, 0, METAL, 0, 0.1)
	s:block(r * 2.1, r * 1.3, Color3.fromRGB(62, 62, 74), 0, r * 0.2, 0.5, 0, METAL, 0, 0.55)
	s:disc(r * 1.0, gold, 0, r * 0.1, 0.9, METAL, 0, 0.12)
	s:disc(r * 0.5, Color3.fromRGB(220, 40, 60), 0, r * 0.1, 1.0, NEON, 0, 0.1)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.5, r * 1.5, p.skin, sx * r * 1.0, -r * 0.4, 0.55, sx * 0.1, nil, 0, 0.4)
		s:disc(r * 0.6, p.skin, sx * r * 1.0, -r * 1.1, 0.6, nil, 0, 0.4)
		s:disc(r * 1.0, gold, sx * r * 1.2, r * 0.05, 0.9, METAL, 0, 0.4)
		for i = 0, 2 do
			local a = math.rad(-30 + i * 60)
			s:block(r * 0.14, r * 0.45, gold, sx * (r * 1.2 + math.sin(a) * r * 0.7), r * 0.05 - math.cos(a) * r * 0.1 + (i - 1) * r * 0.25, 1.15, sx * 1.4, METAL, 0, 0.12)
		end
	end
	s:disc(r * 1.35, p.skin, 0, -r * 0.2, 1.0, nil, 0, 0.8)
	s:disc(r * 0.35, Color3.fromRGB(220, 255, 220), -r * 0.65, -r * 0.1, 1.0, nil, 0, 0.5)
	s:disc(r * 0.35, Color3.fromRGB(220, 255, 220), r * 0.65, -r * 0.1, 1.0, nil, 0, 0.5)
	s:disc(r * 0.4, Color3.new(p.skin.R * 0.8, p.skin.G * 0.8, p.skin.B * 0.8), 0, -r * 0.95, 1.0, nil, 0, 0.2)
	s:disc(r * 1.3, gold, 0, -r * 0.2, 1.5, METAL, 0, 0.2)
	s:disc(r * 0.95, p.skin, 0, -r * 0.2, 1.62, nil, 0, 0.2)
	s:disc(r * 0.7, p.hair, 0, r * 0.05, 1.7, nil, 0, 0.1)
	for i = 0, 5 do
		local a = i * (math.pi * 2 / 6)
		s:disc(r * 0.26, gold, math.cos(a) * r * 0.6, -r * 0.2 + math.sin(a) * r * 0.6, 1.72, METAL, 0, 0.3)
	end
	s:disc(r * 0.3, Color3.fromRGB(230, 40, 70), 0, -r * 0.8, 1.8, NEON, 0, 0.15)
	s:disc(r * 0.2, Color3.fromRGB(255, 60, 60), -r * 0.28, -r * 0.65, 1.75, NEON, 0, 0.1)
	s:disc(r * 0.2, Color3.fromRGB(255, 60, 60), r * 0.28, -r * 0.65, 1.75, NEON, 0, 0.1)
	return Sprites.weapon("Swordsman", root, parent, CFrame.new(r * 1.3, 1.0, -r * 0.5) * CFrame.Angles(0, -0.1, 0), r * 0.55,
		{ blade = Color3.fromRGB(170, 175, 185), fuller = Color3.fromRGB(120, 125, 135), guard = gold, grip = Color3.fromRGB(70, 40, 30), gem = Color3.fromRGB(230, 40, 70) })
end

function Sprites.enemy(def, root, parent)
	local s = Sprites.new(root, parent, 0, 1)
	local r = def.r
	if def.kind == "zombie" then
		zombie(s, def, r)
	elseif def.kind == "goblin" then
		return goblin(s, def, r, root, parent)
	elseif def.kind == "titan" then
		titan(s, def, r)
	elseif def.kind == "king" then
		return king(s, def, r, root, parent)
	end
	return nil
end

return Sprites
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX7">
<Properties>
<string name="Name">MapBuilder</string>
<ProtectedString name="Source"><![CDATA[-- Procedural builders for the lobby and the two dungeon arenas (everything is flat / top-down)
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))
local Sprites = require(script.Parent:WaitForChild("Sprites"))

local M = {}

local CYL = Enum.PartType.Cylinder
local BLK = Enum.PartType.Block
local MAT = Enum.Material
local C3 = Color3.fromRGB

local function part(parent, shape, size, cf, color, mat, trans, collide)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or MAT.SmoothPlastic
	p.Transparency = trans or 0
	p.CanCollide = collide or false
	p.CanQuery = collide or false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function disc(parent, d, color, x, y, z, mat, trans, thick)
	return part(parent, CYL, Vector3.new(thick or 0.2, d, d), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans, false)
end

local function block(parent, sx, sy, sz, color, x, y, z, rot, mat, trans, collide)
	return part(parent, BLK, Vector3.new(sx, sy, sz), CFrame.new(x, y, z) * CFrame.Angles(0, rot or 0, 0), color, mat, trans, collide)
end

local function collider(parent, d, x, z, h)
	h = h or 10
	return part(parent, CYL, Vector3.new(h, d, d), CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.pi / 2), C3(0, 0, 0), nil, 1, true)
end

local function addLight(p, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = p
end

local function label(parent, x, y, z, text, color, w, h, size)
	local a = part(parent, BLK, Vector3.new(1, 1, 1), CFrame.new(x, y, z), C3(255, 255, 255), nil, 1, false)
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(w or 300, h or 60)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 600
	g.Adornee = a
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color or C3(255, 255, 255)
	t.Font = Enum.Font.GothamBlack
	t.TextSize = size or 24
	t.TextStrokeTransparency = 0.2
	t.TextWrapped = true
	t.Parent = g
	g.Parent = a
	return a
end

local function ring(parent, d, thick, color, x, y, z, mat, trans)
	disc(parent, d, color, x, y, z, mat or MAT.Neon, trans, 0.15)
	disc(parent, d - thick * 2, C3(30, 30, 38), x, y + 0.02, z, MAT.Slate, 0, 0.15)
end

local function tree(parent, x, z, r, variant)
	local g
	if variant == 2 then
		g = { C3(24, 66, 58), C3(32, 86, 70), C3(44, 108, 84), C3(66, 140, 104) }
	elseif variant == 3 then
		g = { C3(120, 78, 30), C3(158, 98, 34), C3(190, 124, 40), C3(222, 160, 60) }
	else
		g = { C3(28, 80, 34), C3(40, 104, 44), C3(56, 130, 56), C3(86, 164, 74) }
	end
	disc(parent, r * 2.2, C3(0, 0, 0), x + r * 0.25, 0.08, z + r * 0.3, nil, 0.65, 0.05)
	disc(parent, r * 2.0, g[1], x, 1.6, z, MAT.Grass, 0, 0.6)
	disc(parent, r * 1.62, g[2], x - r * 0.05, 2.2, z - r * 0.05, MAT.Grass, 0, 0.6)
	disc(parent, r * 1.18, g[3], x - r * 0.1, 2.8, z - r * 0.1, MAT.Grass, 0, 0.6)
	disc(parent, r * 0.6, g[4], x - r * 0.15, 3.4, z - r * 0.15, MAT.Grass, 0, 0.6)
	for i = 0, 5 do
		local a = i * 1.05 + (x * 7 % 3)
		disc(parent, r * 0.7, g[3], x + math.cos(a) * r * 0.85, 2.0 + (i % 2) * 0.15, z + math.sin(a) * r * 0.85, MAT.Grass, 0, 0.5)
	end
	collider(parent, r * 1.6, x, z, 8)
end

local function bush(parent, x, z, r)
	disc(parent, r * 2.2, C3(0, 0, 0), x + 0.3, 0.08, z + 0.4, nil, 0.7, 0.05)
	disc(parent, r * 2, C3(40, 100, 44), x, 0.7, z, MAT.Grass, 0, 0.5)
	disc(parent, r * 1.3, C3(60, 130, 56), x - r * 0.2, 1.1, z - r * 0.2, MAT.Grass, 0, 0.4)
	disc(parent, r * 0.5, C3(90, 165, 70), x - r * 0.3, 1.4, z - r * 0.3, MAT.Grass, 0, 0.3)
end

local function rock(parent, x, z, r, collide, dark)
	local base = dark and C3(70, 70, 80) or C3(125, 125, 130)
	disc(parent, r * 2.3, C3(0, 0, 0), x + r * 0.2, 0.08, z + r * 0.3, nil, 0.65, 0.05)
	disc(parent, r * 2, base, x, 1.0, z, MAT.Slate, 0, 1.4)
	disc(parent, r * 1.5, C3(base.R * 255 + 22, base.G * 255 + 22, base.B * 255 + 22), x - r * 0.15, 1.9, z - r * 0.15, MAT.Slate, 0, 0.5)
	disc(parent, r * 0.7, C3(base.R * 255 + 45, base.G * 255 + 45, base.B * 255 + 45), x - r * 0.3, 2.3, z - r * 0.3, MAT.Slate, 0, 0.3)
	block(parent, r * 0.1, 0.1, r * 1.1, C3(40, 40, 46), x + r * 0.3, 2.2, z + r * 0.1, 0.7, nil, 0, false)
	if collide then
		collider(parent, r * 1.7, x, z, 8)
	end
end

local function flower(parent, x, z, rng)
	local cols = { C3(255, 90, 120), C3(255, 220, 70), C3(250, 250, 255), C3(160, 120, 255), C3(255, 150, 60) }
	local c = cols[rng:NextInteger(1, #cols)]
	disc(parent, 0.35, C3(50, 140, 50), x, 0.12, z, nil, 0, 0.05)
	disc(parent, 0.7, c, x, 0.16, z, nil, 0, 0.05)
	disc(parent, 0.28, C3(255, 230, 110), x, 0.2, z, nil, 0, 0.05)
end

local function mushroom(parent, x, z, glow)
	local cap = glow and C3(80, 220, 255) or C3(210, 50, 50)
	disc(parent, 1.3, C3(0, 0, 0), x + 0.2, 0.08, z + 0.2, nil, 0.7, 0.05)
	disc(parent, 1.2, cap, x, 0.5, z, glow and MAT.Neon or MAT.SmoothPlastic, 0, 0.5)
	if not glow then
		disc(parent, 0.28, C3(255, 255, 255), x - 0.2, 0.8, z, nil, 0, 0.05)
		disc(parent, 0.22, C3(255, 255, 255), x + 0.25, 0.8, z + 0.2, nil, 0, 0.05)
	end
end

local function lamp(parent, x, z)
	disc(parent, 1.6, C3(40, 40, 46), x, 0.6, z, MAT.Metal, 0, 1.2)
	disc(parent, 1.0, C3(255, 235, 150), x, 1.4, z, MAT.Neon, 0, 0.3)
	disc(parent, 5, C3(255, 235, 150), x, 0.1, z, MAT.Neon, 0.88, 0.05)
	local top = disc(parent, 0.3, C3(255, 255, 255), x, 1.7, z, nil, 1, 0.1)
	addLight(top, C3(255, 230, 160), 22, 1)
	collider(parent, 1.6, x, z, 4)
end

-- ===================================================== LOBBY
local GATE_COLORS = {
	C3(90, 255, 130), C3(90, 190, 255), C3(200, 120, 255), C3(255, 160, 70),
}

local function glowDisc(parent, d, color, x, y, z, trans)
	return disc(parent, d, color, x, y, z, MAT.Neon, trans or 0.8, 0.08)
end

local function torch(parent, x, z, color)
	color = color or C3(255, 150, 50)
	disc(parent, 1.8, C3(55, 50, 56), x, 0.6, z, MAT.Slate, 0, 1.2)
	disc(parent, 1.2, C3(30, 28, 32), x, 1.4, z, MAT.Metal, 0, 0.4)
	local f = disc(parent, 0.9, color, x, 1.7, z, MAT.Neon, 0.1, 0.3)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 14
	pe.Lifetime = NumberRange.new(0.6, 1.1)
	pe.Speed = NumberRange.new(1.5, 3)
	pe.EmissionDirection = Enum.NormalId.Right
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new(0.1, 1)
	pe.Color = ColorSequence.new(color, C3(255, 70, 30))
	pe.LightEmission = 1
	pe.Parent = f
	addLight(f, color, 18, 1.4)
	collider(parent, 1.6, x, z, 4)
end

local function bench(parent, x, z, rot)
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, rot, 0)
	local function b(sx, sy, sz, ox, oy, oz, col, mat)
		part(parent, BLK, Vector3.new(sx, sy, sz), cf * CFrame.new(ox, oy, oz), col, mat, 0, false)
	end
	b(6, 0.4, 2, 0, 1.2, 0, C3(150, 104, 60), MAT.WoodPlanks)
	b(0.5, 1.2, 1.6, -2.5, 0.6, 0, C3(50, 50, 58), MAT.Metal)
	b(0.5, 1.2, 1.6, 2.5, 0.6, 0, C3(50, 50, 58), MAT.Metal)
	b(6, 0.8, 0.4, 0, 1.9, -0.9, C3(130, 90, 52), MAT.WoodPlanks)
end

local function banner(parent, x, z, color, rot)
	block(parent, 0.5, 6.2, 0.5, C3(60, 44, 34), x, 3.1, z, 0, MAT.Wood, 0, false)
	block(parent, 3.2, 0.2, 5, color, x, 6.4, z + 2.6, rot or 0, MAT.Fabric, 0, false)
	block(parent, 3.6, 0.3, 0.4, C3(255, 214, 90), x, 6.6, z + 0.2, 0, MAT.Metal, 0, false)
end

local function hedge(parent, x, z, sx, sz)
	block(parent, sx, 2.2, sz, C3(38, 104, 46), x, 1.1, z, 0, MAT.Grass, 0, true)
	block(parent, sx - 0.8, 0.4, sz - 0.8, C3(64, 140, 62), x, 2.3, z, 0, MAT.Grass, 0, false)
end

local function pillar(parent, x, z, color)
	disc(parent, 2.6, C3(36, 36, 44), x, 0.45, z, MAT.Slate, 0, 0.9)
	disc(parent, 2.0, C3(92, 92, 106), x, 2.6, z, MAT.Marble, 0, 4.2)
	disc(parent, 2.6, C3(36, 36, 44), x, 4.9, z, MAT.Slate, 0, 0.6)
	local cap = disc(parent, 1.5, color, x, 5.3, z, MAT.Neon, 0.05, 0.4)
	addLight(cap, color, 14, 1)
	return cap
end

-- builds a live label on an invisible anchor and returns the TextLabel
local function liveLabel(parent, x, y, z, text, color, w, h, size)
	local a = label(parent, x, y, z, text, color, w, h, size)
	return a:FindFirstChildOfClass("BillboardGui"):FindFirstChildOfClass("TextLabel")
end

function M.lobby(folder)
	local rng = Random.new(42)
	local H = Config.Lobby.half
	local gates = {}

	-- outer grass with a darker rim
	part(folder, BLK, Vector3.new(520, 1, 520), CFrame.new(0, -0.5, 0), C3(84, 140, 70), MAT.Grass, 0, true)
	for i = 1, 70 do
		local x, z = rng:NextNumber(-250, 250), rng:NextNumber(-250, 250)
		if math.abs(x) > H + 8 or math.abs(z) > H + 8 then
			disc(folder, rng:NextNumber(10, 26), rng:NextNumber() < 0.5 and C3(76, 130, 64) or C3(94, 152, 78), x, 0.04, z, MAT.Grass, 0, 0.04)
		end
	end

	-- stone plaza (checker)
	local tile = 20
	for ix = -5, 4 do
		for iz = -5, 4 do
			local even = (ix + iz) % 2 == 0
			part(folder, BLK, Vector3.new(tile - 0.3, 0.2, tile - 0.3),
				CFrame.new(ix * tile + tile / 2, 0.1, iz * tile + tile / 2),
				even and C3(158, 154, 150) or C3(128, 124, 128), even and MAT.Cobblestone or MAT.Slate, 0, true)
		end
	end
	-- golden border inlay around the plaza
	for _, e in ipairs({ { 0, -H + 2.5, H * 2 - 4, 1 }, { 0, H - 2.5, H * 2 - 4, 1 }, { -H + 2.5, 0, 1, H * 2 - 4 }, { H - 2.5, 0, 1, H * 2 - 4 } }) do
		block(folder, e[3], 0.06, e[4], C3(214, 170, 70), e[1], 0.23, e[2], 0, MAT.Metal, 0, false)
	end

	-- walls with crenellations
	local wallC = C3(112, 80, 60)
	local function wall(sx, sz, x, z)
		block(folder, sx, 7, sz, wallC, x, 3.5, z, 0, MAT.Brick, 0, true)
		block(folder, sx, 0.6, sz + 1, C3(170, 130, 95), x, 7.2, z, 0, MAT.Cobblestone, 0, false)
	end
	wall(H * 2 + 6, 3, 0, -H - 1.5)
	wall(H * 2 + 6, 3, 0, H + 1.5)
	wall(3, H * 2, -H - 1.5, 0)
	wall(3, H * 2, H + 1.5, 0)
	for i = -9, 9 do
		local o = i * 10.5
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), o, 8.2, -H - 1.5, 0, MAT.Cobblestone, 0, false)
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), o, 8.2, H + 1.5, 0, MAT.Cobblestone, 0, false)
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), -H - 1.5, 8.2, o, 0, MAT.Cobblestone, 0, false)
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), H + 1.5, 8.2, o, 0, MAT.Cobblestone, 0, false)
	end
	-- corner towers
	for _, c in ipairs({ { -H - 3, -H - 3 }, { H + 3, -H - 3 }, { -H - 3, H + 3 }, { H + 3, H + 3 } }) do
		disc(folder, 13, C3(136, 100, 76), c[1], 5.5, c[2], MAT.Brick, 0, 11)
		disc(folder, 15, C3(170, 130, 95), c[1], 11.2, c[2], MAT.Cobblestone, 0, 1.2)
		disc(folder, 9, C3(90, 62, 50), c[1], 11.9, c[2], MAT.Slate, 0, 0.3)
		local f = disc(folder, 3, C3(255, 160, 60), c[1], 12.2, c[2], MAT.Neon, 0.2, 0.5)
		addLight(f, C3(255, 170, 80), 30, 1.5)
		collider(folder, 13, c[1], c[2], 12)
	end

	-- outside forest decoration
	for i = 1, 110 do
		local side = rng:NextInteger(1, 4)
		local a, b = rng:NextNumber(-H - 30, H + 30), rng:NextNumber(H + 14, H + 60)
		local x, z
		if side == 1 then x, z = a, -b elseif side == 2 then x, z = a, b elseif side == 3 then x, z = -b, a else x, z = b, a end
		tree(folder, x, z, rng:NextNumber(4, 7), rng:NextInteger(1, 3))
	end

	-- main avenue (spawn -> fountain -> gates street) and gate street
	local avenue = C3(190, 158, 112)
	block(folder, 14, 0.06, H * 2 - 8, avenue, 0, 0.23, 0, 0, MAT.Cobblestone, 0, false)
	block(folder, 15.5, 0.05, H * 2 - 8, C3(120, 90, 62), 0, 0.22, 0, 0, MAT.Slate, 0, false)
	block(folder, H * 2 - 8, 0.06, 12, avenue, 0, 0.23, -60, 0, MAT.Cobblestone, 0, false)
	block(folder, H * 2 - 8, 0.05, 13.5, C3(120, 90, 62), 0, 0.22, -60, 0, MAT.Slate, 0, false)
	-- red carpet to the gates
	block(folder, 5, 0.04, 80, C3(170, 40, 50), 0, 0.3, -20, 0, MAT.Fabric, 0, false)
	block(folder, 5.8, 0.03, 80.8, C3(230, 190, 80), 0, 0.28, -20, 0, MAT.Fabric, 0, false)

	-- fountain (bigger, with outer ring of light)
	disc(folder, 30, C3(120, 118, 128), 0, 0.5, 0, MAT.Slate, 0, 1)
	for i = 0, 23 do
		local a = i * math.pi / 12
		glowDisc(folder, 1.1, i % 2 == 0 and C3(120, 220, 255) or C3(255, 230, 150), math.cos(a) * 14.2, 1.1, math.sin(a) * 14.2, 0.1)
	end
	disc(folder, 24, C3(176, 176, 186), 0, 0.7, 0, MAT.Marble, 0, 1.2)
	collider(folder, 24, 0, 0, 5)
	disc(folder, 20.5, C3(70, 160, 230), 0, 1.0, 0, MAT.Glass, 0.15, 1.0)
	disc(folder, 17, C3(120, 215, 255), 0, 1.35, 0, MAT.Neon, 0.75, 0.1)
	disc(folder, 13, C3(150, 235, 255), 0, 1.4, 0, MAT.Neon, 0.8, 0.1)
	disc(folder, 8.5, C3(200, 200, 210), 0, 1.7, 0, MAT.Marble, 0, 1.4)
	disc(folder, 6.5, C3(70, 160, 230), 0, 2.45, 0, MAT.Glass, 0.15, 0.2)
	disc(folder, 3, C3(235, 245, 255), 0, 2.6, 0, MAT.Marble, 0, 0.3)
	local spout = disc(folder, 1.4, C3(190, 240, 255), 0, 3.0, 0, MAT.Neon, 0.2, 0.3)
	addLight(spout, C3(150, 220, 255), 40, 1.4)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 60
	pe.EmissionDirection = Enum.NormalId.Right
	pe.Lifetime = NumberRange.new(1, 1.6)
	pe.Speed = NumberRange.new(10, 14)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Acceleration = Vector3.new(0, -22, 0)
	pe.Size = NumberSequence.new(0.5, 0.1)
	pe.Transparency = NumberSequence.new(0.2, 1)
	pe.Color = ColorSequence.new(C3(170, 230, 255))
	pe.LightEmission = 0.6
	pe.Parent = spout

	-- spawn runes
	disc(folder, 20, C3(40, 36, 60), 0, 0.31, 32, MAT.Slate, 0, 0.06)
	glowDisc(folder, 18, C3(255, 214, 90), 0, 0.34, 32, 0.8)
	glowDisc(folder, 13, C3(40, 36, 60), 0, 0.36, 32, 0)
	glowDisc(folder, 12, C3(255, 214, 90), 0, 0.38, 32, 0.85)
	for i = 0, 7 do
		local a = i * math.pi / 4
		block(folder, 0.6, 0.1, 2.6, C3(255, 214, 90), math.cos(a) * 7.6, 0.45, 32 + math.sin(a) * 7.6, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0.1, false)
	end

	-- lamps / torches
	for _, p in ipairs({ { -40, -20 }, { 40, -20 }, { -40, 40 }, { 40, 40 }, { -85, -85 }, { 85, -85 }, { -85, 85 }, { 85, 85 }, { -20, 12 }, { 20, 12 } }) do
		lamp(folder, p[1], p[2])
	end
	for _, p in ipairs({ { -8, -88 }, { 8, -88 }, { -8, 88 }, { 8, 88 }, { -88, -30 }, { 88, -30 }, { -88, 30 }, { 88, 30 } }) do
		torch(folder, p[1], p[2])
	end

	-- hedges & benches & banners
	hedge(folder, -50, 2, 2, 24)
	hedge(folder, 50, 2, 2, 24)
	hedge(folder, -50, 40, 2, 12)
	hedge(folder, 50, 40, 2, 12)
	bench(folder, -44, 2, math.pi / 2)
	bench(folder, 44, 2, -math.pi / 2)
	bench(folder, -30, -22, 0)
	bench(folder, 30, -22, math.pi)
	bench(folder, -12, 50, 0)
	bench(folder, 12, 50, 0)
	for i = -3, 3 do
		if i ~= 0 then
			banner(folder, i * 25, -H + 5, GATE_COLORS[(math.abs(i) % 4) + 1], 0)
		end
	end

	-- flowers & bushes
	for i = 1, 200 do
		local x, z = rng:NextNumber(-H + 4, H - 4), rng:NextNumber(-H + 4, H - 4)
		if (math.abs(x) > 56 or math.abs(z) > 82) and (math.abs(x) > 9) and not (z < -48 and z > -72) then
			if i % 3 == 0 then bush(folder, x, z, rng:NextNumber(1.5, 2.4)) else flower(folder, x, z, rng) end
		end
	end
	for i = 1, 6 do
		bush(folder, -92 + i * 3, -93, 2.2)
		bush(folder, 92 - i * 3, -93, 2.2)
	end

	-- fireflies drifting over the whole plaza
	do
		local a = part(folder, BLK, Vector3.new(190, 6, 190), CFrame.new(0, 4, 0), C3(255, 255, 255), nil, 1, false)
		local ff = Instance.new("ParticleEmitter")
		ff.Rate = 28
		ff.Lifetime = NumberRange.new(5, 8)
		ff.Speed = NumberRange.new(0.5, 1.8)
		ff.SpreadAngle = Vector2.new(180, 180)
		ff.Shape = Enum.ParticleEmitterShape.Box
		ff.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		ff.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 0) })
		ff.Transparency = NumberSequence.new(0.1)
		ff.Color = ColorSequence.new(C3(255, 240, 150), C3(170, 255, 170))
		ff.LightEmission = 1
		ff.LightInfluence = 0
		ff.Parent = a
	end

	-- title
	label(folder, 0, 8, 22, "TOP-DOWN HEROES", C3(255, 235, 140), 520, 70, 46)
	label(folder, 0, 8, 12, "Pick a gate  ->  choose a location  ->  survive the waves!", C3(255, 255, 255), 640, 36, 20)
	label(folder, 0, 8, -40, "THE FOUR GATES", C3(255, 255, 255), 360, 30, 20)

	-- ================= THE FOUR GATES =================
	local wlabels = { forest = "Forest", cave = "Cave" }
	for _, zn in ipairs(Config.Lobby.zones) do
		if zn.kind == "gate" then
			local col = GATE_COLORS[zn.n]
			local dark = C3(col.R * 255 * 0.22, col.G * 255 * 0.22, col.B * 255 * 0.22)
			-- stone dais
			disc(folder, zn.r * 2 + 3, C3(52, 50, 62), zn.x, 0.26, zn.z, MAT.Slate, 0, 0.12)
			disc(folder, zn.r * 2 + 1, C3(30, 30, 38), zn.x, 0.3, zn.z, MAT.Slate, 0, 0.1)
			ring(folder, zn.r * 2, 0.9, col, zn.x, 0.34, zn.z)
			disc(folder, zn.r * 1.7, dark, zn.x, 0.5, zn.z, MAT.Marble, 0, 0.3)
			local glow = glowDisc(folder, zn.r * 1.5, col, zn.x, 0.66, zn.z, 0.78)
			glowDisc(folder, zn.r * 1.0, col, zn.x, 0.7, zn.z, 0.7)
			glowDisc(folder, zn.r * 0.5, col, zn.x, 0.74, zn.z, 0.6)
			-- rune dashes
			for i = 0, 15 do
				local a = i * math.pi / 8
				block(folder, 0.5, 0.12, 1.5, col, zn.x + math.cos(a) * zn.r * 0.78, 0.8, zn.z + math.sin(a) * zn.r * 0.78, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0, false)
			end
			-- pillars around
			for i = 0, 5 do
				local a = i * math.pi / 3 + math.pi / 6
				local cap = pillar(folder, zn.x + math.cos(a) * (zn.r + 2.2), zn.z + math.sin(a) * (zn.r + 2.2), col)
				if i == 0 then cap.Name = "GateCap" end
			end
			-- sparkles rising
			local em = disc(folder, 1, col, zn.x, 1.0, zn.z, MAT.Neon, 1, 0.1)
			local pe2 = Instance.new("ParticleEmitter")
			pe2.Rate = 22
			pe2.Lifetime = NumberRange.new(1.2, 2.2)
			pe2.Speed = NumberRange.new(3, 6)
			pe2.SpreadAngle = Vector2.new(35, 35)
			pe2.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
			pe2.Transparency = NumberSequence.new(0, 1)
			pe2.Color = ColorSequence.new(col, C3(255, 255, 255))
			pe2.LightEmission = 1
			pe2.EmissionDirection = Enum.NormalId.Right
			pe2.Parent = em
			addLight(em, col, 26, 1.3)
			-- labels
			label(folder, zn.x, 7, zn.z - 1.5, tostring(zn.n), col, 120, 90, 80)
			label(folder, zn.x, 7, zn.z - zn.r - 4.5, "GATE " .. zn.n, col, 300, 40, 30)
			local sub = liveLabel(folder, zn.x, 7, zn.z - zn.r - 1.2, "FREE - step in to host a run", C3(255, 255, 255), 340, 40, 15)
			gates[zn.id] = { sub = sub, glow = glow, color = col, n = zn.n }
		end
	end

	-- upgrade zone (yellow)
	local uz
	for _, zn in ipairs(Config.Lobby.zones) do
		if zn.id == "upgrade" then uz = zn end
	end
	disc(folder, uz.r * 2 + 3, C3(52, 50, 62), uz.x, 0.26, uz.z, MAT.Slate, 0, 0.12)
	ring(folder, uz.r * 2, 1.0, C3(255, 214, 40), uz.x, 0.34, uz.z)
	disc(folder, uz.r * 1.7, C3(90, 74, 30), uz.x, 0.5, uz.z, MAT.Marble, 0, 0.4)
	disc(folder, uz.r * 1.3, C3(255, 214, 40), uz.x, 0.62, uz.z, MAT.Neon, 0.82, 0.1)
	for i = 0, 15 do
		local a = i * math.pi / 8
		block(folder, 0.5, 0.15, 1.5, C3(255, 214, 40), uz.x + math.cos(a) * uz.r * 0.8, 0.75, uz.z + math.sin(a) * uz.r * 0.8, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0, false)
	end
	-- anvil
	block(folder, 5, 1.2, 3, C3(60, 60, 68), uz.x, 1.4, uz.z, 0, MAT.Metal, 0, false)
	block(folder, 7.5, 0.8, 2.4, C3(90, 90, 100), uz.x, 2.2, uz.z, 0, MAT.Metal, 0, false)
	block(folder, 2.5, 0.8, 2.2, C3(110, 110, 120), uz.x + 4.2, 2.2, uz.z, 0, MAT.Metal, 0, false)
	disc(folder, 1.5, C3(255, 120, 30), uz.x - 1, 2.7, uz.z, MAT.Neon, 0.2, 0.2)
	for i = 0, 5 do
		local a = i * 1.0
		local coin = disc(folder, 1.3, C3(255, 205, 40), uz.x + math.cos(a) * 8, 0.9 + (i % 3) * 0.2, uz.z + math.sin(a) * 6, MAT.Neon, 0.1, 0.2)
		if i == 0 then addLight(coin, C3(255, 214, 40), 20, 1.2) end
	end
	collider(folder, 5, uz.x, uz.z, 4)
	label(folder, uz.x, 7, uz.z - uz.r - 4, "UPGRADES", C3(255, 214, 40), 380, 48, 34)
	label(folder, uz.x, 7, uz.z - uz.r - 0.8, "Spend skill points & coins", C3(255, 255, 255), 380, 28, 16)

	-- crates
	for _, p in ipairs({ { -88, 60 }, { -84, 66 }, { 88, 60 }, { 85, 67 }, { 90, -20 }, { -90, -20 } }) do
		block(folder, 5, 4, 5, C3(150, 108, 60), p[1], 2.2, p[2], rng:NextNumber(0, 1), MAT.WoodPlanks, 0, true)
		block(folder, 5.2, 0.4, 1, C3(100, 70, 40), p[1], 4.3, p[2], 0, MAT.Wood, 0, false)
	end
	return gates
end

-- ===================================================== ARENAS
local function newPlacer(rng, obstacles, ox, half, spawnZ)
	return function(r, margin)
		for _ = 1, 40 do
			local x = rng:NextNumber(-half + 10, half - 10)
			local z = rng:NextNumber(-half + 10, half - 10)
			local ok = true
			if (x * x + (z - spawnZ) * (z - spawnZ)) < (r + 16) * (r + 16) then ok = false end
			if x * x + (z + 60) * (z + 60) < (r + 12) * (r + 12) then ok = false end
			if ok then
				for _, o in ipairs(obstacles) do
					local dx, dz = x + ox - o.x, z - o.z
					local m = r + o.r + (margin or 3)
					if dx * dx + dz * dz < m * m then ok = false break end
				end
			end
			if ok then
				table.insert(obstacles, { x = x + ox, z = z, r = r * 0.8 })
				return x + ox, z
			end
		end
		return nil
	end
end

local function boundaryWalls(folder, ox, half)
	local c = C3(0, 0, 0)
	block(folder, half * 2 + 30, 40, 6, c, ox, 20, -half - 3, 0, nil, 1, true)
	block(folder, half * 2 + 30, 40, 6, c, ox, 20, half + 3, 0, nil, 1, true)
	block(folder, 6, 40, half * 2, c, ox - half - 3, 20, 0, 0, nil, 1, true)
	block(folder, 6, 40, half * 2, c, ox + half + 3, 20, 0, 0, nil, 1, true)
end

local function buildForest(folder, ox, rng, info)
	local half = info.half
	part(folder, BLK, Vector3.new(half * 2 + 160, 1, half * 2 + 160), CFrame.new(ox, -0.5, 0), C3(34, 76, 40), MAT.Grass, 0, true)
	part(folder, BLK, Vector3.new(half * 2, 1, half * 2), CFrame.new(ox, -0.45, 0), C3(62, 118, 52), MAT.Grass, 0, true)
	-- grass patches
	for i = 1, 55 do
		local d = rng:NextNumber(8, 24)
		local g = rng:NextInteger(0, 28)
		disc(folder, d, C3(52 + g, 108 + g, 44 + math.floor(g / 2)), ox + rng:NextNumber(-half, half), 0.08, rng:NextNumber(-half, half), MAT.Grass, 0.1, 0.05)
	end
	-- dirt path from the spawn to the middle and beyond
	local px, pz = 0, 62
	for i = 1, 11 do
		local nx = px + rng:NextNumber(-12, 12)
		nx = math.clamp(nx, -40, 40)
		local nz = pz - 13
		local dx, dz = nx - px, nz - pz
		local len = math.sqrt(dx * dx + dz * dz)
		block(folder, 8.5, 0.1, len + 3, C3(126, 96, 60), ox + (px + nx) / 2, 0.12, (pz + nz) / 2, math.atan2(dx, dz), MAT.Ground, 0, false)
		for j = 1, 4 do
			disc(folder, rng:NextNumber(0.4, 0.9), C3(150, 140, 125), ox + px + rng:NextNumber(-5, 5), 0.2, pz + rng:NextNumber(-6, 6), MAT.Slate, 0, 0.1)
		end
		px, pz = nx, nz
	end
	local place = newPlacer(rng, info.obstacles, ox, half, 62)
	for i = 1, 40 do
		local r = rng:NextNumber(3.6, 6)
		local x, z = place(r, 4)
		if x then tree(folder, x, z, r, (i % 7 == 0) and 3 or ((i % 3 == 0) and 2 or 1)) end
	end
	for i = 1, 12 do
		local r = rng:NextNumber(1.6, 3.2)
		local x, z = place(r, 2)
		if x then rock(folder, x, z, r, true, false) end
	end
	for i = 1, 6 do -- stumps
		local x, z = place(1.8, 2)
		if x then
			disc(folder, 3.4, C3(0, 0, 0), x + 0.4, 0.08, z + 0.5, nil, 0.7, 0.05)
			disc(folder, 3.2, C3(98, 66, 38), x, 0.8, z, MAT.Wood, 0, 1.4)
			disc(folder, 2.5, C3(176, 134, 82), x, 1.55, z, MAT.Wood, 0, 0.1)
			disc(folder, 1.5, C3(150, 108, 64), x, 1.6, z, MAT.Wood, 0, 0.1)
			disc(folder, 0.6, C3(120, 84, 50), x, 1.65, z, MAT.Wood, 0, 0.1)
			collider(folder, 3, x, z, 3)
		end
	end
	for i = 1, 26 do bush(folder, ox + rng:NextNumber(-half + 6, half - 6), rng:NextNumber(-half + 6, half - 6), rng:NextNumber(1.4, 2.6)) end
	for i = 1, 100 do flower(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half), rng) end
	for i = 1, 16 do mushroom(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half), false) end
	for i = 1, 8 do -- fallen logs
		local x, z = ox + rng:NextNumber(-half + 8, half - 8), rng:NextNumber(-half + 8, half - 8)
		local rot = rng:NextNumber(0, math.pi)
		block(folder, 1.8, 1.6, 9, C3(92, 62, 36), x, 0.8, z, rot, MAT.Wood, 0, false)
		block(folder, 1.2, 0.1, 8, C3(70, 100, 50), x, 1.65, z, rot, MAT.Grass, 0, false)
	end
	-- light shafts
	for i = 1, 9 do
		disc(folder, rng:NextNumber(10, 18), C3(255, 240, 160), ox + rng:NextNumber(-half, half), 0.18, rng:NextNumber(-half, half), MAT.Neon, 0.92, 0.05)
	end
	-- border treeline
	for i = 1, 70 do
		local side = rng:NextInteger(1, 4)
		local a, b = rng:NextNumber(-half - 20, half + 20), rng:NextNumber(half + 5, half + 40)
		local x, z
		if side == 1 then x, z = a, -b elseif side == 2 then x, z = a, b elseif side == 3 then x, z = -b, a else x, z = b, a end
		tree(folder, ox + x, z, rng:NextNumber(4.5, 8), rng:NextInteger(1, 3))
	end
	for i = 0, 15 do -- inside border bushes
		bush(folder, ox - half + 2 + i * 10.5, -half + 3, 2.4)
		bush(folder, ox - half + 2 + i * 10.5, half - 3, 2.4)
	end
end

local function crystal(folder, x, z, r, col, withLight)
	disc(folder, r * 2.6, C3(0, 0, 0), x + 0.3, 0.08, z + 0.4, nil, 0.65, 0.05)
	disc(folder, r * 2.2, C3(50, 46, 66), x, 0.6, z, MAT.Slate, 0, 1.0)
	local c = disc(folder, r * 1.6, col, x, 1.6, z, MAT.Neon, 0.1, 1.0)
	disc(folder, r * 1.0, C3(math.min(255, col.R * 255 + 60), math.min(255, col.G * 255 + 60), math.min(255, col.B * 255 + 60)), x - 0.2, 2.3, z - 0.2, MAT.Neon, 0, 0.5)
	for i = 0, 4 do
		local a = i * 1.26
		local sh = block(folder, r * 0.45, 1.0, r * 1.5, col, x + math.cos(a) * r * 0.9, 1.4, z + math.sin(a) * r * 0.9, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0.1, false)
		if i == 0 and withLight then addLight(sh, col, 24, 1.4) end
	end
	collider(folder, r * 1.8, x, z, 8)
end

local function stalagmite(folder, x, z, r)
	disc(folder, r * 2.4, C3(0, 0, 0), x + r * 0.2, 0.08, z + r * 0.3, nil, 0.65, 0.05)
	disc(folder, r * 2.0, C3(58, 56, 66), x, 1.0, z, MAT.Slate, 0, 1.6)
	disc(folder, r * 1.55, C3(76, 74, 88), x - 0.2, 2.0, z - 0.2, MAT.Slate, 0, 0.7)
	disc(folder, r * 1.0, C3(98, 96, 112), x - 0.4, 2.7, z - 0.4, MAT.Slate, 0, 0.7)
	disc(folder, r * 0.45, C3(130, 128, 146), x - 0.5, 3.2, z - 0.5, MAT.Slate, 0, 0.4)
	collider(folder, r * 1.7, x, z, 8)
end

local function torch(folder, x, z)
	disc(folder, 1.2, C3(60, 40, 28), x, 0.7, z, MAT.Wood, 0, 1.3)
	local f = disc(folder, 1.5, C3(255, 140, 30), x, 1.6, z, MAT.Neon, 0.1, 0.3)
	disc(folder, 0.8, C3(255, 230, 120), x, 1.9, z, MAT.Neon, 0, 0.2)
	disc(folder, 9, C3(255, 150, 50), x, 0.15, z, MAT.Neon, 0.9, 0.05)
	addLight(f, C3(255, 150, 60), 28, 1.4)
end

local function skull(folder, x, z)
	local b = C3(225, 218, 195)
	disc(folder, 1.3, b, x, 0.2, z, nil, 0, 0.3)
	disc(folder, 0.28, C3(20, 20, 20), x - 0.25, 0.4, z - 0.15, nil, 0, 0.1)
	disc(folder, 0.28, C3(20, 20, 20), x + 0.25, 0.4, z - 0.15, nil, 0, 0.1)
	block(folder, 0.2, 0.2, 1.8, b, x + 1.2, 0.2, z + 0.4, 0.5, nil, 0, false)
	block(folder, 0.2, 0.2, 1.8, b, x + 1.0, 0.2, z + 0.6, -0.8, nil, 0, false)
end

local function buildCave(folder, ox, rng, info)
	local half = info.half
	part(folder, BLK, Vector3.new(half * 2 + 160, 1, half * 2 + 160), CFrame.new(ox, -0.5, 0), C3(26, 24, 32), MAT.Basalt, 0, true)
	part(folder, BLK, Vector3.new(half * 2, 1, half * 2), CFrame.new(ox, -0.45, 0), C3(66, 62, 78), MAT.Slate, 0, true)
	for i = 1, 50 do
		local g = rng:NextInteger(-14, 18)
		local mats = { MAT.Cobblestone, MAT.Pebble, MAT.Slate, MAT.Basalt }
		disc(folder, rng:NextNumber(8, 22), C3(66 + g, 62 + g, 78 + g), ox + rng:NextNumber(-half, half), 0.08, rng:NextNumber(-half, half), mats[rng:NextInteger(1, 4)], 0.05, 0.05)
	end
	for i = 1, 28 do -- cracks
		local x, z = ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half)
		local rot = rng:NextNumber(0, math.pi)
		block(folder, 0.35, 0.05, rng:NextNumber(6, 16), C3(20, 18, 26), x, 0.14, z, rot, nil, 0, false)
		block(folder, 0.25, 0.05, rng:NextNumber(3, 8), C3(20, 18, 26), x + math.sin(rot) * 5, 0.14, z + math.cos(rot) * 5, rot + 0.8, nil, 0, false)
	end
	-- lava streams (decorative)
	for s = 1, 3 do
		local x = rng:NextNumber(-60, 60)
		local z = -half + 6
		local first = true
		for i = 1, 9 do
			local nx = math.clamp(x + rng:NextNumber(-14, 14), -70, 70)
			local nz = z + 18
			local dx, dz = nx - x, nz - z
			local len = math.sqrt(dx * dx + dz * dz)
			-- keep away from the arena spawn
			if nz < 40 then
				block(folder, 6.5, 0.1, len + 2, C3(40, 20, 16), ox + (x + nx) / 2, 0.13, (z + nz) / 2, math.atan2(dx, dz), MAT.Basalt, 0, false)
				local lv = block(folder, 4.2, 0.1, len + 2, C3(255, 100, 20), ox + (x + nx) / 2, 0.18, (z + nz) / 2, math.atan2(dx, dz), MAT.Neon, 0.05, false)
				block(folder, 1.8, 0.1, len, C3(255, 210, 80), ox + (x + nx) / 2, 0.2, (z + nz) / 2, math.atan2(dx, dz), MAT.Neon, 0.1, false)
				if first then addLight(lv, C3(255, 110, 30), 26, 1.2) first = false end
			end
			x, z = nx, nz
		end
	end
	local place = newPlacer(rng, info.obstacles, ox, half, 62)
	for i = 1, 22 do
		local r = rng:NextNumber(2.2, 4.4)
		local x, z = place(r, 4)
		if x then stalagmite(folder, x, z, r) end
	end
	for i = 1, 12 do
		local r = rng:NextNumber(2.6, 5)
		local x, z = place(r, 3)
		if x then rock(folder, x, z, r, true, true) end
	end
	local ccols = { C3(90, 160, 255), C3(190, 90, 255), C3(80, 255, 200) }
	for i = 1, 11 do
		local r = rng:NextNumber(1.6, 2.6)
		local x, z = place(r, 3)
		if x then crystal(folder, x, z, r, ccols[(i % 3) + 1], i % 2 == 0) end
	end
	for i = 1, 16 do skull(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half)) end
	for i = 1, 20 do mushroom(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half), true) end
	for i = 1, 4 do -- mine tracks with carts
		local z = -60 + i * 30
		block(folder, 1.0, 0.1, 40, C3(90, 70, 50), ox + (i % 2 == 0 and -62 or 62), 0.16, z, math.pi / 2, MAT.Wood, 0, false)
		block(folder, 0.4, 0.1, 40, C3(130, 130, 140), ox + (i % 2 == 0 and -62 or 62), 0.22, z - 1, math.pi / 2, MAT.Metal, 0, false)
		block(folder, 0.4, 0.1, 40, C3(130, 130, 140), ox + (i % 2 == 0 and -62 or 62), 0.22, z + 1, math.pi / 2, MAT.Metal, 0, false)
	end
	-- torches along the borders
	for i = 0, 7 do
		torch(folder, ox - half + 3, -half + 12 + i * 22)
		torch(folder, ox + half - 3, -half + 12 + i * 22)
	end
	-- border rocks (outside walls)
	for i = 1, 90 do
		local side = rng:NextInteger(1, 4)
		local a, b = rng:NextNumber(-half - 20, half + 20), rng:NextNumber(half + 4, half + 35)
		local x, z
		if side == 1 then x, z = a, -b elseif side == 2 then x, z = a, b elseif side == 3 then x, z = -b, a else x, z = b, a end
		rock(folder, ox + x, z, rng:NextNumber(4, 9), false, true)
	end
	for i = 0, 15 do
		rock(folder, ox - half + 2 + i * 10.5, -half + 1, 4.5, false, true)
		rock(folder, ox - half + 2 + i * 10.5, half - 1, 4.5, false, true)
	end
end

function M.arena(locId, ox, folder, seed)
	local rng = Random.new(seed)
	local info = { half = 80, ox = ox, obstacles = {}, spawn = Vector3.new(ox, 4, 62) }
	boundaryWalls(folder, ox, info.half)
	if locId == "forest" then
		buildForest(folder, ox, rng, info)
	else
		buildCave(folder, ox, rng, info)
	end
	-- spawn marker
	disc(folder, 14, C3(255, 255, 255), ox, 0.2, 62, MAT.Neon, 0.9, 0.05)
	return info
end

return M
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX8">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX9">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="LocalScript" referent="RBX10">
<Properties>
<string name="Name">GameClient</string>
<ProtectedString name="Source"><![CDATA[-- GameClient: top-down camera, controls, HUD, menus and visual effects
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")

local lp = Players.LocalPlayer
local Net = RS:WaitForChild("Net")
local ToServer = Net:WaitForChild("ToServer")
local ToClient = Net:WaitForChild("ToClient")
local Config = require(RS:WaitForChild("Config"))
local cam = workspace.CurrentCamera
local C3 = Color3.fromRGB

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

-- disable the default movement controls (we move with WASD in world space)
task.spawn(function()
	pcall(function()
		local pm = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		pm:GetControls():Disable()
	end)
end)

-- ============================================================ DATA
local data = { level = 1, xp = 0, need = 100, points = 0, coins = 0, upg = {}, vit = 0, swift = 0, unlocked = {} }
local onData -- forward

local function readData()
	local s = lp:GetAttribute("Data")
	if s then
		local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
		if ok and type(t) == "table" then
			data = t
			data.upg = data.upg or {}
			data.unlocked = data.unlocked or {}
			if onData then onData() end
		end
	end
end

-- ============================================================ UI HELPERS
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
-- ------------------------------------------------------------ THEME (flat, crisp, muted)
local GOLD = C3(214, 178, 98)
local INK = C3(12, 14, 20)
local PANEL = C3(21, 24, 33)
local CARD = C3(30, 34, 46)
local LINE = C3(62, 68, 86)
local TXT = C3(232, 235, 242)
local TXT2 = C3(150, 157, 175)
local DISABLED_TXT = C3(124, 130, 148)

-- keeps hues but caps brightness / saturation so nothing screams
local function tone(c)
	local h, s, v = c:ToHSV()
	if s > 0.3 then s = s * 0.72 end
	if v > 0.62 then v = 0.62 end
	return Color3.fromHSV(h, s, v)
end

local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end
local function stroke(o, color, th, tr) return new("UIStroke", { Color = color or LINE, Thickness = th or 1.5, Transparency = tr or 0 }, o) end
local function mkLabel(parent, text, pos, size, ts, color, align, font)
	return new("TextLabel", {
		Text = text, Position = pos, Size = size, TextSize = ts or 16, TextColor3 = color or TXT,
		BackgroundTransparency = 1, Font = font or Enum.Font.GothamBold, TextXAlignment = align or Enum.TextXAlignment.Left,
		TextWrapped = true, TextStrokeTransparency = 1,
	}, parent)
end
local function mkBar(parent, pos, size, color)
	local bg = new("Frame", { Position = pos, Size = size, BackgroundColor3 = INK, BorderSizePixel = 0 }, parent)
	corner(bg, 5)
	stroke(bg, LINE, 1.5, 0.1)
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = tone(color), BorderSizePixel = 0 }, bg)
	corner(fill, 5)
	new("UIGradient", { Color = ColorSequence.new(C3(255, 255, 255), C3(176, 176, 176)), Rotation = 90 }, fill)
	local txt = mkLabel(bg, "", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 13, nil, Enum.TextXAlignment.Center)
	txt.ZIndex = 3
	txt.TextStrokeColor3 = INK
	txt.TextStrokeTransparency = 0.45
	return { bg = bg, fill = fill, txt = txt }
end

local function setDisabled(b, dis)
	b:SetAttribute("Dis", dis and true or false)
	if dis then b.TextColor3 = DISABLED_TXT end
end

local function markSelected(b)
	local st = b:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = GOLD
		st.Thickness = 2
		st.Transparency = 0
	end
end

local function mkButton(parent, text, pos, size, color, cb)
	local b = new("TextButton", {
		Text = text, Position = pos, Size = size, BackgroundColor3 = tone(color), TextColor3 = TXT,
		Font = Enum.Font.GothamBold, TextSize = 16, AutoButtonColor = false, BorderSizePixel = 0, TextWrapped = true,
	}, parent)
	corner(b, 6)
	-- crisp dark outline
	new("UIStroke", { Color = C3(8, 10, 16), Thickness = 1.5, Transparency = 0.25 }, b)
	-- soft top light (flat bevel)
	local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(255, 255, 255), BorderSizePixel = 0, Active = false }, b)
	corner(shine, 6)
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.5, 0.97), NumberSequenceKeypoint.new(1, 1) }), Rotation = 90 }, shine)
	-- hover / press overlay
	local hov = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(255, 255, 255), BackgroundTransparency = 1, BorderSizePixel = 0, Active = false }, b)
	corner(hov, 6)
	local sc = new("UIScale", {}, b)
	local function over(tr, t) TweenService:Create(hov, TweenInfo.new(t or 0.1), { BackgroundTransparency = tr }):Play() end
	b.MouseEnter:Connect(function()
		if not b:GetAttribute("Dis") then over(0.9) end
	end)
	b.MouseLeave:Connect(function()
		over(1, 0.14)
		TweenService:Create(sc, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		if b:GetAttribute("Dis") then return end
		over(0.8, 0.05)
		TweenService:Create(sc, TweenInfo.new(0.06), { Scale = 0.97 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		if b:GetAttribute("Dis") then return end
		over(0.9, 0.1)
		TweenService:Create(sc, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	if cb then
		b.MouseButton1Click:Connect(function()
			if not b:GetAttribute("Dis") then cb() end
		end)
	end
	return b
end
local function hex(s) return Color3.fromHex(s) end

local gui = new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5 }, lp:WaitForChild("PlayerGui"))

-- ------------------------------------------------------------ HUD
local info = new("Frame", { Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(290, 100), BackgroundColor3 = PANEL, BackgroundTransparency = 0.06, BorderSizePixel = 0 }, gui)
corner(info, 8)
stroke(info, LINE, 1.5, 0)
local lvlLabel = mkLabel(info, "Lv.1", UDim2.fromOffset(12, 6), UDim2.fromOffset(130, 28), 24, GOLD)
local xpBar = mkBar(info, UDim2.fromOffset(12, 38), UDim2.fromOffset(266, 16), C3(80, 150, 255))
local coinLabel = mkLabel(info, "Coins: 0", UDim2.fromOffset(12, 60), UDim2.fromOffset(140, 22), 16, GOLD)
local ptsLabel = mkLabel(info, "Skill points: 0", UDim2.fromOffset(150, 60), UDim2.fromOffset(136, 22), 16, C3(130, 200, 156))
local classLabel = mkLabel(info, "", UDim2.fromOffset(140, 6), UDim2.fromOffset(140, 28), 16, C3(196, 202, 218), Enum.TextXAlignment.Right)
local winsLabel = mkLabel(info, "", UDim2.fromOffset(12, 80), UDim2.fromOffset(266, 16), 12, TXT2)

local hpBar = mkBar(gui, UDim2.new(0.5, -200, 1, -50), UDim2.fromOffset(400, 28), C3(80, 210, 90))
local dashBar = mkBar(gui, UDim2.new(0.5, -200, 1, -76), UDim2.fromOffset(400, 14), C3(90, 200, 255))
dashBar.txt.TextSize = 11

local waveFrame = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(460, 46), BackgroundColor3 = PANEL, BackgroundTransparency = 0.06, BorderSizePixel = 0, Visible = false }, gui)
corner(waveFrame, 8)
stroke(waveFrame, LINE, 1.5, 0)
local waveTitle = mkLabel(waveFrame, "", UDim2.fromOffset(0, 2), UDim2.new(1, 0, 0, 24), 20, GOLD, Enum.TextXAlignment.Center)
local waveSub = mkLabel(waveFrame, "", UDim2.fromOffset(0, 24), UDim2.new(1, 0, 0, 20), 14, TXT2, Enum.TextXAlignment.Center)
local bossFrame = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 66), Size = UDim2.fromOffset(620, 40), BackgroundTransparency = 1, Visible = false }, gui)
local bossName = mkLabel(bossFrame, "", UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 18), 18, C3(226, 128, 108), Enum.TextXAlignment.Center)
local bossBar = mkBar(bossFrame, UDim2.fromOffset(0, 20), UDim2.new(1, 0, 0, 20), C3(220, 50, 50))

local toastLabel = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.22, 0), Size = UDim2.fromOffset(900, 60), BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack, TextSize = 38, TextColor3 = TXT, TextStrokeColor3 = INK, TextStrokeTransparency = 0.1, Text = "", TextTransparency = 1, ZIndex = 20,
}, gui)
local toastScale = new("UIScale", {}, toastLabel)
local toastToken = 0
local function showToast(text, color, dur)
	toastToken = toastToken + 1
	local my = toastToken
	toastLabel.Text = text
	toastLabel.TextColor3 = hex(color or "ffffff")
	toastLabel.TextTransparency = 0
	toastLabel.TextStrokeTransparency = 0.1
	toastScale.Scale = 0.8
	TweenService:Create(toastScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(dur or 3, function()
		if my == toastToken then
			TweenService:Create(toastLabel, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

local hint = mkLabel(gui, "WASD - move   |   Mouse - aim   |   Hold LMB - attack   |   SPACE / SHIFT - dash   |   Wheel - zoom",
	UDim2.new(0, 14, 1, -30), UDim2.fromOffset(700, 22), 14, C3(196, 202, 218))
hint.TextStrokeColor3 = INK
hint.TextStrokeTransparency = 0.5
local downLabel = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.7, 0), Size = UDim2.fromOffset(700, 50), BackgroundTransparency = 1,
	Text = "YOU ARE DOWN - you will revive when the next wave starts", TextColor3 = C3(224, 100, 100), Font = Enum.Font.GothamBlack, TextSize = 26,
	TextStrokeColor3 = INK, TextStrokeTransparency = 0.15, Visible = false,
}, gui)
local hurt = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(255, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0 }, gui)

-- ------------------------------------------------------------ PANEL FRAME
local function makePanel(title, w, h)
	local f = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -24, 0.5, 0), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = PANEL, BackgroundTransparency = 0, BorderSizePixel = 0, Visible = false,
	}, gui)
	corner(f, 10)
	local st = stroke(f, LINE, 1.5, 0)
	local t = mkLabel(f, title, UDim2.fromOffset(16, 10), UDim2.new(1, -32, 0, 34), 26, GOLD, nil, Enum.Font.GothamBlack)
	local sub = mkLabel(f, "", UDim2.fromOffset(16, 44), UDim2.new(1, -32, 0, 36), 14, TXT2, nil, Enum.Font.Gotham)
	new("Frame", { Position = UDim2.fromOffset(12, 82), Size = UDim2.new(1, -24, 0, 1), BackgroundColor3 = LINE, BorderSizePixel = 0 }, f)
	local content = new("Frame", { Position = UDim2.fromOffset(12, 86), Size = UDim2.new(1, -24, 1, -96), BackgroundTransparency = 1 }, f)
	local lay = new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, content)
	return { frame = f, title = t, sub = sub, content = content, stroke = st }
end

local function clearContent(p)
	for _, c in ipairs(p.content:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
end

local order = 0
local function row(parent, h)
	order = order + 1
	return new("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, LayoutOrder = order }, parent)
end

-- ------------------------------------------------------------ GATE PANEL
local portal = makePanel("", 430, 540)
local curZone = nil
local gateViews = {}
local sel = { loc = Config.LocationOrder[1], diff = 1, max = 2, friends = false }
local countdownLabel, countdownAt
local LOC_COLORS = { forest = C3(70, 150, 90), cave = C3(124, 96, 190) }

local function gateNumber(zid)
	for _, zn in ipairs(Config.Lobby.zones) do
		if zn.id == zid then return zn.n end
	end
	return 0
end

local function toggleRow(parent, labels, current, onPick, disabledFrom)
	local n = #labels
	for i, text in ipairs(labels) do
		local dis = disabledFrom and i >= disabledFrom
		local on = (current == i)
		local b = mkButton(parent, text, UDim2.new((i - 1) / n, 2, 0, 0), UDim2.new(1 / n, -4, 1, 0),
			on and C3(70, 120, 200) or C3(42, 47, 62), function() onPick(i) end)
		b.TextSize = 14
	end
end

local function renderPortal()
	local zn = gateNumber(curZone)
	if zn == 0 then return end
	clearContent(portal)
	portal.title.Text = "GATE " .. zn
	order = 0
	countdownLabel = nil
	local view = gateViews[curZone]

	-- ---------- a party already stands in this gate
	if view then
		local loc = Config.Locations[view.loc]
		local d = Config.Difficulties[view.diff]
		portal.sub.Text = view.mine and "You are in this party." or "This gate is already taken."
		local r = row(portal.content, 30)
		mkLabel(r, string.upper(loc.name), UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 20, LOC_COLORS[view.loc] and LOC_COLORS[view.loc]:Lerp(C3(255, 255, 255), 0.35) or C3(255, 255, 255))
		local r2 = row(portal.content, 24)
		mkLabel(r2, d.name .. "   -   " .. (view.friendsOnly and "FRIENDS ONLY" or "OPEN TO EVERYONE"), UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 16, view.friendsOnly and C3(120, 200, 255) or hex(d.color))
		local names = row(portal.content, 24 * #view.names + 8)
		for i, n in ipairs(view.names) do
			mkLabel(names, (n == view.host and "[HOST] " or "") .. n, UDim2.fromOffset(8, (i - 1) * 24), UDim2.new(1, -8, 0, 24), 17)
		end
		local st = row(portal.content, 26)
		countdownLabel = mkLabel(st, "Players " .. view.n .. " / " .. view.max .. "  -  waiting...", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 16, C3(200, 220, 255))
		countdownAt = view.startAt
		local br = row(portal.content, 44)
		if view.mine then
			if view.hostId == lp.UserId then
				mkButton(br, "START NOW", UDim2.fromScale(0, 0), UDim2.new(0.5, -4, 1, 0), C3(64, 140, 92), function() ToServer:FireServer("StartParty") end)
				mkButton(br, "LEAVE", UDim2.new(0.5, 4, 0, 0), UDim2.new(0.5, -4, 1, 0), C3(160, 66, 66), function() ToServer:FireServer("LeaveParty") end)
			else
				mkButton(br, "LEAVE PARTY", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), C3(160, 66, 66), function() ToServer:FireServer("LeaveParty") end)
			end
		else
			if view.canJoin then
				mkButton(br, "JOIN PARTY", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), C3(70, 120, 200), function() ToServer:FireServer("JoinParty", view.id) end)
			else
				local b = mkButton(br, view.why or "UNAVAILABLE", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), C3(44, 48, 58), nil)
				setDisabled(b, true)
			end
			local hr = row(portal.content, 40)
			mkLabel(hr, "Wait for the run to start or use another gate.", UDim2.fromOffset(2, 0), UDim2.fromScale(1, 1), 14, C3(170, 175, 190), nil, Enum.Font.Gotham)
		end
		return
	end

	-- ---------- free gate: create a party
	portal.sub.Text = "Pick a location, difficulty, party size and who may join."
	local loc = Config.Locations[sel.loc]
	local unlocked = data.unlocked[sel.loc] or 1
	if sel.diff > unlocked then sel.diff = unlocked end

	local r1 = row(portal.content, 22)
	mkLabel(r1, "LOCATION", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 15, GOLD)
	local rl = row(portal.content, 56)
	local nloc = #Config.LocationOrder
	for i, id in ipairs(Config.LocationOrder) do
		local l = Config.Locations[id]
		local on = sel.loc == id
		local b = mkButton(rl, l.name .. "\nLv." .. l.minLvl .. "-" .. l.maxLvl, UDim2.new((i - 1) / nloc, 2, 0, 0), UDim2.new(1 / nloc, -4, 1, 0),
			on and (LOC_COLORS[id] or C3(70, 120, 200)) or C3(42, 47, 62), function()
				sel.loc = id
				renderPortal()
			end)
		b.TextSize = 15
		if on then markSelected(b) end
	end
	local rd = row(portal.content, 34)
	mkLabel(rd, loc.desc, UDim2.fromOffset(2, 0), UDim2.fromScale(1, 1), 13, C3(190, 195, 210), nil, Enum.Font.Gotham)

	local r2 = row(portal.content, 22)
	mkLabel(r2, "DIFFICULTY", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 15, GOLD)
	local r3 = row(portal.content, 40)
	for i, d in ipairs(Config.Difficulties) do
		local locked = i > unlocked
		local b = mkButton(r3, locked and "LOCKED" or d.name, UDim2.new((i - 1) / 5, 2, 0, 0), UDim2.new(0.2, -4, 1, 0),
			locked and C3(44, 48, 58) or (sel.diff == i and hex(d.color) or C3(42, 47, 62)), function()
				if not locked then sel.diff = i renderPortal() end
			end)
		b.TextSize = locked and 11 or 13
		if locked then setDisabled(b, true) elseif sel.diff == i then markSelected(b) end
	end

	local r4 = row(portal.content, 22)
	mkLabel(r4, "PLAYERS IN PARTY  (including you, 1 = solo)", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 15, GOLD)
	local r5 = row(portal.content, 38)
	for i = 1, Config.GateMaxPlayers do
		mkButton(r5, tostring(i), UDim2.new((i - 1) / Config.GateMaxPlayers, 2, 0, 0), UDim2.new(1 / Config.GateMaxPlayers, -4, 1, 0),
			sel.max == i and C3(70, 120, 200) or C3(42, 47, 62), function()
				sel.max = i
				if i == 1 then sel.friends = false end
				renderPortal()
			end)
	end

	local r6 = row(portal.content, 22)
	mkLabel(r6, "WHO CAN JOIN", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 15, GOLD)
	local r7 = row(portal.content, 38)
	local solo = sel.max == 1
	local b1 = mkButton(r7, "EVERYONE", UDim2.fromScale(0, 0), UDim2.new(0.5, -4, 1, 0),
		(not sel.friends) and C3(70, 150, 100) or C3(42, 47, 62), function()
			sel.friends = false
			renderPortal()
		end)
	local b2 = mkButton(r7, "FRIENDS ONLY", UDim2.new(0.5, 4, 0, 0), UDim2.new(0.5, -4, 1, 0),
		(sel.friends and not solo) and C3(70, 120, 200) or C3(42, 47, 62), function()
			if solo then return end
			sel.friends = true
			renderPortal()
		end)
	b1.TextSize, b2.TextSize = 14, 14
	if solo then
		b1.BackgroundColor3 = C3(36, 40, 52)
		b2.BackgroundColor3 = C3(36, 40, 52)
		setDisabled(b1, true)
		setDisabled(b2, true)
		b1.Text = "SOLO RUN"
	end

	local dd = Config.Difficulties[sel.diff]
	local r8 = row(portal.content, 46)
	local tag = solo and "SOLO" or (sel.max .. "P" .. (sel.friends and ", FRIENDS" or ""))
	mkButton(r8, "CREATE PARTY  (" .. loc.short .. ", " .. dd.name .. ", " .. tag .. ")", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), C3(64, 140, 92), function()
		ToServer:FireServer("CreateParty", curZone, sel.loc, sel.diff, sel.max, sel.friends and sel.max > 1)
	end).TextSize = 15
end

-- ------------------------------------------------------------ UPGRADE PANEL
local upPanel = makePanel("UPGRADES", 470, 600)
upPanel.sub.Text = "Spend skill points on your weapons (1 point per level) and coins on hero upgrades."
local upTab = "Swordsman"

local function statText(cls, id, upg)
	local ws = Config.weaponStats(cls, upg)
	if id == "Damage" then return string.format("%.0f", ws.damage) .. " dmg"
	elseif id == "Speed" then return string.format("%.2f", 1 / ws.cooldown) .. " hits/s"
	elseif id == "Range" then return string.format("%.0f", ws.range) .. " studs"
	else return string.format("%.0f", ws.crit * 100) .. "% crit" end
end

local function renderUpgrade()
	clearContent(upPanel)
	order = 0
	local r0 = row(upPanel.content, 26)
	mkLabel(r0, "Skill points: " .. data.points .. "      Coins: " .. data.coins, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 18, C3(130, 200, 156))
	local tabs = row(upPanel.content, 40)
	for i, cls in ipairs(Config.ClassOrder) do
		local b = mkButton(tabs, string.upper(cls), UDim2.new((i - 1) / 3, 2, 0, 0), UDim2.new(1 / 3, -4, 1, 0), upTab == cls and Config.Classes[cls].color or C3(42, 47, 62), function()
			upTab = cls
			renderUpgrade()
		end)
		b.TextSize = 14
	end
	local upg = data.upg[upTab] or {}
	for _, s in ipairs(Config.Stats) do
		local lv = upg[s.id] or 0
		local r = row(upPanel.content, 62)
		local bg = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = CARD, BorderSizePixel = 0 }, r)
		corner(bg, 7)
		stroke(bg, LINE, 1, 0.35)
		mkLabel(bg, s.name .. "   Lv." .. lv .. "/" .. s.max, UDim2.fromOffset(10, 4), UDim2.new(1, -90, 0, 22), 17)
		local nextUpg = {}
		for k, v in pairs(upg) do nextUpg[k] = v end
		nextUpg[s.id] = lv + 1
		local now = statText(upTab, s.id, upg)
		local nxt = lv >= s.max and "MAX" or statText(upTab, s.id, nextUpg)
		mkLabel(bg, now .. "  ->  " .. nxt, UDim2.fromOffset(10, 26), UDim2.new(1, -90, 0, 16), 14, C3(130, 190, 226), nil, Enum.Font.Gotham)
		mkLabel(bg, s.fmt, UDim2.fromOffset(10, 42), UDim2.new(1, -90, 0, 16), 11, TXT2, nil, Enum.Font.Gotham)
		local can = data.points >= 1 and lv < s.max
		setDisabled(mkButton(bg, lv >= s.max and "MAX" or "+1", UDim2.new(1, -74, 0, 12), UDim2.fromOffset(64, 38), can and C3(64, 140, 92) or C3(44, 48, 58), function()
			if can then ToServer:FireServer("Upgrade", upTab, s.id) end
		end), not can)
	end
	local rh = row(upPanel.content, 22)
	mkLabel(rh, "HERO UPGRADES (coins)", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 15, GOLD)
	local function coinRow(name, lvl, max, cost, desc, action)
		local r = row(upPanel.content, 52)
		local bg = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = CARD, BorderSizePixel = 0 }, r)
		corner(bg, 7)
		stroke(bg, LINE, 1, 0.35)
		mkLabel(bg, name .. "   Lv." .. lvl .. "/" .. max, UDim2.fromOffset(10, 4), UDim2.new(1, -120, 0, 22), 17)
		mkLabel(bg, desc, UDim2.fromOffset(10, 28), UDim2.new(1, -120, 0, 18), 12, TXT2, nil, Enum.Font.Gotham)
		local can = lvl < max and data.coins >= cost
		setDisabled(mkButton(bg, lvl >= max and "MAX" or (cost .. " coins"), UDim2.new(1, -108, 0, 8), UDim2.fromOffset(98, 36), can and C3(190, 150, 60) or C3(44, 48, 58), function()
			if can then ToServer:FireServer(action) end
		end), not can)
	end
	coinRow("Vitality", data.vit, Config.VitMax, Config.vitCost(data.vit), "+12 max HP per level", "BuyVit")
	coinRow("Swiftness", data.swift, Config.SwiftMax, Config.swiftCost(data.swift), "+0.25 move speed per level", "BuySwift")
end

