end)

-- ============================================================ DATA CALLBACK
onData = function()
	lvlLabel.Text = "Lv." .. data.level
	xpBar.fill.Size = UDim2.fromScale(math.clamp(data.xp / math.max(1, data.need), 0, 1), 1)
	xpBar.txt.Text = "XP " .. data.xp .. " / " .. data.need
	coinLabel.Text = "Coins: " .. data.coins
	ptsLabel.Text = "Skill points: " .. data.points
	classLabel.Text = data.class and string.upper(data.class) or "NO WEAPON"
	classPrompt.Visible = (data.class == nil) and not lp:GetAttribute("InRun")
	if curZone == "upgrade" then renderUpgrade() end
	if Config.Locations[curZone or ""] then renderPortal() end
end
lp:GetAttributeChangedSignal("Data"):Connect(readData)
lp:GetAttributeChangedSignal("InRun"):Connect(function()
	classPrompt.Visible = (data.class == nil) and not lp:GetAttribute("InRun")
end)
readData()
onData()

-- ============================================================ CAMERA / INPUT
local function char()
	local c = lp.Character
	if not c then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if h and r then return c, h, r end
	return nil
end

local camPos = Vector3.new(0, 0, 32)
local zoomH = 78
UIS.InputChanged:Connect(function(input, gp)
	if input.UserInputType == Enum.UserInputType.MouseWheel and not gp then
		zoomH = math.clamp(zoomH - input.Position.Z * 6, 45, 125)
	end
end)

local function aimPoint()
	local m = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(m.X, m.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then return nil end
	local t = -ray.Origin.Y / ray.Direction.Y
	return ray.Origin + ray.Direction * t
end

RunService:BindToRenderStep("TopDownCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
	cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 45
	local _, _, r = char()
	if r then
		local target = Vector3.new(r.Position.X, 0, r.Position.Z)
		if (target - camPos).Magnitude > 120 then
			camPos = target
		else
			camPos = camPos:Lerp(target, 1 - math.exp(-14 * dt))
		end
	end
	cam.CFrame = CFrame.new(camPos.X, zoomH, camPos.Z) * CFrame.Angles(-math.pi / 2, 0, 0)
end)

local attacking = false
local dashReady = 0
local dashUntil = 0
local dashDir = Vector3.new(0, 0, -1)

local function moveVector()
	local x, z = 0, 0
	if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then z = z - 1 end
	if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then z = z + 1 end
	if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then x = x - 1 end
	if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then x = x + 1 end
	local v = Vector3.new(x, 0, z)
	if v.Magnitude > 0 then v = v.Unit end
	return v
end

local function tryDash()
	local _, h, r = char()
	if not h or h.Health <= 0 then return end
	local now = os.clock()
	if now < dashReady then return end
	dashReady = now + Config.DashCooldown
	local dir = moveVector()
	if dir.Magnitude < 0.1 then
		local lv = r.CFrame.LookVector
		dir = Vector3.new(lv.X, 0, lv.Z)
		if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, -1) end
		dir = dir.Unit
	end
	dashDir = dir
	dashUntil = now + 0.2
	ToServer:FireServer("Dash")
	h.WalkSpeed = 85
	r.AssemblyLinearVelocity = Vector3.new(dir.X * 85, r.AssemblyLinearVelocity.Y, dir.Z * 85)
	task.delay(0.2, function()
		if h.Parent then h.WalkSpeed = lp:GetAttribute("WalkSpeed") or 20 end
	end)
end

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		attacking = true
	elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftShift then
		tryDash()
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then attacking = false end
end)

local lastSend = 0
RunService.RenderStepped:Connect(function()
	local _, h, r = char()
	-- HUD bars
	if h then
		local frac = math.clamp(h.Health / math.max(1, h.MaxHealth), 0, 1)
		hpBar.fill.Size = UDim2.fromScale(frac, 1)
		hpBar.fill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.75, 0.9)
		hpBar.txt.Text = "HP  " .. math.ceil(h.Health) .. " / " .. math.ceil(h.MaxHealth)
	end
	local dleft = math.max(0, dashReady - os.clock())
	dashBar.fill.Size = UDim2.fromScale(1 - dleft / Config.DashCooldown, 1)
	dashBar.txt.Text = dleft > 0 and ("DASH  " .. string.format("%.1f", dleft) .. "s") or "DASH READY  [SPACE]"
	if countdownLabel and countdownAt then
		local left = math.max(0, math.ceil(countdownAt - workspace:GetServerTimeNow()))
		countdownLabel.Text = "Party full! Starting in " .. left .. "..."
	end
	if not h or not r or h.Health <= 0 then return end
	h.AutoRotate = false
	local aim = aimPoint()
	if aim then
		local p = r.Position
		local d = Vector3.new(aim.X - p.X, 0, aim.Z - p.Z)
		if d.Magnitude > 0.5 then
			r.CFrame = CFrame.lookAt(p, p + d)
		end
	end
	if os.clock() < dashUntil then
		h:Move(dashDir, false)
	else
		h:Move(moveVector(), false)
	end
	if attacking and lp:GetAttribute("InRun") and aim and os.clock() - lastSend > 0.06 then
		lastSend = os.clock()
		ToServer:FireServer("Attack", aim)
	end
end)

lp.CharacterAdded:Connect(function()
	downLabel.Visible = false
end)

-- ============================================================ FX
local fxFolder = Instance.new("Folder")
fxFolder.Name = "FX"
fxFolder.Parent = workspace
local NEON = Enum.Material.Neon

local function fxPart(shape, size, cf, color, mat, trans)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or NEON
	p.Transparency = trans or 0
	p.Parent = fxFolder
	return p
end
local function fxDisc(d, x, y, z, color, trans, mat, thick)
	return fxPart(Enum.PartType.Cylinder, Vector3.new(thick or 0.2, d, d), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans)
end
local function tw(o, t, props, style)
	TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local H = {}

H.Slash = function(x, z, dx, dz, range, arcDeg, crit)
	local col = crit and C3(255, 215, 80) or C3(190, 235, 255)
	local N = 10
	local half = math.rad(arcDeg) / 2
	for i = 0, N - 1 do
		local phi = -half + (i / (N - 1)) * half * 2
		local c, s = math.cos(phi), math.sin(phi)
		local rx, rz = dx * c - dz * s, dx * s + dz * c
		local pos = Vector3.new(x + rx * range * 0.85, 2.2, z + rz * range * 0.85)
		local tx, tz = -rz, rx
		local seg = fxPart(Enum.PartType.Block, Vector3.new(0.7, 0.12, (half * 2 / N) * range * 1.5), CFrame.lookAt(pos, pos + Vector3.new(tx, 0, tz)), col, NEON, 1)
		task.delay(i * 0.01, function()
			seg.Transparency = 0.05
			tw(seg, 0.28, { Transparency = 1 })
			Debris:AddItem(seg, 0.4)
		end)
	end
end

local projs = {}
local function addProjPart(pr, shape, size, off, color, mat, trans)
	local p = fxPart(shape, size, CFrame.new(), color, mat, trans)
	table.insert(pr.parts, { p, off })
	return p
end

H.Proj = function(id, kind, x, z, dx, dz, speed, range)
	local pr = { kind = kind, x = x, z = z, dx = dx, dz = dz, speed = speed, left = range, parts = {}, acc = 0 }
	local B, CY = Enum.PartType.Block, Enum.PartType.Cylinder
	local flat = CFrame.Angles(0, 0, math.pi / 2)
	if kind == "arrow" then
		addProjPart(pr, B, Vector3.new(0.22, 0.16, 2.6), CFrame.new(), C3(235, 225, 190), Enum.Material.Wood)
		addProjPart(pr, B, Vector3.new(0.55, 0.16, 0.55), CFrame.new(0, 0, -1.4) * CFrame.Angles(0, math.pi / 4, 0), C3(210, 220, 235), Enum.Material.Metal)
		addProjPart(pr, B, Vector3.new(0.75, 0.12, 0.5), CFrame.new(0, 0, 1.1), C3(215, 60, 60), Enum.Material.Fabric)
	elseif kind == "fireball" then
		local o = addProjPart(pr, CY, Vector3.new(0.5, 3.0, 3.0), flat, C3(255, 120, 30), NEON, 0.25)
		addProjPart(pr, CY, Vector3.new(0.6, 1.7, 1.7), CFrame.new(0, 0.1, 0) * flat, C3(255, 230, 120), NEON, 0)
		local l = Instance.new("PointLight")
		l.Color = C3(255, 140, 50)
		l.Range = 22
		l.Brightness = 2
		l.Parent = o
	elseif kind == "spit" then
		addProjPart(pr, CY, Vector3.new(0.5, 1.7, 1.7), flat, C3(120, 255, 60), NEON, 0.1)
		addProjPart(pr, CY, Vector3.new(0.6, 0.8, 0.8), CFrame.new(0, 0.1, 0) * flat, C3(220, 255, 170), NEON, 0)
	else
		addProjPart(pr, B, Vector3.new(0.3, 0.15, 1.7), CFrame.new(), C3(185, 190, 200), Enum.Material.Metal)
		addProjPart(pr, B, Vector3.new(0.9, 0.15, 0.25), CFrame.new(0, 0, 0.5), C3(110, 70, 40), Enum.Material.Wood)
	end
	projs[id] = pr
end

local function killProj(id)
	local pr = projs[id]
	if not pr then return nil end
	projs[id] = nil
	for _, e in ipairs(pr.parts) do e[1]:Destroy() end
	return pr
end

H.ProjEnd = function(id, x, z, kind, radius)
	killProj(id)
	if kind == "fireball" then
		local a = fxDisc(radius * 0.6, x, 2, z, C3(255, 130, 30), 0.15, NEON, 0.3)
		tw(a, 0.35, { Size = Vector3.new(0.3, radius * 2.1, radius * 2.1), Transparency = 1 })
		local b = fxDisc(radius * 0.3, x, 2.2, z, C3(255, 235, 140), 0, NEON, 0.3)
		tw(b, 0.25, { Size = Vector3.new(0.3, radius * 1.2, radius * 1.2), Transparency = 1 })
		local c = fxDisc(radius * 1.0, x, 0.3, z, C3(40, 20, 10), 0.4, Enum.Material.SmoothPlastic, 0.1)
		tw(c, 0.8, { Transparency = 1 })
		Debris:AddItem(a, 0.5)
		Debris:AddItem(b, 0.5)
		Debris:AddItem(c, 0.9)
	else
		local col = kind == "spit" and C3(130, 255, 70) or (kind == "arrow" and C3(255, 240, 190) or C3(200, 200, 210))
		local a = fxDisc(1.0, x, 2, z, col, 0.1, NEON, 0.2)
		tw(a, 0.25, { Size = Vector3.new(0.2, 3.2, 3.2), Transparency = 1 })
		Debris:AddItem(a, 0.4)
	end
end

H.Dmg = function(x, z, amount, crit, onPlayer)
	local a = fxPart(Enum.PartType.Block, Vector3.new(0.5, 0.5, 0.5), CFrame.new(x + (math.random() - 0.5) * 3, 5, z), C3(255, 255, 255), Enum.Material.SmoothPlastic, 1)
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(120, 44)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.Adornee = a
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextSize = crit and 32 or 22
	t.Text = tostring(amount) .. (crit and "!" or "")
	t.TextColor3 = onPlayer and C3(255, 80, 80) or (crit and C3(255, 220, 70) or C3(255, 255, 255))
	t.TextStrokeTransparency = 0
	t.Parent = g
	g.Parent = a
	tw(a, 0.8, { Position = a.Position + Vector3.new(0, 0, -5) })
	task.delay(0.45, function()
		tw(t, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Linear)
	end)
	Debris:AddItem(a, 0.9)
end

H.Tele = function(x, z, r, dur)
	local base = fxDisc(r * 2, x, 0.3, z, C3(255, 40, 40), 0.78, NEON, 0.05)
	local ringp = fxDisc(r * 2 + 0.8, x, 0.25, z, C3(255, 90, 60), 0.4, NEON, 0.05)
	local fill = fxDisc(0.5, x, 0.35, z, C3(255, 60, 40), 0.5, NEON, 0.05)
	tw(fill, dur, { Size = Vector3.new(0.05, r * 2, r * 2) }, Enum.EasingStyle.Linear)
	task.delay(dur, function()
		base:Destroy()
		ringp:Destroy()
		fill:Destroy()
	end)
end

local rocks = {}
H.Rock = function(sx, sz, tx, tz, dur)
	local a = fxPart(Enum.PartType.Cylinder, Vector3.new(2, 4.4, 4.4), CFrame.new(sx, 3, sz) * CFrame.Angles(0, 0, math.pi / 2), C3(120, 120, 126), Enum.Material.Slate)
	local b = fxPart(Enum.PartType.Cylinder, Vector3.new(2.4, 2.8, 2.8), CFrame.new(sx, 3, sz) * CFrame.Angles(0, 0, math.pi / 2), C3(150, 150, 156), Enum.Material.Slate)
	table.insert(rocks, { a = a, b = b, t = 0, dur = dur, sx = sx, sz = sz, tx = tx, tz = tz })
end

H.Boom = function(x, z, r)
	local a = fxDisc(r * 1.2, x, 0.5, z, C3(190, 170, 140), 0.35, Enum.Material.SmoothPlastic, 0.2)
	tw(a, 0.6, { Size = Vector3.new(0.2, r * 2.6, r * 2.6), Transparency = 1 })
	local b = fxDisc(r * 0.8, x, 0.6, z, C3(255, 200, 120), 0.2, NEON, 0.2)
	tw(b, 0.35, { Size = Vector3.new(0.2, r * 1.8, r * 1.8), Transparency = 1 })
	for i = 1, 8 do
		local ang = i * math.pi / 4
		local d = fxDisc(0.9, x, 1.5, z, C3(110, 110, 116), 0, Enum.Material.Slate, 0.5)
		tw(d, 0.5, { Position = Vector3.new(x + math.cos(ang) * r * 0.9, 1.5, z + math.sin(ang) * r * 0.9), Transparency = 1 })
		Debris:AddItem(d, 0.6)
	end
	Debris:AddItem(a, 0.7)
	Debris:AddItem(b, 0.5)
end

H.Death = function(x, z, r, kind)
	local col = C3(120, 190, 80)
	if kind == "titan" then col = C3(140, 140, 146) elseif kind == "king" then col = C3(255, 205, 70) elseif kind == "goblin" then col = C3(150, 210, 70) end
	for i = 1, 8 do
		local ang = i * math.pi / 4 + math.random() * 0.4
		local d = fxDisc(r * 0.5, x, 1.5, z, col, 0.1, Enum.Material.SmoothPlastic, 0.3)
		tw(d, 0.5, { Position = Vector3.new(x + math.cos(ang) * r * 1.8, 1.5, z + math.sin(ang) * r * 1.8), Transparency = 1, Size = Vector3.new(0.1, 0.2, 0.2) })
		Debris:AddItem(d, 0.6)
	end
	local puff = fxDisc(r * 1.6, x, 1.0, z, C3(255, 255, 255), 0.3, NEON, 0.2)
	tw(puff, 0.4, { Size = Vector3.new(0.1, r * 3, r * 3), Transparency = 1 })
	Debris:AddItem(puff, 0.5)
end

H.DashFx = function(x, z)
	for i = 1, 3 do
		local d = fxDisc(2.2 - i * 0.4, x, 0.6 + i * 0.05, z, C3(200, 235, 255), 0.4, NEON, 0.1)
		tw(d, 0.4, { Size = Vector3.new(0.1, 6, 6), Transparency = 1 })
		Debris:AddItem(d, 0.5)
	end
end

H.Hurt = function()
	hurt.BackgroundTransparency = 0.7
	tw(hurt, 0.35, { BackgroundTransparency = 1 })
end

-- projectile + rock simulation
RunService.Heartbeat:Connect(function(dt)
	for id, pr in pairs(projs) do
		local step = pr.speed * dt
		pr.x = pr.x + pr.dx * step
		pr.z = pr.z + pr.dz * step
		pr.left = pr.left - step
		local pos = Vector3.new(pr.x, 2.2, pr.z)
		local base = CFrame.lookAt(pos, pos + Vector3.new(pr.dx, 0, pr.dz))
		for _, e in ipairs(pr.parts) do e[1].CFrame = base * e[2] end
		pr.acc = pr.acc + dt
		if (pr.kind == "fireball" or pr.kind == "spit") and pr.acc > 0.035 then
			pr.acc = 0
			local col = pr.kind == "fireball" and C3(255, 150, 40) or C3(120, 255, 70)
			local t = fxDisc(pr.kind == "fireball" and 1.8 or 1.0, pr.x, 2.0, pr.z, col, 0.3, NEON, 0.2)
			tw(t, 0.3, { Size = Vector3.new(0.1, 0.2, 0.2), Transparency = 1 })
			Debris:AddItem(t, 0.4)
		end
		if pr.left < -4 then killProj(id) end
	end
	for i = #rocks, 1, -1 do
		local rk = rocks[i]
		rk.t = rk.t + dt
		local a = math.min(1, rk.t / rk.dur)
		local x = rk.sx + (rk.tx - rk.sx) * a
		local z = rk.sz + (rk.tz - rk.sz) * a
		local y = 1.5 + math.sin(math.pi * a) * 16
		local cf = CFrame.new(x, y, z) * CFrame.Angles(a * 8, 0, math.pi / 2)
		rk.a.CFrame = cf
		rk.b.CFrame = cf * CFrame.new(0.2, 0, 0)
		if a >= 1 then
			rk.a:Destroy()
			rk.b:Destroy()
			table.remove(rocks, i)
		end
	end
end)

-- ============================================================ ENVIRONMENT
local cc = Instance.new("ColorCorrectionEffect")
cc.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Parent = Lighting
local ENV = {
	lobby = { amb = C3(150, 150, 160), out = C3(160, 160, 170), br = 2.2, clock = 14, tint = C3(255, 250, 240), sat = 0.12, con = 0.05, bloom = 0.3 },
	forest = { amb = C3(100, 120, 98), out = C3(125, 145, 112), br = 1.9, clock = 16.5, tint = C3(255, 244, 214), sat = 0.18, con = 0.1, bloom = 0.35 },
	cave = { amb = C3(88, 82, 120), out = C3(80, 74, 112), br = 1.2, clock = 0, tint = C3(205, 205, 255), sat = 0.05, con = 0.12, bloom = 0.7 },
}
local function applyEnv(name)
	local e = ENV[name] or ENV.lobby
	Lighting.GlobalShadows = false
	TweenService:Create(Lighting, TweenInfo.new(1), { Ambient = e.amb, OutdoorAmbient = e.out, Brightness = e.br, ClockTime = e.clock }):Play()
	cc.TintColor = e.tint
	cc.Saturation = e.sat
	cc.Contrast = e.con
	bloom.Intensity = e.bloom
	bloom.Size = 28
	bloom.Threshold = 0.9
end
applyEnv("lobby")

-- ============================================================ SERVER MESSAGES
H.Toast = function(text, color, dur) showToast(text, color, dur) end
H.Env = function(name) applyEnv(name) end
H.Down = function() downLabel.Visible = true end

H.Zone = function(zid)
	curZone = zid
	portal.frame.Visible = false
	upPanel.frame.Visible = false
	if zid == "upgrade" then
		upPanel.frame.Visible = true
		renderUpgrade()
	elseif zid and Config.Locations[zid] then
		portal.frame.Visible = true
		renderPortal()
	end
end

H.Parties = function(loc, list, mineId)
	partyLists[loc] = list
	myPartyId = mineId
	if curZone == loc then renderPortal() end
end

H.Run = function(d)
	waveFrame.Visible = true
	waveTitle.Text = (d.wave and d.wave > 0) and ("WAVE " .. d.wave .. " / " .. d.waves) or "GET READY"
	waveSub.Text = d.loc .. "  [" .. d.diff .. "]   -   Enemies left: " .. d.left
	if d.boss then
		bossFrame.Visible = true
		bossName.Text = string.upper(d.boss.name)
		bossBar.fill.Size = UDim2.fromScale(math.clamp(d.boss.hp / d.boss.max, 0, 1), 1)
		bossBar.txt.Text = math.ceil(d.boss.hp) .. " / " .. math.ceil(d.boss.max)
	else
		bossFrame.Visible = false
	end
end

H.RunEnd = function()
	waveFrame.Visible = false
	bossFrame.Visible = false
	result.Visible = false
	downLabel.Visible = false
end

H.Result = function(r)
	waveFrame.Visible = false
	bossFrame.Visible = false
	result.Visible = true
	resTitle.Text = r.won and "VICTORY!" or "DEFEAT"
	resTitle.TextColor3 = r.won and C3(255, 214, 74) or C3(255, 90, 90)
	resStroke.Color = resTitle.TextColor3
	local txt = r.loc .. "  [" .. r.diff .. "]\n\nKills: " .. r.kills .. "\nXP earned: +" .. r.xp .. "\nCoins earned: +" .. r.coins .. "\nYour level: " .. r.level
	if r.unlocked then txt = txt .. "\n\nNEW DIFFICULTY UNLOCKED: " .. string.upper(r.unlocked) .. "!" end
	if not r.won then txt = txt .. "\n\nAll heroes fell. Try again!" end
	resBody.Text = txt
end

ToClient.OnClientEvent:Connect(function(name, ...)
	local f = H[name]
	if f then
		local ok, err = pcall(f, ...)
		if not ok then warn("[client] " .. name .. ": " .. tostring(err)) end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
