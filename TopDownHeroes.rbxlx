-- ============================================================ DATA CALLBACK
onData = function()
	lvlLabel.Text = "Lv." .. data.level
	xpBar.fill.Size = UDim2.fromScale(math.clamp(data.xp / math.max(1, data.need), 0, 1), 1)
	xpBar.txt.Text = "XP " .. data.xp .. " / " .. data.need
	coinLabel.Text = "Coins: " .. data.coins
	ptsLabel.Text = "Skill points: " .. data.points
	local wd = data.weapon and Config.Weapons[data.weapon]
	if wd then
		classLabel.Text = wd.name
		classLabel.TextColor3 = wd.rainbow and C3(255, 255, 255) or Config.Rarities[wd.tier].color
	else
		classLabel.Text = data.class and string.upper(data.class) or "NO WEAPON"
	end
	classLabel.TextScaled = true
	refreshWeaponCards()
	if curZone == "upgrade" then renderUpgrade() end
	if curZone and gateNumber(curZone) > 0 and portal.frame.Visible then renderPortal() end
end
lp:GetAttributeChangedSignal("Data"):Connect(readData)
lp:GetAttributeChangedSignal("InRun"):Connect(function()
	refreshChangeBtn()
	if lp:GetAttribute("InRun") then closeWeaponPanel() end
end)
refreshChangeBtn()
-- the weapon panel pops up as soon as you enter the game
openWeaponPanel()
readData()
onData()

-- ============================================================ CAMERA / INPUT
local function char()
	local c = lp.Character
	if not c then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if h and r then return c, h, r end
	return nil
end

local camPos = Vector3.new(0, 0, 32)
local zoomH = 78
UIS.InputChanged:Connect(function(input, gp)
	if input.UserInputType == Enum.UserInputType.MouseWheel and not gp then
		zoomH = math.clamp(zoomH - input.Position.Z * 6, 45, 125)
	end
end)

local function aimPoint()
	local m = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(m.X, m.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then return nil end
	local t = -ray.Origin.Y / ray.Direction.Y
	return ray.Origin + ray.Direction * t
end

RunService:BindToRenderStep("TopDownCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
	cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 45
	local _, _, r = char()
	if r then
		local target = Vector3.new(r.Position.X, 0, r.Position.Z)
		if (target - camPos).Magnitude > 120 then
			camPos = target
		else
			camPos = camPos:Lerp(target, 1 - math.exp(-14 * dt))
		end
	end
	cam.CFrame = CFrame.new(camPos.X, zoomH, camPos.Z) * CFrame.Angles(-math.pi / 2, 0, 0)
end)

local attacking = false
local dashReady = 0
local dashUntil = 0
local dashDir = Vector3.new(0, 0, -1)

local function moveVector()
	local x, z = 0, 0
	if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then z = z - 1 end
	if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then z = z + 1 end
	if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then x = x - 1 end
	if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then x = x + 1 end
	local v = Vector3.new(x, 0, z)
	if v.Magnitude > 0 then v = v.Unit end
	return v
end

local function tryDash()
	local _, h, r = char()
	if not h or h.Health <= 0 then return end
	local now = os.clock()
	if now < dashReady then return end
	dashReady = now + Config.DashCooldown
	local dir = moveVector()
	if dir.Magnitude < 0.1 then
		local lv = r.CFrame.LookVector
		dir = Vector3.new(lv.X, 0, lv.Z)
		if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, -1) end
		dir = dir.Unit
	end
	dashDir = dir
	dashUntil = now + 0.2
	ToServer:FireServer("Dash")
	h.WalkSpeed = 85
	r.AssemblyLinearVelocity = Vector3.new(dir.X * 85, r.AssemblyLinearVelocity.Y, dir.Z * 85)
	task.delay(0.2, function()
		if h.Parent then h.WalkSpeed = lp:GetAttribute("WalkSpeed") or 20 end
	end)
end

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		attacking = true
	elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftShift then
		tryDash()
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then attacking = false end
end)

local lastSend = 0
RunService.RenderStepped:Connect(function()
	local _, h, r = char()
	-- HUD bars
	if h then
		local frac = math.clamp(h.Health / math.max(1, h.MaxHealth), 0, 1)
		hpBar.fill.Size = UDim2.fromScale(frac, 1)
		hpBar.fill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.55, 0.66)
		hpBar.txt.Text = "HP  " .. math.ceil(h.Health) .. " / " .. math.ceil(h.MaxHealth)
	end
	local dleft = math.max(0, dashReady - os.clock())
	dashBar.fill.Size = UDim2.fromScale(1 - dleft / Config.DashCooldown, 1)
	dashBar.txt.Text = dleft > 0 and ("DASH  " .. string.format("%.1f", dleft) .. "s") or "DASH READY  [SPACE]"
	if countdownLabel and countdownAt then
		local left = math.max(0, math.ceil(countdownAt - workspace:GetServerTimeNow()))
		countdownLabel.Text = "Party full! Starting in " .. left .. "..."
	end
	if not h or not r or h.Health <= 0 then return end
	h.AutoRotate = false
	local aim = aimPoint()
	if aim then
		local p = r.Position
		local d = Vector3.new(aim.X - p.X, 0, aim.Z - p.Z)
		if d.Magnitude > 0.5 then
			r.CFrame = CFrame.lookAt(p, p + d)
		end
	end
	if os.clock() < dashUntil then
		h:Move(dashDir, false)
	else
		h:Move(moveVector(), false)
	end
	if attacking and lp:GetAttribute("InRun") and aim and os.clock() - lastSend > 0.06 then
		lastSend = os.clock()
		ToServer:FireServer("Attack", aim)
	end
end)

-- your own name + HP plate is only for OTHER players to see
local function hideOwnPlate(c)
	local function chk(o)
		if o.Name == "Plate" and o:IsA("BillboardGui") then o.Enabled = false end
	end
	for _, o in ipairs(c:GetDescendants()) do chk(o) end
	c.DescendantAdded:Connect(chk)
end
if lp.Character then hideOwnPlate(lp.Character) end
lp.CharacterAdded:Connect(function(c)
	downLabel.Visible = false
	hideOwnPlate(c)
end)

-- ============================================================ FX
local fxFolder = Instance.new("Folder")
fxFolder.Name = "FX"
fxFolder.Parent = workspace
local NEON = Enum.Material.Neon

local function fxPart(shape, size, cf, color, mat, trans)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or NEON
	p.Transparency = trans or 0
	p.Parent = fxFolder
	return p
end
local function fxDisc(d, x, y, z, color, trans, mat, thick)
	return fxPart(Enum.PartType.Cylinder, Vector3.new(thick or 0.2, d, d), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans)
end
local function tw(o, t, props, style, dir)
	TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end

-- crisp expanding ring (an outlined circle drawn on the top face of a thin part)
local function ringFx(x, y, z, d0, d1, color, dur, thick, startTrans, endTrans)
	local p = fxPart(Enum.PartType.Block, Vector3.new(d0, 0.05, d0), CFrame.new(x, y, z), color, Enum.Material.SmoothPlastic, 1)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(256, 256)
	sg.LightInfluence = 0
	sg.Brightness = 1.4
	sg.Parent = p
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Parent = sg
	local uc = Instance.new("UICorner")
	uc.CornerRadius = UDim.new(0.5, 0)
	uc.Parent = f
	local us = Instance.new("UIStroke")
	us.Color = color
	us.Thickness = thick or 8
	us.Transparency = startTrans or 0.1
	us.Parent = f
	tw(p, dur, { Size = Vector3.new(d1, 0.05, d1) })
	tw(us, dur, { Transparency = endTrans or 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(p, dur + 0.1)
	return p
end

-- one-shot particle burst
local function burst(x, y, z, color, count, smin, smax, size, life, color2, dirX, dirZ, spread)
	local cf = CFrame.new(x, y, z)
	if dirX then
		local pos = Vector3.new(x, y, z)
		cf = CFrame.lookAt(pos, pos + Vector3.new(dirX, 0, dirZ)) * CFrame.Angles(-math.pi / 2, 0, 0)
	end
	local p = fxPart(Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), cf, color, Enum.Material.SmoothPlastic, 1)
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Rate = 0
	e.Color = ColorSequence.new(color, color2 or color)
	e.LightEmission = 0.9
	e.LightInfluence = 0
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(smin, smax)
	e.SpreadAngle = spread and Vector2.new(spread, spread) or Vector2.new(180, 180)
	e.Drag = 3
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.6, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Parent = p
	e:Emit(count)
	Debris:AddItem(p, life + 0.3)
end

local function addTrail(part, c0, c1, width, life, off)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-width / 2, 0, off or 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(width / 2, 0, off or 0)
	a1.Parent = part
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = life
	t.Color = ColorSequence.new(c0, c1)
	t.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.6, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	t.LightEmission = 0.8
	t.LightInfluence = 0
	t.MinLength = 0.04
	t.FaceCamera = false
	t.Parent = part
	return t
end

local function addEmbers(part, c0, c1, rate, size, life, speed)
	local e = Instance.new("ParticleEmitter")
	e.Rate = rate
	e.Color = ColorSequence.new(c0, c1)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(speed * 0.3, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = part
	return e
end

local H = {}

-- sword arc: layered crescent that sweeps in the direction of the swing, with sparks
H.Slash = function(x, z, dx, dz, range, arcDeg, crit, swingDir)
	WeaponFX.markAttack()
	-- new clean sword VFX (falls back to the old arc below if anything goes wrong)
	if pcall(WeaponFX.slash, Theme.current(), x, z, dx, dz, range, arcDeg, crit, swingDir) then return end
	local col = crit and C3(255, 196, 84) or C3t(150, 190, 235)
	local core = crit and C3(255, 238, 190) or C3t(236, 246, 255)
	local N = 14
	local half = math.rad(arcDeg) / 2
	local dir = swingDir or 1
	local segLen = (half * 2 / N) * range * 1.55
	for i = 0, N - 1 do
		local a = i / (N - 1)
		local phi = -half + a * half * 2
		local c, s = math.cos(phi), math.sin(phi)
		local rx, rz = dx * c - dz * s, dx * s + dz * c
		local taper = math.sin(a * math.pi) ^ 0.6
		local order = dir == 1 and (N - 1 - i) or i
		local r0 = range * 0.8
		local r1 = range * 0.98
		local tx, tz = -rz, rx
		local function place(r)
			local pos = Vector3.new(x + rx * r, 2.2, z + rz * r)
			return CFrame.lookAt(pos, pos + Vector3.new(tx, 0, tz))
		end
		local wOut = 0.5 + 2.4 * taper
		local wIn = 0.15 + 0.7 * taper
		local outer = fxPart(Enum.PartType.Block, Vector3.new(wOut, 0.1, segLen), place(r0), col, NEON, 1)
		local inner = fxPart(Enum.PartType.Block, Vector3.new(wIn, 0.12, segLen), place(r0 + 0.2), core, NEON, 1)
		task.delay(order * 0.0075, function()
			outer.Transparency = 0.38
			inner.Transparency = 0.02
			tw(outer, 0.26, { Transparency = 1, Size = Vector3.new(wOut * 0.35, 0.1, segLen), CFrame = place(r1) })
			tw(inner, 0.2, { Transparency = 1, Size = Vector3.new(wIn * 0.3, 0.12, segLen), CFrame = place(r1 + 0.2) })
			Debris:AddItem(outer, 0.35)
			Debris:AddItem(inner, 0.35)
		end)
		-- sparks flying off the tip of the arc
		if i % 4 == 0 then
			task.delay(order * 0.0075, function()
				burst(x + rx * range * 0.95, 2.2, z + rz * range * 0.95, core, 2, 6, 14, 0.4, 0.3, col, -tx * dir, -tz * dir, 50)
			end)
		end
	end
	-- soft flash at the hero
	local flash = fxDisc(3.4, x + dx * 1.6, 2.0, z + dz * 1.6, core, 0.55, NEON, 0.1)
	tw(flash, 0.16, { Size = Vector3.new(0.1, 5.2, 5.2), Transparency = 1 })
	Debris:AddItem(flash, 0.25)
end

local projs = {}
local function addProjPart(pr, shape, size, off, color, mat, trans)
	local p = fxPart(shape, size, CFrame.new(), color, mat, trans)
	table.insert(pr.parts, { p, off })
	return p
end

H.Proj = function(id, kind, x, z, dx, dz, speed, range)
	local TH = (kind == "arrow" or kind == "fireball") and Theme.current() or nil
	local tinted = TH ~= nil and (TH.tier > 1 or TH.elem ~= "none")
	projWid[id] = TH and TH.id or false
	local pr = { kind = kind, x = x, z = z, dx = dx, dz = dz, speed = speed, left = range, parts = {}, acc = 0 }
	local B, CY = Enum.PartType.Block, Enum.PartType.Cylinder
	local flat = CFrame.Angles(0, 0, math.pi / 2)
	-- element / rarity projectiles (arrows + staff orbs); plain starter weapons keep the classic look
	local built = false
	if TH and (TH.tier > 1 or TH.elem ~= "none") and (kind == "arrow" or kind == "fireball") then
		built = pcall(WeaponFX.projectile, pr, kind, TH)
		if not built then
			for _, e in ipairs(pr.parts) do e[1]:Destroy() end
			pr.parts = {}
		end
	end
	if built then
		-- nothing: WeaponFX filled pr.parts
	elseif kind == "arrow" then
		local shaft = addProjPart(pr, B, Vector3.new(0.2, 0.14, 2.8), CFrame.new(), C3(232, 222, 188), Enum.Material.Wood)
		addProjPart(pr, B, Vector3.new(0.6, 0.16, 0.6), CFrame.new(0, 0, -1.5) * CFrame.Angles(0, math.pi / 4, 0), (tinted and Theme.glow(TH) or C3(176, 188, 206)), Enum.Material.Metal)
		addProjPart(pr, B, Vector3.new(0.34, 0.2, 0.34), CFrame.new(0, 0, -1.5) * CFrame.Angles(0, math.pi / 4, 0), (tinted and Theme.glow(TH) or C3(232, 238, 246)), tinted and NEON or Enum.Material.Metal)
		addProjPart(pr, B, Vector3.new(0.16, 0.12, 0.7), CFrame.new(-0.2, 0, 1.15) * CFrame.Angles(0, 0.3, 0), (tinted and Theme.main(TH) or C3(196, 62, 62)), Enum.Material.Fabric)
		addProjPart(pr, B, Vector3.new(0.16, 0.12, 0.7), CFrame.new(0.2, 0, 1.15) * CFrame.Angles(0, -0.3, 0), (tinted and Theme.main(TH) or C3(196, 62, 62)), Enum.Material.Fabric)
		addProjPart(pr, B, Vector3.new(0.14, 0.12, 0.6), CFrame.new(0, 0, 0.6), C3(236, 236, 236), Enum.Material.Fabric)
		addTrail(shaft, tinted and Theme.glow(TH) or C3(255, 246, 215), tinted and Theme.main(TH) or C3(190, 215, 240), 0.5 + (tinted and 0.14 * TH.tier or 0), 0.16 + (tinted and 0.03 * TH.tier or 0), 1.3)
		if tinted and TH.tier >= 3 then
			addProjPart(pr, CY, Vector3.new(0.3, 1.6 + 0.3 * TH.tier, 1.6 + 0.3 * TH.tier), flat, Theme.glow(TH), NEON, 0.55)
			addEmbers(shaft, Theme.glow(TH), Theme.main(TH), 10 + TH.tier * 6, 0.5, 0.4, 4)
		end
		burst(x, 2.2, z, C3t(255, 244, 210), 5, 8, 18, 0.35, 0.2, C3t(190, 210, 235), dx, dz, 35)
	elseif kind == "fireball" then
		local halo = addProjPart(pr, CY, Vector3.new(0.4, 3.6, 3.6), flat, C3t(255, 100, 30), NEON, 0.72)
		local o = addProjPart(pr, CY, Vector3.new(0.5, 2.5, 2.5), CFrame.new(0, 0.05, 0) * flat, C3t(255, 142, 44), NEON, 0.15)
		local c = addProjPart(pr, CY, Vector3.new(0.6, 1.3, 1.3), CFrame.new(0, 0.1, 0) * flat, C3t(255, 236, 170), NEON, 0)
		local l = Instance.new("PointLight")
		l.Color = C3t(255, 140, 50)
		l.Range = 20
		l.Brightness = 1.6
		l.Parent = o
		addTrail(halo, C3t(255, 170, 60), C3t(150, 30, 10), 2.0, 0.28, 0)
		addEmbers(c, C3t(255, 214, 120), C3t(255, 70, 20), 38, 0.9, 0.5, 4)
		burst(x, 2.2, z, C3t(255, 210, 120), 10, 6, 16, 0.7, 0.35, C3t(255, 90, 30), dx, dz, 50)
		ringFx(x, 1.0, z, 1.2, 4.2, C3t(255, 150, 60), 0.3, 8)
	elseif kind == "spit" then
		local o = addProjPart(pr, CY, Vector3.new(0.5, 1.7, 1.7), flat, C3(112, 220, 62), NEON, 0.15)
		local c = addProjPart(pr, CY, Vector3.new(0.6, 0.8, 0.8), CFrame.new(0, 0.1, 0) * flat, C3(222, 255, 176), NEON, 0)
		addTrail(o, C3(150, 255, 90), C3(40, 110, 30), 1.0, 0.24, 0)
		addEmbers(c, C3(190, 255, 120), C3(70, 170, 40), 18, 0.5, 0.45, 2)
	else
		local blade = addProjPart(pr, B, Vector3.new(0.3, 0.15, 1.7), CFrame.new(), C3(200, 206, 216), Enum.Material.Metal)
		addProjPart(pr, B, Vector3.new(0.9, 0.15, 0.25), CFrame.new(0, 0, 0.5), C3(110, 70, 40), Enum.Material.Wood)
		addProjPart(pr, B, Vector3.new(0.12, 0.2, 1.3), CFrame.new(0, 0, -0.2), C3(250, 252, 255), Enum.Material.Metal)
		addTrail(blade, C3(230, 236, 246), C3(130, 140, 160), 0.4, 0.14, 0.8)
	end
	do -- start every part at its first pose so trails don't streak from the origin
		local p0 = Vector3.new(x, 2.2, z)
		local b0 = CFrame.lookAt(p0, p0 + Vector3.new(dx, 0, dz))
		for _, e in ipairs(pr.parts) do e[1].CFrame = b0 * e[2] end
	end
	projs[id] = pr
end

local function killProj(id)
	local pr = projs[id]
	if not pr then return nil end
	projs[id] = nil
	for _, e in ipairs(pr.parts) do e[1]:Destroy() end
	return pr
end

H.ProjEnd = function(id, x, z, kind, radius)
	local pr = killProj(id)
	local pw = projWid[id]
	projWid[id] = nil
	if pw then Theme.set(pw) end
	local WTH = pw and Config.Weapons[pw]
	if WTH and (WTH.tier > 1 or WTH.elem ~= "none") and (kind == "arrow" or kind == "fireball") then
		if pcall(WeaponFX.impact, kind, x, z, radius, WTH, pr and pr.dx, pr and pr.dz) then return end
	end
	if kind == "fireball" then
		local fl = fxDisc(radius * 0.7, x, 2.2, z, C3t(255, 238, 170), 0.05, NEON, 0.3)
		tw(fl, 0.2, { Size = Vector3.new(0.3, radius * 1.5, radius * 1.5), Transparency = 1 })
		local a = fxDisc(radius * 0.6, x, 2, z, C3t(255, 120, 34), 0.2, NEON, 0.3)
		tw(a, 0.38, { Size = Vector3.new(0.3, radius * 2.1, radius * 2.1), Transparency = 1 })
		local scorch = fxDisc(radius * 1.2, x, 0.3, z, C3t(36, 20, 12), 0.45, Enum.Material.SmoothPlastic, 0.1)
		tw(scorch, 1.0, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		ringFx(x, 0.6, z, radius * 0.6, radius * 2.3, C3t(255, 170, 70), 0.45, 10)
		ringFx(x, 0.7, z, radius * 0.3, radius * 1.5, C3t(255, 236, 170), 0.3, 6)
		burst(x, 2.2, z, C3t(255, 214, 120), 26, 14, 34, 1.1, 0.7, C3t(255, 70, 20), nil, nil, nil)
		burst(x, 1.0, z, C3t(90, 60, 45), 10, 4, 12, 2.2, 0.9, C3t(40, 28, 22), nil, nil, nil)
		Debris:AddItem(fl, 0.3)
		Debris:AddItem(a, 0.5)
		Debris:AddItem(scorch, 1.1)
	else
		local col = kind == "spit" and C3t(130, 240, 76) or (kind == "arrow" and C3t(255, 238, 190) or C3t(205, 210, 222))
		local a = fxDisc(1.0, x, 2, z, col, 0.15, NEON, 0.2)
		tw(a, 0.2, { Size = Vector3.new(0.2, 3.0, 3.0), Transparency = 1 })
		Debris:AddItem(a, 0.3)
		ringFx(x, 1.0, z, 0.8, 4.0, col, 0.25, 7)
		burst(x, 2.2, z, col, 8, 8, 20, 0.45, 0.3, C3t(255, 255, 255), nil, nil, nil)
	end
end

H.Dmg = function(x, z, amount, crit, onPlayer)
	local a = fxPart(Enum.PartType.Block, Vector3.new(0.5, 0.5, 0.5), CFrame.new(x + (math.random() - 0.5) * 3, 5, z), C3(255, 255, 255), Enum.Material.SmoothPlastic, 1)
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(140, 56)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.Adornee = a
	local t = Instance.new("TextLabel")
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(0.5, 0.5)
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextSize = crit and 34 or 22
	t.Text = tostring(amount) .. (crit and "!" or "")
	t.TextColor3 = onPlayer and C3(232, 96, 96) or (crit and C3(255, 205, 90) or C3(240, 242, 248))
	t.TextStrokeColor3 = C3(14, 16, 22)
	t.TextStrokeTransparency = 0.15
	t.Parent = g
	local sc = Instance.new("UIScale")
	sc.Scale = 0.4
	sc.Parent = t
	g.Parent = a
	tw(sc, 0.14, { Scale = crit and 1.25 or 1.1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	task.delay(0.14, function() tw(sc, 0.12, { Scale = 1 }) end)
	tw(a, 0.8, { Position = a.Position + Vector3.new(0, 0, -5) })
	task.delay(0.45, function()
		tw(t, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Linear)
	end)
	Debris:AddItem(a, 0.9)
	if not onPlayer then
		if not (WeaponFX.recentAttack() and pcall(WeaponFX.hit, Theme.current(), x, z, crit)) then
			burst(x, 2.4, z, crit and C3(255, 214, 110) or C3(255, 255, 255), crit and 8 or 4, 8, 18, crit and 0.55 or 0.35, 0.25, nil, nil, nil, nil)
		end
	end
end

-- status proc visual (frost / nature / shock / void) on an enemy
H.Proc = function(x, z, r, el) WeaponFX.proc(x, z, r, el) end

H.Tele = function(x, z, r, dur)
	local base = fxDisc(r * 2, x, 0.3, z, C3(210, 50, 50), 0.82, NEON, 0.05)
	local fill = fxDisc(0.5, x, 0.35, z, C3(235, 70, 55), 0.55, NEON, 0.05)
	tw(fill, dur, { Size = Vector3.new(0.05, r * 2, r * 2) }, Enum.EasingStyle.Linear)
	ringFx(x, 0.4, z, r * 2, r * 2, C3(255, 96, 76), dur, 10, 0.05, 0.2)
	task.delay(dur, function()
		base:Destroy()
		fill:Destroy()
	end)
end

local rocks = {}
H.Rock = function(sx, sz, tx, tz, dur)
	local a = fxPart(Enum.PartType.Cylinder, Vector3.new(2, 4.4, 4.4), CFrame.new(sx, 3, sz) * CFrame.Angles(0, 0, math.pi / 2), C3(112, 112, 120), Enum.Material.Slate)
	local b = fxPart(Enum.PartType.Cylinder, Vector3.new(2.4, 2.8, 2.8), CFrame.new(sx, 3, sz) * CFrame.Angles(0, 0, math.pi / 2), C3(146, 146, 154), Enum.Material.Slate)
	table.insert(rocks, { a = a, b = b, t = 0, dur = dur, sx = sx, sz = sz, tx = tx, tz = tz })
end

H.Boom = function(x, z, r)
	local a = fxDisc(r * 1.2, x, 0.5, z, C3(176, 158, 132), 0.4, Enum.Material.SmoothPlastic, 0.2)
	tw(a, 0.6, { Size = Vector3.new(0.2, r * 2.6, r * 2.6), Transparency = 1 })
	local b = fxDisc(r * 0.8, x, 0.6, z, C3(240, 188, 112), 0.25, NEON, 0.2)
	tw(b, 0.35, { Size = Vector3.new(0.2, r * 1.8, r * 1.8), Transparency = 1 })
	ringFx(x, 0.8, z, r * 0.8, r * 2.5, C3(240, 200, 140), 0.5, 10)
	burst(x, 1.5, z, C3(150, 142, 130), 22, 10, 30, 2.0, 0.8, C3(90, 86, 80), nil, nil, nil)
	for i = 1, 8 do
		local ang = i * math.pi / 4
		local d = fxDisc(0.9, x, 1.5, z, C3(110, 110, 116), 0, Enum.Material.Slate, 0.5)
		tw(d, 0.5, { Position = Vector3.new(x + math.cos(ang) * r * 0.9, 1.5, z + math.sin(ang) * r * 0.9), Transparency = 1 })
		Debris:AddItem(d, 0.6)
	end
	Debris:AddItem(a, 0.7)
	Debris:AddItem(b, 0.5)
end

H.Death = function(x, z, r, kind)
	local col = C3(120, 190, 80)
	if kind == "titan" then col = C3(140, 140, 146) elseif kind == "king" then col = C3(240, 196, 70) elseif kind == "goblin" then col = C3(150, 210, 70) end
	for i = 1, 8 do
		local ang = i * math.pi / 4 + math.random() * 0.4
		local d = fxDisc(r * 0.5, x, 1.5, z, col, 0.1, Enum.Material.SmoothPlastic, 0.3)
		tw(d, 0.5, { Position = Vector3.new(x + math.cos(ang) * r * 1.8, 1.5, z + math.sin(ang) * r * 1.8), Transparency = 1, Size = Vector3.new(0.1, 0.2, 0.2) })
		Debris:AddItem(d, 0.6)
	end
	local puff = fxDisc(r * 1.6, x, 1.0, z, C3(235, 238, 245), 0.45, NEON, 0.2)
	tw(puff, 0.4, { Size = Vector3.new(0.1, r * 3, r * 3), Transparency = 1 })
	Debris:AddItem(puff, 0.5)
	ringFx(x, 0.9, z, r * 1.0, r * 3.4, col, 0.45, 7)
	burst(x, 2, z, col, 14 + math.floor(r * 3), 8, 22, 0.9, 0.55, C3(255, 255, 255), nil, nil, nil)
end

H.DashFx = function(x, z)
	for i = 1, 3 do
		local d = fxDisc(2.2 - i * 0.4, x, 0.6 + i * 0.05, z, C3(190, 218, 240), 0.5, NEON, 0.1)
		tw(d, 0.4, { Size = Vector3.new(0.1, 6, 6), Transparency = 1 })
		Debris:AddItem(d, 0.5)
	end
	ringFx(x, 0.8, z, 2, 8, C3(200, 226, 245), 0.35, 6)
	burst(x, 1.2, z, C3(200, 205, 212), 10, 6, 14, 1.4, 0.5, C3(150, 154, 162), nil, nil, nil)
end

-- ability movement (server tells the owner to move; the client owns its character physics)
H.Lunge = function(dx, dz, speed, dur)
	local _, h, r = char()
	if not h or h.Health <= 0 then return end
	dashDir = Vector3.new(dx, 0, dz)
	dashUntil = os.clock() + dur
	h.WalkSpeed = speed
	r.AssemblyLinearVelocity = Vector3.new(dx * speed, r.AssemblyLinearVelocity.Y, dz * speed)
	task.delay(dur, function()
		if h.Parent then h.WalkSpeed = lp:GetAttribute("WalkSpeed") or 20 end
	end)
end
H.BlinkTo = function(x, z)
	local _, _, r = char()
	if not r then return end
	r.CFrame = CFrame.new(x, r.Position.Y, z) * (r.CFrame - r.CFrame.Position)
	r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end

H.Hurt = function()
	hurt.BackgroundColor3 = C3(150, 24, 24)
	hurt.BackgroundTransparency = 0.78
	tw(hurt, 0.4, { BackgroundTransparency = 1 })
end

-- projectile + rock simulation
RunService.Heartbeat:Connect(function(dt)
	for id, pr in pairs(projs) do
		local step = pr.speed * dt
		pr.x = pr.x + pr.dx * step
		pr.z = pr.z + pr.dz * step
		pr.left = pr.left - step
		pr.age = (pr.age or 0) + dt
		if pr.tick then pcall(pr.tick, pr, dt, pr.age) end
		local pos = Vector3.new(pr.x, 2.2, pr.z)
		local base = CFrame.lookAt(pos, pos + Vector3.new(pr.dx, 0, pr.dz))
		for _, e in ipairs(pr.parts) do e[1].CFrame = base * e[2] end
		if pr.left < -4 then killProj(id) end
	end
	for i = #rocks, 1, -1 do
		local rk = rocks[i]
		rk.t = rk.t + dt
		local a = math.min(1, rk.t / rk.dur)
		local x = rk.sx + (rk.tx - rk.sx) * a
		local z = rk.sz + (rk.tz - rk.sz) * a
		local y = 1.5 + math.sin(math.pi * a) * 16
		local cf = CFrame.new(x, y, z) * CFrame.Angles(a * 8, 0, math.pi / 2)
		rk.a.CFrame = cf
		rk.b.CFrame = cf * CFrame.new(0.2, 0, 0)
		if a >= 1 then
			rk.a:Destroy()
			rk.b:Destroy()
			table.remove(rocks, i)
		end
	end
end)

-- ============================================================ ENVIRONMENT
local cc = Instance.new("ColorCorrectionEffect")
cc.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Parent = Lighting
local ENV = {
	lobby = { amb = C3(150, 146, 162), out = C3(166, 160, 172), br = 2.3, clock = 17.2, tint = C3(255, 238, 218), sat = 0.22, con = 0.1, bloom = 0.5 },
	forest = { amb = C3(100, 120, 98), out = C3(125, 145, 112), br = 1.9, clock = 16.5, tint = C3(255, 244, 214), sat = 0.18, con = 0.1, bloom = 0.35 },
	test = { amb = C3(150, 150, 168), out = C3(170, 170, 184), br = 2.4, clock = 14, tint = C3(255, 250, 240), sat = 0.2, con = 0.1, bloom = 0.55 }, -- [TESTAREA]
	cave = { amb = C3(88, 82, 120), out = C3(80, 74, 112), br = 1.2, clock = 0, tint = C3(205, 205, 255), sat = 0.05, con = 0.12, bloom = 0.7 },
}
local function applyEnv(name)
	local e = ENV[name] or ENV.lobby
	Lighting.GlobalShadows = false
	TweenService:Create(Lighting, TweenInfo.new(1), { Ambient = e.amb, OutdoorAmbient = e.out, Brightness = e.br, ClockTime = e.clock }):Play()
	cc.TintColor = e.tint
	cc.Saturation = e.sat
	cc.Contrast = e.con
	bloom.Intensity = e.bloom
	bloom.Size = 28
	bloom.Threshold = 0.9
end
applyEnv("lobby")

-- ============================================================ SERVER MESSAGES
H.Toast = function(text, color, dur) showToast(text, color, dur) end
H.Env = function(name) applyEnv(name) end
H.Down = function() downLabel.Visible = true end

H.Zone = function(zid)
	curZone = zid
	portal.frame.Visible = false
	upPanel.frame.Visible = false
	if zid == "upgrade" then
		upPanel.frame.Visible = true
		renderUpgrade()
	elseif zid and gateNumber(zid) > 0 then
		gateViews[zid] = nil -- wait for the server to tell us the gate state
	end
end

H.Gate = function(gate, view)
	gateViews[gate] = view or false
	if curZone == gate then
		portal.frame.Visible = true
		renderPortal()
	end
end

H.Run = function(d)
	waveFrame.Visible = true
	waveTitle.Text = (d.wave and d.wave > 0) and ("WAVE " .. d.wave .. " / " .. d.waves) or "GET READY"
	waveSub.Text = d.loc .. "  [" .. d.diff .. "]   -   Enemies left: " .. d.left
	if d.test then -- [TESTAREA]
		waveTitle.Text = "TEST ARENA"
		waveSub.Text = "Тренировочные манекены  -  бей и пробуй способности Q / E / Z"
	end
	if d.boss then
		bossFrame.Visible = true
		bossName.Text = string.upper(d.boss.name)
		bossBar.fill.Size = UDim2.fromScale(math.clamp(d.boss.hp / d.boss.max, 0, 1), 1)
		bossBar.txt.Text = math.ceil(d.boss.hp) .. " / " .. math.ceil(d.boss.max)
	else
		bossFrame.Visible = false
	end
end

H.RunEnd = function()
	waveFrame.Visible = false
	bossFrame.Visible = false
	result.Visible = false
	downLabel.Visible = false
end

H.Result = function(r)
	waveFrame.Visible = false
	bossFrame.Visible = false
	result.Visible = true
	resTitle.Text = r.won and "VICTORY!" or "DEFEAT"
	resTitle.TextColor3 = r.won and GOLD or C3(214, 100, 100)
	resStroke.Color = resTitle.TextColor3
	local txt = r.loc .. "  [" .. r.diff .. "]\n\nKills: " .. r.kills .. "\nXP earned: +" .. r.xp .. "\nCoins earned: +" .. r.coins .. "\nYour level: " .. r.level
	if r.unlocked then txt = txt .. "\n\nNEW DIFFICULTY UNLOCKED: " .. string.upper(r.unlocked) .. "!" end
	if not r.won then txt = txt .. "\n\nAll heroes fell. Try again!" end
	resBody.Text = txt
end

ToClient.OnClientEvent:Connect(function(name, ...)
	local f = H[name]
	if f then
		local ok, err = pcall(f, ...)
		if not ok then warn("[client] " .. name .. ": " .. tostring(err)) end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX12">
<Properties>
<string name="Name">AbilityClient</string>
<ProtectedString name="Source"><![CDATA[-- AbilityClient: custom crosshair cursor, Q / E / Z ability bar + input, and all ability VFX
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
