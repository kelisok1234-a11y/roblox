-- ============================================================ SMALL UI HELPERS
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end
local function tw(o, t, props, style, dir)
	local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end
local function label(parent, text, size, color, font, pos, sz, align)
	return new("TextLabel", {
		Text = text, TextSize = size, TextColor3 = color or C3(255, 255, 255), Font = font or Enum.Font.GothamBold,
		BackgroundTransparency = 1, Position = pos or UDim2.fromScale(0, 0), Size = sz or UDim2.fromScale(1, 1),
		TextXAlignment = align or Enum.TextXAlignment.Center,
	}, parent)
end

-- ============================================================ STATE
local curClass = nil
local cdEnd = { Q = 0, E = 0, Z = 0 }
local cdTotal = { Q = 1, E = 1, Z = 1 }
local kick = 0 -- crosshair recoil / pulse
local attacking = false

local curWeapon = nil
local function classColor()
	if curWeapon and curWeapon.tier >= 2 then return Theme.main(curWeapon) end
	local c = curClass and Config.Classes[curClass]
	return c and c.color or C3(230, 230, 240)
end

-- ============================================================ CAMERA SHAKE
local shakes = {}
local function shake(amp, dur)
	table.insert(shakes, { amp = amp, dur = dur, t = 0 })
end
local function shakeAt(x, z, amp, dur, radius)
	local c = lp.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	local d = 0
	if r then d = math.sqrt((r.Position.X - x) ^ 2 + (r.Position.Z - z) ^ 2) end
	local k = math.clamp(1 - d / (radius or 80), 0.15, 1)
	shake(amp * k, dur)
end
RunService:BindToRenderStep("AbilityShake", Enum.RenderPriority.Camera.Value + 2, function(dt)
	if #shakes == 0 then return end
	local ox, oy = 0, 0
	for i = #shakes, 1, -1 do
		local s = shakes[i]
		s.t = s.t + dt
		if s.t >= s.dur then
			table.remove(shakes, i)
		else
			local k = (1 - s.t / s.dur) ^ 2 * s.amp
			ox = ox + (math.random() * 2 - 1) * k
			oy = oy + (math.random() * 2 - 1) * k
		end
	end
	local cam = workspace.CurrentCamera
	cam.CFrame = cam.CFrame * CFrame.new(ox, oy, 0)
end)

-- ============================================================ SCREEN EFFECTS (flash / banner / letterbox)
local fxGui = new("ScreenGui", { Name = "AbilityFX", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 8, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
local flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(255, 255, 255), BackgroundTransparency = 1, BorderSizePixel = 0 }, fxGui)
local barTop = new("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = C3(0, 0, 0), BorderSizePixel = 0, ZIndex = 2 }, fxGui)
local barBot = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = C3(0, 0, 0), BorderSizePixel = 0, ZIndex = 2 }, fxGui)
local bannerBox = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.27), Size = UDim2.fromOffset(900, 120), BackgroundTransparency = 1, ZIndex = 5 }, fxGui)
local bannerScale = new("UIScale", { Scale = 1 }, bannerBox)
local bannerSub = label(bannerBox, "- ULTIMATE -", 20, C3(255, 255, 255), Enum.Font.GothamBold, UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 26))
bannerSub.TextTransparency = 1
bannerSub.ZIndex = 5
local bannerTxt = label(bannerBox, "", 52, C3(255, 255, 255), Enum.Font.GothamBlack, UDim2.fromOffset(0, 26), UDim2.new(1, 0, 0, 68))
bannerTxt.TextTransparency = 1
bannerTxt.TextStrokeColor3 = C3(10, 10, 16)
bannerTxt.TextStrokeTransparency = 1
bannerTxt.ZIndex = 5

local function screenFlash(color, alpha, dur)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = alpha
	tw(flash, dur, { BackgroundTransparency = 1 })
end

local bannerTok = 0
local function showBanner(text, color)
	bannerTok = bannerTok + 1
	local tok = bannerTok
	bannerTxt.Text = string.upper(text)
	bannerTxt.TextColor3 = color
	bannerSub.TextColor3 = color
	bannerScale.Scale = 1.7
	bannerTxt.TextTransparency = 0
	bannerTxt.TextStrokeTransparency = 0.1
	bannerSub.TextTransparency = 0.1
	tw(bannerScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	tw(barTop, 0.25, { Size = UDim2.new(1, 0, 0, 54) })
	tw(barBot, 0.25, { Size = UDim2.new(1, 0, 0, 54) })
	task.delay(1.5, function()
		if tok ~= bannerTok then return end
		tw(bannerTxt, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		tw(bannerSub, 0.5, { TextTransparency = 1 })
		tw(barTop, 0.45, { Size = UDim2.new(1, 0, 0, 0) })
		tw(barBot, 0.45, { Size = UDim2.new(1, 0, 0, 0) })
	end)
end

-- ============================================================ CUSTOM CROSSHAIR CURSOR
local cg = new("ScreenGui", { Name = "Crosshair", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
local chRoot = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, cg)
local chScale = new("UIScale", { Scale = 1 }, chRoot)
local chColored = {} -- every element that gets tinted by class / hover color

local function chFrame(parent, size, pos, anchor, rotation)
	local f = new("Frame", {
		AnchorPoint = anchor or Vector2.new(0.5, 0.5), Position = pos or UDim2.fromOffset(0, 0), Size = size,
		BackgroundColor3 = C3(255, 255, 255), BorderSizePixel = 0, Rotation = rotation or 0,
	}, parent)
	new("UIStroke", { Color = C3(8, 10, 16), Thickness = 1, Transparency = 0.35 }, f)
	table.insert(chColored, f)
	return f
end

-- soft shadow ring (contrast on bright ground)
local shadow = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(46, 46), BackgroundTransparency = 1 }, chRoot)
corner(shadow, 23)
new("UIStroke", { Color = C3(0, 0, 0), Thickness = 5, Transparency = 0.7 }, shadow)

-- main ring
local ring = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(42, 42), BackgroundTransparency = 1 }, chRoot)
corner(ring, 21)
local ringStroke = new("UIStroke", { Color = C3(255, 255, 255), Thickness = 2, Transparency = 0.1 }, ring)

-- four ticks that open up when you shoot
local ticks = {}
for i = 1, 4 do
	local vertical = (i == 1 or i == 3)
	ticks[i] = chFrame(chRoot, vertical and UDim2.fromOffset(3, 10) or UDim2.fromOffset(10, 3))
end

-- rotating square brackets
local brackets = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1 }, chRoot)
local function bracket(ax, ay)
	chFrame(brackets, UDim2.fromOffset(13, 3), UDim2.fromScale(ax, ay), Vector2.new(ax, ay))
	chFrame(brackets, UDim2.fromOffset(3, 13), UDim2.fromScale(ax, ay), Vector2.new(ax, ay))
end
bracket(0, 0)
bracket(1, 0)
bracket(0, 1)
bracket(1, 1)

-- center dot
local dot = chFrame(chRoot, UDim2.fromOffset(6, 6))
corner(dot, 3)

local chColor = C3(255, 255, 255)
local function paintCrosshair(c)
	ringStroke.Color = c
	for _, f in ipairs(chColored) do f.BackgroundColor3 = c end
end

-- is the cursor over an enemy? (looks into the Run folders in workspace)
local hover = false
local hoverCheckAt = 0
local function cursorWorld()
	local cam = workspace.CurrentCamera
	local m = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(m.X, m.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then return nil end
	local t = -ray.Origin.Y / ray.Direction.Y
	return ray.Origin + ray.Direction * t
end
local function checkHover()
	local aim = cursorWorld()
	if not aim then return false end
	for _, f in ipairs(workspace:GetChildren()) do
		if f:IsA("Folder") and string.sub(f.Name, 1, 3) == "Run" then
			local ef = f:FindFirstChild("Enemies")
			if ef then
				for _, m in ipairs(ef:GetChildren()) do
					local pp = m:IsA("Model") and m.PrimaryPart
					if pp then
						local big = (m.Name == "Zombie Titan" or m.Name == "Goblin King")
						local rr = big and 6.5 or 3.2
						local dx, dz = pp.Position.X - aim.X, pp.Position.Z - aim.Z
						if dx * dx + dz * dz < rr * rr then return true end
					end
				end
			end
		end
	end
	return false
end

local spin = 0
local smoothScale = 1
RunService.RenderStepped:Connect(function(dt)
	UIS.MouseIconEnabled = false
	local m = UIS:GetMouseLocation()
	chRoot.Position = UDim2.fromOffset(m.X, m.Y)

	local now = os.clock()
	if now > hoverCheckAt then
		hoverCheckAt = now + 0.07
		hover = checkHover()
	end
	if attacking then kick = math.max(kick, 0.3 + 0.12 * math.sin(now * 32)) end
	kick = kick * math.exp(-dt * 9)

	spin = spin + dt * (hover and 150 or 45)
	brackets.Rotation = spin
	local targetScale = 1 + kick * 0.22 + (hover and 0.14 or 0)
	smoothScale = smoothScale + (targetScale - smoothScale) * (1 - math.exp(-dt * 20))
	chScale.Scale = smoothScale

	local spread = 24 + kick * 9 - (hover and 3 or 0)
	ticks[1].Position = UDim2.fromOffset(0, -spread)
	ticks[2].Position = UDim2.fromOffset(spread, 0)
	ticks[3].Position = UDim2.fromOffset(0, spread)
	ticks[4].Position = UDim2.fromOffset(-spread, 0)

	local base = classColor():Lerp(C3(255, 255, 255), 0.35)
	local target = hover and C3(255, 72, 72) or base
	chColor = chColor:Lerp(target, 1 - math.exp(-dt * 16))
	paintCrosshair(chColor)
	ringStroke.Thickness = 2 + kick * 1.6
end)

-- ============================================================ ABILITY BAR
local hudGui = new("ScreenGui", { Name = "AbilityHUD", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 6, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
local group = new("CanvasGroup", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -82), Size = UDim2.fromOffset(300, 112),
	BackgroundTransparency = 1, Visible = false,
}, hudGui)

local slots = {}
do
	local layout = { { key = "Q", w = 64 }, { key = "E", w = 64 }, { key = "Z", w = 82 } }
	local x = 32
	for _, l in ipairs(layout) do
		local w = l.w
		local isUlt = l.key == "Z"
		local f = new("Frame", {
			Position = UDim2.fromOffset(x, 112 - w - 6), Size = UDim2.fromOffset(w, w),
			BackgroundColor3 = C3(255, 255, 255), BorderSizePixel = 0,
		}, group)
		corner(f, 12)
		new("UIGradient", { Color = ColorSequence.new(C3(52, 56, 78), C3(14, 16, 24)), Rotation = 90 }, f)
		local sc = new("UIScale", { Scale = 1 }, f)
		local st = new("UIStroke", { Color = C3(255, 255, 255), Thickness = isUlt and 3 or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
		local icon = label(f, "", math.floor(w * 0.46), C3(255, 255, 255), Enum.Font.GothamBold, UDim2.fromOffset(0, 2), UDim2.new(1, 0, 1, -14))
		local nm = label(f, "", 10, C3(220, 224, 236), Enum.Font.GothamBold, UDim2.new(0, 2, 1, -15), UDim2.new(1, -4, 0, 13))
		nm.TextScaled = true
		new("UITextSizeConstraint", { MinTextSize = 7, MaxTextSize = 11 }, nm)
		local badge = new("Frame", { Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(20, 18), BackgroundColor3 = C3(255, 255, 255), BorderSizePixel = 0, ZIndex = 3 }, f)
		corner(badge, 5)
		local bl = label(badge, l.key, 13, C3(12, 14, 20), Enum.Font.GothamBlack)
		bl.ZIndex = 4
		local cd = new("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = C3(0, 0, 0), BackgroundTransparency = 0.38, BorderSizePixel = 0, ZIndex = 5 }, f)
		corner(cd, 12)
		local cdText = label(f, "", isUlt and 24 or 20, C3(255, 255, 255), Enum.Font.GothamBlack)
		cdText.ZIndex = 6
		cdText.TextStrokeColor3 = C3(0, 0, 0)
		cdText.TextStrokeTransparency = 0.3
		slots[l.key] = { frame = f, scale = sc, stroke = st, icon = icon, name = nm, badge = badge, cd = cd, cdText = cdText, ult = isUlt, was = false }
		x = x + w + 12
	end
end

local function refreshSlots()
	local defs = curClass and Config.Abilities[curClass]
	group.Visible = defs ~= nil
	if not defs then return end
	local col = classColor()
	for key, s in pairs(slots) do
		local d = defs[key]
		s.icon.Text = d.icon
		s.name.Text = d.name
		s.stroke.Color = s.ult and C3(255, 206, 90) or col
		s.badge.BackgroundColor3 = s.ult and C3(255, 206, 90) or col
	end
end

local function readClass()
	local raw = lp:GetAttribute("Data")
	if not raw then return end
	local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
	if ok and type(d) == "table" and (d.class ~= curClass or (d.weapon and Config.Weapons[d.weapon] ~= curWeapon)) then
		curClass = d.class
		curWeapon = d.weapon and Config.Weapons[d.weapon] or nil
		refreshSlots()
	end
end
lp:GetAttributeChangedSignal("Data"):Connect(readClass)
readClass()

lp:GetAttributeChangedSignal("InRun"):Connect(function()
	cdEnd.Q, cdEnd.E, cdEnd.Z = 0, 0, 0
end)

local function readyPop(s)
	s.scale.Scale = 1.18
	tw(s.scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local th = s.ult and 3 or 2
	s.stroke.Thickness = th + 4
	tw(s.stroke, 0.4, { Thickness = th })
end

local function denyPop(s)
	s.frame.Rotation = 6
	tw(s.frame, 0.3, { Rotation = 0 }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
end

RunService.RenderStepped:Connect(function()
	if not group.Visible then return end
	local inRun = lp:GetAttribute("InRun") == true
	group.GroupTransparency = inRun and 0 or 0.55
	local now = os.clock()
	for key, s in pairs(slots) do
		local left = cdEnd[key] - now
		if left > 0 then
			s.was = true
			s.cd.Size = UDim2.new(1, 0, math.clamp(left / math.max(0.1, cdTotal[key]), 0, 1), 0)
			s.cdText.Text = left >= 10 and tostring(math.ceil(left)) or string.format("%.1f", left)
		else
			s.cd.Size = UDim2.new(1, 0, 0, 0)
			s.cdText.Text = ""
			if s.was then
				s.was = false
				readyPop(s)
			end
			if s.ult and inRun then
				local k = 0.5 + 0.5 * math.sin(now * 5)
				s.stroke.Color = C3(255, 206, 90):Lerp(C3(255, 255, 255), k * 0.8)
			end
		end
	end
end)

-- ============================================================ INPUT
local KEYS = { [Enum.KeyCode.Q] = "Q", [Enum.KeyCode.E] = "E", [Enum.KeyCode.Z] = "Z" }

UIS.InputBegan:Connect(function(input, gp)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not gp then
		attacking = true
		kick = math.max(kick, 0.9)
		return
	end
	if gp then return end
	local key = KEYS[input.KeyCode]
	if not key or not curClass then return end
	local s = slots[key]
	if os.clock() < cdEnd[key] then
		if s then denyPop(s) end
		return
	end
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return end
	local aim = cursorWorld()
	if not aim then return end
	ToServer:FireServer("Ability", key, aim)
	kick = 1.6
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then attacking = false end
end)

-- ============================================================ VFX HELPERS
local fxFolder = Instance.new("Folder")
fxFolder.Name = "AbilityFX"
fxFolder.Parent = workspace
local NEON = Enum.Material.Neon
local B, CY, BALL = Enum.PartType.Block, Enum.PartType.Cylinder, Enum.PartType.Ball

local function fxPart(shape, size, cf, color, mat, trans)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = Theme.tint(color)
	p.Material = mat or NEON
	p.Transparency = trans or 0
	p.Parent = fxFolder
	return p
end
local function fxDisc(d, x, y, z, color, trans, mat, thick)
	return fxPart(CY, Vector3.new(thick or 0.2, d, d), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans)
end

-- runs fn(alpha, elapsed) every frame for dur seconds
local function animate(dur, fn, done)
	task.spawn(function()
		local t = 0
		while t < dur do
			local dt = RunService.Heartbeat:Wait()
			t = t + dt
			local ok = pcall(fn, math.min(1, t / dur), t)
			if not ok then break end
		end
		if done then pcall(done) end
	end)
end

local function ringFx(x, y, z, d0, d1, color, dur, thick, startTrans, endTrans)
	local p = fxPart(B, Vector3.new(d0, 0.05, d0), CFrame.new(x, y, z), color, Enum.Material.SmoothPlastic, 1)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(256, 256)
	sg.LightInfluence = 0
	sg.Brightness = 1.4
	sg.Parent = p
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Parent = sg
	local uc = Instance.new("UICorner")
	uc.CornerRadius = UDim.new(0.5, 0)
	uc.Parent = f
	local us = Instance.new("UIStroke")
	us.Color = Theme.tint(color)
	us.Thickness = thick or 8
	us.Transparency = startTrans or 0.1
	us.Parent = f
	tw(p, dur, { Size = Vector3.new(d1, 0.05, d1) })
	tw(us, dur, { Transparency = endTrans or 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(p, dur + 0.1)
	return p
end

local function burst(x, y, z, color, count, smin, smax, size, life, color2, dirX, dirZ, spread)
	local cf = CFrame.new(x, y, z)
	if dirX then
		local pos = Vector3.new(x, y, z)
		cf = CFrame.lookAt(pos, pos + Vector3.new(dirX, 0, dirZ)) * CFrame.Angles(-math.pi / 2, 0, 0)
	end
	local p = fxPart(B, Vector3.new(0.2, 0.2, 0.2), cf, color, Enum.Material.SmoothPlastic, 1)
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Rate = 0
	e.Color = ColorSequence.new(Theme.tint(color), Theme.tint(color2 or color))
	e.LightEmission = 0.9
	e.LightInfluence = 0
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(smin, smax)
	e.SpreadAngle = spread and Vector2.new(spread, spread) or Vector2.new(180, 180)
	e.Drag = 3
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.6, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Parent = p
	e:Emit(count)
	Debris:AddItem(p, life + 0.3)
end

local function addTrail(part, c0, c1, width, life, off)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-width / 2, 0, off or 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(width / 2, 0, off or 0)
	a1.Parent = part
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = life
	t.Color = ColorSequence.new(Theme.tint(c0), Theme.tint(c1))
	t.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.6, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	t.LightEmission = 0.8
	t.LightInfluence = 0
	t.MinLength = 0.04
	t.FaceCamera = false
	t.Parent = part
	return t
end

local function addEmbers(part, c0, c1, rate, size, life, speed)
	local e = Instance.new("ParticleEmitter")
	e.Rate = rate
	e.Color = ColorSequence.new(Theme.tint(c0), Theme.tint(c1))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(speed * 0.3, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = part
	return e
end

-- a glowing bar between two world points
local function segment(a, b, w, h, color, trans, mat)
	local mid = (a + b) / 2
	local d = b - a
	local len = d.Magnitude
	local fwd = len > 0.01 and d.Unit or Vector3.new(0, 0, 1)
	return fxPart(B, Vector3.new(w, h, math.max(len, 0.05)), CFrame.lookAt(mid, mid + fwd), color, mat or NEON, trans or 0)
end

-- vertical column of light
local function pillar(x, z, w, h, color, dur, startTrans)
	local p = fxPart(B, Vector3.new(w, h, w), CFrame.new(x, h / 2, z), color, NEON, startTrans or 0.3)
	tw(p, dur, { Size = Vector3.new(0.1, h, 0.1), Transparency = 1 })
	Debris:AddItem(p, dur + 0.1)
	return p
end

local function heroPos(userId)
	local pl = Players:GetPlayerByUserId(userId)
	local c = pl and pl.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	return r and r.Position or nil
end

local H = {}

-- ============================================================ GENERIC
H.AbCd = function(key, cd)
	cdEnd[key] = os.clock() + cd
	cdTotal[key] = cd
end

H.UltBanner = function(name, color, wid)
	local w = wid and Config.Weapons[wid]
	local col = (w and w.tier >= 2) and Theme.main(w) or color or C3(255, 206, 90)
	showBanner(name, col)
	screenFlash(col:Lerp(C3(255, 255, 255), 0.6), 0.55, 0.45)
	shake(1.2, 0.45)
	local c = lp.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	if r then
		local x, z = r.Position.X, r.Position.Z
		ringFx(x, 0.7, z, 3, 26, col, 0.55, 10)
		ringFx(x, 0.8, z, 2, 16, C3(255, 255, 255), 0.4, 7)
		pillar(x, z, 4, 70, col:Lerp(C3(255, 255, 255), 0.4), 0.6, 0.45)
		burst(x, 1.5, z, col, 10, 14, 30, 0.9, 0.6, C3(255, 255, 255))
	end
end

H.Theme = function(wid)
	Theme.set(wid)
end

-- rarity aura: every ability cast gets a bigger, flashier burst the rarer the weapon is
H.Aura = function(x, z, tier, mult, wid)
	Theme.set(wid)
	local w = wid and Config.Weapons[wid]
	if not w or tier < 2 then return end
	local m = mult or 1
	-- one clean element sigil instead of stacked rings / bursts / spiral emitters
	if not pcall(WeaponFX.sigil, x, z, tier, m, w) then
		ringFx(x, 0.9, z, 3, 10 + tier * 2, Theme.main(w), 0.5, 8)
	end
	if tier >= 5 then
		shakeAt(x, z, 0.45 * m, 0.3)
		if m > 1 then screenFlash(Theme.glow(w), 0.82, 0.3) end
	end
	if tier >= 7 then shakeAt(x, z, 0.8 * m, 0.45) end
end

H.Spark = function(x, z, r, g, b)
	local col = C3(r, g, b)
	burst(x, 2.4, z, col, 9, 10, 24, 0.55, 0.3, C3(255, 255, 255))
	ringFx(x, 1.0, z, 1, 5.5, col, 0.25, 6)
end

H.Ring = function(x, z, size, r, g, b)
	local col = C3(r, g, b)
	ringFx(x, 0.9, z, size * 0.3, size, col, 0.5, 10)
	local d = fxDisc(size * 0.7, x, 1.0, z, col, 0.6, NEON, 0.15)
	tw(d, 0.35, { Size = Vector3.new(0.1, size, size), Transparency = 1 })
	Debris:AddItem(d, 0.45)
end

H.Ember = function(x, z, r)
	burst(x + (math.random() - 0.5) * r, 2.4, z + (math.random() - 0.5) * r, C3(255, 170, 60), 3, 5, 12, 0.7, 0.55, C3(255, 60, 20))
end

-- ============================================================ SWORDSMAN
-- Q: Crimson Charge
H.SwCharge = function(px, pz, dx, dz, dist, dur)
	local a = Vector3.new(px, 2.2, pz)
	local b = Vector3.new(px + dx * dist, 2.2, pz + dz * dist)
	local red, hot = C3(235, 54, 64), C3(255, 170, 150)
	ringFx(px, 0.8, pz, 2, 10, red, 0.35, 8)
	burst(px, 1.2, pz, C3(210, 190, 170), 14, 8, 20, 1.6, 0.5, C3(120, 110, 100), -dx, -dz, 60)
	-- speed streak on the ground
	local st = segment(a + Vector3.new(0, -1.2, 0), b + Vector3.new(0, -1.2, 0), 3.2, 0.1, red, 0.45)
	tw(st, 0.5, { Transparency = 1, Size = Vector3.new(0.2, 0.1, st.Size.Z) })
	Debris:AddItem(st, 0.6)
	local st2 = segment(a + Vector3.new(0, -1.1, 0), b + Vector3.new(0, -1.1, 0), 1.0, 0.12, hot, 0.1)
	tw(st2, 0.35, { Transparency = 1, Size = Vector3.new(0.1, 0.12, st2.Size.Z) })
	Debris:AddItem(st2, 0.45)
	-- red afterimages of the hero
	for i = 1, 8 do
		local f = i / 8
		local pos = a:Lerp(b, f)
		task.delay(f * dur, function()
			local g = fxDisc(3.6, pos.X, 2.0, pos.Z, red, 0.35, NEON, 0.2)
			tw(g, 0.4, { Size = Vector3.new(0.1, 6, 6), Transparency = 1 })
			Debris:AddItem(g, 0.5)
			ringFx(pos.X, 1.0, pos.Z, 2, 7, hot, 0.3, 5)
			burst(pos.X, 2.2, pos.Z, hot, 3, 4, 12, 0.5, 0.3, red)
		end)
	end
	-- glowing comet that races along the path
	local comet = fxPart(B, Vector3.new(2.2, 0.4, 2.2), CFrame.lookAt(a, b), hot, NEON, 0.1)
	addTrail(comet, hot, red, 3.2, 0.3, 0)
	addEmbers(comet, hot, red, 60, 0.8, 0.4, 8)
	animate(dur, function(al)
		comet.CFrame = CFrame.lookAt(a:Lerp(b, al), b)
	end, function()
		comet:Destroy()
		ringFx(b.X, 0.8, b.Z, 3, 16, red, 0.4, 9)
		shakeAt(b.X, b.Z, 0.9, 0.3)
	end)
end

-- E: Blade Whirlwind (follows the hero)
H.SwSpin = function(uid, dur, radius)
	local bladeCol, coreCol = C3(215, 70, 76), C3(255, 236, 232)
	local parts = {}
	local ARMS, GHOSTS = 3, 4
	for k = 1, ARMS do
		for g = 0, GHOSTS - 1 do
			local tr = 0.2 + g * 0.2
			local o = fxPart(B, Vector3.new(1.6 - g * 0.25, 0.25, radius * 0.72), CFrame.new(), bladeCol, NEON, tr + 0.1)
			local c = fxPart(B, Vector3.new(0.5, 0.3, radius * 0.7), CFrame.new(), coreCol, NEON, tr)
			table.insert(parts, { o = o, c = c, arm = k, ghost = g })
		end
	end
	local glow = fxDisc(radius * 2, 0, 0.5, 0, C3(255, 90, 90), 0.88, NEON, 0.1)
	local lastPulse = 0
	local lastPos = heroPos(uid)
	animate(dur, function(al, t)
		local pos = heroPos(uid) or lastPos
		if not pos then return end
		lastPos = pos
		local fade = al > 0.85 and (1 - (al - 0.85) / 0.15) or 1
		local spinA = t * 24
		for _, e in ipairs(parts) do
			local ang = -(spinA - e.ghost * 0.4) + e.arm * (math.pi * 2 / ARMS)
			local cf = CFrame.new(pos.X, 2.4, pos.Z) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -(radius * 0.4 + radius * 0.36))
			e.o.CFrame = cf
			e.c.CFrame = cf * CFrame.new(0, 0.05, 0)
			local tr = 0.2 + e.ghost * 0.2
			e.o.Transparency = math.min(1, (tr + 0.1) + (1 - fade) * 0.9)
			e.c.Transparency = math.min(1, tr + (1 - fade) * 0.9)
		end
		glow.CFrame = CFrame.new(pos.X, 0.5, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
		glow.Transparency = 0.88 + (1 - fade) * 0.12
		if t - lastPulse > 0.3 then
			lastPulse = t
			ringFx(pos.X, 0.8, pos.Z, radius * 0.6, radius * 2.1, bladeCol, 0.4, 7)
			burst(pos.X, 2.2, pos.Z, coreCol, 8, 16, 34, 0.6, 0.35, bladeCol)
			shake(0.35, 0.15)
		end
	end, function()
		for _, e in ipairs(parts) do
			e.o:Destroy()
			e.c:Destroy()
		end
		glow:Destroy()
		if lastPos then
			ringFx(lastPos.X, 0.8, lastPos.Z, radius, radius * 2.6, coreCol, 0.5, 9)
		end
	end)
end

-- Z: Heaven's Verdict
H.SwUlt = function(tx, tz, R, fall)
	local gold, white = C3(255, 205, 90), C3(255, 248, 225)
	-- telegraph
	local base = fxDisc(R * 2, tx, 0.3, tz, gold, 0.85, NEON, 0.05)
	local fill = fxDisc(0.5, tx, 0.35, tz, C3(255, 226, 150), 0.6, NEON, 0.05)
	tw(fill, fall, { Size = Vector3.new(0.05, R * 2, R * 2) }, Enum.EasingStyle.Linear)
	ringFx(tx, 0.4, tz, R * 2, R * 2, gold, fall, 10, 0.05, 0.25)
	ringFx(tx, 0.45, tz, R * 1.2, R * 1.2, white, fall, 5, 0.2, 0.4)
	-- rune spokes
	local spokes = {}
	for i = 1, 8 do
		local ang = i * math.pi / 4
		local s = fxPart(B, Vector3.new(0.5, 0.05, R * 0.9), CFrame.new(tx, 0.42, tz) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -R * 0.5), gold, NEON, 0.55)
		table.insert(spokes, s)
	end
	-- light beam from the sky grows as the sword approaches
	local beam = fxPart(B, Vector3.new(0.6, 140, 0.6), CFrame.new(tx, 70, tz), white, NEON, 0.55)
	tw(beam, fall, { Size = Vector3.new(R * 0.35, 140, R * 0.35), Transparency = 0.3 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	-- the sword (tip points along -Z, origin at the hilt)
	local dir = Vector3.new(-0.32, -1, 0.42).Unit
	local L = 26
	local endPos = Vector3.new(tx, 0, tz) - dir * L
	local startPos = endPos - dir * 95
	local sw = {}
	local function sp(shape, size, off, color, mat, tr)
		local p = fxPart(shape, size, CFrame.new(), color, mat, tr)
		table.insert(sw, { p = p, off = off })
		return p
	end
	local blade = sp(B, Vector3.new(4.4, 0.9, 20), CFrame.new(0, 0, -14), C3(214, 224, 240), Enum.Material.Metal, 0)
	sp(B, Vector3.new(0.9, 1.05, 19), CFrame.new(0, 0, -14), white, NEON, 0)
	sp(B, Vector3.new(0.5, 1.0, 20), CFrame.new(2.2, 0, -14), gold, NEON, 0)
	sp(B, Vector3.new(0.5, 1.0, 20), CFrame.new(-2.2, 0, -14), gold, NEON, 0)
	sp(B, Vector3.new(3.1, 0.9, 3.1), CFrame.new(0, 0, -24) * CFrame.Angles(0, math.pi / 4, 0), C3(214, 224, 240), Enum.Material.Metal, 0)
	sp(B, Vector3.new(1.3, 1.05, 1.3), CFrame.new(0, 0, -24.3) * CFrame.Angles(0, math.pi / 4, 0), white, NEON, 0)
	sp(B, Vector3.new(12, 1.5, 1.8), CFrame.new(0, 0, -4), C3(228, 178, 70), Enum.Material.Metal, 0)
	sp(B, Vector3.new(12.4, 0.6, 0.8), CFrame.new(0, 0.5, -4), gold, NEON, 0.1)
	sp(B, Vector3.new(1.4, 1.3, 5.5), CFrame.new(0, 0, 0.8), C3(86, 56, 40), Enum.Material.Fabric, 0)
	sp(BALL, Vector3.new(2.4, 2.4, 2.4), CFrame.new(0, 0, 4), gold, NEON, 0)
	sp(BALL, Vector3.new(14, 14, 14), CFrame.new(0, 0, -12), white, NEON, 0.88)
	local tipPart = fxPart(B, Vector3.new(1, 0.4, 1), CFrame.new(), white, NEON, 1)
	addTrail(tipPart, white, gold, 5.4, 0.45, 0)
	local light = Instance.new("PointLight")
	light.Color = Theme.tint(gold)
	light.Range = 45
	light.Brightness = 3
	light.Parent = blade
	addEmbers(blade, white, gold, 70, 1.2, 0.7, 14)
	local function place(pos)
		local cf = CFrame.lookAt(pos, pos + dir)
		for _, e in ipairs(sw) do e.p.CFrame = cf * e.off end
		tipPart.CFrame = cf * CFrame.new(0, 0, -23.5)
	end
	place(startPos)

	animate(fall, function(al)
		local a = al ^ 2.6
		place(startPos:Lerp(endPos, a))
	end, function()
		place(endPos)
		tipPart:Destroy()
		-- IMPACT
		base:Destroy()
		fill:Destroy()
		beam:Destroy()
		for _, s in ipairs(spokes) do s:Destroy() end
		shakeAt(tx, tz, 3.2, 0.8, 120)
		screenFlash(white, 0.35, 0.5)
		local fl = fxDisc(R * 1.6, tx, 2.5, tz, white, 0.0, NEON, 0.3)
		tw(fl, 0.3, { Size = Vector3.new(0.3, R * 2.6, R * 2.6), Transparency = 1 })
		Debris:AddItem(fl, 0.4)
		local dsc = fxDisc(R * 1.2, tx, 1.2, tz, gold, 0.15, NEON, 0.3)
		tw(dsc, 0.6, { Size = Vector3.new(0.3, R * 2.2, R * 2.2), Transparency = 1 })
		Debris:AddItem(dsc, 0.7)
		for i = 0, 3 do
			task.delay(i * 0.07, function()
				ringFx(tx, 0.6 + i * 0.05, tz, R * 0.4, R * (1.7 + i * 0.35), i % 2 == 0 and gold or white, 0.55 + i * 0.08, 12 - i * 2)
			end)
		end
		pillar(tx, tz, R * 0.9, 120, white, 0.55, 0.15)
		pillar(tx, tz, R * 0.5, 120, gold, 0.8, 0.2)
		burst(tx, 2.5, tz, white, 50, 18, 56, 1.4, 0.9, gold)
		burst(tx, 1.2, tz, C3(150, 140, 120), 20, 8, 24, 3.0, 1.1, C3(70, 66, 60))
		-- cracks in the ground
		for i = 1, 14 do
			local ang = i * (math.pi * 2 / 14) + math.random() * 0.2
			local ln = R * (0.55 + math.random() * 0.5)
			local c = fxPart(B, Vector3.new(0.7, 0.08, ln), CFrame.new(tx, 0.5, tz) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -ln / 2), gold, NEON, 0.05)
			tw(c, 1.3, { Transparency = 1, Size = Vector3.new(0.1, 0.08, ln) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(c, 1.4)
		end
		local scorch = fxDisc(R * 1.8, tx, 0.28, tz, C3(40, 30, 20), 0.35, Enum.Material.SmoothPlastic, 0.1)
		tw(scorch, 3, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(scorch, 3.1)
		-- flying stone chunks
		for i = 1, 10 do
			local ang = i * math.pi / 5 + math.random() * 0.4
			local ch = fxDisc(1.1 + math.random(), tx, 1.5, tz, C3(120, 118, 124), 0, Enum.Material.Slate, 0.8)
			tw(ch, 0.6, { Position = Vector3.new(tx + math.cos(ang) * R * 1.1, 1.5, tz + math.sin(ang) * R * 1.1), Transparency = 1 })
			Debris:AddItem(ch, 0.7)
		end
		-- aftershock + sword shatters
		task.delay(0.65, function()
			shakeAt(tx, tz, 1.8, 0.5, 120)
			ringFx(tx, 0.6, tz, R * 0.5, R * 2.7, gold, 0.6, 14)
			ringFx(tx, 0.7, tz, R * 0.3, R * 2.0, white, 0.45, 8)
			burst(tx, 2.5, tz, gold, 36, 20, 50, 1.2, 0.7, white)
			local a2 = fxDisc(R * 1.5, tx, 1.0, tz, gold, 0.5, NEON, 0.2)
			tw(a2, 0.5, { Size = Vector3.new(0.2, R * 2.7, R * 2.7), Transparency = 1 })
			Debris:AddItem(a2, 0.6)
			for _, e in ipairs(sw) do
				tw(e.p, 0.4, { Transparency = 1 })
				Debris:AddItem(e.p, 0.5)
			end
			burst(endPos.X + dir.X * 12, 3, endPos.Z + dir.Z * 12, white, 30, 10, 30, 1.2, 0.7, gold)
		end)
	end)
end

-- ============================================================ ARCHER
-- Q: Arrow Fan
H.Fan = function(px, pz, dx, dz, spread)
	local col, core = C3(120, 235, 120), C3(240, 255, 232)
	for i = 1, 9 do
		local a = (i - 1) / 8 - 0.5
		local ang = a * spread
		local c, s = math.cos(ang), math.sin(ang)
		local ddx, ddz = dx * c - dz * s, dx * s + dz * c
		local p0 = Vector3.new(px + ddx * 3, 2.2, pz + ddz * 3)
		local p1 = Vector3.new(px + ddx * 20, 2.2, pz + ddz * 20)
		local l = segment(p0, p1, 0.5, 0.2, col, 0.25)
		tw(l, 0.3, { Transparency = 1, Size = Vector3.new(0.05, 0.1, l.Size.Z) })
		Debris:AddItem(l, 0.4)
	end
	burst(px + dx * 2.6, 2.2, pz + dz * 2.6, core, 16, 14, 34, 0.55, 0.3, col, dx, dz, 60)
	local fl = fxDisc(4.5, px + dx * 2.5, 2.0, pz + dz * 2.5, col, 0.4, NEON, 0.1)
	tw(fl, 0.2, { Size = Vector3.new(0.1, 8, 8), Transparency = 1 })
	Debris:AddItem(fl, 0.3)
	ringFx(px, 0.8, pz, 3, 9, col, 0.3, 6)
end

-- E: Frost Trap (rune appears, then bursts)
H.TrapSet = function(x, z, R, delay)
	local ice, white = C3(120, 210, 255), C3(235, 250, 255)
	local base = fxDisc(R * 2, x, 0.3, z, ice, 0.88, NEON, 0.05)
	ringFx(x, 0.4, z, R * 2, R * 2, ice, delay, 8, 0.05, 0.3)
	ringFx(x, 0.42, z, R * 1.3, R * 1.3, white, delay, 4, 0.2, 0.5)
	local runes = {}
	for i = 1, 10 do
		table.insert(runes, { p = fxPart(B, Vector3.new(0.8, 0.06, 2.4), CFrame.new(), white, NEON, 0.1), ang = i * math.pi * 2 / 10, rad = R * 0.82, spin = 1 })
	end
	for i = 1, 6 do
		table.insert(runes, { p = fxPart(B, Vector3.new(0.6, 0.06, 1.8), CFrame.new(), ice, NEON, 0.15), ang = i * math.pi * 2 / 6, rad = R * 0.5, spin = -1.6 })
	end
	local arms = {}
	for _ = 0, 2 do
		table.insert(arms, fxPart(B, Vector3.new(0.5, 0.06, R * 0.9), CFrame.new(), white, NEON, 0.1))
	end
	animate(delay, function(al, t)
		local grow = math.min(1, al * 5)
		for _, r in ipairs(runes) do
			local a = r.ang + t * 2.2 * r.spin
			r.p.CFrame = CFrame.new(x, 0.45, z) * CFrame.Angles(0, -a, 0) * CFrame.new(0, 0, -r.rad * grow)
		end
		for i, p in ipairs(arms) do
			p.CFrame = CFrame.new(x, 0.46, z) * CFrame.Angles(0, (i - 1) * math.pi / 3 - t * 1.5, 0)
			p.Size = Vector3.new(0.5, 0.06, R * 0.9 * grow)
		end
	end, function()
		base:Destroy()
		for _, r in ipairs(runes) do r.p:Destroy() end
		for _, p in ipairs(arms) do p:Destroy() end
	end)
end

H.Freeze = function(x, z, R, dur)
	local ice, white = C3(130, 214, 255), C3(240, 252, 255)
	shakeAt(x, z, 1.0, 0.35)
	screenFlash(C3(200, 235, 255), 0.82, 0.3)
	local fl = fxDisc(R * 1.6, x, 2, z, white, 0.05, NEON, 0.3)
	tw(fl, 0.35, { Size = Vector3.new(0.2, R * 2.4, R * 2.4), Transparency = 1 })
	Debris:AddItem(fl, 0.45)
	ringFx(x, 0.6, z, R * 0.5, R * 2.3, ice, 0.5, 12)
	ringFx(x, 0.7, z, R * 0.3, R * 1.6, white, 0.35, 7)
	burst(x, 2, z, white, 46, 12, 36, 1.0, 1.0, ice)
	-- ground frost
	local field = fxDisc(R * 2, x, 0.32, z, ice, 0.7, NEON, 0.08)
	local mist = fxPart(B, Vector3.new(R * 1.8, 0.3, R * 1.8), CFrame.new(x, 0.8, z), white, Enum.Material.SmoothPlastic, 1)
	local em = Instance.new("ParticleEmitter")
	em.Rate = 26
	em.Color = ColorSequence.new(Theme.tint(white), Theme.tint(ice))
	em.LightEmission = 0.8
	em.LightInfluence = 0
	em.Lifetime = NumberRange.new(1.2, 2)
	em.Speed = NumberRange.new(0.5, 2)
	em.SpreadAngle = Vector2.new(180, 180)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(0.5, 2.2), NumberSequenceKeypoint.new(1, 0) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	pcall(function() em.Shape = Enum.ParticleEmitterShape.Box end)
	em.Parent = mist
	-- ice crystals burst out of the ground
	local crystals = {}
	for _ = 1, 26 do
		local ang = math.random() * math.pi * 2
		local rad = math.sqrt(math.random()) * R * 0.95
		local cx, cz = x + math.cos(ang) * rad, z + math.sin(ang) * rad
		local h = 3.5 + math.random() * 5.5
		local w = 0.9 + math.random() * 0.8
		local tilt = CFrame.Angles((math.random() - 0.5) * 0.7, math.random() * math.pi, (math.random() - 0.5) * 0.7)
		local cr = fxPart(B, Vector3.new(w, 0.1, w), CFrame.new(cx, 0.1, cz) * tilt, ice, Enum.Material.Ice, 0.1)
		local core = fxPart(B, Vector3.new(w * 0.4, 0.1, w * 0.4), CFrame.new(cx, 0.1, cz) * tilt, white, NEON, 0.2)
		table.insert(crystals, { cr, core })
		task.delay(math.random() * 0.12, function()
			tw(cr, 0.2, { Size = Vector3.new(w, h, w), CFrame = CFrame.new(cx, h / 2, cz) * tilt }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tw(core, 0.2, { Size = Vector3.new(w * 0.4, h * 0.95, w * 0.4), CFrame = CFrame.new(cx, h / 2, cz) * tilt }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end)
	end
	local life = 3.4
	task.delay(life, function()
		for _, c in ipairs(crystals) do
			tw(c[1], 0.5, { Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1) })
			tw(c[2], 0.5, { Transparency = 1 })
			Debris:AddItem(c[1], 0.6)
			Debris:AddItem(c[2], 0.6)
		end
		tw(field, 0.6, { Transparency = 1 })
		em.Enabled = false
		Debris:AddItem(field, 0.7)
		Debris:AddItem(mist, 2.2)
	end)
end

-- Z: Sunpiercer - charge
H.BeamCharge = function(uid, dx, dz, charge, len)
	local gold, white = C3(255, 214, 96), C3(255, 250, 225)
	local pos0 = heroPos(uid)
	if not pos0 then return end
	local ox, oz = pos0.X, pos0.Z
	local mid = Vector3.new(ox + dx * len / 2, 0.35, oz + dz * len / 2)
	local look = Vector3.new(ox + dx * len, 0.35, oz + dz * len)
	local tele = fxPart(B, Vector3.new(0.4, 0.05, len), CFrame.lookAt(mid, look), gold, NEON, 0.7)
	tw(tele, charge, { Size = Vector3.new(8.4, 0.05, len), Transparency = 0.82 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local edge1 = fxPart(B, Vector3.new(0.4, 0.06, len), CFrame.lookAt(mid, look) * CFrame.new(4.2, 0, 0), gold, NEON, 0.4)
	local edge2 = fxPart(B, Vector3.new(0.4, 0.06, len), CFrame.lookAt(mid, look) * CFrame.new(-4.2, 0, 0), gold, NEON, 0.4)
	local orb = fxPart(BALL, Vector3.new(0.5, 0.5, 0.5), CFrame.new(ox, 3, oz), white, NEON, 0)
	local halo = fxPart(BALL, Vector3.new(1, 1, 1), CFrame.new(ox, 3, oz), gold, NEON, 0.6)
	local light = Instance.new("PointLight")
	light.Color = Theme.tint(gold)
	light.Range = 30
	light.Brightness = 2
	light.Parent = orb
	local nextRing = 0
	animate(charge, function(al, t)
		local p = heroPos(uid)
		if p then
			local c = CFrame.new(p.X + dx * 2.5, 3, p.Z + dz * 2.5)
			local s = 0.8 + al * 5.5 + math.sin(t * 40) * 0.25
			orb.Size = Vector3.new(s, s, s)
			orb.CFrame = c
			halo.Size = Vector3.new(s * 2, s * 2, s * 2)
			halo.CFrame = c
			light.Brightness = 2 + al * 4
			if t >= nextRing then
				nextRing = t + 0.14
				ringFx(p.X, 0.8, p.Z, 18, 2, gold, 0.28, 6, 0.6, 0.0)
				burst(p.X + dx * 2.5, 3, p.Z + dz * 2.5, white, 3, 6, 14, 0.5, 0.3, gold)
			end
		end
		edge1.Transparency = 0.4 + 0.3 * math.sin(t * 30)
		edge2.Transparency = edge1.Transparency
	end, function()
		tele:Destroy()
		edge1:Destroy()
		edge2:Destroy()
		orb:Destroy()
		halo:Destroy()
	end)
end

H.Beam = function(ox, oz, dx, dz, len, width, dur)
	local gold, white = C3(255, 205, 80), C3(255, 252, 235)
	local start = Vector3.new(ox + dx * 2.5, 2.4, oz + dz * 2.5)
	local fin = Vector3.new(ox + dx * len, 2.4, oz + dz * len)
	local layers = {
		segment(start, fin, width * 2.4, 1.4, C3(255, 160, 50), 0.5),
		segment(start, fin, width * 1.5, 1.8, gold, 0.2),
		segment(start, fin, width * 0.75, 2.2, white, 0),
	}
	local widths = { width * 2.4, width * 1.5, width * 0.75 }
	local baseTr = { 0.5, 0.2, 0 }
	local lenZ = layers[1].Size.Z
	shake(2.4, 0.9)
	screenFlash(C3(255, 240, 200), 0.5, 0.5)
	-- sparks along the beam
	for i = 1, 16 do
		local f = i / 16
		local px, pz = ox + dx * len * f, oz + dz * len * f
		task.delay(f * 0.12, function()
			burst(px, 2.4, pz, white, 8, 10, 36, 0.9, 0.55, gold, -dz, dx, 90)
			burst(px, 2.4, pz, gold, 6, 10, 30, 0.8, 0.5, white, dz, -dx, 90)
		end)
	end
	-- flare at the bow + ring at the end
	local fl = fxDisc(7, ox + dx * 2.5, 2.4, oz + dz * 2.5, white, 0.05, NEON, 0.3)
	tw(fl, 0.5, { Size = Vector3.new(0.3, 15, 15), Transparency = 1 })
	Debris:AddItem(fl, 0.6)
	ringFx(ox, 0.8, oz, 4, 22, gold, 0.5, 10)
	ringFx(ox + dx * len, 0.8, oz + dz * len, 4, 26, white, 0.55, 10)
	-- burn mark on the ground
	local lowS = start - Vector3.new(0, 2.05, 0)
	local lowF = fin - Vector3.new(0, 2.05, 0)
	local scorch = fxPart(B, Vector3.new(width * 1.9, 0.06, lenZ), CFrame.lookAt((lowS + lowF) / 2, lowF), C3(40, 28, 16), Enum.Material.SmoothPlastic, 0.3)
	tw(scorch, 2.4, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(scorch, 2.5)
	animate(dur, function(al, t)
		local pulse = 1 + 0.07 * math.sin(t * 70)
		local shrink = al < 0.6 and 1 or (1 - (al - 0.6) / 0.4)
		for i, l in ipairs(layers) do
			l.Size = Vector3.new(math.max(0.05, widths[i] * pulse * shrink), l.Size.Y, lenZ)
			l.Transparency = baseTr[i] + (1 - shrink) * (1 - baseTr[i])
		end
	end, function()
		for _, l in ipairs(layers) do l:Destroy() end
	end)
end

-- ============================================================ MAGE
-- Q: Chain Lightning. args: x1, z1, x2, z2, ...
H.Chain = function(...)
	local a = { ... }
	local pts = {}
	for i = 1, #a - 1, 2 do table.insert(pts, { a[i], a[i + 1] }) end
	local blue, core = C3(120, 190, 255), C3(245, 250, 255)
	local function bolt(ax, az, bx, bz, w)
		local p0, p1 = Vector3.new(ax, 2.4, az), Vector3.new(bx, 2.4, bz)
		local d = p1 - p0
		local len = d.Magnitude
		if len < 0.5 then return end
		local u = d.Unit
		local perp = Vector3.new(-u.Z, 0, u.X)
		local n = math.clamp(math.floor(len / 3.2), 3, 9)
		local list = { p0 }
		for i = 1, n - 1 do
			local mid = p0 + d * (i / n)
			table.insert(list, mid + perp * (math.random() * 2 - 1) * math.min(2.4, len * 0.15))
		end
		table.insert(list, p1)
		for i = 1, #list - 1 do
			local o = segment(list[i], list[i + 1], w, 0.5, blue, 0.1)
			local c = segment(list[i], list[i + 1], w * 0.4, 0.6, core, 0)
			o.Size = o.Size + Vector3.new(0, 0, w * 0.6)
			c.Size = c.Size + Vector3.new(0, 0, w * 0.6)
			tw(o, 0.22, { Transparency = 1, Size = Vector3.new(0.05, 0.5, o.Size.Z) })
			tw(c, 0.16, { Transparency = 1, Size = Vector3.new(0.05, 0.6, c.Size.Z) })
			Debris:AddItem(o, 0.3)
			Debris:AddItem(c, 0.3)
		end
	end
	for i = 2, #pts do
		local p0, p1 = pts[i - 1], pts[i]
		task.delay((i - 2) * 0.07, function()
			local w = i == 2 and 1.2 or 0.9
			bolt(p0[1], p0[2], p1[1], p1[2], w)
			task.delay(0.05, function() bolt(p0[1], p0[2], p1[1], p1[2], w * 0.7) end)
			local fl = fxDisc(3.5, p1[1], 2.4, p1[2], core, 0.1, NEON, 0.2)
			tw(fl, 0.25, { Size = Vector3.new(0.1, 8, 8), Transparency = 1 })
			Debris:AddItem(fl, 0.3)
			ringFx(p1[1], 1.0, p1[2], 2, 9, blue, 0.3, 6)
			burst(p1[1], 2.4, p1[2], core, 12, 14, 34, 0.55, 0.35, blue)
			shakeAt(p1[1], p1[2], 0.35, 0.12)
		end)
	end
	local s = pts[1]
	burst(s[1], 2.4, s[2], core, 8, 8, 20, 0.5, 0.25, blue)
end

-- E: Arcane Blink
H.Blink = function(x0, z0, x1, z1)
	local purple, magenta, white = C3(160, 96, 255), C3(220, 120, 255), C3(250, 240, 255)
	shake(0.9, 0.3)
	-- origin: implosion
	ringFx(x0, 0.7, z0, 22, 2, purple, 0.3, 9, 0.0, 0.0)
	ringFx(x0, 0.8, z0, 14, 20, magenta, 0.4, 8)
	local d0 = fxDisc(8, x0, 2.2, z0, magenta, 0.2, NEON, 0.3)
	tw(d0, 0.3, { Size = Vector3.new(0.1, 22, 22), Transparency = 1 })
	Debris:AddItem(d0, 0.4)
	burst(x0, 2.4, z0, white, 34, 16, 44, 0.9, 0.7, purple)
	pillar(x0, z0, 3.5, 40, purple, 0.45, 0.3)
	-- travel streak
	local a, b = Vector3.new(x0, 2.4, z0), Vector3.new(x1, 2.4, z1)
	local st = segment(a, b, 2.6, 0.3, purple, 0.35)
	tw(st, 0.4, { Transparency = 1, Size = Vector3.new(0.1, 0.3, st.Size.Z) })
	Debris:AddItem(st, 0.5)
	local st2 = segment(a, b, 0.9, 0.35, white, 0.05)
	tw(st2, 0.3, { Transparency = 1, Size = Vector3.new(0.05, 0.35, st2.Size.Z) })
	Debris:AddItem(st2, 0.4)
	for i = 1, 6 do
		local f = i / 7
		local p = a:Lerp(b, f)
		task.delay(f * 0.15, function()
			ringFx(p.X, 1.0, p.Z, 2, 7, magenta, 0.3, 5)
			burst(p.X, 2.4, p.Z, magenta, 4, 6, 14, 0.5, 0.35, white)
		end)
	end
	-- destination: arcane bloom
	task.delay(0.1, function()
		shakeAt(x1, z1, 1.0, 0.3)
		ringFx(x1, 0.7, z1, 3, 22, white, 0.5, 9)
		ringFx(x1, 0.8, z1, 2, 17, magenta, 0.4, 7)
		local d1 = fxDisc(6, x1, 2.2, z1, white, 0.1, NEON, 0.3)
		tw(d1, 0.35, { Size = Vector3.new(0.1, 21, 21), Transparency = 1 })
		Debris:AddItem(d1, 0.45)
		burst(x1, 2.4, z1, white, 40, 18, 48, 1.0, 0.8, magenta)
		pillar(x1, z1, 4, 50, magenta, 0.5, 0.25)
		for i = 1, 6 do
			local ang = i * math.pi / 3
			local g = fxPart(B, Vector3.new(0.7, 0.06, 5), CFrame.new(x1, 0.5, z1) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -5), purple, NEON, 0.1)
			tw(g, 0.6, { Transparency = 1, CFrame = CFrame.new(x1, 0.5, z1) * CFrame.Angles(0, ang + 1.2, 0) * CFrame.new(0, 0, -11) })
			Debris:AddItem(g, 0.7)
		end
	end)
end

-- Z: Meteor Storm (one call per meteor)
H.Meteor = function(tx, tz, fall, R)
	local orange, red, yellow = C3(255, 130, 40), C3(220, 50, 20), C3(255, 236, 160)
	-- telegraph
	local base = fxDisc(R * 2, tx, 0.3, tz, orange, 0.86, NEON, 0.05)
	local fill = fxDisc(0.5, tx, 0.35, tz, red, 0.55, NEON, 0.05)
	tw(fill, fall, { Size = Vector3.new(0.05, R * 2, R * 2) }, Enum.EasingStyle.Linear)
	ringFx(tx, 0.4, tz, R * 2, R * 2, orange, fall, 8, 0.05, 0.25)
	-- the meteor itself
	local dir = Vector3.new(-0.3, -1, 0.38).Unit
	local endPos = Vector3.new(tx, 3.5, tz)
	local startPos = endPos - dir * 100
	local halo = fxPart(BALL, Vector3.new(11, 11, 11), CFrame.new(startPos), red, NEON, 0.78)
	local rock = fxPart(BALL, Vector3.new(6.6, 6.6, 6.6), CFrame.new(startPos), C3(86, 44, 30), Enum.Material.Slate, 0)
	local lava = fxPart(BALL, Vector3.new(7.1, 7.1, 7.1), CFrame.new(startPos), orange, NEON, 0.35)
	local hot = fxPart(BALL, Vector3.new(3.4, 3.4, 3.4), CFrame.new(startPos), yellow, NEON, 0)
	addTrail(halo, C3(255, 190, 80), C3(150, 30, 10), 7, 0.55, 0)
	addTrail(hot, yellow, orange, 3.4, 0.4, 0)
	addEmbers(hot, yellow, red, 70, 1.4, 0.7, 10)
	local pl = Instance.new("PointLight")
	pl.Color = Theme.tint(orange)
	pl.Range = 36
	pl.Brightness = 3
	pl.Parent = lava
	animate(fall, function(al, t)
		local a = al ^ 2.2
		local pos = startPos:Lerp(endPos, a)
		local rotc = CFrame.new(pos) * CFrame.Angles(t * 4, t * 3, 0)
		halo.CFrame = CFrame.new(pos)
		rock.CFrame = rotc
		lava.CFrame = rotc
		hot.CFrame = CFrame.new(pos)
	end, function()
		halo:Destroy()
		rock:Destroy()
		lava:Destroy()
		hot:Destroy()
		base:Destroy()
		fill:Destroy()
		-- impact
		shakeAt(tx, tz, 1.5, 0.45, 90)
		local fl = fxDisc(R * 1.0, tx, 2.4, tz, yellow, 0.0, NEON, 0.3)
		tw(fl, 0.25, { Size = Vector3.new(0.3, R * 2.0, R * 2.0), Transparency = 1 })
		Debris:AddItem(fl, 0.35)
		local fb = fxDisc(R * 0.9, tx, 2.0, tz, orange, 0.15, NEON, 0.3)
		tw(fb, 0.5, { Size = Vector3.new(0.3, R * 2.3, R * 2.3), Transparency = 1 })
		Debris:AddItem(fb, 0.6)
		ringFx(tx, 0.6, tz, R * 0.6, R * 2.5, orange, 0.5, 12)
		ringFx(tx, 0.7, tz, R * 0.3, R * 1.6, yellow, 0.35, 7)
		pillar(tx, tz, R * 0.5, 40, yellow, 0.35, 0.2)
		burst(tx, 2.4, tz, yellow, 40, 18, 48, 1.5, 0.9, red)
		burst(tx, 1.2, tz, C3(80, 56, 46), 14, 6, 18, 3.2, 1.2, C3(36, 28, 24))
		local scorch = fxDisc(R * 1.7, tx, 0.27, tz, C3(34, 20, 12), 0.35, Enum.Material.SmoothPlastic, 0.1)
		tw(scorch, 3.6, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(scorch, 3.7)
		for i = 1, 8 do
			local ang = i * math.pi / 4 + math.random() * 0.4
			local ch = fxDisc(1.2, tx, 1.5, tz, C3(110, 70, 50), 0, Enum.Material.Slate, 0.8)
			tw(ch, 0.55, { Position = Vector3.new(tx + math.cos(ang) * R * 1.05, 1.5, tz + math.sin(ang) * R * 1.05), Transparency = 1 })
			Debris:AddItem(ch, 0.65)
		end
		-- lingering flames
		local fire = fxPart(B, Vector3.new(R * 1.4, 0.2, R * 1.4), CFrame.new(tx, 0.6, tz), orange, Enum.Material.SmoothPlastic, 1)
		local em = addEmbers(fire, yellow, red, 36, 1.3, 0.9, 6)
		pcall(function() em.Shape = Enum.ParticleEmitterShape.Box end)
		task.delay(2.0, function() em.Enabled = false end)
		Debris:AddItem(fire, 3)
	end)
end

ToClient.OnClientEvent:Connect(function(name, ...)
	local f = H[name]
	if f then
		local ok, err = pcall(f, ...)
		if not ok then warn("[abilities] " .. tostring(name) .. ": " .. tostring(err)) end
	end
end)

print("[AbilityClient] ready")
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX13">
<Properties>
<string name="Name">ShopClient</string>
<ProtectedString name="Source"><![CDATA[-- ShopClient: weapon chests (lobby station), opening animation and the inventory (Staffs / Swords / Bows)
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local lp = Players.LocalPlayer
local Net = RS:WaitForChild("Net")
local ToServer = Net:WaitForChild("ToServer")
local ToClient = Net:WaitForChild("ToClient")
local Config = require(RS:WaitForChild("Config"))
local WM = require(RS:WaitForChild("WeaponModels"))
local Theme = require(RS:WaitForChild("Theme"))
WM.startRainbow()
local C3 = Color3.fromRGB

-- ============================================================ UI HELPERS
local GOLD = C3(214, 178, 98)
local INK = C3(12, 14, 20)
local PANEL = C3(21, 24, 33)
local CARD = C3(30, 34, 46)
local LINE = C3(62, 68, 86)
local TXT = C3(232, 235, 242)
local TXT2 = C3(150, 157, 175)

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end
local function stroke(o, color, th, tr) return new("UIStroke", { Color = color or LINE, Thickness = th or 1.5, Transparency = tr or 0 }, o) end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- labels that must cycle through the rainbow (secret rarity)
local rbLabels = {}
RunService.Heartbeat:Connect(function()
	local col = Color3.fromHSV((os.clock() * 0.35) % 1, 0.75, 1)
	for l in pairs(rbLabels) do
		if l.Parent then l.TextColor3 = col else rbLabels[l] = nil end
	end
end)

local function label(parent, text, pos, size, ts, color, align, font)
	return new("TextLabel", {
		Text = text, Position = pos or UDim2.fromScale(0, 0), Size = size or UDim2.fromScale(1, 1), TextSize = ts or 16,
		TextColor3 = color or TXT, BackgroundTransparency = 1, Font = font or Enum.Font.GothamBold,
		TextXAlignment = align or Enum.TextXAlignment.Left, TextWrapped = true, TextStrokeTransparency = 1,
	}, parent)
end

local function rarityColor(w) return Config.Rarities[w.tier].color end
local function paintRarity(l, w)
	if w.rainbow then
		rbLabels[l] = true
	else
		rbLabels[l] = nil
		l.TextColor3 = rarityColor(w)
	end
end

local function button(parent, text, pos, size, color, cb)
	local b = new("TextButton", {
		Text = text, Position = pos, Size = size, BackgroundColor3 = color, TextColor3 = TXT, Font = Enum.Font.GothamBold,
		TextSize = 15, AutoButtonColor = false, BorderSizePixel = 0, TextWrapped = true,
	}, parent)
	corner(b, 6)
	new("UIStroke", { Color = C3(8, 10, 16), Thickness = 1.5, Transparency = 0.25 }, b)
	local sc = new("UIScale", {}, b)
	local base = color
	b.MouseEnter:Connect(function()
		if not b:GetAttribute("Dis") then tween(b, 0.1, { BackgroundColor3 = base:Lerp(C3(255, 255, 255), 0.14) }) end
	end)
	b.MouseLeave:Connect(function()
		tween(b, 0.12, { BackgroundColor3 = base })
		tween(sc, 0.1, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		if not b:GetAttribute("Dis") then tween(sc, 0.06, { Scale = 0.96 }) end
	end)
	b.MouseButton1Up:Connect(function() tween(sc, 0.12, { Scale = 1 }, Enum.EasingStyle.Back) end)
	b.MouseButton1Click:Connect(function()
		if not b:GetAttribute("Dis") and cb then cb() end
	end)
	return b
end
local function setDis(b, dis)
	b:SetAttribute("Dis", dis and true or false)
	b.TextTransparency = dis and 0.45 or 0
	b.BackgroundTransparency = dis and 0.5 or 0
end

local gui = new("ScreenGui", { Name = "ShopUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 12 }, lp:WaitForChild("PlayerGui"))

-- ============================================================ DATA
local data = { inv = {}, equip = {}, coins = 0, upg = {}, opened = 0 }
local onData
local lastInvKey = ""
local function readData()
	local s = lp:GetAttribute("Data")
	if not s then return end
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then
		t.inv = t.inv or {}
		t.equip = t.equip or {}
		t.upg = t.upg or {}
		data = t
		if onData then onData() end
	end
end
local function inRun() return lp:GetAttribute("InRun") == true end

-- ============================================================ WEAPON PREVIEW (ViewportFrame)
local function makePreview(parent, w, dim)
	local vf = new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = C3(200, 200, 210), LightColor = C3(255, 255, 255),
		LightDirection = Vector3.new(-0.3, -1, -0.4), ZIndex = 2,
	}, parent)
	local model = new("Model", {}, vf)
	local root = new("Part", { Size = Vector3.new(1, 1, 1), Anchored = true, CanCollide = false, Transparency = 1, CFrame = CFrame.new() }, model)
	model.PrimaryPart = root
	local ok = pcall(function()
		WM.build(w.type, w, root, model, CFrame.new(), 1, { anchored = true })
	end)
	local cam = new("Camera", {}, vf)
	vf.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local ext = math.max(size.X, size.Z, 4)
	cam.FieldOfView = 24
	local dist = ext * 0.62 / math.tan(math.rad(12))
	local center = cf.Position
	cam.CFrame = CFrame.lookAt(center + Vector3.new(0, dist, 0), center, Vector3.new(0.35, 0, -1))
	if dim then vf.ImageColor3 = C3(0, 0, 0) end
	return vf
end

-- weapon card (used by the chest reveal and by the inventory grid)
local function makeCard(parent, w, opts)
	opts = opts or {}
	local owned = opts.owned ~= false
	local rc = rarityColor(w)
	local card = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = CARD, BorderSizePixel = 0, Size = opts.size or UDim2.fromOffset(150, 214) }, parent)
	corner(card, 10)
	local st = stroke(card, owned and (w.rainbow and C3(255, 255, 255) or rc) or LINE, owned and 2 or 1.2, owned and 0 or 0.3)
	local bar = new("Frame", { Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = owned and rc or LINE, BorderSizePixel = 0, ZIndex = 3 }, card)
	corner(bar, 3)
	if owned and w.rainbow then
		new("UIGradient", { Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C3(255, 80, 80)), ColorSequenceKeypoint.new(0.2, C3(255, 220, 80)), ColorSequenceKeypoint.new(0.4, C3(90, 255, 120)),
			ColorSequenceKeypoint.new(0.6, C3(80, 220, 255)), ColorSequenceKeypoint.new(0.8, C3(170, 100, 255)), ColorSequenceKeypoint.new(1, C3(255, 80, 200)),
		}) }, bar)
	end
	-- soft rarity glow behind the model
	local glow = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(1, -16, 0, (opts.size and 90 or 130)), BackgroundColor3 = owned and rc or C3(40, 44, 58), BackgroundTransparency = owned and 0.82 or 0.4, BorderSizePixel = 0 }, card)
	corner(glow, 8)
	local pv = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(1, -16, 0, (opts.size and 90 or 130)), BackgroundTransparency = 1 }, card)
	makePreview(pv, w, not owned)
	local nameY = opts.size and 104 or 146
	local nm = label(card, owned and w.name or "???", UDim2.fromOffset(6, nameY), UDim2.new(1, -12, 0, 32), opts.size and 12 or 14, owned and TXT or TXT2, Enum.TextXAlignment.Center)
	local rl = label(card, Config.Rarities[w.tier].name, UDim2.fromOffset(6, nameY + (opts.size and 30 or 36)), UDim2.new(1, -12, 0, 16), opts.size and 11 or 13, rc, Enum.TextXAlignment.Center)
	if owned then
		paintRarity(rl, w)
	else
		rl.TextColor3 = TXT2
		rbLabels[rl] = nil
	end
	return card, st, glow
end

-- ============================================================ PANEL FRAME
local function makePanel(title, w, h)
	local f = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -24, 0.5, 0), Size = UDim2.fromOffset(w, h), BackgroundColor3 = PANEL, BorderSizePixel = 0, Visible = false }, gui)
	corner(f, 10)
	stroke(f, LINE, 1.5, 0)
	new("UIScale", {}, f)
	label(f, title, UDim2.fromOffset(16, 10), UDim2.new(1, -32, 0, 34), 24, GOLD, nil, Enum.Font.GothamBlack)
	local sub = label(f, "", UDim2.fromOffset(16, 44), UDim2.new(1, -32, 0, 30), 14, TXT2, nil, Enum.Font.Gotham)
	new("Frame", { Position = UDim2.fromOffset(12, 78), Size = UDim2.new(1, -24, 0, 1), BackgroundColor3 = LINE, BorderSizePixel = 0 }, f)
	local content = new("Frame", { Position = UDim2.fromOffset(12, 86), Size = UDim2.new(1, -24, 1, -96), BackgroundTransparency = 1 }, f)
	return { frame = f, sub = sub, content = content }
end

local function fitScale(frame, w, h)
	local function fit()
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local sc = math.clamp(math.min(vp.X / (w + 360), vp.Y / (h + 40)), 0.45, 1.1)
		local us = frame:FindFirstChildOfClass("UIScale")
		if us then us.Scale = sc end
	end
	fit()
	if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end
end

-- ============================================================ CHEST PANEL
local chestPanel = makePanel("СУНДУКИ С ОРУЖИЕМ", 490, 660)
fitScale(chestPanel.frame, 490, 660)
local selType = "Swordsman"
local lastReq = nil
local revealOpen = false

local function drawChest(parent, color, w, h)
	local g = new("Frame", { Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1 }, parent)
	local dark = color:Lerp(C3(0, 0, 0), 0.5)
	local gold = C3(255, 205, 80)
	local body = new("Frame", { Position = UDim2.fromScale(0.05, 0.42), Size = UDim2.fromScale(0.9, 0.54), BackgroundColor3 = color, BorderSizePixel = 0 }, g)
	corner(body, 8)
	stroke(body, dark, 3)
	local lid = new("Frame", { Position = UDim2.fromScale(0.0, 0.08), Size = UDim2.fromScale(1, 0.38), BackgroundColor3 = color:Lerp(C3(255, 255, 255), 0.12), BorderSizePixel = 0, ZIndex = 2 }, g)
	corner(lid, 12)
	stroke(lid, dark, 3)
	for _, x in ipairs({ 0.16, 0.76 }) do
		local band = new("Frame", { Position = UDim2.fromScale(x, 0.08), Size = UDim2.fromScale(0.09, 0.88), BackgroundColor3 = gold, BorderSizePixel = 0, ZIndex = 3 }, g)
		corner(band, 3)
		stroke(band, C3(150, 100, 20), 1.5)
	end
	local lock = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromScale(0.14, 0.24), BackgroundColor3 = gold, BorderSizePixel = 0, ZIndex = 4 }, g)
	corner(lock, 5)
	stroke(lock, C3(150, 100, 20), 2)
	local gem = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.34, 0.34), BackgroundColor3 = C3(255, 90, 70), BorderSizePixel = 0, ZIndex = 5 }, lock)
	corner(gem, 10)
	return g, lid
end

local function oddsText(chest)
	local total = 0
	for _, o in ipairs(chest.odds) do total = total + o end
	local parts = {}
	for i, o in ipairs(chest.odds) do
		if o > 0 then
			local pct = o / total * 100
			local s = pct >= 1 and string.format("%.0f", pct) or (pct >= 0.1 and string.format("%.1f", pct) or string.format("%.2f", pct))
			local col = i == 7 and C3(255, 120, 220) or Config.Rarities[i].color
			table.insert(parts, string.format('<font color="#%s">%s%%</font>', col:ToHex(), s))
		end
	end
	return table.concat(parts, "  ")
end

local function dupValue()
	local total, n = 0, 0
	for id, cnt in pairs(data.inv) do
		local w = Config.Weapons[id]
		if w and cnt > 1 then
			total = total + (cnt - 1) * Config.Rarities[w.tier].sell
			n = n + cnt - 1
		end
	end
	return total, n
end

local function requestOpen(chestId, typ, amount)
	if revealOpen then return end
	lastReq = { chestId, typ, amount }
	ToServer:FireServer("OpenChest", chestId, typ, amount)
end

local function renderChest()
	for _, c in ipairs(chestPanel.content:GetChildren()) do c:Destroy() end
	chestPanel.sub.Text = "Монет: " .. data.coins .. "   |   Открыто сундуков: " .. (data.opened or 0)
	-- tabs
	local y = 0
	for i, typ in ipairs(Config.TypeOrder) do
		local info = Config.TypeInfo[typ]
		local sel = typ == selType
		local b = button(chestPanel.content, info.icon .. "  " .. info.name, UDim2.new((i - 1) / 3, 2, 0, y), UDim2.new(1 / 3, -4, 0, 38), sel and C3(190, 140, 50) or C3(42, 47, 62), function()
			selType = typ
			renderChest()
		end)
		b.TextSize = 16
	end
	y = y + 46
	local tl = label(chestPanel.content, "Из сундука выпадет: " .. string.lower(Config.TypeInfo[selType].name) .. ". Чем реже предмет - тем мощнее способности!", UDim2.fromOffset(2, y), UDim2.new(1, -4, 0, 30), 12, TXT2, nil, Enum.Font.Gotham)
	y = y + 32
	for _, chest in ipairs(Config.Chests) do
		local row = new("Frame", { Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 104), BackgroundColor3 = CARD, BorderSizePixel = 0 }, chestPanel.content)
		corner(row, 8)
		stroke(row, chest.color:Lerp(C3(0, 0, 0), 0.25), 1.5, 0.1)
		local icon = new("Frame", { Position = UDim2.fromOffset(8, 10), Size = UDim2.fromOffset(78, 56), BackgroundTransparency = 1 }, row)
		drawChest(icon, chest.color, 78, 56)
		label(row, chest.name, UDim2.fromOffset(98, 4), UDim2.new(1, -106, 0, 20), 17, chest.color:Lerp(C3(255, 255, 255), 0.35))
		label(row, chest.desc, UDim2.fromOffset(98, 24), UDim2.new(1, -106, 0, 16), 11, TXT2, nil, Enum.Font.Gotham)
		local odds = label(row, oddsText(chest), UDim2.fromOffset(98, 42), UDim2.new(1, -106, 0, 26), 11, TXT, nil, Enum.Font.GothamBold)
		odds.RichText = true
		for k, amount in ipairs(Config.MultiOpen) do
			local cost = math.floor(chest.price * amount * Config.MultiDiscount[amount])
			local can = data.coins >= cost
			local txt = "x" .. amount .. "  -  " .. cost
			if amount > 1 then txt = txt .. (amount == 10 and "  (-10%)" or "  (-5%)") end
			local b = button(row, txt, UDim2.new((k - 1) / 3, 6, 1, -34), UDim2.new(1 / 3, -8, 0, 28), can and C3(184, 138, 50) or C3(52, 56, 68), function()
				requestOpen(chest.id, selType, amount)
			end)
			b.TextSize = 12
			setDis(b, not can)
		end
		y = y + 110
	end
	local total, n = dupValue()
	local sb = button(chestPanel.content, n > 0 and ("Продать все дубликаты (" .. n .. " шт.)  +" .. total .. " монет") or "Нет дубликатов для продажи", UDim2.fromOffset(0, y + 2), UDim2.new(1, 0, 0, 34), n > 0 and C3(64, 140, 92) or C3(52, 56, 68), function()
		ToServer:FireServer("Sell", "all")
	end)
	sb.TextSize = 14
	setDis(sb, n == 0)
end

-- ============================================================ CHEST OPENING ANIMATION
local rg = new("ScreenGui", { Name = "ChestReveal", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 40 }, lp:WaitForChild("PlayerGui"))
local dim = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(4, 6, 12), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, Visible = false }, rg)
local stage = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, dim)
local revealToken = 0

local function ping(tier)
	local s = Instance.new("Sound")
	s.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	s.Volume = 0.5
	s.PlaybackSpeed = 0.7 + tier * 0.12
	s.Parent = gui
	s:Play()
	game:GetService("Debris"):AddItem(s, 2)
end

local function closeReveal()
	revealToken = revealToken + 1
	revealOpen = false
	tween(dim, 0.2, { BackgroundTransparency = 1 })
	task.delay(0.2, function()
		if not revealOpen then
			dim.Visible = false
			for _, c in ipairs(stage:GetChildren()) do c:Destroy() end
		end
	end)
	if onData then onData() end
end

local function showReveal(chestId, results)
	local chest
	for _, c in ipairs(Config.Chests) do if c.id == chestId then chest = c end end
	if not chest then return end
	revealToken = revealToken + 1
	local tok = revealToken
	revealOpen = true
	for _, c in ipairs(stage:GetChildren()) do c:Destroy() end
	dim.Visible = true
	dim.BackgroundTransparency = 1
	tween(dim, 0.25, { BackgroundTransparency = 0.18 })
	local best = 1
	for _, r in ipairs(results) do
		local w = Config.Weapons[r.id]
		if w and w.tier > best then best = w.tier end
	end
	local bestCol = best == 7 and C3(255, 140, 255) or Config.Rarities[best].color

	-- chest + glow
	local halo = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(120, 120), BackgroundColor3 = bestCol, BackgroundTransparency = 0.9, BorderSizePixel = 0 }, stage)
	corner(halo, 200)
	local holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(260, 190), BackgroundTransparency = 1 }, stage)
	local hs = new("UIScale", { Scale = 0.2 }, holder)
	local chestG, lid = drawChest(holder, chest.color, 260, 190)
	tween(hs, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(halo, 1.1, { Size = UDim2.fromOffset(420, 420), BackgroundTransparency = 0.55 })
	local title = label(stage, results[1] and (#results > 1 and ("Открываем x" .. #results .. "...") or "Открываем...") or "", UDim2.new(0.5, -300, 0.5, 130), UDim2.fromOffset(600, 34), 24, TXT, Enum.TextXAlignment.Center, Enum.Font.GothamBlack)

	task.spawn(function()
		task.wait(0.4)
		-- shake, getting stronger
		for i = 1, 9 do
			if tok ~= revealToken then return end
			local a = (3 + i * 1.3) * (i % 2 == 0 and 1 or -1)
			tween(holder, 0.06, { Rotation = a })
			ping(math.min(best, 3))
			task.wait(0.085)
		end
		if tok ~= revealToken then return end
		tween(holder, 0.1, { Rotation = 0 })
		-- flash + lid pops
		local flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = best >= 5 and bestCol:Lerp(C3(255, 255, 255), 0.6) or C3(255, 255, 255), BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 50 }, stage)
		tween(flash, 0.6, { BackgroundTransparency = 1 })
		tween(lid, 0.25, { Position = UDim2.fromScale(0, -0.5), Rotation = -18 })
		tween(hs, 0.3, { Scale = 1.5 })
		tween(halo, 0.6, { Size = UDim2.fromOffset(900, 900), BackgroundTransparency = 1 })
		task.wait(0.28)
		if tok ~= revealToken then return end
		tween(holder, 0.2, { Position = UDim2.fromScale(0.5, -0.2) })
		title:Destroy()

		-- result cards
		local n = #results
		local cols = math.min(n, 5)
		local rows = math.ceil(n / 5)
		local cw, ch, pad = 150, 214, 10
		local grid = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.46),
			Size = UDim2.fromOffset(cols * (cw + pad), rows * (ch + pad)), BackgroundTransparency = 1,
		}, stage)
		new("UIGridLayout", { CellSize = UDim2.fromOffset(cw, ch), CellPadding = UDim2.fromOffset(pad, pad), FillDirectionMaxCells = 5, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local gs = new("UIScale", { Scale = math.clamp(math.min(vp.X / (cols * (cw + pad) + 80), vp.Y / (rows * (ch + pad) + 190)), 0.4, 1.15) }, grid)
		for i, r in ipairs(results) do
			if tok ~= revealToken then return end
			local w = Config.Weapons[r.id]
			if w then
				local slot = new("Frame", { BackgroundTransparency = 1, LayoutOrder = i }, grid)
				local card, st = makeCard(slot, w, { owned = true })
				card.Size = UDim2.fromScale(1, 1)
				card.Active = false
				local sc = new("UIScale", { Scale = 0 }, card)
				tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				ping(w.tier)
				if r.new then
					local nb = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 10), Size = UDim2.fromOffset(52, 18), BackgroundColor3 = C3(80, 200, 110), BorderSizePixel = 0, ZIndex = 6 }, card)
					corner(nb, 5)
					label(nb, "НОВОЕ!", nil, nil, 11, INK, Enum.TextXAlignment.Center, Enum.Font.GothamBlack).ZIndex = 7
				end
				if w.tier >= 5 then
					st.Thickness = 3
					TweenService:Create(st, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 6 }):Play()
					local f2 = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = w.rainbow and C3(255, 255, 255) or rarityColor(w), BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 8 }, card)
					corner(f2, 10)
					tween(f2, 0.5, { BackgroundTransparency = 1 })
				end
				task.wait(n > 5 and 0.1 or 0.16)
			end
		end
		task.wait(0.2)
		if tok ~= revealToken then return end
		local bw = 190
		local by = 0.5 + (rows * (ch + pad) * gs.Scale) / (2 * vp.Y) + 0.08
		by = math.clamp(by, 0.55, 0.94)
		local b1 = button(stage, "ЗАБРАТЬ", UDim2.new(0.5, -bw - 8, by, 0), UDim2.fromOffset(bw, 46), C3(64, 140, 92), closeReveal)
		b1.TextSize = 19
		b1.Font = Enum.Font.GothamBlack
		local again = button(stage, "ОТКРЫТЬ ЕЩЁ", UDim2.new(0.5, 8, by, 0), UDim2.fromOffset(bw, 46), C3(184, 138, 50), function()
			local rq = lastReq
			closeReveal()
			if rq then
				task.delay(0.25, function() requestOpen(rq[1], rq[2], rq[3]) end)
			end
		end)
		again.TextSize = 19
		again.Font = Enum.Font.GothamBlack
	end)
end

-- ============================================================ INVENTORY
local inv = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(980, 600), BackgroundColor3 = PANEL, BorderSizePixel = 0, Visible = false }, gui)
corner(inv, 12)
stroke(inv, LINE, 2, 0)
local invScale = new("UIScale", {}, inv)
local function fitInv()
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	invScale.Scale = math.clamp(math.min(vp.X / 1020, vp.Y / 640), 0.45, 1.1)
end
fitInv()
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitInv) end
label(inv, "ИНВЕНТАРЬ", UDim2.fromOffset(20, 10), UDim2.fromOffset(300, 36), 28, GOLD, nil, Enum.Font.GothamBlack)
local invSub = label(inv, "", UDim2.fromOffset(20, 44), UDim2.fromOffset(600, 22), 14, TXT2, nil, Enum.Font.Gotham)
local invClose = button(inv, "X", UDim2.new(1, -52, 0, 12), UDim2.fromOffset(38, 34), C3(160, 66, 66), function() inv.Visible = false end)
invClose.TextSize = 18
local sellAll = button(inv, "", UDim2.new(1, -330, 0, 12), UDim2.fromOffset(270, 34), C3(64, 140, 92), function() ToServer:FireServer("Sell", "all") end)
sellAll.TextSize = 13
new("Frame", { Position = UDim2.fromOffset(14, 72), Size = UDim2.new(1, -28, 0, 1), BackgroundColor3 = LINE, BorderSizePixel = 0 }, inv)

local invType = "Swordsman"
local invSel = nil
local tabBtns = {}
for i, typ in ipairs(Config.TypeOrder) do
	local b = button(inv, "", UDim2.fromOffset(14, 84 + (i - 1) * 62), UDim2.fromOffset(150, 54), C3(42, 47, 62), function()
		invType = typ
		invSel = nil
		lastInvKey = ""
		onData()
	end)
	b.TextSize = 15
	tabBtns[typ] = b
end
local scroll = new("ScrollingFrame", {
	Position = UDim2.fromOffset(176, 84), Size = UDim2.fromOffset(510, 500), BackgroundTransparency = 1, BorderSizePixel = 0,
	ScrollBarThickness = 6, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, inv)
new("UIGridLayout", { CellSize = UDim2.fromOffset(112, 160), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }, scroll)
local detail = new("Frame", { Position = UDim2.fromOffset(700, 84), Size = UDim2.fromOffset(268, 500), BackgroundColor3 = CARD, BorderSizePixel = 0 }, inv)
corner(detail, 10)
stroke(detail, LINE, 1.5, 0.2)

local function statLine(parent, text, color, y, size)
	return label(parent, text, UDim2.fromOffset(12, y), UDim2.new(1, -24, 0, 16), size or 13, color or TXT, nil, Enum.Font.Gotham)
end

local function renderDetail()
	for _, c in ipairs(detail:GetChildren()) do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") then c:Destroy() end
	end
	local w = invSel and Config.Weapons[invSel]
	if not w then
		label(detail, "Выбери оружие\nиз списка слева", UDim2.fromOffset(10, 200), UDim2.new(1, -20, 0, 60), 16, TXT2, Enum.TextXAlignment.Center)
		return
	end
	local cnt = data.inv[w.id] or 0
	local owned = cnt > 0
	local r = Config.Rarities[w.tier]
	local pvBox = new("Frame", { Position = UDim2.fromOffset(34, 8), Size = UDim2.fromOffset(200, 190), BackgroundColor3 = w.rainbow and C3(40, 40, 60) or r.color:Lerp(C3(10, 12, 18), 0.82), BorderSizePixel = 0 }, detail)
	corner(pvBox, 10)
	stroke(pvBox, w.rainbow and C3(255, 255, 255) or r.color, 2, 0.2)
	makePreview(pvBox, w, not owned)
	local nm = label(detail, owned and w.name or "???", UDim2.fromOffset(10, 202), UDim2.new(1, -20, 0, 26), 19, TXT, Enum.TextXAlignment.Center, Enum.Font.GothamBlack)
	local rl = label(detail, r.name .. "  -  " .. Config.TypeInfo[w.type].one, UDim2.fromOffset(10, 228), UDim2.new(1, -20, 0, 18), 14, r.color, Enum.TextXAlignment.Center)
	paintRarity(rl, w)
	local ws = Config.weaponStats(w.type, data.upg[w.type], w)
	local y = 252
	statLine(detail, string.format("Урон: %.0f     Скорость: %.2f уд/с", ws.damage, 1 / ws.cooldown), TXT, y)
	y = y + 18
	statLine(detail, string.format("Дальность: %.0f     Крит: %.0f%%", ws.range, ws.crit * 100), TXT, y)
	y = y + 22
	label(detail, "СПОСОБНОСТИ", UDim2.fromOffset(12, y), UDim2.new(1, -24, 0, 16), 12, GOLD)
	y = y + 18
	local cn = r.cnt
	local extra
	if w.type == "Swordsman" then
		extra = string.format("Вихрь: +%d ударов, ульта: +%d волн", cn * 2, math.floor(cn / 2))
	elseif w.type == "Archer" then
		extra = string.format("Веер: +%d стрел, луч: +%d импульсов", cn * 2, cn)
	else
		extra = string.format("Молния: +%d прыжков, метеоры: +%d", cn * 2, cn * 3)
	end
	statLine(detail, string.format("Размер способностей: x%.2f", r.rs), C3(130, 200, 226), y)
	y = y + 17
	statLine(detail, string.format("Урон способностей: x%.2f", r.am), C3(130, 200, 226), y)
	y = y + 17
	statLine(detail, extra, C3(130, 200, 226), y, 12)
	y = y + 17
	statLine(detail, string.format("Перезарядка: -%.0f%%", (1 - r.cdr) * 100), C3(130, 200, 226), y)
	y = y + 19
	local ult = label(detail, "ULT: " .. w.ult, UDim2.fromOffset(12, y), UDim2.new(1, -24, 0, 16), 13, GOLD)
	y = y + 18
	local el = label(detail, Config.ElementInfo[w.elem] or "", UDim2.fromOffset(12, y), UDim2.new(1, -24, 0, 30), 11, TXT2, nil, Enum.Font.Gotham)
	local eq = data.equip[w.type] == w.id and data.class == w.type
	local bY = 500 - 88
	if owned then
		local eb = button(detail, eq and "ЭКИПИРОВАНО" or "ЭКИПИРОВАТЬ", UDim2.fromOffset(12, bY), UDim2.new(1, -24, 0, 36), eq and C3(52, 56, 68) or C3(64, 140, 92), function()
			ToServer:FireServer("Equip", w.id)
		end)
		eb.TextSize = 16
		setDis(eb, eq or inRun())
		local dup = cnt - 1
		local sb = button(detail, dup > 0 and string.format("Продать дубликаты: %d  (+%d)", dup, dup * r.sell) or ("Экземпляров: " .. cnt .. "  (продажа: " .. r.sell .. " за дубликат)"), UDim2.fromOffset(12, bY + 42), UDim2.new(1, -24, 0, 34), dup > 0 and C3(184, 138, 50) or C3(52, 56, 68), function()
			ToServer:FireServer("Sell", w.id)
		end)
		sb.TextSize = 12
		setDis(sb, dup <= 0)
	else
		label(detail, "Ещё не получено. Выбей в сундуках!", UDim2.fromOffset(12, bY + 6), UDim2.new(1, -24, 0, 40), 14, TXT2, Enum.TextXAlignment.Center)
	end
end

local function renderInventory()
	-- header + tabs
	local owned, total = 0, 0
	for _, w in ipairs(Config.WeaponList) do
		total = total + 1
		if (data.inv[w.id] or 0) > 0 then owned = owned + 1 end
	end
	invSub.Text = "Монет: " .. data.coins .. "     Коллекция: " .. owned .. " / " .. total
	local dv, dn = dupValue()
	sellAll.Text = dn > 0 and ("Продать все дубликаты (" .. dn .. ")  +" .. dv) or "Дубликатов нет"
	setDis(sellAll, dn == 0 or inRun())
	for typ, b in pairs(tabBtns) do
		local o, t = 0, 0
		for _, w in ipairs(Config.ByType[typ]) do
			t = t + 1
			if (data.inv[w.id] or 0) > 0 then o = o + 1 end
		end
		b.Text = Config.TypeInfo[typ].icon .. " " .. Config.TypeInfo[typ].name .. "\n" .. o .. " / " .. t
		b.BackgroundColor3 = typ == invType and C3(190, 140, 50) or C3(42, 47, 62)
	end
	-- grid (rebuilt only when the inventory itself changed)
	local key = invType .. HttpService:JSONEncode(data.inv) .. tostring(data.equip[invType]) .. tostring(data.class)
	if key ~= lastInvKey then
		lastInvKey = key
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		local list = {}
		for _, w in ipairs(Config.ByType[invType]) do table.insert(list, w) end
		table.sort(list, function(a, b)
			if a.tier ~= b.tier then return a.tier > b.tier end
			return a.name < b.name
		end)
		for i, w in ipairs(list) do
			local cnt = data.inv[w.id] or 0
			local slot = new("Frame", { BackgroundTransparency = 1, LayoutOrder = i }, scroll)
			local card, st = makeCard(slot, w, { owned = cnt > 0, size = UDim2.fromScale(1, 1) })
			card.Size = UDim2.fromScale(1, 1)
			if invSel == w.id then st.Color = GOLD st.Thickness = 3 end
			if cnt > 1 then
				local cb = new("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 10), Size = UDim2.fromOffset(34, 18), BackgroundColor3 = C3(10, 12, 18), BackgroundTransparency = 0.2, Text = "x" .. cnt, TextColor3 = TXT, Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 6, BorderSizePixel = 0 }, card)
				corner(cb, 5)
			end
			if data.equip[w.type] == w.id and data.class == w.type then
				local eb = new("TextLabel", { Position = UDim2.fromOffset(4, 10), Size = UDim2.fromOffset(22, 18), BackgroundColor3 = C3(80, 200, 110), Text = "✔", TextColor3 = INK, Font = Enum.Font.GothamBlack, TextSize = 13, ZIndex = 6, BorderSizePixel = 0 }, card)
				corner(eb, 5)
			end
			card.MouseButton1Click:Connect(function()
				invSel = w.id
				lastInvKey = ""
				onData()
			end)
		end
	end
	renderDetail()
end

local invBtn
local function openInventory()
	if inRun() then return end
	inv.Visible = not inv.Visible
	if inv.Visible then
		lastInvKey = ""
		renderInventory()
	end
end
invBtn = button(gui, "ИНВЕНТАРЬ  [B]", UDim2.fromOffset(14, 122), UDim2.fromOffset(290, 34), C3(52, 58, 86), openInventory)
invBtn.TextSize = 15
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.B then openInventory() end
end)

-- ============================================================ HOOKS
onData = function()
	if chestPanel.frame.Visible and not revealOpen then renderChest() end
	if inv.Visible then renderInventory() end
end
lp:GetAttributeChangedSignal("Data"):Connect(readData)
lp:GetAttributeChangedSignal("InRun"):Connect(function()
	invBtn.Visible = not inRun()
	if inRun() then
		inv.Visible = false
		chestPanel.frame.Visible = false
	end
end)
invBtn.Visible = not inRun()

local H = {}
H.Zone = function(zid)
	chestPanel.frame.Visible = zid == "chest"
	if zid == "chest" then renderChest() end
end
H.ChestResult = function(chestId, results, cost)
	showReveal(chestId, results)
end
ToClient.OnClientEvent:Connect(function(name, ...)
	local f = H[name]
	if f then
		local ok, err = pcall(f, ...)
		if not ok then warn("[shop] " .. tostring(name) .. ": " .. tostring(err)) end
	end
end)
readData()
print("[ShopClient] ready")
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX14">
<Properties>
<string name="Name">TestAreaClient</string>
<ProtectedString name="Source"><![CDATA[-- ===========================================================================================
-- [TESTAREA]  client side of the weapon test place (portal panel + weapon picker).
-- Delete this LocalScript together with the TestArea module to remove the feature.
-- ===========================================================================================
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local lp = Players.LocalPlayer
local Net = RS:WaitForChild("Net")
local ToServer = Net:WaitForChild("ToServer")
local ToClient = Net:WaitForChild("ToClient")
local Config = require(RS:WaitForChild("Config"))
local C3 = Color3.fromRGB

local GOLD = C3(214, 178, 98)
local INK = C3(12, 14, 20)
local PANEL = C3(21, 24, 33)
local CARD = C3(30, 34, 46)
local LINE = C3(62, 68, 86)
local TXT = C3(232, 235, 242)
local TXT2 = C3(150, 157, 175)
local BLUE = C3(70, 190, 255)

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end
local function stroke(o, color, th, tr) return new("UIStroke", { Color = color or LINE, Thickness = th or 1.5, Transparency = tr or 0 }, o) end
local function label(parent, text, pos, size, ts, color, align, font)
	return new("TextLabel", {
		Text = text, Position = pos or UDim2.fromScale(0, 0), Size = size or UDim2.fromScale(1, 1), TextSize = ts or 16,
		TextColor3 = color or TXT, BackgroundTransparency = 1, Font = font or Enum.Font.GothamBold,
		TextXAlignment = align or Enum.TextXAlignment.Left, TextWrapped = true,
	}, parent)
end
local function button(parent, text, pos, size, color, cb)
	local b = new("TextButton", { Text = text, Position = pos, Size = size, BackgroundColor3 = color, TextColor3 = TXT, Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = false, BorderSizePixel = 0, TextWrapped = true }, parent)
	corner(b, 6)
	new("UIStroke", { Color = C3(8, 10, 16), Thickness = 1.5, Transparency = 0.25 }, b)
	b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = color:Lerp(C3(255, 255, 255), 0.14) }):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color }):Play() end)
	b.MouseButton1Click:Connect(function() if cb then cb() end end)
	return b
end

local gui = new("ScreenGui", { Name = "TestAreaUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 11 }, lp:WaitForChild("PlayerGui"))

-- ============================================================ portal panel (lobby)
local portal = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -24, 0.5, 0), Size = UDim2.fromOffset(400, 330), BackgroundColor3 = PANEL, BorderSizePixel = 0, Visible = false }, gui)
corner(portal, 10)
stroke(portal, BLUE, 2, 0.1)
label(portal, "ТЕСТОВАЯ АРЕНА", UDim2.fromOffset(16, 12), UDim2.new(1, -32, 0, 34), 26, BLUE, nil, Enum.Font.GothamBlack)
label(portal, "Временная зона для проверки всего оружия: посохов, мечей и луков всех редкостей. Манекены не бьют в ответ и не умирают.\n\nОружие из арены не попадает в твой инвентарь - это только тест.", UDim2.fromOffset(16, 52), UDim2.new(1, -32, 0, 170), 14, TXT2, nil, Enum.Font.Gotham)
local enterBtn = button(portal, "ВОЙТИ В ТЕСТОВУЮ АРЕНУ", UDim2.fromOffset(16, 250), UDim2.new(1, -32, 0, 50), C3(40, 130, 200), function()
	ToServer:FireServer("TestEnter")
end)
enterBtn.TextSize = 18
enterBtn.Font = Enum.Font.GothamBlack

-- ============================================================ weapon picker (inside the arena)
local W, H = 300, 560
local panel = new("Frame", { Position = UDim2.fromOffset(14, 166), Size = UDim2.fromOffset(W, H), BackgroundColor3 = PANEL, BorderSizePixel = 0, Visible = false }, gui)
corner(panel, 10)
stroke(panel, BLUE, 2, 0.1)
label(panel, "ТЕСТ ОРУЖИЯ", UDim2.fromOffset(12, 6), UDim2.new(1, -24, 0, 26), 20, BLUE, nil, Enum.Font.GothamBlack)
label(panel, "Клик по оружию - сразу надеть. Способности: Q / E / Z", UDim2.fromOffset(12, 30), UDim2.new(1, -24, 0, 30), 11, TXT2, nil, Enum.Font.Gotham)
local panelScale = new("UIScale", {}, panel)
local function fit()
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	panelScale.Scale = math.clamp((vp.Y - 180) / H, 0.5, 1)
end
fit()
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end

local pickType = "Swordsman"
local tabs = {}
for i, typ in ipairs(Config.TypeOrder) do
	local info = Config.TypeInfo[typ]
	local b = button(panel, info.icon .. " " .. info.name, UDim2.new((i - 1) / 3, 8, 0, 64), UDim2.new(1 / 3, -10, 0, 30), C3(42, 47, 62), function()
		pickType = typ
		if panel.Visible then
			for t, tb in pairs(tabs) do tb.BackgroundColor3 = t == typ and BLUE:Lerp(C3(0, 0, 0), 0.45) or C3(42, 47, 62) end
			panel:SetAttribute("Rebuild", (panel:GetAttribute("Rebuild") or 0) + 1)
		end
	end)
	b.TextSize = 12
	tabs[typ] = b
end
local list = new("ScrollingFrame", { Position = UDim2.fromOffset(8, 102), Size = UDim2.new(1, -16, 1, -214), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, panel)
new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)

local curWeapon = nil
local function readWeapon()
	local s = lp:GetAttribute("Data")
	if not s then return end
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok and type(t) == "table" then curWeapon = t.weapon end
end

local function rebuildList()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local arr = {}
	for _, w in ipairs(Config.ByType[pickType]) do table.insert(arr, w) end
	table.sort(arr, function(a, b) return a.tier < b.tier end)
	for i, w in ipairs(arr) do
		local rc = Config.Rarities[w.tier]
		local sel = curWeapon == w.id
		local row = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = sel and C3(44, 60, 84) or CARD, BorderSizePixel = 0, LayoutOrder = i }, list)
		corner(row, 6)
		stroke(row, sel and BLUE or LINE, sel and 2 or 1, sel and 0 or 0.4)
		local bar = new("Frame", { Size = UDim2.new(0, 5, 1, -8), Position = UDim2.fromOffset(4, 4), BackgroundColor3 = w.rainbow and C3(255, 120, 220) or rc.color, BorderSizePixel = 0 }, row)
		corner(bar, 3)
		label(row, w.name, UDim2.fromOffset(16, 1), UDim2.new(1, -20, 0, 18), 13, TXT)
		label(row, rc.name .. " - " .. w.ult, UDim2.fromOffset(16, 17), UDim2.new(1, -20, 0, 14), 10, w.rainbow and C3(255, 140, 230) or rc.color, nil, Enum.Font.Gotham)
		row.MouseButton1Click:Connect(function()
			ToServer:FireServer("TestEquip", w.id)
			curWeapon = w.id
			rebuildList()
		end)
	end
end
panel:GetAttributeChangedSignal("Rebuild"):Connect(rebuildList)

local actions = {
	{ "Сбросить перезарядки", C3(52, 110, 170), "TestCd" },
	{ "Вернуть манекены", C3(150, 110, 50), "TestReset" },
	{ "ВЫЙТИ В ЛОББИ", C3(160, 66, 66), "TestLeave" },
}
for i, a in ipairs(actions) do
	button(panel, a[1], UDim2.new(0, 8, 1, -108 + (i - 1) * 34), UDim2.new(1, -16, 0, 30), a[2], function()
		ToServer:FireServer(a[3])
	end)
end

lp:GetAttributeChangedSignal("Data"):Connect(function()
	readWeapon()
	if panel.Visible then rebuildList() end
end)
readWeapon()

local H2 = {}
H2.Zone = function(zid)
	portal.Visible = zid == "testportal"
end
H2.TestMode = function(on)
	panel.Visible = on
	portal.Visible = false
	if on then
		readWeapon()
		if curWeapon and Config.Weapons[curWeapon] then pickType = Config.Weapons[curWeapon].type end
		for t, tb in pairs(tabs) do tb.BackgroundColor3 = t == pickType and BLUE:Lerp(C3(0, 0, 0), 0.45) or C3(42, 47, 62) end
		rebuildList()
	end
end
ToClient.OnClientEvent:Connect(function(name, ...)
	local f = H2[name]
	if f then
		local ok, err = pcall(f, ...)
		if not ok then warn("[testarea] " .. tostring(name) .. ": " .. tostring(err)) end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="StarterCharacterScripts" referent="RBX16">
<Properties>
<string name="Name">StarterCharacterScripts</string>
</Properties>
</Item>
</Item>
</roblox>
