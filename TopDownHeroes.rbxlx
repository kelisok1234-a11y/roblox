	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(480, 340),
	BackgroundColor3 = C3(20, 22, 32), BorderSizePixel = 0, Visible = false, ZIndex = 30,
}, gui)
corner(result, 16)
local resStroke = stroke(result, C3(255, 214, 74), 3)
local resTitle = mkLabel(result, "", UDim2.fromOffset(0, 14), UDim2.new(1, 0, 0, 50), 42, C3(255, 214, 74), Enum.TextXAlignment.Center, Enum.Font.GothamBlack)
local resBody = mkLabel(result, "", UDim2.fromOffset(20, 76), UDim2.new(1, -40, 0, 190), 20, nil, Enum.TextXAlignment.Center)
mkButton(result, "RETURN TO LOBBY", UDim2.new(0.5, -110, 1, -60), UDim2.fromOffset(220, 44), C3(70, 130, 220), function()
