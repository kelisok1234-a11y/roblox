	{ id = "bw_nova", name = "Cosmic Nova", type = "Archer", kind = "Bow", tier = 7, v = 1, dm = 1.10, elem = "prism", ult = "Nova: Birth of a Star", rainbow = true,
		c1 = Color3.fromRGB(255, 255, 255), c2 = Color3.fromRGB(255, 255, 255), c3 = Color3.fromRGB(255, 255, 255) },
	{ id = "st_apprentice", name = "Apprentice Staff", type = "Mage", kind = "Staff", tier = 1, v = 1, dm = 1.00, elem = "none", ult = "Apprentice Spark", rainbow = false,
		c1 = Color3.fromRGB(120, 80, 50), c2 = Color3.fromRGB(212, 168, 72), c3 = Color3.fromRGB(120, 180, 245) },
	{ id = "st_branch", name = "Gnarled Branch", type = "Mage", kind = "Staff", tier = 1, v = 2, dm = 1.05, elem = "none", ult = "Wild Surge", rainbow = false,
		c1 = Color3.fromRGB(100, 75, 50), c2 = Color3.fromRGB(90, 140, 70), c3 = Color3.fromRGB(170, 230, 150) },
	{ id = "st_jade", name = "Jade Rod", type = "Mage", kind = "Staff", tier = 2, v = 1, dm = 1.00, elem = "nature", ult = "Jade Cataclysm", rainbow = false,
		c1 = Color3.fromRGB(60, 190, 130), c2 = Color3.fromRGB(30, 110, 80), c3 = Color3.fromRGB(180, 255, 220) },
	{ id = "st_crook", name = "Verdant Crook", type = "Mage", kind = "Staff", tier = 2, v = 2, dm = 1.05, elem = "nature", ult = "Overgrowth Storm", rainbow = false,
		c1 = Color3.fromRGB(110, 200, 70), c2 = Color3.fromRGB(80, 60, 40), c3 = Color3.fromRGB(210, 255, 160) },
	{ id = "st_aqua", name = "Aqua Scepter", type = "Mage", kind = "Staff", tier = 3, v = 1, dm = 1.00, elem = "frost", ult = "Aqua Deluge", rainbow = false,
		c1 = Color3.fromRGB(60, 190, 255), c2 = Color3.fromRGB(30, 100, 180), c3 = Color3.fromRGB(200, 245, 255) },
	{ id = "st_prism", name = "Cyan Prism Staff", type = "Mage", kind = "Staff", tier = 3, v = 2, dm = 1.05, elem = "frost", ult = "Prism Meteorfall", rainbow = false,
		c1 = Color3.fromRGB(80, 230, 230), c2 = Color3.fromRGB(40, 120, 160), c3 = Color3.fromRGB(210, 255, 255) },
	{ id = "st_amethyst", name = "Amethyst Arcana", type = "Mage", kind = "Staff", tier = 4, v = 1, dm = 1.00, elem = "void", ult = "Arcana Collapse", rainbow = false,
		c1 = Color3.fromRGB(170, 90, 255), c2 = Color3.fromRGB(90, 40, 160), c3 = Color3.fromRGB(235, 200, 255) },
	{ id = "st_spire", name = "Stormspire", type = "Mage", kind = "Staff", tier = 4, v = 2, dm = 1.05, elem = "shock", ult = "Stormspire Tempest", rainbow = false,
		c1 = Color3.fromRGB(110, 140, 255), c2 = Color3.fromRGB(255, 230, 100), c3 = Color3.fromRGB(235, 240, 255) },
	{ id = "st_sunfire", name = "Sunfire Scepter", type = "Mage", kind = "Staff", tier = 5, v = 1, dm = 1.00, elem = "fire", ult = "Sunfire Armageddon", rainbow = false,
		c1 = Color3.fromRGB(255, 180, 40), c2 = Color3.fromRGB(255, 240, 170), c3 = Color3.fromRGB(255, 245, 200) },
	{ id = "st_lantern", name = "Astral Lantern", type = "Mage", kind = "Staff", tier = 5, v = 2, dm = 1.05, elem = "holy", ult = "Astral Judgement", rainbow = false,
		c1 = Color3.fromRGB(255, 230, 120), c2 = Color3.fromRGB(120, 150, 255), c3 = Color3.fromRGB(255, 250, 220) },
	{ id = "st_nether", name = "Nether Crown", type = "Mage", kind = "Staff", tier = 6, v = 1, dm = 1.00, elem = "void", ult = "Nether Apocalypse", rainbow = false,
		c1 = Color3.fromRGB(200, 40, 255), c2 = Color3.fromRGB(20, 5, 35), c3 = Color3.fromRGB(255, 170, 255) },
	{ id = "st_pyre", name = "Hellfire Pyre", type = "Mage", kind = "Staff", tier = 6, v = 2, dm = 1.05, elem = "fire", ult = "Hellfire Ragnarok", rainbow = false,
		c1 = Color3.fromRGB(255, 60, 30), c2 = Color3.fromRGB(50, 10, 10), c3 = Color3.fromRGB(255, 190, 60) },
	{ id = "st_galaxy", name = "Galaxy Weaver", type = "Mage", kind = "Staff", tier = 7, v = 1, dm = 1.10, elem = "prism", ult = "Galaxy: Heat Death", rainbow = true,
		c1 = Color3.fromRGB(255, 255, 255), c2 = Color3.fromRGB(255, 255, 255), c3 = Color3.fromRGB(255, 255, 255) },
--@WEAPONS_END
}
Config.Weapons = {}
Config.ByType = { Swordsman = {}, Archer = {}, Mage = {} }
for _, w in ipairs(Config.WeaponList) do
	Config.Weapons[w.id] = w
	table.insert(Config.ByType[w.type], w)
end
function Config.rarityOf(w) return Config.Rarities[w and w.tier or 1] end

-- weighted random weapon of a given type from a chest (returns weapon def)
function Config.rollWeapon(chest, typ, rng)
	local total = 0
	for _, o in ipairs(chest.odds) do total = total + o end
	local r = rng:NextNumber() * total
	local tier = #chest.odds
	for i, o in ipairs(chest.odds) do
		r = r - o
		if r <= 0 and o > 0 then tier = i break end
	end
	local pool = {}
	for _, w in ipairs(Config.ByType[typ]) do
		if w.tier == tier then table.insert(pool, w) end
	end
	return pool[rng:NextInteger(1, #pool)]
end

-- [TESTAREA] set enabled = false (or delete the TestArea scripts) to remove the weapon test place
Config.TestArea = { enabled = true }

-- ============================================================ ABILITIES (Q / E / Z)
-- Q and E are normal skills, Z is the ULTIMATE of every weapon.
-- cd = cooldown in seconds. All damage is scaled by the weapon's upgraded damage.
Config.Abilities = {
	Swordsman = {
		Q = { name = "Crimson Charge", cd = 7, icon = "💨", short = "Dash through enemies, slashing them",
			desc = "Lunge forward, cutting through everything on the way. Ends with a 360 slash. You are invulnerable while charging." },
		E = { name = "Blade Whirlwind", cd = 12, icon = "🌀", short = "Spin and shred everything near you",
			desc = "Spin for 2.4s, hitting all nearby enemies 8 times and pushing them away." },
		Z = { name = "Heaven's Verdict", cd = 50, icon = "⚔️", short = "ULT: giant sword crushes an area",
			desc = "A colossal holy sword falls from the sky, crushing and stunning everything, followed by an aftershock.", ult = true },
	},
	Archer = {
		Q = { name = "Arrow Fan", cd = 6, icon = "🏹", short = "Fire 9 arrows in a wide cone",
			desc = "Release a fan of 9 arrows at once. Perfect against crowds." },
		E = { name = "Frost Trap", cd = 11, icon = "❄️", short = "Freeze enemies in an area",
			desc = "Throw a frost rune. After a moment it explodes, freezing enemies in place and leaving a slowing frost field." },
		Z = { name = "Sunpiercer", cd = 55, icon = "☀️", short = "ULT: huge piercing beam of light",
			desc = "Charge a radiant arrow and fire a gigantic beam that pierces every enemy in a line.", ult = true },
	},
	Mage = {
		Q = { name = "Chain Lightning", cd = 6, icon = "⚡", short = "Lightning jumps between enemies",
			desc = "A bolt of lightning strikes an enemy and jumps to up to 7 more." },
		E = { name = "Arcane Blink", cd = 9, icon = "✨", short = "Teleport and blast both ends",
			desc = "Teleport toward the cursor. Arcane explosions hit enemies where you leave and where you arrive." },
		Z = { name = "Meteor Storm", cd = 55, icon = "☄️", short = "ULT: rain of burning meteors",
			desc = "Call down a storm of 10 meteors over the target area. Each impact explodes and sets enemies on fire.", ult = true },
	},
}
Config.AbilityKeys = { "Q", "E", "Z" }

return Config
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX3">
<Properties>
<string name="Name">Theme</string>
<ProtectedString name="Source"><![CDATA[-- Theme (ReplicatedStorage.Theme): recolours ability / attack VFX with the colours of the weapon that is being used.
-- The server sends a "Theme" event (weapon id) right before every attack / ability, clients call Theme.set(id).
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS:WaitForChild("Config"))

local Theme = {}
local cur = nil
local WHITE = Color3.new(1, 1, 1)

function Theme.set(wid)
	cur = wid and Config.Weapons[wid] or nil
end

function Theme.current()
	return cur
end

-- main colour of a weapon (animated for rainbow weapons)
function Theme.main(w)
	w = w or cur
	if not w then return WHITE end
	if w.rainbow then return Color3.fromHSV((os.clock() * 0.35) % 1, 0.8, 1) end
	return w.c1
end

function Theme.accent(w)
	w = w or cur
	if not w then return WHITE end
	if w.rainbow then return Color3.fromHSV((os.clock() * 0.35 + 0.4) % 1, 0.8, 1) end
	return w.c2
end

function Theme.glow(w)
	w = w or cur
	if not w then return WHITE end
	if w.rainbow then return Color3.fromHSV((os.clock() * 0.35 + 0.7) % 1, 0.3, 1) end
	return w.c3
end

-- maps any "class coloured" VFX colour onto the current weapon palette (keeps brightness / neutrals)
function Theme.tint(c)
	local w = cur
	if not w or w.tier <= 1 and w.elem == "none" and not w.rainbow then
		return c
	end
	local h, s, v = c:ToHSV()
	if s < 0.16 then
		-- white / grey stays white-ish, bright cores get a hint of the glow colour
		if v > 0.55 then return c:Lerp(Theme.glow(w), 0.22) end
		return c
	end
	if w.rainbow then
		return Color3.fromHSV(((os.clock() * 0.35) + h * 1.7) % 1, math.clamp(s * 0.95, 0.25, 0.9), math.clamp(v + 0.05, 0.3, 1))
	end
	local t = (h * 7) % 1
	local base = w.c1:Lerp(w.c2, t * 0.8)
	if s < 0.55 then base = base:Lerp(w.c3, 0.65) end
	local bh, bs = base:ToHSV()
	return Color3.fromHSV(bh, math.clamp(bs, 0.12, 1), math.clamp(v * 1.05, 0.28, 1))
end

return Theme
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX4">
<Properties>
<string name="Name">WeaponModels</string>
<ProtectedString name="Source"><![CDATA[-- WeaponModels (ReplicatedStorage.WeaponModels): procedural, top-down "sprite" models of every weapon.
-- Used by the server (hero sprite) and by the client (inventory / chest previews in ViewportFrames).
-- The richer the rarity (w.tier 1..7) the more detail, glow, particles and floating pieces a weapon gets.
--
-- v2 geometry rules (artifact free):
--   * every shape is built from exact geometry: boxes, cylinders and flat TRIANGLES made of two WedgeParts.
--     Curved blades / limbs are "ribbons" (strips of quads that share their corner points) - no overlapping segments.
--   * pieces that overlap each other in the top view are stacked in separate height slabs (tops >= 0.04 studs apart)
--     or have exactly the same colour / material, so nothing flickers (no z-fighting).
--   * translucent glow pieces never overlap another translucent piece of the same height.
--   * everything is expressed in "weapon units" (forward = -z, y = height) and scaled by k.
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local WM = {}

local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.Wood
local FABRIC = Enum.Material.Fabric
local SMOOTH = Enum.Material.SmoothPlastic
local BLK, CYL = Enum.PartType.Block, Enum.PartType.Cylinder
local RB = "RB" -- rainbow colour marker
local PI = math.pi
local sin, cos, sqrt, abs, max, min = math.sin, math.cos, math.sqrt, math.abs, math.max, math.min

local function C(r, g, b) return Color3.fromRGB(r, g, b) end
local function darker(c, m)
	if c == RB then return c end
	return Color3.new(c.R * m, c.G * m, c.B * m)
end
local function lighter(c, m)
	if c == RB then return c end
	return c:Lerp(Color3.new(1, 1, 1), m)
end
local function mix(a, b, f)
	if a == RB or b == RB then return RB end
	return a:Lerp(b, f)
end
-- direction (x, z) -> yaw so that a block's local z axis points along it
local function rot(vx, vz) return math.atan2(vx, vz) end

local RAINBOW_KEYS = {}
for i = 0, 6 do
	RAINBOW_KEYS[#RAINBOW_KEYS + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i / 6) % 1, 0.75, 1))
end
local function cseq(a, b)
	if a == RB or b == RB then return ColorSequence.new(RAINBOW_KEYS) end
	return ColorSequence.new(a, b or a)
end

-- ============================================================================ part factory
local rbCounter = 0
local function vec(x, y, z) return Vector3.new(max(x, 0.05), max(y, 0.05), max(z, 0.05)) end

-- shape == nil -> WedgePart
local function mkPart(parent, shape, size, cf, color, mat, trans, anchored, hue)
	local p = Instance.new(shape and "Part" or "WedgePart")
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	if color == RB then
		rbCounter = rbCounter + 1
		local off = hue or ((rbCounter * 0.083) % 1)
		p.Color = Color3.fromHSV(off % 1, 0.75, 1)
		p:SetAttribute("rb", off % 1)
		CollectionService:AddTag(p, "RainbowPart")
	else
		p.Color = color
	end
	p.Material = mat or SMOOTH
	p.Transparency = trans or 0
	p.Anchored = anchored and true or false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- ============================================================================ geometry helpers (2D, units = (x, z))
local function polyAt(pts, s)
	-- point + unit tangent at fraction s (0..1) of the arc length of a polyline {{x,z},...}
	local total = 0
	local seg = {}
	for i = 2, #pts do
		local l = sqrt((pts[i][1] - pts[i - 1][1]) ^ 2 + (pts[i][2] - pts[i - 1][2]) ^ 2)
		seg[i] = l
		total = total + l
	end
	local want = max(0, min(1, s)) * total
	local acc = 0
	for i = 2, #pts do
		if acc + seg[i] >= want or i == #pts then
			local u = seg[i] > 0 and (want - acc) / seg[i] or 0
			local ax, az, bx, bz = pts[i - 1][1], pts[i - 1][2], pts[i][1], pts[i][2]
			local tx, tz = (bx - ax) / max(seg[i], 1e-6), (bz - az) / max(seg[i], 1e-6)
			return ax + (bx - ax) * u, az + (bz - az) * u, tx, tz
		end
		acc = acc + seg[i]
	end
end

-- ear clipping triangulation of a simple polygon {{x,z},...} -> list of {i,j,k}
local function triangulate(pts)
	local n = #pts
	local idx = {}
	local area = 0
	for i = 1, n do
		local a, b = pts[i], pts[i % n + 1]
		area = area + (a[1] * b[2] - b[1] * a[2])
		idx[i] = i
	end
	local sgn = area >= 0 and 1 or -1
	local function cross(a, b, c) return ((b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])) * sgn end
	local function inside(p, a, b, c)
		return cross(a, b, p) >= -1e-9 and cross(b, c, p) >= -1e-9 and cross(c, a, p) >= -1e-9
	end
	local out = {}
	local guard = 0
	while #idx > 3 and guard < 400 do
		guard = guard + 1
		local clipped = false
		for i = 1, #idx do
			local ia, ib, ic = idx[(i - 2) % #idx + 1], idx[i], idx[i % #idx + 1]
			local a, b, c = pts[ia], pts[ib], pts[ic]
			if cross(a, b, c) > 1e-7 then
				local ok = true
				for j = 1, #idx do
					local ij = idx[j]
					if ij ~= ia and ij ~= ib and ij ~= ic and inside(pts[ij], a, b, c) then ok = false break end
				end
				if ok then
					out[#out + 1] = { ia, ib, ic }
					table.remove(idx, i)
					clipped = true
					break
				end
			end
		end
		if not clipped then break end
	end
	if #idx == 3 then out[#out + 1] = { idx[1], idx[2], idx[3] } end
	return out
end

-- ============================================================================ builder bound to a pivot part
-- forward = -z, local units scaled by k. y0 = bottom of the slab, h = slab height.
local function newS(pivot, parent, k, anchored)
	local S = {}
	local pcf = pivot.CFrame
	local function place(p)
		if S.rec then S.rec[#S.rec + 1] = p end -- S.rec = {} records every part built until it is set to nil again
		if not anchored then
			local w = Instance.new("WeldConstraint")
			w.Part0 = pivot
			w.Part1 = p
			w.Parent = p
		end
		return p
	end
	-- rainbow phase that flows along the weapon (so every piece of a gradient has a smooth, matching hue)
	local function hue(x, z) return (0.55 - z * 0.065 + x * 0.04) % 1 end
	local function P3(x, y, z) return pcf * Vector3.new(x * k, y * k, z * k) end
	S.hue = hue

	function S.box(cx, cz, sx, sz, y0, h, ry, col, mat, tr)
		local cf = pcf * CFrame.new(cx * k, (y0 + h / 2) * k, cz * k) * CFrame.Angles(0, ry or 0, 0)
		return place(mkPart(parent, BLK, vec(sx * k, h * k, sz * k), cf, col, mat, tr, anchored, hue(cx, cz)))
	end
	function S.disc(cx, cz, d, y0, h, col, mat, tr)
		local cf = pcf * CFrame.new(cx * k, (y0 + h / 2) * k, cz * k) * CFrame.Angles(0, 0, PI / 2)
		return place(mkPart(parent, CYL, vec(h * k, d * k, d * k), cf, col, mat, tr, anchored, hue(cx, cz)))
	end
	-- invisible part (used for emitters / lights / trails)
	function S.ghost(cx, cz, sx, sz, y0, h)
		local p = S.box(cx, cz, sx, sz, y0 or 0.1, h or 0.1, 0, Color3.new(1, 1, 1), SMOOTH, 1)
		return p
	end
	-- beam between two points (square ends)
	function S.beam(x1, z1, x2, z2, wid, y0, h, col, mat, tr)
		local dx, dz = x2 - x1, z2 - z1
		local len = sqrt(dx * dx + dz * dz)
		if len < 0.02 then return end
		return S.box((x1 + x2) / 2, (z1 + z2) / 2, wid, len, y0, h, rot(dx, dz), col, mat, tr)
	end

	-- flat triangle prism = two wedges (classic triangle-drawing trick). a,b,c = {x, z}
	function S.tri(a, b, c, y0, h, col, mat, tr, hu)
		local ar = abs((b[1] - a[1]) * (c[2] - a[2]) - (c[1] - a[1]) * (b[2] - a[2])) / 2
		if ar < 0.006 then return end
		local ym = y0 + h / 2
		local pa, pb, pc = P3(a[1], ym, a[2]), P3(b[1], ym, b[2]), P3(c[1], ym, c[2])
		local ab, ac, bc = pb - pa, pc - pa, pc - pb
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			pc, pa = pa, pc
		elseif acd > bcd and acd > abd then
			pa, pb = pb, pa
		end
		ab, ac, bc = pb - pa, pc - pa, pc - pb
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = abs(ab:Dot(up))
		local hv = hu or hue((a[1] + b[1] + c[1]) / 3, (a[2] + b[2] + c[2]) / 3)
		local thick = h * k
		local l1, l2 = abs(ab:Dot(back)), abs(ac:Dot(back))
		local made
		if height > 0.03 and l1 > 0.03 then
			made = place(mkPart(parent, nil, vec(thick, height, l1), CFrame.fromMatrix((pa + pb) / 2, right, up, back), col, mat, tr, anchored, hv))
		end
		if height > 0.03 and l2 > 0.03 then
			made = place(mkPart(parent, nil, vec(thick, height, l2), CFrame.fromMatrix((pa + pc) / 2, -right, up, -back), col, mat, tr, anchored, hv))
		end
		return made
	end

	-- convex quad {{x,z} x4} (rectangles become a single block)
	function S.quad(q, y0, h, col, mat, tr)
		local a, b, c, d = q[1], q[2], q[3], q[4]
		local e1x, e1z, e2x, e2z = b[1] - a[1], b[2] - a[2], d[1] - a[1], d[2] - a[2]
		local l1, l2 = sqrt(e1x * e1x + e1z * e1z), sqrt(e2x * e2x + e2z * e2z)
		local hv = hue((a[1] + b[1] + c[1] + d[1]) / 4, (a[2] + b[2] + c[2] + d[2]) / 4)
		if l1 > 0.02 and l2 > 0.02 and abs(e1x * e2x + e1z * e2z) < 0.002 * l1 * l2
			and abs((c[1] - b[1]) - e2x) < 0.01 and abs((c[2] - b[2]) - e2z) < 0.01 then
			return place(mkPart(parent, BLK, vec(l2 * k, h * k, l1 * k),
				pcf * CFrame.new((a[1] + c[1]) / 2 * k, (y0 + h / 2) * k, (a[2] + c[2]) / 2 * k) * CFrame.Angles(0, rot(e1x, e1z), 0),
				col, mat, tr, anchored, hv))
		end
		S.tri(a, b, c, y0, h, col, mat, tr, hv)
		S.tri(a, c, d, y0, h, col, mat, tr, hv)
	end

	-- any simple polygon (ear clipping)
	function S.poly(pts, y0, h, col, mat, tr)
		local hv
		for _, t in ipairs(triangulate(pts)) do
			S.tri(pts[t[1]], pts[t[2]], pts[t[3]], y0, h, col, mat, tr)
		end
	end

	-- ribbon: stations {x, z, a, b}: a / b = half widths on the +n / -n side of the centre line
	-- (n = left normal; for a blade pointing forward +n is +x). Neighbouring quads share their corner points.
	function S.ribbon(st, y0, h, col, mat, tr)
		local n = #st
		local A, B, N = {}, {}, {}
		local seg = {}
		for i = 1, n - 1 do
			local dx, dz = st[i + 1].x - st[i].x, st[i + 1].z - st[i].z
			local l = max(sqrt(dx * dx + dz * dz), 1e-6)
			seg[i] = { dx / l, dz / l }
		end
		for i = 1, n do
			local t1, t2 = seg[i - 1] or seg[i], seg[i] or seg[i - 1]
			local tx, tz = t1[1] + t2[1], t1[2] + t2[2]
			local tl = max(sqrt(tx * tx + tz * tz), 1e-6)
			tx, tz = tx / tl, tz / tl
			local nx, nz = -tz, tx
			local sx, sz = seg[min(i, n - 1)][1], seg[min(i, n - 1)][2]
			local m = 1 / max(0.6, nx * (-sz) + nz * sx)
			N[i] = { nx, nz }
			A[i] = { st[i].x + nx * st[i].a * m, st[i].z + nz * st[i].a * m }
			B[i] = { st[i].x - nx * st[i].b * m, st[i].z - nz * st[i].b * m }
		end
		for i = 1, n - 1 do
			S.quad({ A[i], A[i + 1], B[i + 1], B[i] }, y0, h, col, mat, tr)
		end
		return { A = A, B = B, N = N, st = st }
	end

	-- ribbon along a circular arc (angles in the (x,z) plane: x = cos a, z = sin a); w0 -> w1 = full width
	function S.arc(cx, cz, r, a0, a1, n, w0, w1, y0, h, col, mat, tr, rScale)
		local st = {}
		for i = 0, n do
			local f = i / n
			local a = a0 + (a1 - a0) * f
			local rr = r * (1 + ((rScale or 1) - 1) * f)
			local w = (w0 + (w1 - w0) * f) / 2
			st[#st + 1] = { x = cx + cos(a) * rr, z = cz + sin(a) * rr, a = w, b = w }
		end
		return S.ribbon(st, y0, h, col, mat, tr)
	end

	-- closed ring made of exact trapezoids (a true polygon ring, no gaps / overlaps)
	function S.band(cx, cz, r0, r1, n, y0, h, col, mat, tr, a0)
		for i = 0, n - 1 do
			local aa, bb = (a0 or 0) + i / n * PI * 2, (a0 or 0) + (i + 1) / n * PI * 2
			S.quad({
				{ cx + cos(aa) * r0, cz + sin(aa) * r0 }, { cx + cos(aa) * r1, cz + sin(aa) * r1 },
				{ cx + cos(bb) * r1, cz + sin(bb) * r1 }, { cx + cos(bb) * r0, cz + sin(bb) * r0 },
			}, y0, h, col, mat, tr)
		end
	end

	-- dashed ring (rune circle): separate dashes with a clean gap between them
	function S.ring(cx, cz, r, n, wid, y0, h, col, mat, tr, fill)
		local len = (2 * PI * r / n) * (fill or 0.72)
		for i = 0, n - 1 do
			local a = i / n * PI * 2
			S.box(cx + cos(a) * r, cz + sin(a) * r, wid, len, y0, h, rot(-sin(a), cos(a)), col, mat, tr)
		end
	end

	-- kite / crystal / leaf: base at (cx,cz), pointing along angle a, widest at `belly` (0..1) of the length
	function S.shard(cx, cz, len, wid, a, belly, y0, h, col, mat, tr)
		local dx, dz = cos(a), sin(a)
		local nx, nz = -dz, dx
		local mx, mz = cx + dx * len * belly, cz + dz * len * belly
		S.quad({
			{ cx, cz }, { mx + nx * wid / 2, mz + nz * wid / 2 },
			{ cx + dx * len, cz + dz * len }, { mx - nx * wid / 2, mz - nz * wid / 2 },
		}, y0, h, col, mat, tr)
	end
	-- spike: flat base of width `wid` centred at (cx,cz), tip `len` away along angle a (optionally slanted sideways)
	function S.spike(cx, cz, len, wid, a, y0, h, col, mat, tr, slant)
		local dx, dz = cos(a), sin(a)
		local nx, nz = -dz, dx
		local sl = (slant or 0) * len
		S.tri({ cx + nx * wid / 2, cz + nz * wid / 2 }, { cx + dx * len + nx * sl, cz + dz * len + nz * sl }, { cx - nx * wid / 2, cz - nz * wid / 2 }, y0, h, col, mat, tr)
	end
	-- regular polygon / diamond made of triangles around the centre
	function S.ngon(cx, cz, r, n, a0, y0, h, col, mat, tr, sx, sz)
		local pts = {}
		for i = 0, n - 1 do
			local a = (a0 or 0) + i / n * PI * 2
			pts[#pts + 1] = { cx + cos(a) * r * (sx or 1), cz + sin(a) * r * (sz or 1) }
		end
		S.poly(pts, y0, h, col, mat, tr)
	end
	return S
end

-- ============================================================================ effects
local function light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color == RB and Color3.new(1, 1, 1) or color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = part
	return l
end

local function emitter(part, c0, c1, rate, size, life, speed, spread)
	local em = Instance.new("ParticleEmitter")
	em.Rate = rate
	em.Lifetime = NumberRange.new(life * 0.6, life)
	em.Speed = NumberRange.new(speed * 0.3, speed)
	em.SpreadAngle = Vector2.new(spread or 180, spread or 180)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
	em.Color = cseq(c0, c1)
	em.LightEmission = 1
	em.LightInfluence = 0
	em.Parent = part
	return em
end

local function attach(part, x, y, z, k)
	local a = Instance.new("Attachment")
	a.Position = Vector3.new(x * k, y * k, z * k)
	a.Parent = part
	return a
end

local function mkTrail(part, a0, a1, c0, c1, life)
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = life or 0.2
	t.Color = cseq(c0, c1)
	t.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(0.5, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	t.LightEmission = 0.8
	t.LightInfluence = 0
	t.MinLength = 0.05
	t.FaceCamera = false
	t.Enabled = false
	t.Parent = part
	return t
end

local function palette(w)
	if w.rainbow then
		return { main = RB, acc = RB, glow = RB, dark = C(22, 18, 34), steel = C(40, 38, 56) }
	end
	return { main = w.c1, acc = w.c2, glow = w.c3, dark = darker(w.c2, 0.45), steel = w.tier <= 2 and C(168, 176, 190) or darker(w.c1, 0.55) }
end

-- ============================================================================ SWORD
-- Height slabs (weapon units): aura 0..0.09 | blade / guard / grip 0.10..0.20 | face 0.20..0.26 | fuller 0.26..0.31
-- | gems 0.26..0.45.  Parts that share a slab never overlap in the top view.
local SW = {
	sw_iron = { blade = "short", guard = "bar", L = 4.5, W = 1.0 },
	sw_falchion = { blade = "falchion", guard = "disc", L = 4.7, W = 1.35 },
	sw_emerald = { blade = "arming", guard = "leaf", L = 5.2, W = 1.15 },
	sw_jade = { blade = "scimitar", guard = "disc", L = 5.3, W = 1.25, tassel = true },
	sw_frost = { blade = "broad", guard = "horn", L = 5.6, W = 1.3, deco = "ice" },
	sw_tide = { blade = "saber", guard = "knuckle", L = 5.7, W = 1.15, deco = "wave" },
	sw_void = { blade = "fang", guard = "fang", L = 5.9, W = 1.3, deco = "teeth", spike = true },
	sw_thunder = { blade = "saber", guard = "bolt", L = 6.0, W = 1.2, deco = "zigzag" },
	sw_solar = { blade = "great", guard = "sun", L = 6.3, W = 1.5, deco = "rays" },
	sw_phoenix = { blade = "flame", guard = "wing", L = 6.4, W = 1.4, deco = "flames" },
	sw_eclipse = { blade = "broad", guard = "crescent", L = 6.6, W = 1.5, deco = "eclipse" },
	sw_reaper = { blade = "reaper", guard = "claw", L = 6.8, W = 1.5, deco = "hook", spike = true },
	sw_prism = { blade = "crystal", guard = "wing", L = 7.2, W = 1.6, deco = "shards" },
}

local function bladeStations(shape, L, W, z0)
	local hw = W / 2
	local st = {}
	local function add(f, x, a, b, zo)
		st[#st + 1] = { x = x, z = z0 - L * f + (zo or 0), a = a, b = b, f = f }
	end
	if shape == "short" then
		add(0, 0, hw, hw) add(0.8, 0, hw * 0.9, hw * 0.9) add(1, 0, 0, 0)
	elseif shape == "arming" then
		add(0, 0, hw * 0.85, hw * 0.85) add(0.3, 0, hw * 1.02, hw * 1.02) add(0.78, 0, hw * 0.72, hw * 0.72) add(1, 0, 0, 0)
	elseif shape == "broad" then
		add(0, 0, hw, hw) add(0.14, 0, hw * 1.1, hw * 1.1) add(0.6, 0, hw * 0.92, hw * 0.92) add(0.87, 0, hw * 0.6, hw * 0.6) add(1, 0, 0, 0)
	elseif shape == "great" then
		add(0, 0, hw * 0.9, hw * 0.9) add(0.45, 0, hw * 1.1, hw * 1.1) add(0.85, 0, hw * 0.78, hw * 0.78) add(1, 0, 0, 0)
	elseif shape == "fang" then
		add(0, 0, hw, hw) add(0.25, 0, hw * 1.05, hw * 1.05) add(0.7, 0, hw * 0.72, hw * 0.72) add(1, 0, 0, 0)
	elseif shape == "crystal" then
		add(0, 0, hw * 0.62, hw * 0.62) add(0.3, 0, hw * 1.15, hw * 1.15) add(0.62, 0, hw * 0.95, hw * 0.95) add(0.82, 0, hw * 0.55, hw * 0.55) add(1, 0, 0, 0)
	elseif shape == "falchion" then
		for _, f in ipairs({ 0, 0.3, 0.55, 0.7, 0.82, 0.92 }) do
			local tp = f < 0.7 and 1 or max(0.08, 1 - ((f - 0.7) / 0.3) ^ 1.3)
			add(f, 0.9 * f * f, hw * 0.42 * tp, hw * (0.5 + 0.95 * f ^ 1.3) * tp)
		end
		add(1, 0.9, 0, 0)
	elseif shape == "scimitar" then
		for _, f in ipairs({ 0, 0.2, 0.4, 0.6, 0.8, 0.93 }) do
			add(f, 1.7 * f * f, hw * 0.5, hw * (0.5 + 0.55 * sin(PI * min(f, 0.93) / 0.93 * 0.95)))
		end
		add(1, 1.7, 0, 0)
	elseif shape == "saber" then
		for _, f in ipairs({ 0, 0.2, 0.4, 0.6, 0.8, 0.93 }) do
			add(f, 1.25 * f * f, hw * 0.55, hw * (0.62 + 0.18 * sin(PI * f)) * (1 - 0.3 * f))
		end
		add(1, 1.25, 0, 0)
	elseif shape == "flame" then
		for i = 0, 8 do
			local f = i / 8
			add(f, 1.0 * f * f, hw * 0.6, hw * (0.62 + 0.3 * sin(f * PI * 3.2)) * (1 - 0.55 * f ^ 2))
		end
		add(1, 1.0, 0, 0)
	elseif shape == "reaper" then
		for _, f in ipairs({ 0, 0.15, 0.3, 0.45, 0.6, 0.75, 0.88 }) do
			add(f, 2.4 * f ^ 2.2, hw * 0.34, hw * (0.45 + 0.85 * sin(f * PI * 0.85)), (f > 0.7) and (f - 0.7) ^ 2 * L * 1.7 or 0)
		end
		add(1, 2.4, 0, 0, 0.3 ^ 2 * L * 1.7)
	end
	return st
end

-- point on the centre line at fraction f of the blade
local function centreAt(st, f)
	for i = 2, #st do
		if f <= st[i].f or i == #st then
			local a, b = st[i - 1], st[i]
			local u = (f - a.f) / max(b.f - a.f, 1e-6)
			return a.x + (b.x - a.x) * u, a.z + (b.z - a.z) * u
		end
	end
end

-- sawtooth / crystal spikes standing on one edge of a ribbon. Every tooth base lies inside ONE straight edge segment,
-- so the teeth never cut across (and overlap) the blade.
local function edgeSpikes(S, R, side, s0, s1, count, len, slant, y0, h, col, mat, tr, colB)
	local pts = side == "A" and R.A or R.B
	local out = side == "A" and 1 or -1
	local total, segs = 0, {}
	for i = 2, #pts do
		local l = sqrt((pts[i][1] - pts[i - 1][1]) ^ 2 + (pts[i][2] - pts[i - 1][2]) ^ 2)
		segs[i] = l
		total = total + l
	end
	local want = total * (s1 - s0) / count -- wanted tooth pitch
	local acc, n = 0, 0
	for i = 2, #pts do
		local ls = segs[i]
		local lo, hi = max(acc, s0 * total), min(acc + ls, s1 * total)
		if hi - lo > want * 0.5 and ls > 0.05 then
			local m = max(1, math.floor((hi - lo) / want + 0.5))
			local ax, az, bx, bz = pts[i - 1][1], pts[i - 1][2], pts[i][1], pts[i][2]
			local tx, tz = (bx - ax) / ls, (bz - az) / ls
			local nx, nz = -tz * out, tx * out
			for j = 0, m - 1 do
				local u0 = (lo - acc + (hi - lo) * j / m) / ls
				local u1 = (lo - acc + (hi - lo) * (j + 0.8) / m) / ls
				local um = (u0 + u1) / 2
				n = n + 1
				local l = len * (0.8 + 0.4 * ((n * 37) % 5) / 4)
				S.tri({ ax + (bx - ax) * u0, az + (bz - az) * u0 },
					{ ax + (bx - ax) * um + nx * l - tx * l * slant, az + (bz - az) * um + nz * l - tz * l * slant },
					{ ax + (bx - ax) * u1, az + (bz - az) * u1 }, y0, h, (colB and n % 2 == 0) and colB or col, mat, tr)
			end
		end
		acc = acc + ls
	end
end

local function sword(S, w, P, out, k)
	local t, v = w.tier, w.v
	local sp = SW[w.id] or {}
	local shape = sp.blade or (v == 1 and "short" or "saber")
	local L = sp.L or (4.6 + 0.3 * t)
	local W = sp.W or (1.0 + 0.07 * t)
	local hw = W / 2

	local leather = t <= 2 and C(84, 54, 34) or darker(P.acc, 0.55)
	if t >= 5 and not w.rainbow then leather = mix(darker(P.acc, 0.45), C(60, 40, 30), 0.5) end
	local metalCol = (t <= 2) and C(212, 168, 72) or P.acc
	if t == 1 then metalCol = (v == 1) and C(190, 150, 70) or C(150, 150, 156) end
	local metalDark = darker(metalCol, 0.62)
	if t >= 6 and not w.rainbow then metalDark = darker(P.acc, 1.0) end
	local metalHi = (t >= 6 and not w.rainbow) and mix(metalCol, P.main, 0.5) or lighter(metalCol, 0.14)
	local bladeCol = (t <= 2) and lighter(P.main, 0.12) or P.main
	if t == 6 and not w.rainbow then bladeCol = darker(P.main, 0.3) end
	local faceCol = (t == 6 and not w.rainbow) and darker(P.main, 0.2) or lighter(P.main, 0.5)
	if t == 1 then
		bladeCol, faceCol = (v == 1) and C(168, 180, 198) or C(150, 146, 140), (v == 1) and C(222, 230, 241) or C(205, 200, 195)
	end
	if w.rainbow then bladeCol, faceCol = RB, lighter(RB, 0.5) end
	local fullerCol = t >= 3 and P.glow or C(118, 132, 156)
	local fullerMat = t >= 3 and NEON or METAL

	-- ------------------------------------------------------------------ grip + pommel
	local gz = -0.75
	S.box(0, 0.37, 0.44, 1.66, 0.10, 0.10, 0, leather, FABRIC)
	for i = 0, 2 do S.box(0, -0.15 + i * 0.45, 0.56, 0.13, 0.20, 0.05, 0, darker(leather, 0.6), FABRIC) end
	local pd = 0.82 + 0.05 * t
	S.disc(0, 1.5, pd, 0.10, 0.14, metalDark, METAL)
	S.disc(0, 1.5, pd - 0.36, 0.24, 0.06, metalCol, METAL)
	if t >= 3 then S.disc(0, 1.5, 0.3 + 0.03 * t, 0.30, 0.08, P.glow, NEON) end
	if sp.spike then S.tri({ -0.3, 1.5 + pd / 2 - 0.05 }, { 0, 1.5 + pd / 2 + 1.0 }, { 0.3, 1.5 + pd / 2 - 0.05 }, 0.10, 0.14, metalDark, METAL) end

	-- ------------------------------------------------------------------ guard
	local gt = sp.guard or (v == 1 and "bar" or "disc")
	local gemY, bladeStart = 0.30, nil
	local gw = 2.6 + 0.14 * t
	local function bar(width)
		S.box(0, gz, width, 0.56, 0.10, 0.10, 0, metalDark, METAL)
		S.box(0, gz, width - 0.5, 0.3, 0.20, 0.06, 0, metalHi, METAL)
		for _, sx in ipairs({ -1, 1 }) do
			S.disc(sx * width / 2, gz, 0.64, 0.10, 0.21, metalCol, METAL)
		end
	end
	if gt == "bar" then
		bar(gw)
	elseif gt == "disc" then
		local d = 1.9 + 0.1 * t
		S.disc(0, gz, d, 0.10, 0.20, metalDark, METAL)
		S.disc(0, gz, d - 0.4, 0.30, 0.05, metalCol, METAL)
		S.disc(0, gz, d - 1.0, 0.35, 0.05, metalDark, METAL)
		gemY = 0.40
		bladeStart = gz - d / 2 + 0.1
		if sp.tassel then
			for i = 0, 2 do S.box(-0.2 + i * 0.2, 2.05 + (0.9 - 0.1 * i) / 2, 0.14, 0.9 - 0.1 * i, 0.10, 0.04, 0, P.glow, FABRIC) end
		end
	elseif gt == "horn" then
		bar(gw)
		for _, sx in ipairs({ -1, 1 }) do
			S.ribbon({
				{ x = sx * (gw / 2 + 0.12), z = gz + 0.1, a = 0.28, b = 0.28 },
				{ x = sx * (gw / 2 + 0.55), z = gz - 0.55, a = 0.24, b = 0.24 },
				{ x = sx * (gw / 2 + 0.5), z = gz - 1.35 - 0.1 * t, a = 0.14, b = 0.14 },
				{ x = sx * (gw / 2 + 0.25), z = gz - 2.0 - 0.1 * t, a = 0, b = 0 },
			}, 0.10, 0.10, metalCol, METAL)
		end
	elseif gt == "leaf" then
		for _, sx in ipairs({ -1, 1 }) do
			S.shard(sx * 0.3, gz + 0.1, 1.9, 0.9, sx > 0 and -0.2 or PI + 0.2, 0.45, 0.10, 0.10, darker(metalCol, 0.7), METAL)
			S.shard(sx * 0.5, gz + 0.08, 1.4, 0.5, sx > 0 and -0.2 or PI + 0.2, 0.45, 0.20, 0.06, metalCol, METAL)
		end
		S.disc(0, gz, 0.9, 0.26, 0.05, darker(metalCol, 0.6), METAL)
	elseif gt == "knuckle" then
		bar(gw)
		S.ribbon({
			{ x = gw / 2 - 0.1, z = gz + 0.2, a = 0.2, b = 0.2 },
			{ x = gw / 2 + 0.25, z = gz + 0.85, a = 0.2, b = 0.2 },
			{ x = gw / 2 - 0.1, z = gz + 1.5, a = 0.2, b = 0.2 },
			{ x = 0.35, z = 1.3, a = 0.18, b = 0.18 },
		}, 0.30, 0.06, metalCol, METAL)
	elseif gt == "fang" then
		bar(gw - 0.2)
		for _, sx in ipairs({ -1, 1 }) do
			S.spike(sx * ((gw - 0.2) / 2 + 0.35), gz, 2.1, 0.7, -PI / 2 + sx * 0.12, 0.10, 0.10, metalCol, METAL)
			S.spike(sx * ((gw - 0.2) / 2 + 0.75), gz + 0.25, 1.0, 0.4, -PI / 2 + sx * 0.9, 0.10, 0.10, metalDark, METAL, 0.1)
		end
	elseif gt == "bolt" then
		bar(gw)
		for _, sx in ipairs({ -1, 1 }) do
			S.spike(sx * (gw / 2 + 0.1), gz - 0.1, 1.5, 0.4, -PI / 2 + sx * 0.55, 0.10, 0.10, metalCol, METAL)
			S.spike(sx * (gw / 2 + 0.1), gz + 0.15, 1.3, 0.36, PI / 2 + sx * 0.5, 0.10, 0.10, metalDark, METAL)
		end
	elseif gt == "sun" then
		bar(gw + 0.3)
		for i = 0, 11 do
			if i ~= 0 and i ~= 3 and i ~= 6 and (i < 8 or i > 10) then
				local a = i / 12 * PI * 2
				S.spike(cos(a) * 0.95, gz + sin(a) * 0.95, (i % 2 == 0) and 0.9 or 0.55, 0.42, a, 0.10, 0.10, (i % 2 == 0) and P.main or P.acc, METAL)
			end
		end
		S.disc(0, gz, 1.9, 0.10, 0.20, darker(metalCol, 0.75), METAL)
		S.disc(0, gz, 1.45, 0.30, 0.05, P.main, METAL)
		gemY = 0.35
		bladeStart = gz - 1.0 + 0.1
	elseif gt == "wing" then
		for _, sx in ipairs({ -1, 1 }) do
			for i = 1, 4 do
				local a = sx > 0 and (-0.5 + i * 0.3) or (PI + 0.5 - i * 0.3)
				local col = (i % 2 == 0) and P.glow or P.main
				S.shard(sx * 0.35, gz + 0.1, 1.5 + 0.45 * i + (t - 5) * 0.2, 0.5 + 0.06 * i, a, 0.4, 0.10 + 0.05 * (i - 1), 0.05, col, NEON, 0.1)
			end
		end
		S.disc(0, gz, 0.95, 0.30, 0.06, metalDark, METAL)
	elseif gt == "crescent" then
		bar(gw - 0.5)
		local cz = gz - 0.3
		for _, sx in ipairs({ -1, 1 }) do
			local a0, a1 = sx > 0 and PI * 0.4 or PI * 0.6, sx > 0 and -PI * 0.2 or PI * 1.2
			S.arc(0, cz, 2.0, a0, a1, 7, 0.6, 0.12, 0.10, 0.10, metalDark, METAL)
			S.arc(0, cz, 2.0, a0 + (a1 - a0) * 0.12, a1 - (a1 - a0) * 0.08, 6, 0.2, 0.04, 0.20, 0.06, P.main, NEON, 0.1)
		end
	elseif gt == "claw" then
		bar(gw - 0.2)
		for _, sx in ipairs({ -1, 1 }) do
			S.arc(sx * (gw / 2 + 0.3), gz - 0.9, 0.9, sx > 0 and PI * 1.0 or 0, sx > 0 and PI * 1.65 or -PI * 0.65, 5, 0.42, 0.04, 0.10, 0.10, metalHi, METAL)
		end
	end
	-- guard gem
	local gem = S.disc(0, gz, 0.5 + 0.06 * t, gemY, 0.12, (t >= 2) and P.glow or C(186, 52, 66), (t >= 2) and NEON or SMOOTH)
	S.disc(0, gz, 0.16 + 0.02 * t, gemY + 0.12, 0.05, C(255, 255, 255), NEON, 0.15)
	if t >= 4 then light(gem, P.glow, 8 + t * 2, 0.9 + t * 0.12) end

	-- ------------------------------------------------------------------ blade
	local z0 = bladeStart or (gz - 0.28)
	local st = bladeStations(shape, L, W, z0)
	if t >= 5 then -- soft aura under the blade (translucent, in its own low slabs)
		local au1, au2 = {}, {}
		local step = (#st > 6) and 2 or 1 -- the aura is soft, it does not need every station
		for i = 1, #st do
			local s = st[i]
			if i % step == 1 or step == 1 or i == #st then
				au1[#au1 + 1] = { x = s.x, z = s.z, a = s.a * 1.6 + 0.1, b = s.b * 1.6 + 0.1 }
				au2[#au2 + 1] = { x = s.x, z = s.z, a = s.a * 2.2 + 0.2, b = s.b * 2.2 + 0.2 }
			end
		end
		au1[#au1].a, au1[#au1].b, au2[#au2].a, au2[#au2].b = 0, 0, 0, 0
		S.ribbon(au2, 0.0, 0.03, P.main, NEON, 0.93)
		S.ribbon(au1, 0.06, 0.03, P.glow, NEON, 0.84)
	end
	local R = S.ribbon(st, 0.10, 0.10, bladeCol, METAL)
	local fc = {}
	for i, s in ipairs(st) do fc[i] = { x = s.x, z = s.z, a = s.a * 0.56, b = s.b * 0.56 } end
	S.ribbon(fc, 0.20, 0.06, faceCol, METAL)
	local deco = sp.deco
	if deco == "zigzag" then
		local pts = {}
		for i = 0, 7 do
			local cx, cz = centreAt(st, 0.07 + i * 0.1)
			pts[#pts + 1] = { cx + ((i % 2 == 0) and -1 or 1) * hw * 0.2, cz }
		end
		for i = 2, #pts do S.beam(pts[i - 1][1], pts[i - 1][2], pts[i][1], pts[i][2], 0.13, 0.26, 0.05, P.glow, NEON) end
	else
		local fl = {}
		for i, f in ipairs({ 0.05, 0.22, 0.4, 0.58, 0.74 }) do
			local cx, cz = centreAt(st, f)
			fl[i] = { x = cx, z = cz, a = hw * 0.1, b = hw * 0.1 }
		end
		S.ribbon(fl, 0.26, 0.05, fullerCol, fullerMat)
	end

	-- ------------------------------------------------------------------ rarity / theme decorations
	if deco == "ice" then
		edgeSpikes(S, R, "A", 0.1, 0.78, 4, 0.6, 0.55, 0.10, 0.10, P.glow, NEON, 0.12)
		edgeSpikes(S, R, "B", 0.1, 0.78, 4, 0.6, 0.55, 0.10, 0.10, P.glow, NEON, 0.12)
	elseif deco == "wave" then
		edgeSpikes(S, R, "A", 0.14, 0.9, 4, 0.55, -0.7, 0.10, 0.10, P.glow, NEON, 0.1)
	elseif deco == "teeth" then
		edgeSpikes(S, R, "A", 0.08, 0.86, 5, 0.58, 0.75, 0.10, 0.10, P.glow, NEON, 0.1, P.main)
		edgeSpikes(S, R, "B", 0.08, 0.86, 5, 0.58, 0.75, 0.10, 0.10, P.glow, NEON, 0.1, P.main)
	elseif deco == "flames" then
		edgeSpikes(S, R, "A", 0.1, 0.9, 4, 0.8, 0.55, 0.10, 0.10, P.glow, NEON, 0.08, P.main)
		edgeSpikes(S, R, "B", 0.3, 0.9, 2, 0.5, 0.55, 0.10, 0.10, P.main, NEON, 0.1, P.glow)
	elseif deco == "hook" then
		edgeSpikes(S, R, "A", 0.1, 0.75, 4, 0.8, 0.6, 0.10, 0.10, darker(P.main, 0.55), METAL, 0, P.glow)
	elseif deco == "eclipse" then
		local cx, cz = centreAt(st, 0.3)
		S.disc(cx, cz, 1.25, 0.31, 0.05, P.acc, METAL)
		S.ring(cx, cz, 0.92, 14, 0.2, 0.36, 0.05, P.main, NEON, 0, 0.7)
		S.disc(cx, cz, 0.45, 0.36, 0.05, P.glow, NEON)
	elseif deco == "shards" then
		for i = 1, 3 do
			local f = 0.18 + i * 0.24
			local cx, cz = centreAt(st, f)
			for _, sx in ipairs({ -1, 1 }) do
				S.shard(cx + sx * (hw + 0.5 + 0.12 * i), cz + 0.5, 1.1 + 0.2 * i, 0.5, -PI / 2 + sx * 0.12, 0.45, 0.20, 0.08, (i % 2 == 0) and P.glow or P.main, NEON, 0.1)
			end
		end
	end
	if t >= 3 and deco ~= "ice" and deco ~= "zigzag" and deco ~= "eclipse" then -- rune glints on the face
		for i = 1, 3 do
			local cx, cz = centreAt(st, i / 4.2 + 0.04)
			S.box(cx, cz, hw * 0.3, 0.3, 0.31, 0.05, 0, P.glow, NEON, 0.15)
		end
	end
	if t >= 5 and deco ~= "shards" then -- floating shards hovering next to the blade
		for i = 1, 3 do
			local f = i / 3.6
			local cx, cz = centreAt(st, f)
			for _, sx in ipairs({ -1, 1 }) do
				S.shard(cx + sx * (hw + 0.8 + 0.15 * i), cz - 0.1, 0.9 + 0.12 * i, 0.4, -PI / 2 + sx * 0.15, 0.5, 0.20, 0.08, (i % 2 == 0) and P.glow or P.main, NEON, 0.1)
			end
		end
	end
	if t >= 6 and deco ~= "eclipse" then -- cracks of light across the blade
		for i = 1, 5 do
			local cx, cz = centreAt(st, i / 6.4 + 0.1)
			S.box(cx, cz, hw * 0.7, 0.13, 0.36, 0.05, (i % 2 == 0 and 0.55 or -0.55), P.glow, NEON, 0.1)
		end
	end
	if t >= 7 then -- orbiting shards
		local cx, cz = centreAt(st, 0.5)
		for i = 0, 7 do
			local a = i / 8 * PI * 2
			local ex, ez = cx + cos(a) * (hw + 2.3), cz + sin(a) * (L * 0.55)
			S.shard(ex, ez, 0.9, 0.34, a + PI / 2, 0.5, 0.46, 0.08, RB, NEON, 0.05)
		end
	end

	-- ------------------------------------------------------------------ particles / light / trail (on an invisible part)
	local mx, mz = centreAt(st, 0.5)
	local fx = S.ghost(mx, mz, W * 0.8, L * 0.8, 0.12, 0.05)
	if t >= 2 then
		out.emitter = emitter(fx, P.glow, P.main, 2 + t * 3, 0.32 + 0.05 * t, 0.9 + 0.08 * t, 1.2 + 0.2 * t)
	end
	if t >= 5 then light(fx, P.glow, 12 + t * 2, 1.2) end
	local a0 = attach(fx, 0, 0, -L * 0.5, k)
	local a1 = attach(fx, 0, 0, L * 0.1, k)
	out.trail = mkTrail(fx, a0, a1, (t >= 2) and P.glow or C(225, 240, 255), (t >= 2) and P.main or C(120, 170, 235), 0.2 + 0.02 * t)
	out.tipZ = st[#st].z
	out.bladeLen = L
end

-- ============================================================================ BOW
-- Height slabs: halo 0..0.09 | limb 0.10..0.18 | limb face 0.18..0.24 | inlay 0.24..0.28 | string / tip caps 0.24..0.36
-- | riser 0.24..0.36 | gems 0.36..0.43 | arrow 0.44..0.58
local function bow(S, w, P, out, k)
	local t, v = w.tier, w.v
	local R = 3.0 + 0.11 * t
	local wood = (t <= 1) and P.main or ((t <= 2) and darker(P.main, 0.8) or P.main)
	if t == 6 and not w.rainbow then wood = darker(P.main, 0.45) end
	if w.rainbow then wood = RB end
	local woodHi = (t <= 1) and lighter(P.main, 0.3) or lighter(P.main, 0.45)
	if w.rainbow then woodHi = RB end
	local metalCol = (t <= 1) and C(212, 168, 72) or P.acc
	if t == 1 and v == 2 then metalCol = C(160, 160, 150) end
	if t >= 6 and not w.rainbow then metalCol = mix(P.acc, P.main, 0.5) end
	local limbMat = (t <= 2) and WOOD or ((t >= 5) and NEON or METAL)
	if t >= 5 then limbMat = METAL end

	-- ------------------------------------------------------------------ limb centre line (left tip -> right tip)
	local half = (0.55 + 0.03 * t) / 2
	local st, face, inlay = {}, {}, {}
	local tipX, tipZ
	if v == 1 then
		tipX, tipZ = R * sin(math.rad(75)), R * (1 - cos(math.rad(75)))
		for i = -4, 4 do
			local th = math.rad(i * 18.75)
			local ww = half * (1 - 0.55 * abs(i) / 4)
			st[#st + 1] = { x = R * sin(th), z = R * (1 - cos(th)), a = ww, b = ww }
		end
	else
		tipX = R * 1.0
		tipZ = R * 0.74
		for _, s in ipairs({ -1, -0.85, -0.68, -0.5, -0.3, -0.12, 0.12, 0.3, 0.5, 0.68, 0.85, 1 }) do
			local ww = half * (1 - 0.5 * abs(s) ^ 1.5)
			st[#st + 1] = { x = tipX * s * (1 - 0.1 * s * s), z = tipZ * (3.3 * s * s - 2.3 * s ^ 4), a = ww, b = ww }
		end
		tipZ = st[1].z
	end
	local last = #st
	tipX = st[last].x
	for i, s in ipairs(st) do face[i] = { x = s.x, z = s.z, a = s.a * 0.55, b = s.b * 0.55 } end

	-- magic halo behind the bow (own low slabs, nothing else lives there)
	if t >= 5 then
		S.disc(0, tipZ * 0.5, R * 2.5, 0.0, 0.03, P.glow, NEON, 0.92)
		S.disc(0, tipZ * 0.5, R * 1.7, 0.06, 0.03, P.main, NEON, 0.88)
	end
	-- feathers / wings at the tips (below the limbs, outward + backward)
	if t >= 4 then
		for _, sx in ipairs({ -1, 1 }) do
			for i = 1, t - 2 do
				local a = 0.2 + 0.2 * i
				if sx < 0 then a = PI - a end
				S.shard(st[sx < 0 and 1 or last].x + cos(a) * 0.15, st[sx < 0 and 1 or last].z + sin(a) * 0.15, 1.2 + 0.42 * i, 0.42, a, 0.4, 0.12 + 0.045 * (i - 1), 0.04, (i % 2 == 0) and P.glow or P.main, NEON, 0.14 + 0.02 * i)
			end
		end
	end

	S.ribbon(st, 0.10, 0.08, darker(wood, 0.75), limbMat)
	S.ribbon(face, 0.18, 0.06, wood, limbMat)
	if t >= 3 then -- glowing inlay along the limbs (every other station)
		for i = 1, #st do
			inlay[#inlay + 1] = { x = st[i].x, z = st[i].z, a = 0.05, b = 0.05 }
		end
		if #inlay >= 2 then
			S.ribbon(inlay, 0.24, 0.04, P.glow, NEON)
		end
	end
	-- limb tips: metal cap + glow bead
	for _, sx in ipairs({ -1, 1 }) do
		local s = st[sx < 0 and 1 or last]
		S.disc(s.x, s.z, 0.6 + 0.04 * t, 0.24, 0.12, metalCol, METAL)
		if t >= 2 then S.disc(s.x, s.z, 0.28 + 0.03 * t, 0.36, 0.06, P.glow, NEON) end
	end

	-- ------------------------------------------------------------------ riser
	local grip = (t <= 2) and C(66, 42, 28) or darker(P.acc, 0.5)
	if t >= 6 and not w.rainbow then grip = darker(P.main, 0.35) end
	S.box(0, 0, 0.7, 1.3, 0.24, 0.12, 0, grip, FABRIC)
	for _, sz in ipairs({ -0.6, 0.6 }) do S.box(0, sz, 0.82, 0.14, 0.36, 0.05, 0, metalCol, METAL) end
	if t >= 3 then S.disc(0, 0, 0.4 + 0.04 * t, 0.36, 0.07, P.glow, NEON) end
	if t >= 6 then S.ring(0, tipZ * 0.45, R * 1.35, 22, 0.22, 0.62, 0.04, P.glow, NEON, 0.2, 0.7) end
	if t >= 7 then
		for i = 0, 5 do
			local a = i / 6 * PI * 2
			S.shard(cos(a) * R * 1.5, sin(a) * R * 0.95 + tipZ * 0.5, 1.0, 0.36, a + PI / 2, 0.5, 0.2, 0.08, RB, NEON, 0.05)
		end
	end

	-- ------------------------------------------------------------------ string (two beams meeting at the nock)
	local nockZ = tipZ + 0.6
	local strC = (t >= 3) and P.glow or C(238, 233, 214)
	local strMat = (t >= 3) and NEON or FABRIC
	local strW = (t >= 3) and 0.1 or 0.08
	S.beam(tipX, tipZ, 0, nockZ, strW, 0.26, 0.05, strC, strMat)
	S.beam(-tipX, tipZ, 0, nockZ, strW, 0.26, 0.05, strC, strMat)

	-- ------------------------------------------------------------------ nocked arrow (hidden / shown by the server after each shot)
	local arrow = {}
	S.rec = arrow
	local headZ = -3.4 - 0.12 * t
	local hl = 0.95 + 0.04 * t
	local zb = headZ + hl -- base of the head
	local ws = 0.14 + 0.01 * t
	local shaftCol = (t >= 3) and lighter(P.glow, 0.2) or C(232, 222, 188)
	local headCol = (t >= 3) and P.glow or C(176, 188, 206)
	local ay = 0.50
	if t >= 5 then -- glow comet around the arrow
		S.ribbon({
			{ x = 0, z = nockZ, a = 0.08, b = 0.08 }, { x = 0, z = zb + 0.6, a = 0.3, b = 0.3 },
			{ x = 0, z = zb - 0.1, a = 0.62, b = 0.62 }, { x = 0, z = headZ - 0.5, a = 0, b = 0 },
		}, 0.45, 0.03, P.glow, NEON, 0.82)
	end
	S.box(0, (nockZ + zb) / 2, ws, nockZ - zb, ay, 0.06, 0, shaftCol, (t >= 3) and NEON or WOOD)
	S.shard(0, zb, hl, 0.62 + 0.04 * t, -PI / 2, 0.3, ay, 0.08, headCol, (t >= 3) and NEON or METAL)
	S.shard(0, zb - 0.05, hl * 0.6, 0.26, -PI / 2, 0.35, ay + 0.08, 0.04, lighter(headCol, 0.6), NEON, 0.05)
	local fl = (t <= 2) and C(196, 62, 62) or P.main
	for _, sx in ipairs({ -1, 1 }) do
		local x0 = sx * ws / 2
		S.quad({
			{ x0, nockZ - 0.95 }, { x0 + sx * 0.3, nockZ - 0.55 }, { x0 + sx * 0.3, nockZ + 0.02 }, { x0, nockZ - 0.38 },
		}, ay, 0.06, fl, FABRIC)
	end
	S.rec = nil
	for _, p in ipairs(arrow) do p:SetAttribute("T0", p.Transparency) end
	out.arrow = arrow

	-- ------------------------------------------------------------------ sparks + light
	local base = S.ghost(0, tipZ * 0.5, R * 1.2, R * 0.6, 0.12, 0.05)
	if t >= 2 then out.emitter = emitter(base, P.glow, P.main, 2 + t * 3, 0.3 + 0.05 * t, 1 + 0.1 * t, 1.5 + 0.2 * t) end
	if t >= 4 then light(base, P.glow, 10 + t * 2, 1 + 0.12 * t) end
	if t >= 3 then
		for _, sx in ipairs({ -1, 1 }) do
			local tp = S.ghost(sx * tipX, tipZ, 0.4, 0.4, 0.12, 0.05)
			emitter(tp, P.glow, P.main, 1 + t * 2, 0.3 + 0.04 * t, 0.7, 2)
		end
	end
end

-- ============================================================================ STAFF
-- Height slabs: halo 0..0.02 | under-pieces 0.04..0.09 | shaft / head 0.10..0.20 | head details 0.20..0.30
-- | orb glow 0.30..0.36 | orb core 0.36..0.44.  (head details never go above 0.30 so the orb glow floats cleanly on top)
local function staff(S, w, P, out, k)
	local t, v = w.tier, w.v
	local o = -5.9 -- orb centre (z)
	local shaftCol = (t == 1) and P.main or ((t <= 3) and darker(P.main, 0.7) or ((t >= 6 or w.rainbow) and P.dark or darker(P.acc, 0.55)))
	if t == 7 then shaftCol = C(30, 26, 46) end
	local woodHi = (t == 1) and lighter(P.main, 0.3) or lighter(shaftCol, 0.3)
	local metalCol = (t <= 1) and C(212, 168, 72) or P.acc
	if t == 1 and v == 2 then metalCol = P.acc end
	if t >= 6 and not w.rainbow then metalCol = mix(P.acc, P.main, 0.45) end
	local shaftMat = (t <= 2) and WOOD or METAL

	-- ------------------------------------------------------------------ shaft (kept in LOW slabs so head pieces that reach back over it never fight with it)
	S.box(0, -1.6, 0.5 + 0.02 * t, 8.0, 0.04, 0.10, 0, shaftCol, shaftMat)
	S.box(0.12, 0.15, 0.14, 3.3, 0.14, 0.04, 0, woodHi, shaftMat)
	if v == 2 and t == 1 then -- knots of the branch
		for _, z in ipairs({ -2.2, -3.4 }) do S.disc(0.12, z, 0.8, 0.18, 0.06, darker(shaftCol, 0.8), WOOD) end
	end
	for _, z in ipairs({ 1.2, 0.2, -0.8 }) do
		S.box(0, z, 0.8, 0.3, 0.14, 0.09, 0, darker(metalCol, 0.65), METAL)
		S.box(0, z, 0.8, 0.12, 0.23, 0.04, 0, metalCol, METAL)
	end
	if t >= 2 then
		for _, z in ipairs({ 0.7, -0.3 }) do S.box(-0.04, z, 0.1, 0.36, 0.14, 0.05, 0, P.glow, NEON, 0.35) end
	end
	S.disc(0, 2.4, 0.86, 0.04, 0.15, darker(metalCol, 0.65), METAL)
	S.disc(0, 2.4, 0.5, 0.19, 0.06, metalCol, METAL)
	if t >= 4 then S.disc(0, 2.4, 0.4, 0.25, 0.05, P.glow, NEON) end

	-- ------------------------------------------------------------------ heads
	local haloD = 3.7 + 0.45 * t
	local function leaf(cx, cz, len, wid, a, y0, h, col, mat, tr) S.shard(cx, cz, len, wid, a, 0.45, y0, h, col, mat, tr) end
	if t == 1 and v == 1 then -- apprentice: bronze cradle holding the orb
		S.ring(0, o, 1.25, 10, 0.4, 0.10, 0.10, metalCol, METAL, 0, 0.8)
		for i = 0, 3 do
			local a = math.rad(45 + i * 90)
			S.spike(cos(a) * 1.5, o + sin(a) * 1.5, 1.1, 0.5, a, 0.10, 0.10, darker(metalCol, 0.8), METAL)
		end
		for i = 0, 3 do
			local a = math.rad(i * 90)
			S.spike(cos(a) * 1.5, o + sin(a) * 1.5, 0.55, 0.34, a, 0.10, 0.10, metalCol, METAL)
		end
	elseif t == 1 then -- gnarled branch fork with leaves
		for _, sx in ipairs({ -1, 1 }) do
			S.ribbon({
				{ x = sx * 0.2, z = o + 0.55, a = 0.3, b = 0.3 }, { x = sx * 1.05, z = o - 0.1, a = 0.26, b = 0.26 },
				{ x = sx * 1.7, z = o - 1.1, a = 0.2, b = 0.2 }, { x = sx * 1.6, z = o - 2.1, a = 0.1, b = 0.1 },
				{ x = sx * 1.15, z = o - 2.75, a = 0, b = 0 },
			}, 0.10, 0.10, shaftCol, WOOD)
			leaf(sx * 1.95, o - 0.35, 1.3, 0.7, sx > 0 and -0.5 or PI + 0.5, 0.20, 0.06, P.acc, FABRIC)
			leaf(sx * 1.75, o - 1.5, 1.2, 0.62, sx > 0 and -1.0 or PI + 1.0, 0.20, 0.06, lighter(P.acc, 0.25), FABRIC)
			leaf(sx * 1.0, o + 0.2, 1.0, 0.5, sx > 0 and 0.4 or PI - 0.4, 0.20, 0.06, darker(P.acc, 0.8), FABRIC)
		end
	elseif t == 2 and v == 1 then -- jade rod: crystal + leaves
		for i = 0, 3 do
			local a = i * PI / 2 + PI / 4
			leaf(cos(a) * 0.5, o + sin(a) * 0.5, 2.1, 0.8, a, 0.04, 0.05, P.acc, METAL)
		end
		S.shard(0, o + 1.5, 3.2, 1.8, -PI / 2, 0.45, 0.10, 0.10, P.main, METAL)
		S.shard(0, o + 0.9, 2.0, 1.0, -PI / 2, 0.45, 0.20, 0.06, lighter(P.main, 0.35), NEON, 0.1)
	elseif t == 2 then -- crook with a leaf-wrapped hook
		S.arc(0, o, 1.6, -PI / 2 + 0.55, PI * 1.5 - 0.55, 9, 0.42, 0.3, 0.10, 0.10, P.acc, WOOD)
		for i = 0, 5 do
			local a = -PI / 2 + 0.75 + i * (PI * 2 - 1.5) / 5
			leaf(cos(a) * 1.82, o + sin(a) * 1.82, 1.0, 0.62, a, 0.10, 0.10, (i % 2 == 0) and P.main or lighter(P.main, 0.25), FABRIC)
		end
	elseif t == 3 and v == 1 then -- aqua: long crystal, prongs and floating drops
		S.poly({
			{ 0, o - 2.5 }, { 0.8, o - 1.2 }, { 0.8, o + 0.5 }, { 0, o + 1.7 }, { -0.8, o + 0.5 }, { -0.8, o - 1.2 },
		}, 0.10, 0.10, P.main, METAL)
		S.poly({
			{ 0, o - 2.0 }, { 0.38, o - 1.1 }, { 0.38, o + 0.3 }, { 0, o + 1.2 }, { -0.38, o + 0.3 }, { -0.38, o - 1.1 },
		}, 0.20, 0.06, lighter(P.main, 0.35), NEON, 0.2)
		for _, sx in ipairs({ -1, 1 }) do
			S.shard(sx * 0.8, o + 0.5, 2.3, 0.6, sx > 0 and -0.55 or PI + 0.55, 0.4, 0.10, 0.10, P.acc, METAL)
			S.disc(sx * 2.7, o - 1.3, 0.55, 0.10, 0.12, P.glow, NEON, 0.15)
			S.disc(sx * 2.2, o + 0.4, 0.34, 0.10, 0.12, P.glow, NEON, 0.15)
		end
	elseif t == 3 then -- prism hexagon
		S.band(0, o, 1.5, 2.0, 6, 0.10, 0.10, P.main, METAL, nil, PI / 6)
		S.band(0, o, 0.95, 1.25, 6, 0.20, 0.06, P.glow, NEON, 0.2, PI / 6)
		local tr3 = {}
		for i = 0, 2 do local a = i * PI * 2 / 3 - PI / 2; tr3[#tr3 + 1] = { cos(a) * 1.15, o + sin(a) * 1.15 } end
		S.poly(tr3, 0.26, 0.04, P.acc, METAL)
	elseif t == 4 and v == 1 then -- amethyst cluster + orbit ring
		S.ring(0, o, 2.9, 22, 0.2, 0.05, 0.03, P.glow, NEON, 0.15, 0.7)
		for i = 0, 4 do
			local a = i / 5 * PI * 2 + 0.3
			S.shard(cos(a) * 0.9, o + sin(a) * 0.9, 2.3, 0.8, a, 0.35, 0.10 + 0.02 * (i % 2), 0.10, (i % 2 == 0) and P.main or lighter(P.main, 0.25), METAL)
		end
		for i = 0, 2 do
			local a = i / 3 * PI * 2
			S.disc(cos(a) * 2.9, o + sin(a) * 2.9, 0.7, 0.10, 0.16, P.glow, NEON, 0.05)
		end
	elseif t == 4 then -- stormspire: spire + lightning
		S.ring(0, o, 2.6, 18, 0.2, 0.05, 0.03, P.acc, NEON, 0.2, 0.7)
		S.shard(0, o + 1.5, 5.4, 1.3, -PI / 2, 0.38, 0.10, 0.10, P.main, METAL)
		S.shard(0, o + 0.6, 3.2, 0.5, -PI / 2, 0.4, 0.20, 0.06, lighter(P.main, 0.4), NEON, 0.1)
		for _, sx in ipairs({ -1, 1 }) do
			local pts = { { 1.2, 0.9 }, { 2.1, 0.0 }, { 1.5, -0.7 }, { 2.4, -1.7 }, { 1.8, -2.3 }, { 2.7, -3.3 } }
			for i = 2, #pts do
				S.beam(sx * pts[i - 1][1], o + pts[i - 1][2], sx * pts[i][1], o + pts[i][2], 0.22, 0.20, 0.06, P.acc, NEON, 0.05)
			end
		end
	elseif t == 5 and v == 1 then -- sun disc with rays
		S.ring(0, o, 2.25, 24, 0.5, 0.10, 0.10, metalCol, METAL, 0, 0.82)
		S.ring(0, o, 1.7, 20, 0.28, 0.20, 0.06, P.glow, NEON, 0.1, 0.78)
		for i = 0, 15 do
			local a = i / 16 * PI * 2
			local long = (i % 2 == 0)
			S.spike(cos(a) * 2.55, o + sin(a) * 2.55, long and (1.7 + (t - 5) * 0.3) or 0.95, long and 0.5 or 0.44, a, 0.10, 0.10, long and P.main or P.glow, NEON, 0.08)
		end
	elseif t == 5 then -- astral lantern cage
		S.band(0, o, 1.6, 2.05, 6, 0.10, 0.10, metalCol, METAL, nil, PI / 6)
		for i = 0, 5 do
			local a = i / 6 * PI * 2
			S.beam(cos(a) * 0.65, o + sin(a) * 0.65, cos(a) * 1.6, o + sin(a) * 1.6, 0.26, 0.20, 0.06, P.main, NEON, 0.12)
		end
		S.ring(0, o, 2.9, 20, 0.2, 0.05, 0.03, P.glow, NEON, 0.3, 0.7)
		for i, sx in ipairs({ -1.25, -0.8, 0.8, 1.25 }) do
			S.box(sx, o + 2.15 + (0.5 + 0.18 * i) / 2, 0.2, 0.5 + 0.18 * i, 0.10, 0.06, 0, P.main, FABRIC, 0.1)
		end
	elseif t == 6 and v == 1 then -- nether crown
		S.ring(0, o, 3.4, 26, 0.16, 0.05, 0.03, P.glow, NEON, 0.3, 0.7)
		S.ring(0, o, 1.3, 14, 0.4, 0.10, 0.10, P.main, NEON, 0.1, 0.8)
		for i = 0, 7 do
			local a = i / 8 * PI * 2
			S.shard(cos(a) * 1.7, o + sin(a) * 1.7, 2.3, 0.75, a, 0.3, 0.10, 0.10, P.dark, METAL)
			S.shard(cos(a) * 2.6, o + sin(a) * 2.6, 1.3, 0.32, a, 0.4, 0.20, 0.06, P.main, NEON, 0.05)
		end
	elseif t == 6 then -- hellfire pyre
		S.disc(0, o, 3.6, 0.10, 0.10, P.dark, METAL)
		S.disc(0, o, 2.8, 0.20, 0.06, P.main, NEON, 0.35)
		for i = 0, 6 do
			local a = i / 7 * PI * 2
			S.shard(cos(a) * 1.0, o + sin(a) * 1.0, 2.2 + (i % 3) * 0.6, 0.65, a, 0.35, 0.26, 0.04, (i % 2 == 0) and P.main or P.glow, NEON, 0.12)
		end
		for i = 0, 3 do
			local a = i * PI / 2 + 0.4
			S.spike(cos(a) * 1.8, o + sin(a) * 1.8, 1.6, 0.6, a, 0.10, 0.10, P.dark, METAL)
		end
	else -- galaxy weaver (secret)
		S.ring(0, o, 2.3, 20, 0.28, 0.05, 0.03, RB, NEON, 0.3, 0.7)
		S.ring(0, o, 4.5, 30, 0.2, 0.05, 0.03, RB, NEON, 0.4, 0.7)
		for i = 0, 2 do
			local a0 = i / 3 * PI * 2
			S.arc(0, o, 1.1, a0, a0 + PI * 1.15, 5, 0.55, 0.1, 0.18, 0.06, RB, NEON, 0.1, 3.4)
		end
		for i = 0, 11 do
			local a = i / 12 * PI * 2 + 0.2
			local r = 3.6 + (i % 3) * 0.45
			S.shard(cos(a) * r, o + sin(a) * r, 0.7, 0.3, a + 0.8, 0.5, 0.34, 0.06, RB, NEON)
		end
		for i = 0, 3 do
			local a = i * PI / 2 + PI / 4
			S.spike(cos(a) * 1.8, o + sin(a) * 1.8, 3.8, 0.34, a, 0.26, 0.04, RB, NEON, 0.2)
		end
		for i = 0, 5 do
			S.shard(0, 1.0 - i * 1.0, 0.7, 0.26, i * 1.1, 0.5, 0.36, 0.06, RB, NEON, 0.1)
		end
	end

	-- ------------------------------------------------------------------ orb (always present; the server animates it when you attack)
	local glowC = P.glow
	local halo = S.disc(0, o, haloD, 0.0, 0.02, glowC, NEON, 0.86)
	local mid = S.disc(0, o, 2.4 + 0.1 * t, 0.30, 0.06, glowC, NEON, 0.45)
	local core = S.disc(0, o, 1.2 + 0.06 * t, 0.36, 0.08, (w.rainbow and RB) or C(250, 252, 255), NEON, 0)
	local lt = light(mid, glowC, 14 + t * 2, 1 + t * 0.15)
	local em = emitter(core, C(235, 245, 255), glowC, 8 + t * 4, 0.45 * k + 0.05 * t, 1.0 + 0.1 * t, 1.5 + 0.3 * t)
	if t >= 5 then em.Speed = NumberRange.new(2, 6) end
	pcall(function()
		TweenService:Create(halo, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.68 }):Play()
	end)
	out.orb = { halo = halo, glow = mid, core = core, light = lt, emitter = em }
end

-- ============================================================================ PUBLIC
-- kind: "Swordsman" | "Archer" | "Mage".  opts.anchored = true builds a static model (for ViewportFrames)
function WM.build(kind, w, root, parent, handCF, scale, opts)
	local anchored = opts and opts.anchored
	local k = (scale or 1) * (1 + 0.022 * (w.tier - 1))
	local pivot = mkPart(parent, BLK, Vector3.new(0.3, 0.3, 0.3), root.CFrame * handCF, Color3.new(1, 1, 1), nil, 1, anchored)
	local weld
	if not anchored then
		weld = Instance.new("Weld")
		weld.Part0 = root
		weld.Part1 = pivot
		weld.C0 = handCF
		weld.Parent = pivot
	end
	local S = newS(pivot, parent, k, anchored)
	local out = { pivot = pivot, weld = weld, base = handCF, kind = kind, wdef = w }
	local P = palette(w)
	if kind == "Swordsman" then
		sword(S, w, P, out, k)
	elseif kind == "Archer" then
		bow(S, w, P, out, k)
	else
		staff(S, w, P, out, k)
	end
	return out
end

-- glowing rune circle under the hero's feet for high rarities (own slabs above the hero's shadow disc)
function WM.heroAura(root, parent, w, baseY)
	local t = w.tier
	if t < 4 then return end
	local P = palette(w)
	local pivot = mkPart(parent, BLK, Vector3.new(0.2, 0.2, 0.2), root.CFrame * CFrame.new(0, baseY + 0.05, 0), Color3.new(1, 1, 1), nil, 1, false)
	local wd = Instance.new("WeldConstraint")
	wd.Part0 = root
	wd.Part1 = pivot
	wd.Parent = pivot
	local S = newS(pivot, parent, 1, false)
	S.disc(0, 0, 7.5 + (t - 4) * 1.0, 0.10, 0.03, P.glow, NEON, 0.88)
	S.ring(0, 0, 3.9 + (t - 4) * 0.4, 28, 0.2, 0.14, 0.03, P.main, NEON, 0.2, 0.7)
	if t >= 5 then S.ring(0, 0, 2.9, 20, 0.16, 0.14, 0.03, P.glow, NEON, 0.3, 0.7) end
	if t >= 6 then
		for i = 0, 7 do
			local a = i / 8 * PI * 2
			S.spike(cos(a) * 4.5, sin(a) * 4.5, 2.0, 0.3, a, 0.18, 0.03, P.main, NEON, 0.2)
		end
		S.ring(0, 0, 6.8 + (t - 6), 36, 0.14, 0.14, 0.03, P.glow, NEON, 0.35, 0.7)
	end
	local p = S.ghost(0, 0, 0.5, 0.5, 0.1, 0.05)
	emitter(p, P.glow, P.main, 6 + t * 3, 0.4 + 0.05 * t, 1.4, 4 + t * 0.5)
end

-- rainbow weapons: cycle the colour of every tagged part (client side only; cheap)
local rainbowOn = false
function WM.startRainbow()
	if rainbowOn or RunService:IsServer() then return end
	rainbowOn = true
	RunService.Heartbeat:Connect(function()
		local tt = os.clock() * 0.32
		for _, p in ipairs(CollectionService:GetTagged("RainbowPart")) do
			local off = p:GetAttribute("rb")
			if off then p.Color = Color3.fromHSV((tt + off) % 1, 0.78, 1) end
		end
	end)
end

return WM
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX_WFX1">
<Properties>
<string name="Name">WeaponFX</string>
<ProtectedString name="Source"><![CDATA[-- WeaponFX (ReplicatedStorage.WeaponFX)
-- Premium attack VFX for swords / bows / staves.
--
-- Design rules (so the screen never turns into particle soup):
--   * every effect is built from a few crisp, readable layers - rarity makes the shapes sharper, bigger and
--     more distinctive, NOT noisier;
--   * every element has ONE signature motif that is the same on every weapon type:
--         nature = petals    frost = ice crystals    fire = flame tongues + embers   shock = forked lightning
--         void   = implosion holy  = light rays      prism = hue-shifting bands
--   * almost no ParticleEmitters - geometry + one scheduler loop (cheap, deterministic, easy to read);
--   * hard caps on part counts per effect.
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Theme = require(RS:WaitForChild("Theme"))

local FX = {}

local NEON = Enum.Material.Neon
local SMOOTH = Enum.Material.SmoothPlastic
local B, CY, BALL = Enum.PartType.Block, Enum.PartType.Cylinder, Enum.PartType.Ball
local C3 = Color3.fromRGB
local PI, TAU = math.pi, math.pi * 2
local rand, sin, cos, clamp, floor = math.random, math.sin, math.cos, math.clamp, math.floor

local folder = workspace:FindFirstChild("WeaponFX")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "WeaponFX"
	folder.Parent = workspace
end

-- ============================================================ palette
local ELEM = {
	none = { C3(190, 214, 240), C3(110, 140, 185), C3(244, 250, 255) },
	nature = { C3(90, 222, 112), C3(38, 140, 70), C3(218, 255, 200) },
	frost = { C3(118, 210, 255), C3(58, 128, 222), C3(236, 250, 255) },
	fire = { C3(255, 124, 40), C3(190, 36, 18), C3(255, 232, 156) },
	shock = { C3(150, 132, 255), C3(255, 226, 84), C3(250, 250, 255) },
	void = { C3(176, 84, 255), C3(44, 14, 78), C3(236, 192, 255) },
	holy = { C3(255, 206, 72), C3(255, 244, 200), C3(255, 252, 236) },
}
local STEEL_TAIL = C3(92, 112, 150)

local function hue(off, s, v)
	return Color3.fromHSV((os.clock() * 0.35 + off) % 1, s or 0.75, v or 1)
end

-- palette of the weapon in use (or of an explicit element, used for status procs)
local function pal(TH, el)
	if el and (not TH or TH.elem ~= el) then
		local e = ELEM[el] or ELEM.none
		return { main = e[1], acc = e[2], glow = e[3], elem = el, tier = TH and TH.tier or 3, rainbow = false }
	end
	if not TH then
		local e = ELEM.none
		return { main = e[1], acc = e[2], glow = e[3], elem = "none", tier = 1, rainbow = false }
	end
	local elem = TH.elem
	if TH.rainbow then elem = "prism" end
	local p = { main = Theme.main(TH), acc = Theme.accent(TH), glow = Theme.glow(TH), elem = elem, tier = TH.tier, rainbow = TH.rainbow }
	if elem == "none" then
		-- plain steel swords / bows: cool white-blue, never the brown of the handle colour
		p.acc = p.main:Lerp(STEEL_TAIL, 0.55)
		p.glow = C3(244, 250, 255)
	end
	return p
end

-- ============================================================ primitives
local function V(x, y, z) return Vector3.new(math.max(x, 0.05), math.max(y, 0.05), math.max(z, 0.05)) end

local function part(shape, size, cf, color, mat, tr)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or NEON
	p.Transparency = tr or 0
	p.Parent = folder
	return p
end

local function tw(o, t, props, style, dir)
	TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end

-- one Heartbeat loop drives every animated effect (fn(alpha, seconds); done() always runs)
local active = {}
local conn = nil
local function ensureLoop()
	if conn then return end
	conn = RunService.Heartbeat:Connect(function(dt)
		for i = #active, 1, -1 do
			local a = active[i]
			a.t = a.t + dt
			local finished = a.t >= a.dur
			if a.t >= 0 then
				local ok = pcall(a.fn, math.min(1, a.t / a.dur), a.t)
				if not ok then finished = true end
			end
			if finished then
				table.remove(active, i)
				if a.done then pcall(a.done) end
			end
		end
	end)
end
local function run(dur, fn, done, delay)
	ensureLoop()
	table.insert(active, { t = -(delay or 0), dur = dur, fn = fn, done = done })
end

local function disc(d, x, y, z, color, tr, mat, thick)
	return part(CY, V(thick or 0.2, d, d), CFrame.new(x, y, z) * CFrame.Angles(0, 0, PI / 2), color, mat or NEON, tr)
end

-- crisp outlined ring lying on the ground (works for expanding AND shrinking rings)
local function ring(x, y, z, d0, d1, color, dur, thick, tr0, tr1)
	local p = part(B, V(d0, 0.05, d0), CFrame.new(x, y, z), color, SMOOTH, 1)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(256, 256)
	sg.LightInfluence = 0
	sg.Brightness = 1.5
	sg.Parent = p
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Parent = sg
	local uc = Instance.new("UICorner")
	uc.CornerRadius = UDim.new(0.5, 0)
	uc.Parent = f
	local us = Instance.new("UIStroke")
	us.Color = color
	us.Thickness = thick or 7
	us.Transparency = tr0 or 0.1
	us.Parent = f
	tw(p, dur, { Size = V(d1, 0.05, d1) })
	tw(us, dur, { Transparency = tr1 or 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(p, dur + 0.1)
	return p
end

local function pillar(x, z, w, h, color, dur, tr0)
	local p = part(B, V(w, h, w), CFrame.new(x, h / 2, z), color, NEON, tr0 or 0.4)
	tw(p, dur, { Size = V(0.1, h, 0.1), Transparency = 1 })
	Debris:AddItem(p, dur + 0.1)
end

-- tapered shard that flies along `dir` (unit Vector3) while shrinking and fading
local function shard(pos, dir, len, w, color, o)
	o = o or {}
	local dur = o.dur or 0.35
	local travel = o.travel or len
	local h = o.h or 0.16
	local e = o.endLen or 0.25
	local p = part(B, V(w, h, len), CFrame.lookAt(pos + dir * len * 0.5, pos + dir * (len * 0.5 + 1)), color, o.mat or NEON, o.tr or 0.05)
	local c1 = pos + dir * (travel + len * e * 0.5)
	tw(p, dur, {
		CFrame = CFrame.lookAt(c1, c1 + dir),
		Size = V(w * (o.endW or 0.3), h, len * e),
		Transparency = 1,
	}, o.style)
	Debris:AddItem(p, dur + 0.1)
	return p
end

-- petal / leaf: a little diamond that drifts and spins away
local function petal(pos, dir, s, color, dur, travel, spin)
	local a0 = rand() * PI
	local p = part(B, V(s, 0.1, s), CFrame.new(pos) * CFrame.Angles(0, PI / 4 + a0, 0), color, NEON, 0.05)
	local c1 = pos + dir * travel + Vector3.new(0, 1.0, 0)
	tw(p, dur, {
		CFrame = CFrame.new(c1) * CFrame.Angles(0, PI / 4 + a0 + (spin or 2), 0),
		Size = V(s * 0.25, 0.1, s * 0.25),
		Transparency = 1,
	})
	Debris:AddItem(p, dur + 0.1)
end

-- 4-point glint
local function flare(x, y, z, size, color, core, dur, rot)
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rot or rand() * PI, 0)
	local cf2 = cf * CFrame.Angles(0, PI / 4, 0)
	local list = {
		part(B, V(size * 0.5, 0.1, size * 0.09), cf, color, NEON, 0.1),
		part(B, V(size * 0.09, 0.1, size * 0.5), cf, color, NEON, 0.1),
		part(B, V(size * 0.3, 0.1, size * 0.05), cf2, core, NEON, 0.25),
		part(B, V(size * 0.05, 0.1, size * 0.3), cf2, core, NEON, 0.25),
	}
	tw(list[1], dur, { Size = V(size, 0.1, size * 0.02), Transparency = 1 })
	tw(list[2], dur, { Size = V(size * 0.02, 0.1, size), Transparency = 1 })
	tw(list[3], dur, { Size = V(size * 0.6, 0.1, size * 0.01), Transparency = 1 })
	tw(list[4], dur, { Size = V(size * 0.01, 0.1, size * 0.6), Transparency = 1 })
	local o = part(BALL, V(size * 0.2, size * 0.2, size * 0.2), cf, core, NEON, 0)
	tw(o, dur, { Size = V(size * 0.5, size * 0.5, size * 0.5), Transparency = 1 })
	for _, p in ipairs(list) do Debris:AddItem(p, dur + 0.1) end
	Debris:AddItem(o, dur + 0.1)
end

-- forked lightning between two world points (flat in the XZ plane)
local function bolt(a, b, col, core, w, segs, jag, life)
	local d = b - a
	local len = d.Magnitude
	if len < 0.2 then return end
	local fwd = d.Unit
	local side = Vector3.new(-fwd.Z, 0, fwd.X)
	local pts = { a }
	for i = 1, segs - 1 do
		local f = i / segs
		local off = (rand() - 0.5) * 2 * jag * (1 - math.abs(f - 0.5) * 0.7)
		table.insert(pts, a + d * f + side * off)
	end
	table.insert(pts, b)
	local list = {}
	for i = 1, #pts - 1 do
		local p0, p1 = pts[i], pts[i + 1]
		local l = (p1 - p0).Magnitude
		if l > 0.02 then
			local cf = CFrame.lookAt((p0 + p1) / 2, p1)
			table.insert(list, part(B, V(w * 2.6, 0.12, l + w * 0.6), cf, col, NEON, 0.5))
			table.insert(list, part(B, V(w, 0.16, l + w * 0.4), cf, core, NEON, 0))
		end
	end
	for _, p in ipairs(list) do
		tw(p, life, { Transparency = 1 }, Enum.EasingStyle.Linear)
		Debris:AddItem(p, life + 0.1)
	end
end

local function trail(part0, c0, c1, width, life, zoff, o)
	o = o or {}
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-width / 2, 0, zoff or 0)
	a0.Parent = part0
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(width / 2, 0, zoff or 0)
	a1.Parent = part0
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = life
	t.Color = o.seq or ColorSequence.new(c0, c1)
	t.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, o.tr0 or 0.1),
		NumberSequenceKeypoint.new(0.55, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	t.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	t.LightEmission = o.le or 0.85
	t.LightInfluence = 0
	t.MinLength = 0.04
	t.FaceCamera = false
	t.Parent = part0
	return t
end

local function rainbowSeq()
	local o = os.clock() * 0.35
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(o % 1, 0.7, 1)),
		ColorSequenceKeypoint.new(0.33, Color3.fromHSV((o + 0.25) % 1, 0.7, 1)),
		ColorSequenceKeypoint.new(0.66, Color3.fromHSV((o + 0.5) % 1, 0.7, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV((o + 0.75) % 1, 0.7, 1)),
	})
end

local function light(p, color, range, br)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = br
	l.Shadows = false
	l.Parent = p
	return l
end

-- ============================================================ element accents
-- ONE signature motif per element, reused by impacts, hits and status procs.
--   R = size of the area it covers, o.small = reduced count (hits / arrows), o.dx/o.dz = direction (optional)
local function spread(n, a0)
	local out = {}
	for k = 0, n - 1 do
		local a = (a0 or rand() * TAU) + k * TAU / n
		out[k + 1] = { a = a, dir = Vector3.new(cos(a), 0, sin(a)) }
	end
	return out
end

local function accent(el, x, y, z, R, P, o)
	o = o or {}
	local t = P.tier
	local n = o.small and clamp(2 + floor(t / 2), 3, 5) or clamp(4 + t, 6, 11)
	local origin = Vector3.new(x, y, z)
	local dirs = spread(n)
	if el == "nature" then
		for i, d in ipairs(dirs) do
			petal(origin + d.dir * R * 0.2, d.dir, 0.6 + R * 0.08, P.main:Lerp(P.glow, (i % 3) / 3), 0.55, R * (0.8 + rand() * 0.5), 1.5 + rand() * 1.5)
		end
	elseif el == "frost" then
		for i, d in ipairs(dirs) do
			local big = i % 2 == 0
			shard(origin + d.dir * R * 0.12, d.dir, R * (big and 0.7 or 0.45), big and 0.34 or 0.22, P.glow, { travel = R * 0.55, dur = 0.42, endLen = 0.6, tr = 0.0 })
		end
		if not o.small and R >= 4 then
			-- lingering frost patch
			local d = disc(R * 1.5, x, 0.3, z, P.glow, 0.8, NEON, 0.08)
			tw(d, 1.1, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(d, 1.2)
		end
	elseif el == "fire" then
		for i, d in ipairs(dirs) do
			shard(origin + d.dir * R * 0.15, d.dir, R * 0.55, 0.55, i % 2 == 0 and P.main or P.glow, { travel = R * 0.7, dur = 0.34, endLen = 0.3, tr = 0.1, endW = 0.15 })
		end
		for i = 1, floor(n / 2) do
			local d = dirs[i].dir
			shard(origin, (d + Vector3.new(0, 0, 0)).Unit, 0.55, 0.38, P.glow, { travel = R * (1.1 + rand() * 0.6), dur = 0.5, endLen = 1, endW = 0.3, h = 0.3 })
		end
	elseif el == "shock" then
		-- forked lightning is the most part-hungry motif, so it gets fewer, shorter bolts
		local nb = o.small and 2 or clamp(2 + floor(t / 2), 3, 5)
		for i = 1, nb do
			local d = dirs[i * 2 - 1] or dirs[i]
			local len = R * (0.8 + rand() * 0.45)
			bolt(origin + d.dir * R * 0.1, origin + d.dir * len, P.main, P.glow, 0.17, o.small and 3 or 4, R * 0.14, 0.17)
		end
	elseif el == "void" then
		local core = disc(R * 0.9, x, y - 0.4, z, C3(8, 3, 16), 0.05, SMOOTH, 0.12)
		tw(core, 0.4, { Size = V(0.12, 0.2, 0.2), Transparency = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		Debris:AddItem(core, 0.5)
		for _, d in ipairs(dirs) do
			shard(origin + d.dir * R * 1.5, -d.dir, R * 0.55, 0.26, P.main, { travel = R * 1.05, dur = 0.38, endLen = 0.35, tr = 0.05, style = Enum.EasingStyle.Quad })
		end
	elseif el == "holy" then
		for _, d in ipairs(dirs) do
			shard(origin + d.dir * R * 0.2, d.dir, R * 0.95, 0.18, P.glow, { travel = R * 0.3, dur = 0.3, endLen = 0.4, tr = 0.1, endW = 0.2 })
		end
		flare(x, y + 0.6, z, R * 1.5, P.main, P.glow, 0.28, 0)
		if not o.small then pillar(x, z, 1.2 + R * 0.12, 26, P.glow, 0.45, 0.45) end
	elseif el == "prism" then
		for i, d in ipairs(dirs) do
			shard(origin + d.dir * R * 0.15, d.dir, R * 0.6, 0.3, hue(i / n, 0.7, 1), { travel = R * 0.7, dur = 0.38, endLen = 0.35, tr = 0.05 })
		end
		ring(x, y - 0.4, z, R * 0.4, R * 1.7, hue(0.5, 0.6, 1), 0.4, 6)
	else
		for _, d in ipairs(dirs) do
			shard(origin + d.dir * R * 0.1, d.dir, R * 0.4, 0.16, P.glow, { travel = R * 0.7, dur = 0.26, endLen = 0.3, tr = 0.1 })
		end
	end
end

-- ============================================================ crescent (the core of every sword swing)
-- Outer edge sits on a constant radius (a sharp cutting edge), the inner side tapers away.
-- layers = { { col = Color3 | fn(p), wmul, wmin, tr, h, y, r, mat }, ... }
local function crescent(o)
	local half = math.rad(o.arc) / 2
	local N = o.N
	local segLen = (half * 2 / N) * o.R * 1.3
	local dirS = o.dir or 1
	local sweep = o.sweep or 0.1
	local items = {}
	for i = 0, N - 1 do
		local a = (i + 0.5) / N
		local phi = -half + a * half * 2
		local c, s = cos(phi), sin(phi)
		local rx, rz = o.dx * c - o.dz * s, o.dx * s + o.dz * c
		local p = dirS == 1 and (1 - a) or a
		local it = { rx = rx, rz = rz, tx = -rz, tz = rx, tR = p * sweep, w = sin(PI * p ^ 0.8) ^ 0.85, layers = {} }
		for _, L in ipairs(o.layers) do
			local col = type(L.col) == "function" and L.col(p) or L.col
			local pt = part(B, V(0.2, L.h or 0.1, 0.2), CFrame.new(0, -50, 0), col, L.mat or NEON, 1)
			table.insert(it.layers, { part = pt, L = L })
		end
		items[#items + 1] = it
	end
	local life = o.life or 0.26
	run(sweep + life + 0.04, function(_, t)
		local drift = o.drift or 0
		for _, it in ipairs(items) do
			local age = t - it.tR
			if age >= 0 then
				local k = clamp(age / life, 0, 1)
				for _, ly in ipairs(it.layers) do
					local L = ly.L
					local w = ((L.wmin or 0) + (L.wmul or 1) * o.wmax * it.w) * (1 - 0.55 * k)
					if w < 0.07 or k >= 1 then
						ly.part.Transparency = 1
					else
						local r = o.R + (L.r or 0) + drift * k - w * 0.5
						local pos = Vector3.new(o.x + it.rx * r, o.y + (L.y or 0), o.z + it.rz * r)
						ly.part.CFrame = CFrame.lookAt(pos, pos + Vector3.new(it.tx, 0, it.tz))
						ly.part.Size = Vector3.new(w, L.h or 0.1, segLen)
						ly.part.Transparency = (L.tr or 0) + (1 - (L.tr or 0)) * k ^ 1.7
					end
				end
			end
		end
	end, function()
		for _, it in ipairs(items) do
			for _, ly in ipairs(it.layers) do ly.part:Destroy() end
		end
	end, o.delay)
end

-- point on the swing arc for progress p (0 = start of the swing, 1 = head)
local function arcDir(dx, dz, arc, dirS, p)
	local half = math.rad(arc) / 2
	local phi = dirS == 1 and (half - p * 2 * half) or (-half + p * 2 * half)
	local c, s = cos(phi), sin(phi)
	return dx * c - dz * s, dx * s + dz * c
end

-- ============================================================ SWORD SWING
function FX.slash(TH, x, z, dx, dz, range, arc, crit, dirS)
	local P = pal(TH)
	local t, el = P.tier, P.elem
	dirS = dirS or 1
	local gold, cream = C3(255, 198, 84), C3(255, 238, 190)
	local R = range * 0.97
	local N = clamp(floor(arc / 9), 10, 30)
	local wmax = (1.7 + 0.34 * t + range * 0.07) * (crit and 1.2 or 1)
	local y = 2.2
	local sweep = 0.1

	local tail, head = P.acc, P.main
	if el == "shock" or el == "holy" then tail, head = P.main, P.glow end
	local function body(p)
		local c
		if el == "prism" then c = hue(p * 0.6, 0.72, 1)
		elseif el == "void" then c = P.acc
		else c = tail:Lerp(head, p ^ 0.8) end
		if crit then c = c:Lerp(gold, 0.5) end
		return c
	end
	local coreC = crit and cream or P.glow
	local edgeC = crit and C3(255, 252, 235) or C3(255, 255, 255)

	local layers = {}
	if el == "void" then
		layers[1] = { col = body, wmul = 1.0, tr = 0.08, h = 0.1 }
		layers[2] = { col = P.main, wmul = 0.07, wmin = 0.14, tr = 0.0, h = 0.14, y = 0.06 }
		layers[3] = { col = P.main, wmul = 0.42, tr = 0.8, h = 0.1, r = -0.2, y = 0.03 }
	elseif el == "prism" then
		layers[1] = { col = body, wmul = 1.0, tr = 0.3, h = 0.1 }
		layers[2] = { col = function(p) return hue(p * 0.6 + 0.35, 0.3, 1) end, wmul = 0.4, tr = 0.04, h = 0.12, y = 0.04 }
		layers[3] = { col = edgeC, wmul = 0.05, wmin = 0.14, tr = 0, h = 0.14, y = 0.08 }
	else
		layers[1] = { col = body, wmul = 1.0, tr = 0.36, h = 0.1 }
		layers[2] = { col = coreC, wmul = 0.36, tr = 0.04, h = 0.12, y = 0.04 }
		layers[3] = { col = edgeC, wmul = 0.05, wmin = 0.12, tr = 0, h = 0.14, y = 0.08 }
		if el == "fire" and t >= 3 then
			layers[4] = { col = P.acc, wmul = 0.55, tr = 0.6, h = 0.08, r = 1.1, y = -0.04 }
		end
	end
	crescent({ x = x, y = y, z = z, dx = dx, dz = dz, R = R, arc = arc, dir = dirS, N = N, wmax = wmax, sweep = sweep, life = 0.26, layers = layers })

	-- rare swords throw a second, fainter blade wave that keeps travelling outward
	if t >= 5 then
		crescent({
			x = x, y = y - 0.05, z = z, dx = dx, dz = dz, R = R * 1.05, arc = arc * (t >= 6 and 0.8 or 0.88), dir = dirS,
			N = N, wmax = wmax * 0.55, sweep = sweep, life = 0.34, delay = 0.045, drift = t >= 6 and 6.5 or 3.2,
			layers = {
				{ col = el == "prism" and function(p) return hue(p * 0.6 + 0.2, 0.7, 1) end or (el == "void" and P.main or head), wmul = 1, tr = 0.55, h = 0.08 },
				{ col = edgeC, wmul = 0.05, wmin = 0.1, tr = 0.15, h = 0.1, y = 0.04 },
			},
		})
	end

	-- signature motif, a handful of pieces spread along the swing
	local count = clamp(2 + t, 3, 7)
	for j = 1, count do
		local p = 0.2 + 0.75 * (j - 0.5) / count
		local rx, rz = arcDir(dx, dz, arc, dirS, p)
		local radial = Vector3.new(rx, 0, rz)
		local tang = Vector3.new(-rz, 0, rx) * (dirS == 1 and -1 or 1)
		local pos = Vector3.new(x + rx * R * 0.97, y, z + rz * R * 0.97)
		task.delay(p * sweep, function()
			if el == "nature" then
				petal(pos, (radial * 0.8 + tang * 0.5).Unit, 0.7 + 0.08 * t, P.main:Lerp(P.glow, rand()), 0.55, 4 + t, 1.5 + rand() * 1.5)
			elseif el == "frost" then
				shard(pos, (radial + tang * 0.15).Unit, 1.6 + 0.22 * t, 0.28, P.glow, { travel = 3.4 + 0.3 * t, dur = 0.4, endLen = 0.7, tr = 0 })
			elseif el == "fire" then
				shard(pos, (radial * 0.9 + tang * 0.4).Unit, 0.55, 0.42, j % 2 == 0 and P.main or P.glow, { travel = 3 + rand() * 3, dur = 0.5, endLen = 1, h = 0.3, endW = 0.4 })
				if t >= 5 and j % 2 == 1 then
					shard(pos, radial, 3, 0.6, P.main, { travel = 2.4, dur = 0.3, endLen = 0.3, tr = 0.3, endW = 0.2 })
				end
			elseif el == "shock" then
				if j <= clamp(1 + floor(t / 2), 2, 4) then
					bolt(pos, pos + radial * (3 + t * 0.45) + tang * (rand() - 0.5) * 2, P.main, P.glow, 0.17, 4, 0.8, 0.14)
				end
			elseif el == "void" then
				shard(pos + radial * R * 0.5, -radial, 2.4, 0.26, P.main, { travel = 4.2, dur = 0.34, endLen = 0.35, tr = 0.05 })
			elseif el == "holy" then
				local from = Vector3.new(x, y, z) + radial * R * 0.28
				shard(from, radial, R * 0.8, 0.2, P.glow, { travel = R * 0.3, dur = 0.26, endLen = 0.4, tr = 0.1, endW = 0.2 })
			elseif el == "prism" then
				shard(pos, radial, 1.8 + 0.2 * t, 0.3, hue(p, 0.7, 1), { travel = 3.4, dur = 0.4, endLen = 0.5, tr = 0 })
			end
		end)
	end
	if el == "void" and t >= 4 then ring(x, 0.8, z, R * 2.0, R * 0.55, P.main, 0.34, 6, 0.4, 1) end
	if el == "frost" and t >= 5 then ring(x, 0.8, z, R * 0.6, R * 1.9, P.glow, 0.38, 5, 0.2, 1) end

	-- glint on the head of the blade
	if t >= 3 or crit then
		local rx, rz = arcDir(dx, dz, arc, dirS, 1)
		task.delay(sweep, function()
			flare(x + rx * R * 0.95, y + 0.3, z + rz * R * 0.95, 2.2 + 0.36 * t + (crit and 1.2 or 0), crit and gold or P.main, P.glow, 0.24)
		end)
	end
	-- soft flash at the hero's hand
	local fl = disc(3.4, x + dx * 1.6, 2.0, z + dz * 1.6, crit and cream or P.glow, 0.55, NEON, 0.1)
	tw(fl, 0.16, { Size = V(0.1, 5.2, 5.2), Transparency = 1 })
	Debris:AddItem(fl, 0.25)
end

-- ============================================================ HIT SPARK (melee)
local lastMelee = 0
function FX.markAttack() lastMelee = os.clock() end
function FX.recentAttack() return os.clock() - lastMelee < 0.22 end

function FX.hit(TH, x, z, crit)
	local P = pal(TH)
	local t = P.tier
	local ang = rand() * PI
	local d = Vector3.new(cos(ang), 0, sin(ang))
	local col = crit and C3(255, 206, 96) or P.glow
	local pos = Vector3.new(x, 2.4, z)
	-- the cut: one bright line that stretches and fades
	local ln = part(B, V(0.2, 0.12, 2.4 + 0.2 * t), CFrame.lookAt(pos, pos + d), col, NEON, 0)
	tw(ln, 0.15, { Size = V(0.04, 0.12, 5 + 0.5 * t), Transparency = 1 })
	Debris:AddItem(ln, 0.25)
	if crit then
		local ln2 = part(B, V(0.16, 0.12, 2), CFrame.lookAt(pos, pos + Vector3.new(-d.Z, 0, d.X)), C3(255, 250, 230), NEON, 0.1)
		tw(ln2, 0.15, { Size = V(0.04, 0.12, 4.4), Transparency = 1 })
		Debris:AddItem(ln2, 0.25)
	end
	if t >= 2 then accent(P.elem, x, 2.0, z, 1.7 + 0.12 * t, P, { small = true }) end
	if t >= 4 or crit then flare(x, 2.6, z, 1.6 + 0.25 * t, col, P.glow, 0.2) end
end

-- ============================================================ IMPACTS
local function arrowHit(P, x, z)
	local t = P.tier
	local fl = disc(2.2, x, 2.0, z, P.glow, 0.15, NEON, 0.2)
	tw(fl, 0.18, { Size = V(0.2, 3.6 + 0.3 * t, 3.6 + 0.3 * t), Transparency = 1 })
	Debris:AddItem(fl, 0.3)
	ring(x, 1.0, z, 0.8, 3.6 + 0.4 * t, P.main, 0.3, 7)
	accent(P.elem, x, 1.8, z, 2.6 + 0.25 * t, P, { small = true })
	if t >= 4 then flare(x, 2.4, z, 3 + 0.3 * t, P.main, P.glow, 0.22) end
end

local function blast(P, x, z, R)
	local t = P.tier
	local el = P.elem
	if el == "void" then
		-- implosion: dark core + ring that closes in instead of opening
		local d = disc(R * 1.5, x, 0.6, z, C3(10, 4, 20), 0.15, SMOOTH, 0.1)
		tw(d, 0.45, { Size = V(0.1, R * 0.4, R * 0.4), Transparency = 0.7 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		Debris:AddItem(d, 0.55)
		ring(x, 0.7, z, R * 2.6, R * 0.4, P.main, 0.42, 9, 0.1, 0.9)
		task.delay(0.36, function()
			ring(x, 0.8, z, R * 0.4, R * 2.2, P.glow, 0.34, 7)
			local f = disc(R * 0.8, x, 1.6, z, P.main, 0.2, NEON, 0.2)
			tw(f, 0.25, { Size = V(0.2, R * 1.8, R * 1.8), Transparency = 1 })
			Debris:AddItem(f, 0.35)
		end)
	else
		local f = disc(R * 0.8, x, 2.1, z, P.glow, 0.05, NEON, 0.3)
		tw(f, 0.2, { Size = V(0.3, R * 1.6, R * 1.6), Transparency = 1 })
		Debris:AddItem(f, 0.3)
		local m = disc(R * 0.7, x, 1.8, z, P.main, 0.3, NEON, 0.3)
		tw(m, 0.4, { Size = V(0.3, R * 2.0, R * 2.0), Transparency = 1 })
		Debris:AddItem(m, 0.5)
		ring(x, 0.7, z, R * 0.5, R * 2.3, P.main, 0.42, 9)
		if t >= 4 then
			task.delay(0.07, function() ring(x, 0.8, z, R * 0.3, R * 1.5, P.glow, 0.34, 6) end)
		end
	end
	if el == "fire" or el == "void" then
		local s = disc(R * 1.3, x, 0.28, z, el == "fire" and C3(34, 18, 10) or C3(14, 6, 24), 0.45, SMOOTH, 0.1)
		tw(s, 1.1, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(s, 1.2)
	end
	accent(el, x, 1.6, z, R, P, {})
	if t >= 3 then flare(x, 2.6, z, R * 1.5, P.main, P.glow, 0.3) end
end

function FX.impact(kind, x, z, radius, TH, dx, dz)
	local P = pal(TH)
	if kind == "fireball" then blast(P, x, z, math.max(radius or 6, 4)) else arrowHit(P, x, z) end
end

-- status proc on an enemy (frost / nature / shock / void)
function FX.proc(x, z, r, el)
	local P = pal(Theme.current(), el)
	ring(x, 0.9, z, r * 0.8, r * 2.4, P.main, 0.35, 6)
	accent(el, x, 1.6, z, r * 1.3, P, { small = true })
end

-- ============================================================ PROJECTILES
-- Builders fill pr.parts ({ part, localOffset } pairs, moved by GameClient) and may set pr.tick(pr, dt, age).
local function add(pr, shape, size, off, color, mat, tr)
	local p = part(shape, size, CFrame.new(), color, mat, tr)
	local e = { p, off }
	table.insert(pr.parts, e)
	return e
end
local function dia(a) return CFrame.Angles(0, a or 0, 0) end

function FX.muzzle(TH, x, z, dx, dz)
	local P = pal(TH)
	if P.tier < 3 then return end
	flare(x + dx * 1.2, 2.2, z + dz * 1.2, 1.8 + 0.3 * P.tier, P.main, P.glow, 0.18)
end

local function arrow(pr, TH)
	local P = pal(TH)
	local t, el = P.tier, P.elem
	local sc = 1 + 0.07 * (t - 1)
	local main, acc, glow = P.main, P.acc, P.glow

	local shaftCol, shaftMat = C3(232, 222, 188), Enum.Material.Wood
	if el == "nature" then shaftCol = shaftCol:Lerp(main, 0.25)
	elseif el == "fire" then shaftCol = C3(66, 38, 30)
	elseif el == "frost" or el == "holy" then shaftCol, shaftMat = glow, NEON
	elseif el == "shock" then shaftCol, shaftMat = P.acc, NEON
	elseif el == "void" then shaftCol, shaftMat = acc, NEON
	elseif el == "prism" then shaftCol, shaftMat = hue(0.3, 0.5, 1), NEON end

	local shaft = add(pr, B, V(0.17, 0.13, 2.8 * sc), CFrame.new(), shaftCol, shaftMat)
	local headE, coreE
	if el == "frost" then
		headE = add(pr, B, V(0.3, 0.16, 1.2 * sc), CFrame.new(0, 0, -1.6 * sc), glow, NEON)
		add(pr, B, V(0.14, 0.12, 0.7), CFrame.new(-0.24, 0, -1.1 * sc) * dia(0.55), main, NEON, 0.1)
		add(pr, B, V(0.14, 0.12, 0.7), CFrame.new(0.24, 0, -1.1 * sc) * dia(-0.55), main, NEON, 0.1)
	elseif el == "fire" then
		headE = add(pr, BALL, V(0.85, 0.85, 0.85), CFrame.new(0, 0, -1.55 * sc), main, NEON, 0.05)
		coreE = add(pr, BALL, V(0.4, 0.4, 0.4), CFrame.new(0, 0, -1.55 * sc), glow, NEON)
	elseif el == "void" then
		headE = add(pr, BALL, V(0.7, 0.7, 0.7), CFrame.new(0, 0, -1.5 * sc), C3(10, 4, 20), SMOOTH)
		coreE = add(pr, BALL, V(0.95, 0.95, 0.95), CFrame.new(0, 0, -1.5 * sc), main, NEON, 0.55)
	else
		headE = add(pr, B, V(0.62, 0.15, 0.62), CFrame.new(0, 0, -1.5 * sc) * dia(PI / 4), el == "prism" and hue(0, 0.7, 1) or glow, NEON)
		coreE = add(pr, B, V(0.32, 0.2, 0.32), CFrame.new(0, 0, -1.5 * sc) * dia(PI / 4), C3(255, 255, 255), NEON)
	end
	-- fletching
	if el == "nature" then
		add(pr, B, V(0.4, 0.08, 0.4), CFrame.new(-0.28, 0, 1.15) * dia(PI / 4), main, NEON, 0.05)
		add(pr, B, V(0.4, 0.08, 0.4), CFrame.new(0.28, 0, 1.15) * dia(PI / 4), glow, NEON, 0.05)
	elseif el == "holy" then
		add(pr, B, V(0.12, 0.1, 1.5), CFrame.new(-0.5, 0, 1.3) * dia(0.45), glow, NEON, 0.25)
		add(pr, B, V(0.12, 0.1, 1.5), CFrame.new(0.5, 0, 1.3) * dia(-0.45), glow, NEON, 0.25)
	else
		add(pr, B, V(0.16, 0.12, 0.7), CFrame.new(-0.2, 0, 1.15) * dia(0.3), el == "none" and C3(196, 62, 62) or main, NEON, el == "none" and 0 or 0.1)
		add(pr, B, V(0.16, 0.12, 0.7), CFrame.new(0.2, 0, 1.15) * dia(-0.3), el == "none" and C3(196, 62, 62) or main, NEON, el == "none" and 0 or 0.1)
	end

	-- trail: one tapered ribbon (+ one wide ghost ribbon on top tiers)
	local tr
	if el == "prism" then
		tr = trail(shaft[1], main, acc, 0.6 + 0.08 * t, 0.2 + 0.02 * t, 1.3, { seq = rainbowSeq() })
	elseif el == "void" then
		tr = trail(shaft[1], main, acc, 0.6 + 0.08 * t, 0.2 + 0.02 * t, 1.3, { le = 0.35 })
	else
		tr = trail(shaft[1], glow, el == "none" and acc or main, 0.5 + 0.1 * t, 0.17 + 0.02 * t, 1.3)
	end
	if t >= 5 then
		trail(shaft[1], main, acc, 1.6 + 0.12 * t, 0.26, 1.0, { tr0 = 0.6, le = 0.9, seq = el == "prism" and rainbowSeq() or nil })
		local halo = add(pr, CY, V(0.3, 2.2 + 0.2 * t, 2.2 + 0.2 * t), CFrame.new(0, 0, -1.3) * CFrame.Angles(0, 0, PI / 2), main, NEON, 0.7)
		pr._halo = halo
	end
	if el == "fire" and t >= 4 then
		local em = Instance.new("ParticleEmitter")
		em.Rate = 6 + t
		em.Color = ColorSequence.new(glow, main)
		em.LightEmission = 1
		em.LightInfluence = 0
		em.Lifetime = NumberRange.new(0.25, 0.4)
		em.Speed = NumberRange.new(1, 3)
		em.SpreadAngle = Vector2.new(25, 25)
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		em.Parent = shaft[1]
	end

	-- element motion
	local fx = {}
	if el == "fire" then
		for k = 1, 2 do fx[k] = add(pr, B, V(0.5 - k * 0.1, 0.12, 1.4), CFrame.new(0, 0, 1.9), k == 1 and main or glow, NEON, 0.2) end
	elseif el == "shock" then
		for k = 1, 2 do fx[k] = add(pr, B, V(0.1, 0.1, 1.6), CFrame.new(), main, NEON, 0.1) end
	elseif el == "void" then
		for k = 1, 2 do fx[k] = add(pr, B, V(0.2, 0.12, 0.7), CFrame.new(), main, NEON, 0.1) end
	elseif el == "holy" then
		fx[1] = add(pr, B, V(2.0, 0.08, 0.1), CFrame.new(0, 0, -1.55 * sc), main, NEON, 0.1)
		fx[2] = add(pr, B, V(0.1, 0.08, 2.0), CFrame.new(0, 0, -1.55 * sc), main, NEON, 0.1)
	elseif el == "prism" and t >= 4 then
		for k = 1, 2 do fx[k] = add(pr, BALL, V(0.34, 0.34, 0.34), CFrame.new(), main, NEON, 0.05) end
	elseif t >= 6 and (el == "nature" or el == "frost") then
		for k = 1, 2 do fx[k] = add(pr, B, V(0.3, 0.1, 0.3), CFrame.new(), glow, NEON, 0.05) end
	end

	local nextBolt = 0
	pr.tick = function(p, dt, age)
		if p._halo then
			local s = 1 + 0.06 * sin(age * 16)
			p._halo[2] = CFrame.new(0, 0, -1.3) * CFrame.Angles(0, 0, PI / 2) * CFrame.new(0, 0, 0)
			p._halo[1].Size = Vector3.new(0.3, (2.2 + 0.2 * t) * s, (2.2 + 0.2 * t) * s)
		end
		if el == "prism" then
			local c = hue(0, 0.7, 1)
			headE[1].Color = c
			if p._halo then p._halo[1].Color = c end
			if fx[1] then
				for k = 1, 2 do
					local a = age * 9 + k * PI
					fx[k][2] = CFrame.new(cos(a) * 0.75, 0, -1.2 + sin(a) * 0.5)
					fx[k][1].Color = hue(k * 0.3, 0.7, 1)
				end
			end
		elseif el == "fire" then
			for k = 1, 2 do
				fx[k][2] = CFrame.new(sin(age * 22 + k * 2.1) * 0.3, 0, 1.7 + k * 0.5)
			end
		elseif el == "shock" then
			if age >= nextBolt then
				nextBolt = age + 0.06
				for k = 1, 2 do
					fx[k][2] = CFrame.new((rand() - 0.5) * 0.7, 0, -0.4 + (rand() - 0.5) * 1.6) * dia((rand() - 0.5) * 1.6)
					fx[k][1].Transparency = rand() < 0.3 and 1 or 0.05
				end
			end
		elseif el == "void" then
			for k = 1, 2 do
				local a = age * 11 + k * PI
				fx[k][2] = CFrame.new(cos(a) * 0.7, 0, -1.4 + sin(a) * 0.7)
			end
		elseif el == "holy" then
			fx[1][2] = CFrame.new(0, 0, -1.55 * sc) * dia(age * 2.4)
			fx[2][2] = CFrame.new(0, 0, -1.55 * sc) * dia(age * 2.4)
		elseif fx[1] then
			for k = 1, 2 do
				local a = age * 8 + k * PI
				fx[k][2] = CFrame.new(cos(a) * 0.7, 0, -0.6 + sin(a) * 0.8) * dia(a)
			end
		end
	end
end

local function orb(pr, TH)
	local P = pal(TH)
	local t, el = P.tier, P.elem
	local sc = 1 + 0.06 * (t - 1)
	local main, acc, glow = P.main, P.acc, P.glow
	local halo = add(pr, BALL, V(3.6 * sc, 3.6 * sc, 3.6 * sc), CFrame.new(), main, NEON, 0.8)
	local bodyCol, bodyMat, bodyTr = main, NEON, 0.1
	if el == "void" then bodyCol, bodyMat, bodyTr = C3(8, 3, 16), SMOOTH, 0 end
	local body = add(pr, BALL, V(2.1 * sc, 2.1 * sc, 2.1 * sc), CFrame.new(), bodyCol, bodyMat, bodyTr)
	local core
	if el ~= "void" then core = add(pr, BALL, V(1.0 * sc, 1.0 * sc, 1.0 * sc), CFrame.new(), C3(255, 255, 255), NEON, 0) end
	light(body[1], el == "void" and acc:Lerp(main, 0.5) or main, 14 + t, 1.2)

	local tr
	if el == "prism" then
		tr = trail(halo[1], main, acc, 2.0 * sc, 0.3, 0, { seq = rainbowSeq() })
	elseif el == "void" then
		tr = trail(halo[1], acc, C3(10, 4, 20), 2.0 * sc, 0.32, 0, { le = 0.3 })
	elseif el == "fire" then
		tr = trail(halo[1], glow, P.acc, 2.4 * sc, 0.32, 0)
	else
		tr = trail(halo[1], glow, main, 2.0 * sc, 0.28, 0)
	end

	local fx = {}
	if el == "fire" then
		for k = 1, 3 do fx[k] = add(pr, B, V(0.8 - k * 0.15, 0.14, 2.0), CFrame.new(0, 0, 1.6), k == 1 and main or (k == 2 and glow or P.acc), NEON, 0.2) end
	elseif el == "frost" then
		for k = 0, 2 do fx[k + 1] = add(pr, B, V(0.3, 0.3, 3.2 * sc), CFrame.new(), glow, NEON, 0.1) end
	elseif el == "void" then
		for k = 1, 3 do fx[k] = add(pr, B, V(0.26, 0.12, 1.3), CFrame.new(), main, NEON, 0.05) end
		for k = 4, 5 do fx[k] = add(pr, B, V(0.2, 0.12, 0.8), CFrame.new(), glow, NEON, 0.15) end
	elseif el == "shock" then
		-- lightning is spawned live in tick
	elseif el == "holy" then
		fx[1] = add(pr, B, V(5.0 * sc, 0.1, 0.16), CFrame.new(), glow, NEON, 0.1)
		fx[2] = add(pr, B, V(0.16, 0.1, 5.0 * sc), CFrame.new(), glow, NEON, 0.1)
		fx[3] = add(pr, B, V(3.4 * sc, 0.1, 0.1), CFrame.new(), main, NEON, 0.25)
		fx[4] = add(pr, B, V(0.1, 0.1, 3.4 * sc), CFrame.new(), main, NEON, 0.25)
	elseif el == "nature" then
		for k = 1, 3 do fx[k] = add(pr, B, V(0.6, 0.1, 0.6), CFrame.new(), k == 2 and glow or main, NEON, 0.05) end
	elseif el == "prism" then
		for k = 1, 3 do fx[k] = add(pr, BALL, V(0.7, 0.7, 0.7), CFrame.new(), main, NEON, 0.05) end
	end
	if t >= 6 and (el == "fire" or el == "frost" or el == "nature" or el == "shock") then
		for k = 1, 2 do table.insert(fx, add(pr, BALL, V(0.5, 0.5, 0.5), CFrame.new(), glow, NEON, 0.05)) end
		fx.sat = #fx - 1
	end
	if t >= 4 and (el == "nature" or el == "prism" or el == "frost") then
		local em = Instance.new("ParticleEmitter")
		em.Rate = 5
		em.Color = ColorSequence.new(glow, main)
		em.LightEmission = 1
		em.LightInfluence = 0
		em.Lifetime = NumberRange.new(0.35, 0.55)
		em.Speed = NumberRange.new(1, 3)
		em.SpreadAngle = Vector2.new(180, 180)
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		em.Parent = core[1]
	end

	local nextBolt = 0
	pr.tick = function(p, dt, age)
		local pulse = 1 + 0.07 * sin(age * 14)
		halo[1].Size = Vector3.new(3.6 * sc * pulse, 3.6 * sc * pulse, 3.6 * sc * pulse)
		if el == "prism" then
			local c = hue(0, 0.75, 1)
			halo[1].Color = c
			body[1].Color = c
			for k = 1, 3 do
				local a = age * 7 + k * TAU / 3
				fx[k][2] = CFrame.new(cos(a) * 1.9, 0, sin(a) * 1.9)
				fx[k][1].Color = hue(k / 3, 0.75, 1)
			end
		elseif el == "fire" then
			for k = 1, 3 do fx[k][2] = CFrame.new(sin(age * 20 + k * 2.1) * 0.45, 0, 1.4 + k * 0.55) end
		elseif el == "frost" then
			for k = 0, 2 do fx[k + 1][2] = dia(k * PI / 3 + age * 2.4) end
		elseif el == "void" then
			for k = 1, 3 do
				local a = age * 8 + k * TAU / 3
				fx[k][2] = CFrame.new(cos(a) * 1.9, 0, sin(a) * 1.9) * dia(-a)
			end
			for k = 4, 5 do
				local a = -age * 12 + k * PI
				fx[k][2] = CFrame.new(cos(a) * 1.25, 0, sin(a) * 1.25) * dia(-a)
			end
		elseif el == "shock" then
			if age >= nextBolt then
				nextBolt = age + 0.07
				local c = Vector3.new(p.x, 2.2, p.z)
				local a = rand() * TAU
				local len = 2.6 + rand() * 1.6 + 0.2 * t
				bolt(c, c + Vector3.new(cos(a) * len, 0, sin(a) * len), main, glow, 0.15, 3, 0.7, 0.09)
			end
		elseif el == "holy" then
			fx[1][2] = dia(age * 1.6)
			fx[2][2] = dia(age * 1.6)
			fx[3][2] = dia(PI / 4 - age * 1.1)
			fx[4][2] = dia(PI / 4 - age * 1.1)
		elseif el == "nature" then
			for k = 1, 3 do
				local a = age * 6 + k * TAU / 3
				fx[k][2] = CFrame.new(cos(a) * 1.6, 0, sin(a) * 1.6) * dia(PI / 4 + a)
			end
		end
		if fx.sat then
			for k = 0, 1 do
				local e = fx[fx.sat + k]
				local a = age * 10 + k * PI
				e[2] = CFrame.new(cos(a) * 2.5, 0, sin(a) * 2.5)
			end
		end
	end
end

-- returns true when the weapon got a custom projectile
function FX.projectile(pr, kind, TH)
	if kind == "arrow" then arrow(pr, TH) elseif kind == "fireball" then orb(pr, TH) else return false end
	FX.muzzle(TH, pr.x, pr.z, pr.dx, pr.dz)
	return true
end

-- ============================================================ CAST SIGIL (replaces the stacked rings / bursts / spiral emitters)
local SIDES = { none = { 4, 1 }, nature = { 6, 1 }, frost = { 6, 2 }, fire = { 5, 2 }, shock = { 3, 1 }, void = { 8, 3 }, holy = { 8, 1 }, prism = { 7, 2 } }

function FX.sigil(x, z, tier, mult, TH)
	if tier < 2 then return end
	local P = pal(TH)
	local el = P.elem
	local m = mult or 1
	local size = (6 + tier * 2.4) * m
	local sd = SIDES[el] or SIDES.none
	local n, k = sd[1], sd[2]
	local dur = 0.55 + 0.05 * tier

	local sets = {}
	local function polygon(radius, spin, colorFn, w, y)
		local lines = {}
		for j = 0, n - 1 do
			table.insert(lines, part(B, V(w, 0.1, 1), CFrame.new(0, -50, 0), colorFn(j), NEON, 1))
		end
		table.insert(sets, { lines = lines, r = radius, spin = spin, y = y, w = w, colorFn = colorFn })
	end
	polygon(size * 0.32, 1.7, function(j) return el == "prism" and hue(j / n, 0.7, 1) or P.main end, 0.26, 0.9)
	if tier >= 4 then polygon(size * 0.2, -2.3, function(j) return el == "prism" and hue(j / n + 0.5, 0.5, 1) or P.glow end, 0.2, 0.95) end
	if tier >= 6 then polygon(size * 0.44, -1.1, function() return P.acc end, 0.3, 0.85) end

	local base = disc(size * 0.7, x, 0.75, z, P.main, 1, NEON, 0.08)
	ring(x, 0.8, z, el == "void" and size * 1.2 or size * 0.35, el == "void" and size * 0.5 or size, P.main, dur, 8)
	if tier >= 4 then
		task.delay(0.06, function() ring(x, 0.9, z, size * 0.25, size * 0.72, P.glow, dur * 0.8, 5) end)
	end
	if tier >= 7 then
		for i = 1, 2 do
			task.delay(i * 0.12, function() ring(x, 1.0 + i * 0.1, z, size * 0.1, size * (1.5 + i * 0.4), hue(i * 0.3, 0.75, 1), 0.7, 9) end)
		end
	end
	if tier >= 3 then
		pillar(x, z, 1.4 + tier * 0.35, 20 + tier * 6, P.glow, 0.55 + 0.06 * tier, 0.5)
	end
	if tier >= 5 then flare(x, 2.4, z, size * 0.9, P.main, P.glow, 0.4, 0) end

	run(dur, function(al, t)
		local e = 1 - (1 - al) ^ 3
		local scale = el == "void" and (1.35 - 0.4 * e) or (0.7 + 0.3 * e)
		local fadeIn = math.min(1, al / 0.12)
		local fadeOut = clamp((al - 0.45) / 0.55, 0, 1) ^ 1.5
		base.Transparency = 1 - 0.14 * fadeIn * (1 - fadeOut)
		for _, S in ipairs(sets) do
			local r = S.r * scale
			local len = 2 * r * sin(PI * k / n)
			local mid = r * cos(PI * k / n)
			for j, ln in ipairs(S.lines) do
				local a = (j - 1 + k / 2) * TAU / n + S.spin * t
				local pos = Vector3.new(x + cos(a) * mid, S.y, z + sin(a) * mid)
				ln.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-sin(a), 0, cos(a)))
				ln.Size = Vector3.new(S.w, 0.1, len + S.w)
				ln.Transparency = math.max(1 - fadeIn, fadeOut) * 0.9 + (1 - 0.9) * (1 - fadeIn)
				if el == "prism" then ln.Color = S.colorFn(j - 1) end
			end
		end
	end, function()
		base:Destroy()
		for _, S in ipairs(sets) do
			for _, ln in ipairs(S.lines) do ln:Destroy() end
		end
	end)
end

return FX
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX10">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX9">
<Properties>
<string name="Name">GameServer</string>
<ProtectedString name="Source"><![CDATA[-- GameServer: lobby, parties, dungeon runs, enemies, combat, progression
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local DataStoreService = game:GetService("DataStoreService")
local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")

local Config = require(RS:WaitForChild("Config"))
local Sprites = require(script:WaitForChild("Sprites"))
local MapBuilder = require(script:WaitForChild("MapBuilder"))
local WM = require(RS:WaitForChild("WeaponModels"))
Sprites.themed = WM -- rarity based weapon models

-- [TESTAREA] optional weapon test place. Delete the "TestArea" module (and the TestAreaClient LocalScript) to remove it.
local TestArea
do
	local m = script:FindFirstChild("TestArea")
	if m and Config.TestArea and Config.TestArea.enabled then
		local ok, res = pcall(require, m)
		if ok then
			TestArea = res
			pcall(TestArea.preInit, Config)
		else
			warn("[TestArea] " .. tostring(res))
		end
	end
end

Players.CharacterAutoLoads = false
Lighting.GlobalShadows = false

pcall(function()
	PhysicsService:RegisterCollisionGroup("Heroes")
	PhysicsService:CollisionGroupSetCollidable("Heroes", "Heroes", false)
end)

-- ============================================================ NETWORK
local Net = Instance.new("Folder")
Net.Name = "Net"
local ToServer = Instance.new("RemoteEvent")
ToServer.Name = "ToServer"
ToServer.Parent = Net
local ToClient = Instance.new("RemoteEvent")
ToClient.Name = "ToClient"
ToClient.Parent = Net
Net.Parent = RS

-- ============================================================ DATA
local D = {} -- persistent profile per player
local S = {} -- session state per player
local STORE
pcall(function()
	STORE = DataStoreService:GetDataStore("TopDownHeroesV1")
end)

local function newData()
	return {
		level = 1, xp = 0, points = 0, coins = 0, vit = 0, swift = 0, wins = 0,
		unlocked = { forest = 1, cave = 1 },
		upg = { Swordsman = {}, Archer = {}, Mage = {} },
		-- weapon inventory: id -> count.  equip: weapon type -> equipped weapon id
		inv = { [Config.StarterWeapons.Swordsman] = 1, [Config.StarterWeapons.Archer] = 1, [Config.StarterWeapons.Mage] = 1 },
		equip = { Swordsman = Config.StarterWeapons.Swordsman, Archer = Config.StarterWeapons.Archer, Mage = Config.StarterWeapons.Mage },
		opened = 0,
	}
end

local function merge(dst, src)
	for k, v in pairs(src) do
		if type(v) == "table" and type(dst[k]) == "table" then
			merge(dst[k], v)
		else
			dst[k] = v
		end
	end
end

local function loadData(p)
	local d = newData()
	if STORE then
		local ok, res = pcall(function()
			return STORE:GetAsync("P" .. p.UserId)
		end)
		if ok and type(res) == "table" then
			merge(d, res)
		end
	end
	return d
end

local function saveData(p)
	local d = D[p]
	if not STORE or not d then return end
	pcall(function()
		STORE:SetAsync("P" .. p.UserId, d)
	end)
end

-- active weapon (the equipped one, or a temporary one inside the test area)
local function weaponIdOf(p)
	local st, d = S[p], D[p]
	if st and st.testWeapon and Config.Weapons[st.testWeapon] then return st.testWeapon end
	if not d or not d.class then return nil end
	return d.equip and d.equip[d.class]
end
local function weaponDefOf(p)
	local id = weaponIdOf(p)
	return id and Config.Weapons[id]
end
local function classOf(p)
	local st = S[p]
	local w = st and st.testWeapon and Config.Weapons[st.testWeapon]
	if w then return w.type end
	return D[p] and D[p].class
end

local function pushData(p)
	local d = D[p]
	if not d then return end
	local payload = {
		level = d.level, xp = d.xp, need = Config.xpNeed(d.level), points = d.points, coins = d.coins,
		class = classOf(p), weapon = weaponIdOf(p), inv = d.inv, equip = d.equip, opened = d.opened, upg = d.upg, vit = d.vit, swift = d.swift, unlocked = d.unlocked,
	}
	p:SetAttribute("Data", HttpService:JSONEncode(payload))
end

-- ============================================================ HELPERS
local function getChar(p)
	local c = p.Character
	if not c then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if h and r then return c, h, r end
	return nil
end

local function toast(p, text, color, dur)
	ToClient:FireClient(p, "Toast", text, color or "ffffff", dur or 3)
end

local function runFx(run, name, ...)
	for _, p in ipairs(run.players) do
		ToClient:FireClient(p, name, ...)
	end
end

local function runToast(run, text, color, dur)
	for _, p in ipairs(run.players) do
		toast(p, text, color, dur)
	end
end

local damagePlayer, damageEnemy, killEnemy, spawnProj, procElement
local leaveParty, broadcastParties, sendParties, startRun
local returnToLobby, endRun, finishRun, checkDefeat, onDied, chooseClass, buildSprite

-- ============================================================ PLAYER PLATES / SPRITES
local function buildPlate(p, hrp)
	local old = hrp:FindFirstChild("Plate")
	if old then old:Destroy() end
	local g = Instance.new("BillboardGui")
	g.Name = "Plate"
	g.Size = UDim2.fromOffset(190, 50)
	g.StudsOffsetWorldSpace = Vector3.new(0, 0, -4.6)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 500
	g.Adornee = hrp
	-- name + HP are shown to everybody EXCEPT the owner
	pcall(function()
		g.PlayerToHideFrom = p
	 end)
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0, 22)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 17
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.2
	title.Parent = g
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Position = UDim2.new(0.08, 0, 0, 25)
	bar.Size = UDim2.new(0.84, 0, 0, 15)
	bar.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	bar.BackgroundTransparency = 0.2
	bar.BorderSizePixel = 0
	bar.Parent = g
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 5)
	bc.Parent = bar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(80, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0, 5)
	fc.Parent = fill
	local txt = Instance.new("TextLabel")
	txt.Name = "Txt"
	txt.Size = UDim2.fromScale(1, 1)
	txt.BackgroundTransparency = 1
	txt.Font = Enum.Font.GothamBold
	txt.TextSize = 11
	txt.TextColor3 = Color3.new(1, 1, 1)
	txt.TextStrokeTransparency = 0.4
	txt.ZIndex = 3
	txt.Parent = bar
	g.Parent = hrp
end

local function updatePlate(p)
	local c, h, r = getChar(p)
	if not c then return end
	local g = r:FindFirstChild("Plate")
	if not g then return end
	local d = D[p]
	g.Title.Text = "Lv." .. (d and d.level or 1) .. "  " .. p.DisplayName
	local frac = math.clamp(h.Health / math.max(1, h.MaxHealth), 0, 1)
	g.Bar.Fill.Size = UDim2.fromScale(frac, 1)
	g.Bar.Fill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.75, 0.95)
	g.Bar.Txt.Text = math.ceil(h.Health) .. " / " .. math.ceil(h.MaxHealth)
end

buildSprite = function(p)
	local c, h, r = getChar(p)
	if not c then return end
	local st = S[p]
	local old = c:FindFirstChild("Sprite")
	if old then old:Destroy() end
	local f = Instance.new("Folder")
	f.Name = "Sprite"
	f.Parent = c
	local cls = classOf(p)
	local wdef = weaponDefOf(p)
	local color = cls and Config.Classes[cls].color or Color3.fromRGB(150, 150, 160)
	if wdef and wdef.tier >= 2 and not wdef.rainbow then color = color:Lerp(wdef.c1, 0.45) end
	st.elem = wdef and wdef.elem or nil
	st.tier = wdef and wdef.tier or 1
	st.wid = wdef and wdef.id or nil
	st.weapon = Sprites.player(cls, color, r, f, wdef)
end

local function applyStats(p, heal)
	local c, h = getChar(p)
	if not c then return end
	local d = D[p]
	local mh = Config.maxHp(classOf(p), d.vit)
	h.MaxHealth = mh
	if heal then h.Health = mh end
	local sp = Config.walkSpeed(classOf(p), d.swift)
	h.WalkSpeed = sp
	p:SetAttribute("WalkSpeed", sp)
	updatePlate(p)
end

local function swingWeapon(st, cls, cd)
	local w = st.weapon
	if not w or not w.weld.Parent then return end
	local base = w.base
	local weld = w.weld
	st.swingTok = (st.swingTok or 0) + 1
	local tok = st.swingTok
	local function alive() return weld.Parent and st.swingTok == tok end
	local function tween(inst, t, props, style, dir)
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	end
	if cls == "Swordsman" then
		-- combo: every hit swings from the opposite side
		st.swingDir = -(st.swingDir or 1)
		local d = st.swingDir
		local a0, a1 = -1.4 * d, 1.4 * d
		if w.trail then w.trail.Enabled = true end
		-- wind-up, then a fast cut with a little forward thrust
		weld.C0 = CFrame.Angles(0, a0 * 1.12, 0) * base
		tween(weld, 0.11, { C0 = CFrame.Angles(0, a1, 0) * CFrame.new(0, 0, -0.7) * base }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		task.delay(0.13, function()
			if alive() then
				tween(weld, 0.24, { C0 = base }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			end
		end)
		task.delay(0.2, function()
			if alive() and w.trail then w.trail.Enabled = false end
		end)
	elseif cls == "Archer" then
		-- recoil, then the next arrow is nocked
		weld.C0 = base * CFrame.new(0, 0, 0.95)
		tween(weld, 0.24, { C0 = base }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		if w.arrow then
			for _, ap in ipairs(w.arrow) do ap.Transparency = 1 end
			task.delay(math.clamp((cd or 0.4) * 0.45, 0.06, 0.3), function()
				if not alive() then return end
				for _, ap in ipairs(w.arrow) do
					if ap.Parent then tween(ap, 0.12, { Transparency = ap:GetAttribute("T0") or 0 }, Enum.EasingStyle.Linear) end
				end
			end)
		end
	else
		-- staff: small pull-back, thrust forward, orb flares
		weld.C0 = base * CFrame.new(0, 0, 0.5)
		tween(weld, 0.07, { C0 = base * CFrame.new(0, 0, -1.3) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.08, function()
			if alive() then tween(weld, 0.28, { C0 = base }, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end
		end)
		local o = w.orb
		if o then
			o.halo.Transparency = 0.35
			o.glow.Transparency = 0.05
			o.light.Brightness = 3.2
			tween(o.halo, 0.45, { Transparency = 0.86 })
			tween(o.glow, 0.4, { Transparency = 0.45 })
			tween(o.light, 0.4, { Brightness = 1 })
			o.emitter:Emit(14)
		end
	end
end

local lobbyRng = Random.new()
local function lobbySpawnPos()
	return Config.Lobby.spawn + Vector3.new(lobbyRng:NextInteger(-8, 8), 0, lobbyRng:NextInteger(-4, 4))
end

local function setupCharacter(p, c)
	local st = S[p]
	if not st or not D[p] then return end
	local hum = c:WaitForChild("Humanoid", 10)
	local hrp = c:WaitForChild("HumanoidRootPart", 10)
	if not hum or not hrp then return end

	local function hide(d)
		if d:IsA("Accessory") or d:IsA("Clothing") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") or d:IsA("CharacterMesh") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			if d ~= hrp and not d:FindFirstAncestor("Sprite") then
				d.Transparency = 1
			end
			pcall(function()
				d.CollisionGroup = "Heroes"
			end)
		end
	end
	for _, d in ipairs(c:GetDescendants()) do hide(d) end
	c.DescendantAdded:Connect(hide)

	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.UseJumpPower = true
	hum.JumpPower = 0
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)

	local pos
	if st.run then
		local info = st.run.info
		pos = info.spawn + Vector3.new(lobbyRng:NextInteger(-8, 8), 0, lobbyRng:NextInteger(-4, 4))
	else
		pos = lobbySpawnPos()
	end
	c:PivotTo(CFrame.new(pos))
	applyStats(p, true)
	buildSprite(p)
	buildPlate(p, hrp)
	updatePlate(p)
	hum.HealthChanged:Connect(function() updatePlate(p) end)
	hum.Died:Connect(function() onDied(p, c) end)
	ToClient:FireClient(p, "Env", st.run and st.run.cfg.id or "lobby")
end

-- ============================================================ PROGRESSION
local function grantXP(p, amount)
	local d = D[p]
	if not d then return 0 end
	local ups = 0
	d.xp = d.xp + amount
	while d.level < Config.MaxLevel and d.xp >= Config.xpNeed(d.level) do
		d.xp = d.xp - Config.xpNeed(d.level)
		d.level = d.level + 1
		d.points = d.points + 1
		ups = ups + 1
	end
	if d.level >= Config.MaxLevel then d.xp = 0 end
	if ups > 0 then
		toast(p, "LEVEL UP!  Lv." .. d.level .. "  (+" .. ups .. " skill point)", "ffd84a", 3.5)
		updatePlate(p)
	end
	pushData(p)
	return ups
end

chooseClass = function(p, cls)
	local d = D[p]
	d.class = cls
	applyStats(p, false)
	local _, h = getChar(p)
	if h then h.Health = h.MaxHealth end
	buildSprite(p)
	pushData(p)
	toast(p, "Weapon selected: " .. string.upper(cls), "ffffff", 2.5)
end

-- ============================================================ LOBBY
local lobbyFolder = Instance.new("Folder")
lobbyFolder.Name = "Lobby"
lobbyFolder.Parent = Workspace
local lobbyGates = MapBuilder.lobby(lobbyFolder)
if TestArea then pcall(TestArea.buildPortal, lobbyFolder) end -- [TESTAREA]

-- ============================================================ PARTIES
local parties = {}
local partySeq = 0
local runs = {}
local slots = {}

-- gate zones lookup
local gateZones = {}
for _, zn in ipairs(Config.Lobby.zones) do
	if zn.kind == "gate" then gateZones[zn.id] = zn end
end

local friendCache = {}
local function areFriends(a, b)
	if a == b then return true end
	local key = math.min(a.UserId, b.UserId) .. ":" .. math.max(a.UserId, b.UserId)
	local v = friendCache[key]
	if v == nil then
		local ok, res = pcall(function() return a:IsFriendsWith(b.UserId) end)
		v = ok and res == true or false
		friendCache[key] = v
	end
	return v
end

local function gateParty(gate)
	for _, pt in pairs(parties) do
		if pt.gate == gate then return pt end
	end
	return nil
end

local function partyView(pt)
	local names = {}
	for _, m in ipairs(pt.members) do table.insert(names, m.DisplayName) end
	return {
		id = pt.id, gate = pt.gate, loc = pt.loc, host = pt.host.DisplayName, hostId = pt.host.UserId, diff = pt.diff,
		max = pt.max, n = #pt.members, names = names, friendsOnly = pt.friendsOnly, startAt = pt.startAt,
	}
end

-- can player p join party pt? returns ok, reason
local function joinCheck(p, pt)
	if table.find(pt.members, p) then return true end
	if #pt.members >= pt.max then return false, "FULL" end
	if pt.friendsOnly and not areFriends(p, pt.host) then return false, "FRIENDS ONLY" end
	if pt.diff > ((D[p] and D[p].unlocked[pt.loc]) or 1) then return false, "LOCKED" end
	return true
end

local function updateGateSign(gate)
	local g = lobbyGates and lobbyGates[gate]
	if not g then return end
	local pt = gateParty(gate)
	if not pt then
		g.sub.Text = "FREE - step in to host a run"
		g.sub.TextColor3 = Color3.fromRGB(255, 255, 255)
		g.glow.Color = g.color
		return
	end
	local loc = Config.Locations[pt.loc]
	local tag = pt.friendsOnly and "FRIENDS ONLY" or "OPEN"
	g.sub.Text = string.upper(loc.short) .. " - " .. Config.Difficulties[pt.diff].name .. "  |  " .. #pt.members .. "/" .. pt.max .. "  |  " .. tag
	if pt.friendsOnly then
		g.sub.TextColor3 = Color3.fromRGB(120, 200, 255)
		g.glow.Color = Color3.fromRGB(90, 170, 255)
	elseif #pt.members >= pt.max then
		g.sub.TextColor3 = Color3.fromRGB(255, 110, 110)
		g.glow.Color = Color3.fromRGB(255, 80, 80)
	else
		g.sub.TextColor3 = Color3.fromRGB(255, 220, 120)
		g.glow.Color = Color3.fromRGB(255, 190, 70)
	end
end

sendParties = function(p, gate)
	local pt = gateParty(gate)
	local view = nil
	if pt then
		view = partyView(pt)
		view.mine = table.find(pt.members, p) ~= nil
		local ok, why = joinCheck(p, pt)
		view.canJoin = ok and not view.mine
		view.why = why
	end
	ToClient:FireClient(p, "Gate", gate, view)
end

broadcastParties = function(gate)
	updateGateSign(gate)
	for p, st in pairs(S) do
		if st.zone == gate then task.spawn(sendParties, p, gate) end
	end
end

leaveParty = function(p)
	local st = S[p]
	local pt = st and st.party
	if not pt then return end
	st.party = nil
	local i = table.find(pt.members, p)
	if i then table.remove(pt.members, i) end
	if #pt.members == 0 then
		parties[pt.id] = nil
	else
		if pt.host == p then pt.host = pt.members[1] end
		pt.startAt = nil
	end
	broadcastParties(pt.gate)
end

local function createParty(p, gate, loc, diff, max, friendsOnly)
	local st = S[p]
	if not st or st.run or st.party or type(gate) ~= "string" or st.zone ~= gate or not gateZones[gate] then return end
	if type(loc) ~= "string" or not Config.Locations[loc] or type(diff) ~= "number" or type(max) ~= "number" then return end
	if not D[p].class then
		toast(p, "Pick a weapon first!", "ff6060", 2.5)
		return
	end
	if gateParty(gate) then
		toast(p, "This gate is already taken!", "ff6060", 2.5)
		return
	end
	diff = math.floor(diff)
	max = math.clamp(math.floor(max), 1, Config.GateMaxPlayers)
	if diff < 1 or diff > #Config.Difficulties or diff > (D[p].unlocked[loc] or 1) then
		toast(p, "That difficulty is locked!", "ff6060", 2.5)
		return
	end
	partySeq = partySeq + 1
	local pt = {
		id = partySeq, host = p, gate = gate, loc = loc, diff = diff, max = max,
		friendsOnly = friendsOnly == true and max > 1, members = { p },
	}
	parties[pt.id] = pt
	st.party = pt
	broadcastParties(gate)
	if max == 1 then
		toast(p, "Starting solo run...", "ffffff", 1.5)
		task.delay(1.2, function()
			if parties[pt.id] then startRun(pt) end
		end)
	end
end

local function joinParty(p, id)
	local st = S[p]
	if not st or st.run or st.party or type(id) ~= "number" then return end
	local pt = parties[id]
	if not pt or st.zone ~= pt.gate then return end
	if not D[p].class then
		toast(p, "Pick a weapon first!", "ff6060", 2.5)
		return
	end
	local ok, why = joinCheck(p, pt)
	if not ok then
		if why == "FRIENDS ONLY" then
			toast(p, "This party is for the host's friends only!", "ff6060", 2.5)
		elseif why == "LOCKED" then
			toast(p, "You haven't unlocked that difficulty yet!", "ff6060", 2.5)
		else
			toast(p, "Party is full!", "ff6060", 2.5)
		end
		return
	end
	table.insert(pt.members, p)
	st.party = pt
	if #pt.members >= pt.max then
		local t = Workspace:GetServerTimeNow() + 5
		pt.startAt = t
		task.delay(5, function()
			if parties[pt.id] and pt.startAt == t then startRun(pt) end
		end)
	end
	broadcastParties(pt.gate)
end

-- ============================================================ RUNS
local function pickLevel(cfg, wave, def)
	local span = cfg.maxLvl - cfg.minLvl
	local center = cfg.minLvl + span * ((wave - 1) * 0.35 + 0.15)
	local lvl = math.floor(center + (math.random() * 2 - 1) * 1.3 + 0.5)
	return math.clamp(lvl, math.max(cfg.minLvl, def.minLvl), math.min(cfg.maxLvl, def.maxLvl))
end

local function buildQueue(run, wave)
	local cfg = run.cfg
	local pool, tw = {}, 0
	for _, def in ipairs(cfg.enemies) do
		if def.minWave <= wave then
			table.insert(pool, def)
			tw = tw + def.weight
		end
	end
	local q = {}
	if wave == 3 then
		table.insert(q, { def = cfg.boss, lvl = cfg.boss.maxLvl, boss = true })
	end
	for _ = 1, run.waveCounts[wave] do
		local r = math.random() * tw
		local pick = pool[1]
		for _, def in ipairs(pool) do
			r = r - def.weight
			if r <= 0 then pick = def break end
		end
		table.insert(q, { def = pick, lvl = pickLevel(cfg, wave, pick) })
	end
	return q
end

local function schedule(run, t, fn)
	table.insert(run.events, { t = t, fn = fn })
end

local function buildEnemyGui(e, root)
	local boss = e.boss
	local g = Instance.new("BillboardGui")
	g.Size = boss and UDim2.fromOffset(300, 46) or UDim2.fromOffset(120, 34)
	g.StudsOffsetWorldSpace = Vector3.new(0, 0, -(e.r + (boss and 3.2 or 2.2)))
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 400
	g.Adornee = root
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, boss and 24 or 16)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = boss and 20 or 13
	title.Text = "Lv." .. e.lvl .. " " .. e.def.name
	title.TextColor3 = boss and Color3.fromRGB(255, 200, 70) or Color3.fromRGB(255, 255, 255)
	title.TextStrokeTransparency = 0.2
	title.Parent = g
	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0.08, 0, 0, boss and 26 or 17)
	bar.Size = UDim2.new(0.84, 0, 0, boss and 14 or 8)
	bar.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	bar.BorderSizePixel = 0
	bar.Parent = g
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = boss and Color3.fromRGB(230, 50, 50) or Color3.fromRGB(220, 70, 70)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	g.Parent = root
	e.fill = fill
end

local function spawnEnemy(run, def, lvl, x, z)
	local dc = run.dcfg
	local n = #run.players
	local boss = def.boss ~= nil
	local hpMul = (1 + 0.22 * (lvl - 1)) * dc.hp * (1 + (boss and 0.6 or 0.35) * (n - 1))
	local dmgMul = boss and dc.dmg or ((1 + 0.12 * (lvl - 1)) * dc.dmg)
	local e = {
		def = def, lvl = lvl, x = x, z = z, r = def.r, boss = boss,
		maxHp = math.floor(def.hp * hpMul), dmg = def.dmg * dmgMul, speed = def.speed,
		nextAtk = os.clock() + 1, fx = 0, fz = -1,
	}
	e.hp = e.maxHp
	local model = Instance.new("Model")
	model.Name = def.name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.CFrame = CFrame.new(x, 0.2, z)
	root.Parent = model
	model.PrimaryPart = root
	e.weapon = Sprites.enemy(def, root, model)
	e.model, e.root = model, root
	buildEnemyGui(e, root)
	if boss then
		e.nextRock = os.clock() + 3
		e.nextSlam = os.clock() + 4
		e.nextSweep = os.clock() + 3
	end
	model.Parent = run.enemyFolder
	table.insert(run.enemies, e)
	if boss then run.boss = e end
	return e
end

local function pickSpawn(run)
	local info = run.info
	local half = info.half
	local first
	for _ = 1, 14 do
		local side = math.random(1, 3)
		local x, z
		if side == 1 then
			x = info.ox + (math.random() * 2 - 1) * (half - 8)
			z = -half + 8
		elseif side == 2 then
			x = info.ox - half + 8
			z = (math.random() * 2 - 1) * (half - 12)
		else
			x = info.ox + half - 8
			z = (math.random() * 2 - 1) * (half - 12)
		end
		first = first or { x, z }
		local ok = true
		for _, o in ipairs(info.obstacles) do
			local dx, dz = x - o.x, z - o.z
			if dx * dx + dz * dz < (o.r + 3) * (o.r + 3) then ok = false break end
		end
		if ok then
			for _, t in ipairs(run.targets) do
				local dx, dz = x - t.x, z - t.z
				if dx * dx + dz * dz < 1225 then ok = false break end
			end
		end
		if ok then return x, z end
	end
	return first[1], first[2]
end

local function moveEnemy(run, e, dx, dz)
	local nx, nz = e.x + dx, e.z + dz
	local info = run.info
	local collided = false
	for _, o in ipairs(info.obstacles) do
		local ddx, ddz = nx - o.x, nz - o.z
		local minD = o.r + e.r * 0.7
		local d2 = ddx * ddx + ddz * ddz
		if d2 < minD * minD then
			local d = math.sqrt(d2)
			if d < 0.01 then d = 0.01 ddx = 1 end
			nx = o.x + ddx / d * minD
			nz = o.z + ddz / d * minD
			-- slide around the obstacle
			local len = math.sqrt(dx * dx + dz * dz)
			nx = nx + (-ddz / d) * (e.side or 1) * len * 0.8
			nz = nz + (ddx / d) * (e.side or 1) * len * 0.8
			collided = true
		end
	end
	local lim = info.half - e.r - 1
	e.x = math.clamp(nx, info.ox - lim, info.ox + lim)
	e.z = math.clamp(nz, -lim, lim)
	return collided
end

local function areaDamage(run, x, z, r, dmg)
	for _, p in ipairs(run.players) do
		local _, h, hrp = getChar(p)
		if h and h.Health > 0 then
			local dx, dz = hrp.Position.X - x, hrp.Position.Z - z
			if dx * dx + dz * dz <= (r + 0.8) * (r + 0.8) then
				damagePlayer(p, dmg)
			end
		end
	end
end

local function throwRock(run, e, tx, tz, dur, radius, dmg)
	runFx(run, "Tele", tx, tz, radius, dur)
	runFx(run, "Rock", e.x, e.z, tx, tz, dur)
	schedule(run, os.clock() + dur, function()
		areaDamage(run, tx, tz, radius, dmg)
		runFx(run, "Boom", tx, tz, radius)
	end)
end

local function swingBossSword(e)
	local w = e.weapon
	if not w then return end
	task.spawn(function()
		local t0 = os.clock()
		if w.trail then w.trail.Enabled = true end
		while w.weld.Parent do
			local t = os.clock() - t0
			if t > 0.9 then break end
			local a
			if t < 0.45 then
				a = -0.9 * (t / 0.45)
			else
				a = -0.9 + ((t - 0.45) / 0.4) * (math.pi * 2 + 0.9)
			end
			w.weld.C0 = CFrame.Angles(0, a, 0) * w.base
			task.wait()
		end
		if w.trail then w.trail.Enabled = false end
		if w.weld.Parent then w.weld.C0 = w.base end
	end)
end

local function stepBoss(run, e, dist, nx, nz, dt, now)
	local def = e.def
	local pct = e.hp / e.maxHp
	if e.busyUntil and now < e.busyUntil then return end
	local step = e.speed * dt
	if def.boss == "titan" then
		if now >= e.nextRock then
			e.nextRock = now + (pct < 0.5 and 3.0 or 4.5)
			local n = pct < 0.5 and 3 or 2
			for _ = 1, n do
				local t = run.targets[math.random(#run.targets)]
				throwRock(run, e, t.x + (math.random() - 0.5) * 10, t.z + (math.random() - 0.5) * 10, 1.4, def.rockR, e.dmg * 0.9)
			end
			e.busyUntil = now + 0.6
			return
		end
		if dist < e.r + 6 and now >= e.nextSlam then
			e.nextSlam = now + 3.5
			local sx, sz, rad = e.x, e.z, e.r + 7
			runFx(run, "Tele", sx, sz, rad, 0.9)
			schedule(run, now + 0.9, function()
				areaDamage(run, sx, sz, rad, e.dmg * 1.4)
				runFx(run, "Boom", sx, sz, rad)
			end)
			e.busyUntil = now + 1.1
			return
		end
	else
		if dist < e.r + 9 and now >= e.nextSweep then
			e.nextSweep = now + (pct < 0.5 and 2.4 or 3.2)
			local sx, sz, rad = e.x, e.z, e.r + 9
			runFx(run, "Tele", sx, sz, rad, 0.8)
			swingBossSword(e)
			schedule(run, now + 0.8, function()
				areaDamage(run, sx, sz, rad, e.dmg)
				runFx(run, "Boom", sx, sz, rad * 0.8)
			end)
			e.busyUntil = now + 1.0
			return
		end
	end
	if dist > e.r + 1.5 then
		moveEnemy(run, e, nx * step, nz * step)
	end
end

local function stepEnemyCore(run, e, dt, now)
	if e.dummy then -- [TESTAREA] training dummies never move or attack, they only drift back to their spot
		local k = math.min(1, dt * 2.5)
		e.x = e.x + (e.hx - e.x) * k
		e.z = e.z + (e.hz - e.z) * k
		e.fx, e.fz = 0, 1
		return
	end
	local targets = run.targets
	if #targets == 0 then return end
	local best, bd = nil, math.huge
	for _, t in ipairs(targets) do
		local dx, dz = t.x - e.x, t.z - e.z
		local d2 = dx * dx + dz * dz
		if d2 < bd then bd = d2 best = t end
	end
	local dist = math.sqrt(bd)
	local nx, nz = 0, -1
	if dist > 0.001 then nx, nz = (best.x - e.x) / dist, (best.z - e.z) / dist end
	e.fx, e.fz = nx, nz
	if e.boss then
		stepBoss(run, e, dist, nx, nz, dt, now)
		return
	end
	local def = e.def
	local step = e.speed * dt
	if def.ranged then
		if dist > def.keep + 4 then
			moveEnemy(run, e, nx * step, nz * step)
		elseif dist < def.keep - 6 then
			moveEnemy(run, e, -nx * step * 0.8, -nz * step * 0.8)
		end
		if dist <= def.shootRange and now >= e.nextAtk then
			e.nextAtk = now + def.atkCd
			spawnProj(run, { kind = def.projKind, x = e.x, z = e.z, dx = nx, dz = nz, speed = def.projSpeed, range = def.shootRange + 8, dmg = e.dmg, enemy = true, hitR = 0.9 })
		end
	else
		if dist > e.r + 2.2 then
			moveEnemy(run, e, nx * step, nz * step)
		elseif now >= e.nextAtk then
			e.nextAtk = now + def.atkCd
			damagePlayer(best.p, e.dmg)
		end
	end
end

-- wraps the AI step with status effects: burn (damage over time), stun and slow
local function stepEnemy(run, e, dt, now)
	if e.burn then
		local b = e.burn
		if now >= b.nextT then
			b.nextT = now + 0.5
			runFx(run, "Ember", e.x, e.z, e.r)
			damageEnemy(run, e, b.dps * 0.5, b.owner, false, true)
			if e.dead then return end
		end
		if now >= b.untilT then e.burn = nil end
	end
	if e.stunUntil and now < e.stunUntil then return end
	local base = e.speed
	if e.slowUntil and now < e.slowUntil then e.speed = base * (e.slowMul or 0.5) end
	stepEnemyCore(run, e, dt, now)
	e.speed = base
end

local projSeq = 0
spawnProj = function(run, t)
	projSeq = projSeq + 1
	t.id = projSeq
	t.left = t.range
	table.insert(run.projs, t)
	runFx(run, "Proj", t.id, t.kind, t.x, t.z, t.dx, t.dz, t.speed, t.range)
end

local function enemiesInCircle(run, x, z, r)
	local out = {}
	for _, e in ipairs(run.enemies) do
		local dx, dz = e.x - x, e.z - z
		local m = r + e.r
		if dx * dx + dz * dz <= m * m then table.insert(out, e) end
	end
	return out
end

local function stepProjectiles(run, dt)
	for i = #run.projs, 1, -1 do
		local pr = run.projs[i]
		local step = pr.speed * dt
		pr.x = pr.x + pr.dx * step
		pr.z = pr.z + pr.dz * step
		pr.left = pr.left - step
		local ended, explode, hit = false, false, nil
		if pr.enemy then
			for _, t in ipairs(run.targets) do
				local dx, dz = t.x - pr.x, t.z - pr.z
				if dx * dx + dz * dz < (pr.hitR + 1.2) * (pr.hitR + 1.2) then
					damagePlayer(t.p, pr.dmg)
					ended = true
					break
				end
			end
		else
			for _, e in ipairs(run.enemies) do
				local dx, dz = e.x - pr.x, e.z - pr.z
				local m = e.r + pr.hitR
				if dx * dx + dz * dz < m * m then hit = e break end
			end
			if hit then
				ended = true
				if pr.radius then
					explode = true
				else
					damageEnemy(run, hit, pr.dmg, pr.owner, pr.crit)
					if not hit.dead and not hit.boss then moveEnemy(run, hit, pr.dx * 0.8, pr.dz * 0.8) end
				end
			end
		end
		if not ended and pr.left <= 0 then
			ended = true
			if pr.radius then explode = true end
		end
		if ended then
			table.remove(run.projs, i)
			if explode then
				local victims = enemiesInCircle(run, pr.x, pr.z, pr.radius)
				for _, e in ipairs(victims) do
					damageEnemy(run, e, pr.dmg, pr.owner, pr.crit)
				end
			end
			runFx(run, "ProjEnd", pr.id, pr.x, pr.z, pr.kind, pr.radius or 0)
		end
	end
end

-- combat -----------------------------------------------------
damagePlayer = function(p, amount)
	local st = S[p]
	if not st or st.dead then return end
	if st.invUntil and st.invUntil > os.clock() then return end
	local _, h, hrp = getChar(p)
	if not h or h.Health <= 0 then return end
	amount = math.max(1, math.floor(amount))
	h.Health = h.Health - amount
	ToClient:FireClient(p, "Hurt")
	if st.run then
		runFx(st.run, "Dmg", hrp.Position.X, hrp.Position.Z, amount, false, true)
	end
end

damageEnemy = function(run, e, amount, killer, crit, noProc)
	if e.dead then return end
	local ks = killer and S[killer]
	if ks and ks.elem == "holy" and e.hp < e.maxHp * 0.6 then amount = amount * 1.15 end
	amount = math.max(1, math.floor(amount))
	e.hp = e.hp - amount
	runFx(run, "Dmg", e.x, e.z, amount, crit and true or false, false)
	e.fill.Size = UDim2.fromScale(math.clamp(e.hp / e.maxHp, 0, 1), 1)
	if e.hp <= 0 then
		killEnemy(run, e, killer)
	elseif ks and ks.elem and ks.elem ~= "none" and not noProc and procElement then
		procElement(run, e, ks, killer, amount)
	end
end

killEnemy = function(run, e, killer)
	if e.dead then return end
	e.dead = true
	local idx = table.find(run.enemies, e)
	if idx then table.remove(run.enemies, idx) end
	runFx(run, "Death", e.x, e.z, e.r, e.def.kind)
	e.model:Destroy()
	if killer and D[killer] and run.gain[killer] then
		local mult = e.boss and 12 or 1
		local xp = math.floor(e.lvl * 2 * run.dcfg.reward * mult)
		local coins = math.max(1, math.floor(e.lvl * run.dcfg.reward * 0.5 * mult))
		D[killer].coins = D[killer].coins + coins
		local g = run.gain[killer]
		g.xp = g.xp + xp
		g.coins = g.coins + coins
		g.kills = g.kills + 1
		grantXP(killer, xp)
	end
end

local function playerAttack(p, aim)
	local st = S[p]
	local run = st and st.run
	if not run or run.over or st.dead then return end
	local d = D[p]
	local cls = classOf(p)
	if not cls then return end
	local c, h, hrp = getChar(p)
	if not c or h.Health <= 0 then return end
	local now = os.clock()
	if now < (st.nextAtk or 0) - 0.03 then return end
	if now < (st.lockAtk or 0) then return end
	local ws = Config.weaponStats(cls, d.upg[cls], weaponDefOf(p))
	local cdef = Config.Classes[cls]
	st.nextAtk = now + ws.cooldown
	local crit = math.random() < ws.crit
	local dmg = ws.damage * (0.92 + math.random() * 0.16) * (crit and 2 or 1)
	local px, pz = hrp.Position.X, hrp.Position.Z
	local dx, dz = aim.X - px, aim.Z - pz
	local m = math.sqrt(dx * dx + dz * dz)
	if m < 0.01 then
		local lv = hrp.CFrame.LookVector
		dx, dz = lv.X, lv.Z
		m = math.sqrt(dx * dx + dz * dz)
		if m < 0.01 then dx, dz, m = 0, -1, 1 end
	end
	dx, dz = dx / m, dz / m
	swingWeapon(st, cls, ws.cooldown)
	runFx(run, "Theme", ws.wid)
	if cdef.kind == "melee" then
		-- rarer swords cut a wider arc
		local arc = math.min(300, cdef.arc * (1 + 0.06 * (ws.tier - 1)))
		runFx(run, "Slash", px, pz, dx, dz, ws.range, arc, crit, st.swingDir or 1)
		local cosA = math.cos(math.rad(arc) / 2)
		local hits = {}
		for _, e in ipairs(run.enemies) do
			local ex, ez = e.x - px, e.z - pz
			local dist = math.sqrt(ex * ex + ez * ez)
			if dist <= ws.range + e.r then
				local dot = dist < 0.5 and 1 or (ex * dx + ez * dz) / dist
				if dot >= cosA or dist < e.r + 1.2 then table.insert(hits, e) end
			end
		end
		for _, e in ipairs(hits) do
			damageEnemy(run, e, dmg, p, crit)
			if not e.dead and not e.boss then moveEnemy(run, e, dx * 1.6, dz * 1.6) end
		end
	elseif cdef.kind == "arrow" then
		spawnProj(run, { kind = "arrow", x = px + dx * 2, z = pz + dz * 2, dx = dx, dz = dz, speed = cdef.projSpeed, range = ws.range, dmg = dmg, owner = p, crit = crit, hitR = 0.8 })
		-- rarer bows fire extra side arrows
		local extra = ws.tier >= 6 and 2 or (ws.tier >= 4 and 1 or 0)
		for i = 1, extra do
			for _, sgn in ipairs({ -1, 1 }) do
				local a = sgn * math.rad(8 * i)
				local ca, sa = math.cos(a), math.sin(a)
				local ddx, ddz = dx * ca - dz * sa, dx * sa + dz * ca
				spawnProj(run, { kind = "arrow", x = px + ddx * 2, z = pz + ddz * 2, dx = ddx, dz = ddz, speed = cdef.projSpeed, range = ws.range, dmg = dmg * 0.6, owner = p, crit = false, hitR = 0.8 })
			end
		end
	else
		spawnProj(run, { kind = "fireball", x = px + dx * 2.5, z = pz + dz * 2.5, dx = dx, dz = dz, speed = cdef.projSpeed, range = ws.range, dmg = dmg, owner = p, crit = crit, hitR = 1.3, radius = cdef.radius * (1 + (ws.rs - 1) * 0.6) })
	end
end

-- run update -------------------------------------------------
local function updateRun(run, dt, now)
	local targets = {}
	for _, p in ipairs(run.players) do
		local st = S[p]
		if st and not st.dead then
			local _, h, hrp = getChar(p)
			if h and h.Health > 0 then
				table.insert(targets, { p = p, x = hrp.Position.X, z = hrp.Position.Z })
			end
		end
	end
	run.targets = targets

	for i = #run.events, 1, -1 do
		local ev = run.events[i]
		if ev and now >= ev.t then
			table.remove(run.events, i)
			local ok, err = pcall(ev.fn)
			if not ok then warn(err) end
		end
	end

	if #run.queue > 0 and now >= run.nextSpawn and #run.enemies < run.cap then
		local item = table.remove(run.queue, 1)
		local x, z
		if item.boss then
			x, z = run.info.ox, -run.info.half + 22
		else
			x, z = pickSpawn(run)
		end
		spawnEnemy(run, item.def, item.lvl, x, z)
		run.nextSpawn = now + 0.45
	end

	local list = run.enemies
	for _, e in ipairs(list) do
		stepEnemy(run, e, dt, now)
	end
	for i = 1, #list do
		for j = i + 1, #list do
			local a, b = list[i], list[j]
			local dx, dz = b.x - a.x, b.z - a.z
			local m = (a.r + b.r) * 0.85
			local d2 = dx * dx + dz * dz
			if d2 < m * m and d2 > 0.0001 then
				local d = math.sqrt(d2)
				local push = (m - d) * 0.5
				local ux, uz = dx / d, dz / d
				if not a.boss then a.x = a.x - ux * push a.z = a.z - uz * push end
				if not b.boss then b.x = b.x + ux * push b.z = b.z + uz * push end
			end
		end
	end
	for _, e in ipairs(list) do
		if e.root and e.root.Parent then
			local pos = Vector3.new(e.x, 0.2, e.z)
			e.root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(e.fx, 0, e.fz))
		end
	end

	stepProjectiles(run, dt)

	if now >= run.nextHud then
		run.nextHud = now + 0.4
		local boss = nil
		if run.boss and not run.boss.dead then
			boss = { name = run.boss.def.name, hp = run.boss.hp, max = run.boss.maxHp }
		end
		runFx(run, "Run", { wave = run.wave, waves = 3, left = #run.enemies + #run.queue, boss = boss, loc = run.cfg.name, diff = run.dcfg.name, test = run.test })
	end
end

local function reviveDead(run)
	for _, p in ipairs(run.players) do
		local st = S[p]
		if st and st.dead then
			st.dead = false
			task.spawn(function()
				p:LoadCharacter()
			end)
		end
	end
end

local function healAll(run, frac)
	for _, p in ipairs(run.players) do
		local _, h = getChar(p)
		if h and h.Health > 0 then
			h.Health = math.min(h.MaxHealth, h.Health + h.MaxHealth * frac)
		end
	end
end

local function runMain(run)
	task.wait(3)
	for w = 1, 3 do
		if run.over then return end
		run.wave = w
		run.queue = buildQueue(run, w)
		run.nextSpawn = os.clock() + 1
		if w == 3 then
			runToast(run, "FINAL WAVE 3 / 3  -  BOSS!", "ff4d4d", 4)
		else
			runToast(run, "WAVE " .. w .. " / 3", "ffd84a", 3)
		end
		while not run.over do
			task.wait(0.3)
			if #run.queue == 0 and #run.enemies == 0 then break end
		end
		if run.over then return end
		if w < 3 then
			runToast(run, "WAVE " .. w .. " CLEARED!", "6bd66b", 3)
			reviveDead(run)
			healAll(run, 0.5)
			task.wait(7)
		end
	end
	if not run.over then finishRun(run, true) end
end

local function createRun(locId, diff, members)
	local cfg = Config.Locations[locId]
	local dcfg = Config.Difficulties[diff]
	local slot = 1
	while slots[slot] do slot = slot + 1 end
	local ox = 3000 + slot * 400
	local folder = Instance.new("Folder")
	folder.Name = "Run" .. slot
	folder.Parent = Workspace
	local info = MapBuilder.arena(locId, ox, folder, os.time() + slot * 17)
	local ef = Instance.new("Folder")
	ef.Name = "Enemies"
	ef.Parent = folder
	local total = math.clamp(50 + (#members - 1) * 8 + dcfg.extra, 50, 100)
	local w1 = math.floor(total * 0.3)
	local w2 = math.floor(total * 0.35)
	local run = {
		cfg = cfg, dcfg = dcfg, diff = diff, slot = slot, folder = folder, enemyFolder = ef, info = info,
		players = {}, enemies = {}, projs = {}, queue = {}, events = {}, targets = {}, gain = {},
		wave = 0, total = total, waveCounts = { w1, w2, total - w1 - w2 },
		cap = math.min(36, 18 + 6 * #members), nextSpawn = 0, nextHud = 0, over = false,
	}
	slots[slot] = run
	table.insert(runs, run)
	for _, p in ipairs(members) do
		local st = S[p]
		st.run = run
		st.zone = nil
		st.party = nil
		st.dead = false
		st.abCd = {}
		st.lockAtk = 0
		st.lockCast = 0
		table.insert(run.players, p)
		run.gain[p] = { xp = 0, coins = 0, kills = 0 }
		p:SetAttribute("InRun", true)
		ToClient:FireClient(p, "Zone", nil)
		ToClient:FireClient(p, "Env", locId)
		local c = p.Character
		if c then
			c:PivotTo(CFrame.new(info.spawn + Vector3.new(math.random(-8, 8), 0, math.random(-4, 4))))
			applyStats(p, true)
		end
		toast(p, cfg.name .. "  -  " .. dcfg.name, dcfg.color, 3.5)
	end
	task.spawn(runMain, run)
end

startRun = function(pt)
	if not parties[pt.id] then return end
	parties[pt.id] = nil
	local members = {}
	for _, p in ipairs(pt.members) do
		local st = S[p]
		if st then
			st.party = nil
			local c, h = getChar(p)
			if c and h.Health > 0 and p.Parent then table.insert(members, p) end
		end
	end
	if #members > 0 then
		createRun(pt.loc, pt.diff, members)
	end
	broadcastParties(pt.gate)
end

returnToLobby = function(p)
	local st = S[p]
	if not st then return end
	local run = st.run
	st.run = nil
	st.zone = nil
	st.dead = false
	p:SetAttribute("InRun", false)
	if run then
		local i = table.find(run.players, p)
		if i then table.remove(run.players, i) end
	end
	ToClient:FireClient(p, "Env", "lobby")
	ToClient:FireClient(p, "RunEnd")
	local c, h, hrp = getChar(p)
	if c and h.Health > 0 and not hrp.Anchored then
		applyStats(p, true)
		c:PivotTo(CFrame.new(lobbySpawnPos()))
	else
		task.spawn(function()
			p:LoadCharacter()
		end)
	end
	pushData(p)
end

endRun = function(run)
	if run.destroyed then return end
	run.destroyed = true
	run.over = true
	for i = #run.players, 1, -1 do
		returnToLobby(run.players[i])
	end
	if run.folder then run.folder:Destroy() end
	if slots[run.slot] == run then slots[run.slot] = nil end
end

finishRun = function(run, won)
	if run.over then return end
	run.over = true
	local cfg, dc = run.cfg, run.dcfg
	for _, p in ipairs(run.players) do
		local d = D[p]
		if d then
			local xp, coins, unlockedName = 0, 0, nil
			if won then
				xp = math.floor(cfg.xp * dc.reward)
				coins = math.floor(cfg.coins * dc.reward)
				d.coins = d.coins + coins
				d.wins = (d.wins or 0) + 1
				if run.diff == (d.unlocked[cfg.id] or 1) and run.diff < #Config.Difficulties then
					d.unlocked[cfg.id] = run.diff + 1
					unlockedName = Config.Difficulties[run.diff + 1].name
				end
				grantXP(p, xp)
			end
			local g = run.gain[p]
			ToClient:FireClient(p, "Result", {
				won = won, xp = xp + g.xp, coins = coins + g.coins, kills = g.kills, unlocked = unlockedName,
				level = d.level, loc = cfg.name, diff = dc.name,
			})
			pushData(p)
			task.spawn(saveData, p)
		end
	end
	task.delay(won and 20 or 10, function()
		endRun(run)
	end)
end

checkDefeat = function(run)
	if run.over then return end
	for _, p in ipairs(run.players) do
		local st = S[p]
		if st and not st.dead then return end
	end
	finishRun(run, false)
end

onDied = function(p, char)
	local st = S[p]
	if not st then return end
	st.dead = true
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Anchored = true end
	local sp = char:FindFirstChild("Sprite")
	if sp then
		for _, d in ipairs(sp:GetDescendants()) do
			if d:IsA("BasePart") then d.Transparency = math.max(d.Transparency, 0.7) end
		end
	end
	ToClient:FireClient(p, "Down")
	if st.run then
		checkDefeat(st.run)
	else
		task.delay(2, function()
			if S[p] and S[p].dead then
				S[p].dead = false
				p:LoadCharacter()
			end
		end)
	end
end

-- ============================================================ ABILITIES (Q / E / Z)
local abRng = Random.new()
local function rnd() return 0.92 + abRng:NextNumber() * 0.16 end

local function rot(dx, dz, a)
	local c, s = math.cos(a), math.sin(a)
	return dx * c - dz * s, dx * s + dz * c
end

local function aliveRun(run)
	return run ~= nil and not run.over and not run.destroyed
end

-- delayed callback that is cancelled automatically when the run ends
local function later(run, t, fn)
	task.delay(t, function()
		if not aliveRun(run) then return end
		local ok, err = pcall(fn)
		if not ok then warn("[ability] " .. tostring(err)) end
	end)
end

local function clampXZ(run, x, z)
	local info = run.info
	if info then
		local lim = info.half - 3
		x = math.clamp(x, info.ox - lim, info.ox + lim)
		z = math.clamp(z, -lim, lim)
	end
	return x, z
end

-- aim point limited to maxD studs from the caster, kept inside the arena
local function clampTarget(run, px, pz, aim, maxD)
	local tx, tz = aim.X - px, aim.Z - pz
	local m = math.sqrt(tx * tx + tz * tz)
	if m > maxD then tx, tz = tx / m * maxD, tz / m * maxD end
	return clampXZ(run, px + tx, pz + tz)
end

local function pushEnemy(run, e, dx, dz, dist)
	if e.dead or e.boss then return end
	local m = math.sqrt(dx * dx + dz * dz)
	if m < 0.001 then return end
	moveEnemy(run, e, dx / m * dist, dz / m * dist)
end

-- crowd control: stun + slow (bosses cannot be stunned, only slowed)
local function applyCC(e, stun, slow, mul)
	local now = os.clock()
	if stun and stun > 0 then
		if e.boss then
			slow = math.max(slow or 0, stun * 1.2)
			mul = math.min(mul or 1, 0.6)
		else
			e.stunUntil = math.max(e.stunUntil or 0, now + stun)
			e.nextAtk = math.max(e.nextAtk or 0, now + stun + 0.25)
		end
	end
	if slow and slow > 0 then
		local m = mul or 0.5
		if e.slowUntil and now < e.slowUntil then m = math.min(m, e.slowMul or 1) end
		e.slowUntil = math.max(e.slowUntil or 0, now + slow)
		e.slowMul = m
	end
end

local function applyBurn(e, dps, dur, owner)
	local now = os.clock()
	e.burn = { untilT = now + dur, dps = dps, owner = owner, nextT = now + 0.5 }
end

local ELEMS = { "fire", "frost", "shock", "void", "nature", "holy" }
-- weapon element: small on-hit effect, stronger for rarer weapons
procElement = function(run, e, ks, killer, dmg)
	local el = ks.elem
	local tier = ks.tier or 1
	local now = os.clock()
	if el == "prism" then el = ELEMS[math.random(#ELEMS)] end
	if now < (e.procAt or 0) then return end
	e.procAt = now + 0.35
	if el ~= "fire" and now >= (e.procFxAt or 0) then
		e.procFxAt = now + 1.0
		runFx(run, "Proc", e.x, e.z, e.r, el)
	end
	if el == "fire" then
		applyBurn(e, math.max(2, dmg * 0.3), 2 + tier * 0.3, killer)
	elseif el == "frost" then
		applyCC(e, 0, 1.2 + tier * 0.2, 0.55)
	elseif el == "nature" then
		applyCC(e, 0, 1.0 + tier * 0.15, 0.7)
	elseif el == "shock" then
		if math.random() < 0.06 + 0.02 * tier then applyCC(e, 0.45) end
	elseif el == "void" then
		if now >= (ks.healAt or 0) then
			ks.healAt = now + 0.25
			local _, h = getChar(killer)
			if h and h.Health > 0 then h.Health = math.min(h.MaxHealth, h.Health + h.MaxHealth * 0.004 * tier) end
		end
	end
end

local ABIL = { Swordsman = {}, Archer = {}, Mage = {} }

-- ---------------------------------------------------------------- SWORDSMAN
-- Q: Crimson Charge - lunge through enemies, finish with a 360 slash
ABIL.Swordsman.Q = function(run, p, st, ws, hrp, px, pz, dx, dz)
	local dist, dur = 22 * (1 + (ws.rs - 1) * 0.6), 0.22
	local now = os.clock()
	st.invUntil = now + dur + 0.2
	st.lockAtk = now + dur + 0.25
	swingWeapon(st, "Swordsman", 0.3)
	ToClient:FireClient(p, "Lunge", dx, dz, dist / dur, dur)
	runFx(run, "SwCharge", px, pz, dx, dz, dist, dur)
	local hit = {}
	local dmg = ws.damage * 2.3 * ws.am
	task.spawn(function()
		local t0 = os.clock()
		while aliveRun(run) and os.clock() - t0 < dur + 0.06 do
			local _, _, r = getChar(p)
			if not r then return end
			for _, e in ipairs(enemiesInCircle(run, r.Position.X, r.Position.Z, 4.4 * ws.rs)) do
				if not hit[e] then
					hit[e] = true
					damageEnemy(run, e, dmg * rnd(), p, false)
					if not e.dead then
						pushEnemy(run, e, dx, dz, 4)
						applyCC(e, 0.5)
					end
					runFx(run, "Spark", e.x, e.z, 255, 90, 90)
				end
			end
			task.wait()
		end
		local _, _, r = getChar(p)
		if not r or not aliveRun(run) then return end
		local ex, ez = r.Position.X, r.Position.Z
		local rad = ws.range * 1.15 * (1 + (ws.rs - 1) * 0.5)
		runFx(run, "Slash", ex, ez, dx, dz, rad, 360, true, st.swingDir or 1)
		runFx(run, "Ring", ex, ez, rad * 2.2, 255, 90, 80)
		for _, e in ipairs(enemiesInCircle(run, ex, ez, rad)) do
			damageEnemy(run, e, ws.damage * 1.4 * ws.am * rnd(), p, true)
			if not e.dead then
				pushEnemy(run, e, e.x - ex, e.z - ez, 3)
				applyCC(e, 0.6)
			end
		end
	end)
end

-- E: Blade Whirlwind - spin and shred everything around you
ABIL.Swordsman.E = function(run, p, st, ws, hrp)
	local dur, radius, ticks = 2.4 + 0.1 * (ws.tier - 1), 10.5 * ws.rs, 8 + ws.cnt * 2
	st.lockAtk = os.clock() + dur + 0.1
	st.swingTok = (st.swingTok or 0) + 1
	runFx(run, "SwSpin", p.UserId, dur, radius)
	local w = st.weapon
	task.spawn(function()
		local t0 = os.clock()
		local nextTick = 0
		if w and w.trail then w.trail.Enabled = true end
		while aliveRun(run) do
			local t = os.clock() - t0
			if t >= dur then break end
			local _, hh, r = getChar(p)
			if not r or hh.Health <= 0 then break end
			if w and w.weld.Parent then
				w.weld.C0 = CFrame.Angles(0, -t * 24, 0) * w.base
			end
			if t >= nextTick then
				nextTick = nextTick + dur / ticks
				local cx, cz = r.Position.X, r.Position.Z
				for _, e in ipairs(enemiesInCircle(run, cx, cz, radius)) do
					damageEnemy(run, e, ws.damage * 0.8 * ws.am * rnd(), p, false)
					if not e.dead then
						pushEnemy(run, e, e.x - cx, e.z - cz, 1.1)
						applyCC(e, 0, 0.3, 0.6)
					end
				end
			end
			task.wait()
		end
		if w and w.trail then w.trail.Enabled = false end
		if w and w.weld.Parent then w.weld.C0 = w.base end
	end)
end

-- Z: Heaven's Verdict - colossal sword from the sky + aftershock
ABIL.Swordsman.Z = function(run, p, st, ws, hrp, px, pz, dx, dz, aim)
	local R, fall = 15 * ws.rs, 1.25
	local tx, tz = clampTarget(run, px, pz, aim, 42)
	st.lockAtk = os.clock() + fall + 0.3
	st.invUntil = os.clock() + 0.3
	swingWeapon(st, "Swordsman", 0.5)
	runFx(run, "SwUlt", tx, tz, R, fall)
	later(run, fall, function()
		for _, e in ipairs(enemiesInCircle(run, tx, tz, R)) do
			damageEnemy(run, e, ws.damage * 10 * ws.am * rnd(), p, true)
			if not e.dead then
				pushEnemy(run, e, e.x - tx, e.z - tz, 4)
				applyCC(e, 2.5, 3, 0.5)
			end
		end
	end)
	later(run, fall + 0.65, function()
		for _, e in ipairs(enemiesInCircle(run, tx, tz, R * 1.35)) do
			damageEnemy(run, e, ws.damage * 3.5 * ws.am * rnd(), p, false)
			if not e.dead then pushEnemy(run, e, e.x - tx, e.z - tz, 3) end
		end
	end)
	-- rarer swords add extra aftershock waves
	for i = 1, math.floor(ws.cnt / 2) do
		later(run, fall + 0.65 + 0.45 * i, function()
			local rr = R * (1.35 + 0.3 * i)
			local col = Color3.fromRGB(255, 220, 140)
			runFx(run, "Ring", tx, tz, rr * 2, 255, 220, 150)
			for _, e in ipairs(enemiesInCircle(run, tx, tz, rr)) do
				damageEnemy(run, e, ws.damage * 2.2 * ws.am * rnd(), p, false)
				if not e.dead then pushEnemy(run, e, e.x - tx, e.z - tz, 2.5) end
			end
		end)
	end
end

-- ---------------------------------------------------------------- ARCHER
-- Q: Arrow Fan - 9 arrows in a cone
ABIL.Archer.Q = function(run, p, st, ws, hrp, px, pz, dx, dz)
	local n, spread = 9 + ws.cnt * 2, math.rad(64 + ws.cnt * 7)
	st.lockAtk = os.clock() + 0.25
	swingWeapon(st, "Archer", 0.3)
	for i = 1, n do
		local a = (i - 1) / (n - 1) - 0.5
		local ddx, ddz = rot(dx, dz, a * spread)
		spawnProj(run, {
			kind = "arrow", x = px + ddx * 2, z = pz + ddz * 2, dx = ddx, dz = ddz,
			speed = Config.Classes.Archer.projSpeed * 1.15, range = ws.range,
			dmg = ws.damage * 1.0 * ws.am * rnd(), owner = p, crit = false, hitR = 0.9,
		})
	end
	runFx(run, "Fan", px, pz, dx, dz, spread)
end

-- E: Frost Trap - rune that freezes everything in the area
ABIL.Archer.E = function(run, p, st, ws, hrp, px, pz, dx, dz, aim)
	local R, delay = 11.5 * ws.rs, 0.75
	local tx, tz = clampTarget(run, px, pz, aim, 48)
	st.lockAtk = os.clock() + 0.25
	swingWeapon(st, "Archer", 0.3)
	runFx(run, "TrapSet", tx, tz, R, delay)
	later(run, delay, function()
		runFx(run, "Freeze", tx, tz, R, 2.6)
		for _, e in ipairs(enemiesInCircle(run, tx, tz, R)) do
			damageEnemy(run, e, ws.damage * 2.0 * ws.am * rnd(), p, false)
			if not e.dead then applyCC(e, 2.6, 3.5, 0.4) end
		end
	end)
	-- lingering frost field keeps slowing + chips enemies
	for k = 1, 8 do
		later(run, delay + 0.45 * k, function()
			for _, e in ipairs(enemiesInCircle(run, tx, tz, R)) do
				applyCC(e, 0, 0.7, 0.4)
				if k % 2 == 0 then damageEnemy(run, e, ws.damage * 0.25 * ws.am * rnd(), p, false) end
			end
		end)
	end
end

-- Z: Sunpiercer - charged piercing beam of light
ABIL.Archer.Z = function(run, p, st, ws, hrp, px, pz, dx, dz)
	local len, width, charge = 90 * (1 + (ws.rs - 1) * 0.5), 4.2 * ws.rs, 0.85
	st.lockAtk = os.clock() + charge + 0.8
	runFx(run, "BeamCharge", p.UserId, dx, dz, charge, len)
	local ox, oz = px, pz
	local function pulse(mult, stunT)
		for _, e in ipairs(table.clone(run.enemies)) do
			local ex, ez = e.x - ox, e.z - oz
			local t = ex * dx + ez * dz
			if t > -2 and t < len then
				local perp = math.abs(ex * dz - ez * dx)
				if perp <= width + e.r then
					damageEnemy(run, e, ws.damage * mult * ws.am * rnd(), p, mult > 5)
					if not e.dead then applyCC(e, stunT, 1.5, 0.5) end
				end
			end
		end
	end
	later(run, charge, function()
		local _, _, r = getChar(p)
		if r then ox, oz = r.Position.X, r.Position.Z end
		swingWeapon(st, "Archer", 0.6)
		runFx(run, "Beam", ox, oz, dx, dz, len, width, 0.75 + 0.1 * ws.cnt)
		pulse(6.5, 1.2)
	end)
	later(run, charge + 0.25, function() pulse(2.5, 0) end)
	later(run, charge + 0.5, function() pulse(2.5, 0) end)
	for i = 1, ws.cnt do
		later(run, charge + 0.5 + 0.1 * i, function() pulse(2.0, 0) end)
	end
end

-- ---------------------------------------------------------------- MAGE
-- Q: Chain Lightning
ABIL.Mage.Q = function(run, p, st, ws, hrp, px, pz, dx, dz, aim)
	st.lockAtk = os.clock() + 0.3
	swingWeapon(st, "Mage", 0.4)
	local sx, sz = px + dx * 1.5, pz + dz * 1.5
	local first, bd = nil, math.huge
	for _, e in ipairs(run.enemies) do
		local d2 = (e.x - aim.X) ^ 2 + (e.z - aim.Z) ^ 2
		local dp = math.sqrt((e.x - px) ^ 2 + (e.z - pz) ^ 2)
		if d2 < bd and dp < 55 then
			bd = d2
			first = e
		end
	end
	if not first or math.sqrt(bd) > 30 then
		runFx(run, "Chain", sx, sz, px + dx * 34, pz + dz * 34)
		return
	end
	local chain, seen = { first }, { [first] = true }
	local cur = first
	for _ = 1, 7 + ws.cnt * 2 do
		local nxt, nd = nil, (18 * (1 + (ws.rs - 1) * 0.6)) ^ 2
		for _, e in ipairs(run.enemies) do
			if not seen[e] then
				local d2 = (e.x - cur.x) ^ 2 + (e.z - cur.z) ^ 2
				if d2 < nd then
					nd = d2
					nxt = e
				end
			end
		end
		if not nxt then break end
		seen[nxt] = true
		table.insert(chain, nxt)
		cur = nxt
	end
	local flat = { sx, sz }
	for _, e in ipairs(chain) do
		table.insert(flat, e.x)
		table.insert(flat, e.z)
	end
	runFx(run, "Chain", table.unpack(flat))
	for i, e in ipairs(chain) do
		later(run, (i - 1) * 0.07, function()
			if e.dead then return end
			damageEnemy(run, e, ws.damage * 2.1 * ws.am * (0.94 ^ (i - 1)) * rnd(), p, false)
			if not e.dead then applyCC(e, 0.7) end
		end)
	end
end

-- E: Arcane Blink
ABIL.Mage.E = function(run, p, st, ws, hrp, px, pz, dx, dz, aim)
	local want = math.clamp(math.sqrt((aim.X - px) ^ 2 + (aim.Z - pz) ^ 2), 8, 26 * (1 + (ws.rs - 1) * 0.4))
	local nx, nz = clampXZ(run, px + dx * want, pz + dz * want)
	local info = run.info
	if info then
		for _, o in ipairs(info.obstacles) do
			local ddx, ddz = nx - o.x, nz - o.z
			local minD = o.r + 2.5
			local d2 = ddx * ddx + ddz * ddz
			if d2 < minD * minD then
				local d = math.sqrt(d2)
				if d < 0.01 then d = 0.01 ddx = 1 end
				nx = o.x + ddx / d * minD
				nz = o.z + ddz / d * minD
			end
		end
	end
	local now = os.clock()
	st.invUntil = now + 0.6
	st.lockAtk = now + 0.35
	swingWeapon(st, "Mage", 0.4)
	runFx(run, "Blink", px, pz, nx, nz)
	ToClient:FireClient(p, "BlinkTo", nx, nz)
	local R = 10 * ws.rs
	for _, e in ipairs(enemiesInCircle(run, px, pz, R)) do
		damageEnemy(run, e, ws.damage * 1.6 * ws.am * rnd(), p, false)
		if not e.dead then
			pushEnemy(run, e, e.x - px, e.z - pz, 5)
			applyCC(e, 0.8)
		end
	end
	later(run, 0.18, function()
		for _, e in ipairs(enemiesInCircle(run, nx, nz, R)) do
			damageEnemy(run, e, ws.damage * 1.6 * ws.am * rnd(), p, false)
			if not e.dead then
				pushEnemy(run, e, e.x - nx, e.z - nz, 5)
				applyCC(e, 0.8, 1.5, 0.6)
			end
		end
	end)
end

-- Z: Meteor Storm
ABIL.Mage.Z = function(run, p, st, ws, hrp, px, pz, dx, dz, aim)
	local tx, tz = clampTarget(run, px, pz, aim, 50)
	local count, scatter, fall, R = 10 + ws.cnt * 3, 17 * ws.rs, 1.15, 8.5 * (1 + (ws.rs - 1) * 0.7)
	st.lockAtk = os.clock() + 0.6
	swingWeapon(st, "Mage", 0.8)
	for i = 1, count do
		local ang = abRng:NextNumber() * math.pi * 2
		local rad = (i == 1) and 0 or math.sqrt(abRng:NextNumber()) * scatter
		local mx, mz = clampXZ(run, tx + math.cos(ang) * rad, tz + math.sin(ang) * rad)
		local t0 = (i - 1) * math.max(0.1, 3.6 / count)
		later(run, t0, function() runFx(run, "Meteor", mx, mz, fall, R) end)
		later(run, t0 + fall, function()
			for _, e in ipairs(enemiesInCircle(run, mx, mz, R)) do
				damageEnemy(run, e, ws.damage * 3.8 * ws.am * rnd(), p, false)
				if not e.dead then
					pushEnemy(run, e, e.x - mx, e.z - mz, 2.5)
					applyBurn(e, ws.damage * 0.9, 4, p)
				end
			end
		end)
	end
end

local function castAbility(p, key)
	local st = S[p]
	if not st or type(key) ~= "string" then return end
	local run = st.run
	if not run or run.over or st.dead then
		if not run and not st.dead then toast(p, "Abilities work inside dungeons only!", "ff9a3c", 2) end
		return
	end
	local d = D[p]
	local cls = classOf(p)
	if not cls then return end
	local def = Config.Abilities[cls] and Config.Abilities[cls][key]
	local fn = ABIL[cls] and ABIL[cls][key]
	if not def or not fn then return end
	local c, h, hrp = getChar(p)
	if not c or h.Health <= 0 then return end
	local now = os.clock()
	st.abCd = st.abCd or {}
	if now < (st.abCd[key] or 0) then return end
	if now < (st.lockCast or 0) then return end
	local aim = st.lastAim
	if typeof(aim) ~= "Vector3" then aim = hrp.Position + hrp.CFrame.LookVector * 20 end
	local wdef = weaponDefOf(p)
	local ws = Config.weaponStats(cls, d.upg[cls], wdef)
	local px, pz = hrp.Position.X, hrp.Position.Z
	local dx, dz = aim.X - px, aim.Z - pz
	local m = math.sqrt(dx * dx + dz * dz)
	if m < 0.01 then
		local lv = hrp.CFrame.LookVector
		dx, dz = lv.X, lv.Z
		m = math.sqrt(dx * dx + dz * dz)
		if m < 0.01 then dx, dz, m = 0, -1, 1 end
	end
	dx, dz = dx / m, dz / m
	-- rarer weapons recharge faster
	local cd = def.cd * ws.cdr
	st.abCd[key] = now + cd
	st.lockCast = now + 0.3
	runFx(run, "Theme", ws.wid)
	local ok, err = pcall(fn, run, p, st, ws, hrp, px, pz, dx, dz, aim)
	if not ok then
		warn("[ability " .. cls .. key .. "] " .. tostring(err))
		st.abCd[key] = 0
		return
	end
	ToClient:FireClient(p, "AbCd", key, cd)
	-- rarity aura around the caster (bigger for higher tiers / ultimates)
	runFx(run, "Aura", px, pz, ws.tier, def.ult and 2 or 1, ws.wid)
	if def.ult then
		ToClient:FireClient(p, "UltBanner", wdef and wdef.ult or def.name, Config.Classes[cls].color, ws.wid)
	end
end

-- ============================================================ REMOTES
local chestRng = Random.new()
ToServer.OnServerEvent:Connect(function(p, action, a, b, c, d, e)
	local st = S[p]
	if not st or type(action) ~= "string" then return end
	if action == "Attack" then
		if typeof(a) == "Vector3" then
			st.lastAim = a
			playerAttack(p, a)
		end
	elseif action == "Aim" then
		if typeof(a) == "Vector3" then st.lastAim = a end
	elseif action == "Ability" then
		if typeof(b) == "Vector3" then st.lastAim = b end
		castAbility(p, a)
	elseif action == "Dash" then
		local now = os.clock()
		if now < (st.dashAt or 0) or st.dead then return end
		st.dashAt = now + Config.DashCooldown - 0.2
		st.invUntil = now + 0.3
		local _, _, hrp = getChar(p)
		if hrp then
			ToClient:FireAllClients("DashFx", hrp.Position.X, hrp.Position.Z)
		end
	elseif action == "ChooseClass" then
		if not st.run and not st.party and type(a) == "string" and Config.Classes[a] then
			if D[p].class ~= a then chooseClass(p, a) end
		end
	elseif action == "CreateParty" then
		createParty(p, a, b, c, d, e)
	elseif action == "JoinParty" then
		joinParty(p, a)
	elseif action == "LeaveParty" then
		leaveParty(p)
	elseif action == "StartParty" then
		local pt = st.party
		if pt and pt.host == p then startRun(pt) end
	elseif action == "Upgrade" then
		if st.zone ~= "upgrade" or type(a) ~= "string" or type(b) ~= "string" then return end
		local d = D[p]
		if not Config.Classes[a] then return end
		local def
		for _, s in ipairs(Config.Stats) do
			if s.id == b then def = s end
		end
		if not def then return end
		d.upg[a] = d.upg[a] or {}
		local lv = d.upg[a][b] or 0
		if lv >= def.max or d.points < 1 then return end
		d.points = d.points - 1
		d.upg[a][b] = lv + 1
		pushData(p)
	elseif action == "BuyVit" then
		local d = D[p]
		if st.zone ~= "upgrade" or d.vit >= Config.VitMax then return end
		local cost = Config.vitCost(d.vit)
		if d.coins < cost then return end
		d.coins = d.coins - cost
		d.vit = d.vit + 1
		local _, h = getChar(p)
		applyStats(p, false)
		if h then h.Health = math.min(h.MaxHealth, h.Health + 12) end
		pushData(p)
	elseif action == "BuySwift" then
		local d = D[p]
		if st.zone ~= "upgrade" or d.swift >= Config.SwiftMax then return end
		local cost = Config.swiftCost(d.swift)
		if d.coins < cost then return end
		d.coins = d.coins - cost
		d.swift = d.swift + 1
		applyStats(p, false)
		pushData(p)
	elseif action == "ReturnLobby" then
		if st.run and st.run.over then returnToLobby(p) end
	elseif action == "OpenChest" then
		-- a = chest id, b = weapon type, c = amount (1 / 5 / 10)
		local d = D[p]
		if st.zone ~= "chest" or st.run or type(a) ~= "string" or type(b) ~= "string" or type(c) ~= "number" then return end
		local chest
		for _, ch in ipairs(Config.Chests) do
			if ch.id == a then chest = ch end
		end
		if not chest or not Config.ByType[b] then return end
		local amount = math.floor(c)
		local disc = Config.MultiDiscount[amount]
		if not disc or os.clock() < (st.chestLock or 0) then return end
		local cost = math.floor(chest.price * amount * disc)
		if d.coins < cost then
			toast(p, "Не хватает монет!", "ff6b6b", 2)
			return
		end
		d.coins = d.coins - cost
		local results, best = {}, 0
		for _ = 1, amount do
			local w = Config.rollWeapon(chest, b, chestRng)
			local isNew = (d.inv[w.id] or 0) == 0
			d.inv[w.id] = (d.inv[w.id] or 0) + 1
			table.insert(results, { id = w.id, new = isNew })
			if w.tier > best then best = w.tier end
			if w.tier >= 6 then
				local col = Config.Rarities[w.tier].color:ToHex()
				ToClient:FireAllClients("Toast", p.DisplayName .. " выбил " .. string.upper(Config.Rarities[w.tier].name) .. ": " .. w.name .. "!", col, 4.5)
			end
		end
		d.opened = (d.opened or 0) + amount
		st.chestLock = os.clock() + 0.6
		pushData(p)
		ToClient:FireClient(p, "ChestResult", chest.id, results, cost)
		if os.clock() - (st.lastSave or 0) > 25 then
			st.lastSave = os.clock()
			task.spawn(saveData, p)
		end
	elseif action == "Equip" then
		local d = D[p]
		local w = type(a) == "string" and Config.Weapons[a]
		if not w or st.run or (d.inv[a] or 0) < 1 then return end
		d.equip[w.type] = a
		d.class = w.type
		applyStats(p, false)
		local _, h = getChar(p)
		if h then h.Health = h.MaxHealth end
		buildSprite(p)
		pushData(p)
		toast(p, "Экипировано: " .. w.name, Config.Rarities[w.tier].color:ToHex(), 2.2)
	elseif action == "Sell" then
		-- a = weapon id or "all": sells every duplicate (one copy of each weapon is always kept)
		local d = D[p]
		if st.run or type(a) ~= "string" then return end
		local total, n = 0, 0
		for id, cnt in pairs(d.inv) do
			local w = Config.Weapons[id]
			if w and cnt > 1 and (a == "all" or a == id) then
				total = total + (cnt - 1) * Config.Rarities[w.tier].sell
				n = n + cnt - 1
				d.inv[id] = 1
			end
		end
		if n > 0 then
			d.coins = d.coins + total
			pushData(p)
			toast(p, "Продано дубликатов: " .. n .. "  (+" .. total .. " монет)", "ffd84a", 2.5)
		end
	elseif TestArea and TestArea.onAction then -- [TESTAREA]
		local ok, err = pcall(TestArea.onAction, p, st, action, a, b, c)
		if not ok then warn("[TestArea] " .. tostring(err)) end
	end
end)

-- ============================================================ PLAYERS
local function onPlayer(p)
	S[p] = { zone = nil, run = nil, party = nil, nextAtk = 0, dashAt = 0, invUntil = 0, dead = false }
	D[p] = loadData(p)
	p:SetAttribute("InRun", false)
	pushData(p)
	p.CharacterAdded:Connect(function(c)
		task.spawn(setupCharacter, p, c)
	end)
	p:LoadCharacter()
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, p)
end

Players.PlayerRemoving:Connect(function(p)
	local st = S[p]
	if st then
		leaveParty(p)
		local run = st.run
		if run then
			local i = table.find(run.players, p)
			if i then table.remove(run.players, i) end
			if #run.players == 0 then
				endRun(run)
			else
				checkDefeat(run)
			end
		end
	end
	saveData(p)
	S[p] = nil
	D[p] = nil
end)

game:BindToClose(function()
	for p in pairs(D) do
		saveData(p)
	end
end)

-- zone detection (lobby)
task.spawn(function()
	while true do
		task.wait(0.15)
		for p, st in pairs(S) do
			if not st.run then
				local zone
				local _, h, hrp = getChar(p)
				if hrp and h.Health > 0 and not st.dead then
					local pos = hrp.Position
					for _, zn in ipairs(Config.Lobby.zones) do
						local dx, dz = pos.X - zn.x, pos.Z - zn.z
						if dx * dx + dz * dz <= zn.r * zn.r then
							zone = zn
							break
						end
					end
				end
				local zid = zone and zone.id or nil
				if zid ~= st.zone then
					st.zone = zid
					if st.party and st.party.gate ~= zid then leaveParty(p) end
					ToClient:FireClient(p, "Zone", zid)
					if zid and gateZones[zid] then task.spawn(sendParties, p, zid) end
				end
			end
		end
	end
end)

-- autosave
task.spawn(function()
	while true do
		task.wait(90)
		for p in pairs(D) do
			task.spawn(saveData, p)
		end
	end
end)

-- main simulation loop
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	dt = math.min(dt, 0.1)
	for i = #runs, 1, -1 do
		local run = runs[i]
		if run.destroyed then
			table.remove(runs, i)
		elseif not run.over then
			local ok, err = pcall(updateRun, run, dt, now)
			if not ok then warn("[Run error] " .. tostring(err)) end
		end
	end
end)

-- [TESTAREA] hand the internals to the test place module
if TestArea then
	local ok, err = pcall(TestArea.init, {
		Config = Config, D = D, S = S, runs = runs, slots = slots, getChar = getChar, applyStats = applyStats,
		buildSprite = buildSprite, pushData = pushData, toast = toast, returnToLobby = returnToLobby, endRun = endRun,
		spawnEnemy = spawnEnemy, runFx = runFx, ToClient = ToClient, lobbySpawnPos = lobbySpawnPos,
	})
	if not ok then warn("[TestArea] init failed: " .. tostring(err)) end
end

print("[TopDownHeroes] server ready")
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX6">
<Properties>
<string name="Name">Sprites</string>
<ProtectedString name="Source"><![CDATA[-- Flat "2D sprite" builder: everything is made from thin discs / blocks seen from above
local TweenService = game:GetService("TweenService")

local Sprites = {}
Sprites.__index = Sprites

local BLACK = Color3.fromRGB(0, 0, 0)
local NEON = Enum.Material.Neon
local FABRIC = Enum.Material.Fabric
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.Wood
local SLATE = Enum.Material.Slate

local function mkPart(parent, shape, size, cf, color, mat, trans)
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Transparency = trans or 0
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
	return w
end

function Sprites.new(root, parent, baseY, scale)
	return setmetatable({ root = root, parent = parent, baseY = baseY or 0, k = scale or 1 }, Sprites)
end

-- flat circle. x/z offset in local space (forward = -z), y = layer height
function Sprites:disc(d, color, x, z, y, mat, trans, thick)
	local k = self.k
	local cf = self.root.CFrame * CFrame.new(x * k, self.baseY + y * k, z * k) * CFrame.Angles(0, 0, math.pi / 2)
	local p = mkPart(self.parent, Enum.PartType.Cylinder, Vector3.new((thick or 0.3) * k, d * k, d * k), cf, color, mat, trans)
	weld(self.root, p)
	return p
end

function Sprites:block(sx, sz, color, x, z, y, rot, mat, trans, sy)
	local k = self.k
	local cf = self.root.CFrame * CFrame.new(x * k, self.baseY + y * k, z * k) * CFrame.Angles(0, rot or 0, 0)
	local p = mkPart(self.parent, Enum.PartType.Block, Vector3.new(sx * k, (sy or 0.3) * k, sz * k), cf, color, mat, trans)
	weld(self.root, p)
	return p
end

function Sprites:light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = part
end

local function radialRot(vx, vz)
	return math.atan2(vx, vz)
end

-- ===================== WEAPONS =====================
local function C(r, g, b) return Color3.fromRGB(r, g, b) end

local function darker(c, m)
	return Color3.new(c.R * m, c.G * m, c.B * m)
end

local function attach(part, x, y, z, k)
	local a = Instance.new("Attachment")
	a.Position = Vector3.new(x * k, y * k, z * k)
	a.Parent = part
	return a
end

local function mkTrail(part, a0, a1, c0, c1, life)
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Lifetime = life or 0.2
	t.Color = ColorSequence.new(c0, c1 or c0)
	t.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.5, 0.65),
		NumberSequenceKeypoint.new(1, 1),
	})
	t.LightEmission = 0.7
	t.LightInfluence = 0
	t.MinLength = 0.05
	t.FaceCamera = false
	t.Enabled = false
	t.Parent = part
	return t
end

-- builds a weapon on an invisible pivot welded to root with an animatable Weld
-- returns { pivot, weld, base, trail?, arrow?, orb? }
function Sprites.weapon(kind, root, parent, handCF, scale, pal)
	pal = pal or {}
	local k = scale or 1
	local pivot = mkPart(parent, Enum.PartType.Block, Vector3.new(0.3, 0.3, 0.3), root.CFrame * handCF, Color3.new(1, 1, 1), nil, 1)
	local w = Instance.new("Weld")
	w.Part0 = root
	w.Part1 = pivot
	w.C0 = handCF
	w.Parent = pivot
	local s = Sprites.new(pivot, parent, 0, k)
	local out = { pivot = pivot, weld = w, base = handCF, kind = kind }

	if kind == "Swordsman" then
		local edge = pal.blade or C(168, 180, 198)
		local face = pal.fuller or C(222, 230, 241)
		local gold = pal.guard or C(212, 168, 72)
		local goldDark = darker(gold, 0.68)
		local grip = pal.grip or C(84, 54, 34)
		local gemC = pal.gem or C(186, 52, 66)

		-- grip with leather wraps
		s:block(0.42, 1.7, grip, 0, 0.25, 0.02, 0, FABRIC, 0, 0.3)
		for i = 0, 3 do
			s:block(0.5, 0.12, darker(grip, 0.55), 0, -0.4 + i * 0.4, 0.04, 0, FABRIC, 0, 0.3)
		end
		-- pommel
		s:disc(0.82, goldDark, 0, 1.2, 0.02, METAL, 0, 0.36)
		s:disc(0.44, gold, 0, 1.2, 0.04, METAL, 0, 0.4)
		-- crossguard
		s:block(2.8, 0.54, goldDark, 0, -0.75, 0.06, 0, METAL, 0, 0.3)
		s:block(2.4, 0.3, gold, 0, -0.75, 0.1, 0, METAL, 0, 0.32)
		s:disc(0.66, goldDark, -1.4, -0.75, 0.06, METAL, 0, 0.34)
		s:disc(0.66, goldDark, 1.4, -0.75, 0.06, METAL, 0, 0.34)
		s:disc(0.38, gold, -1.4, -0.75, 0.1, METAL, 0, 0.38)
		s:disc(0.38, gold, 1.4, -0.75, 0.1, METAL, 0, 0.38)
		s:disc(0.62, goldDark, 0, -0.75, 0.2, METAL, 0, 0.14)
		s:disc(0.4, gemC, 0, -0.75, 0.26, nil, 0, 0.14)
		s:disc(0.14, C(255, 190, 200), 0, -0.82, 0.34, NEON, 0.2, 0.06)
		-- blade: steel edge + bright face + fuller + rune glints
		local bladeEdge = s:block(0.96, 5.3, edge, 0, -3.5, 0.05, 0, METAL, 0, 0.2)
		s:block(0.62, 5.0, face, 0, -3.5, 0.1, 0, METAL, 0, 0.2)
		s:block(0.14, 3.9, C(118, 132, 156), 0, -3.4, 0.18, 0, METAL, 0, 0.08)
		s:block(0.06, 4.9, C(255, 255, 255), 0.27, -3.5, 0.2, 0, METAL, 0, 0.06)
		s:block(0.06, 4.9, C(150, 162, 184), -0.27, -3.5, 0.2, 0, METAL, 0, 0.06)
		for _, z in ipairs({ -2.3, -3.4, -4.5 }) do
			s:block(0.1, 0.42, C(150, 205, 255), 0, z, 0.23, 0, NEON, 0.3, 0.05)
		end
		s:block(0.68, 0.68, edge, 0, -6.1, 0.05, math.pi / 4, METAL, 0, 0.2)
		s:block(0.42, 0.42, face, 0, -6.1, 0.1, math.pi / 4, METAL, 0, 0.2)
		-- swing trail (enabled by the server while attacking)
		local a0 = attach(bladeEdge, 0, 0, -2.65, k)
		local a1 = attach(bladeEdge, 0, 0, -0.2, k)
		out.trail = mkTrail(bladeEdge, a0, a1, C(225, 240, 255), C(120, 170, 235), 0.2)

	elseif kind == "Archer" then
		local wood = pal.wood or C(124, 80, 42)
		local woodHi = C(166, 116, 66)
		local gold = C(212, 168, 72)
		local R = 3.0
		local prev
		for i = -5, 5 do
			local th = math.rad(i * 15)
			local pt = Vector2.new(R * math.sin(th), R * (1 - math.cos(th)))
			if prev then
				local v = pt - prev
				local len = v.Magnitude
				local mid = (pt + prev) / 2
				local rot = radialRot(v.X, v.Y)
				s:block(0.5, len + 0.14, darker(wood, 0.75), mid.X, mid.Y, 0.08, rot, WOOD, 0, 0.3)
				s:block(0.3, len + 0.1, wood, mid.X, mid.Y, 0.14, rot, WOOD, 0, 0.3)
				s:block(0.1, len + 0.06, woodHi, mid.X + 0.04, mid.Y, 0.3, rot, WOOD, 0, 0.1)
			end
			prev = pt
		end
		local tipZ = R * (1 - math.cos(math.rad(75)))
		local tipX = R * math.sin(math.rad(75))
		-- limb tips
		s:disc(0.6, gold, tipX, tipZ, 0.1, METAL, 0, 0.36)
		s:disc(0.6, gold, -tipX, tipZ, 0.1, METAL, 0, 0.36)
		s:disc(0.26, darker(gold, 0.6), tipX, tipZ, 0.3, METAL, 0, 0.1)
		s:disc(0.26, darker(gold, 0.6), -tipX, tipZ, 0.3, METAL, 0, 0.1)
		-- riser grip with gold rings
		s:block(0.66, 1.3, C(66, 42, 28), 0, 0, 0.3, 0, FABRIC, 0, 0.3)
		s:block(0.78, 0.14, gold, 0, -0.6, 0.34, 0, METAL, 0, 0.3)
		s:block(0.78, 0.14, gold, 0, 0.6, 0.34, 0, METAL, 0, 0.3)
		-- string (drawn back slightly in the middle)
		local nockZ = tipZ + 0.55
		local sv = Vector2.new(tipX, nockZ - tipZ)
		local slen = sv.Magnitude
		local strC = C(238, 233, 214)
		s:block(0.07, slen, strC, tipX / 2, (tipZ + nockZ) / 2, 0.1, radialRot(-sv.X, sv.Y), FABRIC, 0, 0.07)
		s:block(0.07, slen, strC, -tipX / 2, (tipZ + nockZ) / 2, 0.1, radialRot(sv.X, sv.Y), FABRIC, 0, 0.07)
		-- nocked arrow (kept in a list so it can be hidden while "reloading")
		local arrow = {}
		local headZ = -3.4
		local aLen = nockZ - headZ
		local shaftZ = (nockZ + headZ) / 2
		table.insert(arrow, s:block(0.14, aLen, C(232, 222, 188), 0, shaftZ, 0.32, 0, WOOD, 0, 0.12))
		table.insert(arrow, s:block(0.56, 0.56, C(176, 188, 206), 0, headZ, 0.32, math.pi / 4, METAL, 0, 0.12))
		table.insert(arrow, s:block(0.32, 0.32, C(228, 234, 242), 0, headZ, 0.36, math.pi / 4, METAL, 0, 0.08))
		table.insert(arrow, s:block(0.14, 0.7, C(196, 62, 62), -0.2, nockZ - 0.3, 0.34, 0.3, FABRIC, 0, 0.08))
		table.insert(arrow, s:block(0.14, 0.7, C(196, 62, 62), 0.2, nockZ - 0.3, 0.34, -0.3, FABRIC, 0, 0.08))
		table.insert(arrow, s:block(0.14, 0.6, C(236, 236, 236), 0, nockZ - 0.9, 0.34, 0, FABRIC, 0, 0.08))
		out.arrow = arrow

	elseif kind == "Mage" then
		local wood = pal.wood or C(82, 56, 38)
		local woodHi = C(122, 88, 58)
		local gold = C(212, 168, 72)
		local glow = pal.orb or C(120, 180, 245)
		local orbZ = -5.9
		-- shaft
		s:block(0.5, 8.0, wood, 0, -1.6, 0.05, 0, WOOD, 0, 0.3)
		s:block(0.14, 7.8, woodHi, 0.12, -1.6, 0.2, 0, WOOD, 0, 0.08)
		for _, z in ipairs({ 0.4, -1.4, -3.2 }) do
			s:block(0.8, 0.3, darker(gold, 0.65), 0, z, 0.1, 0, METAL, 0, 0.36)
			s:block(0.8, 0.12, gold, 0, z, 0.14, 0, METAL, 0, 0.38)
		end
		for _, z in ipairs({ -0.5, -2.3, -4.3 }) do
			s:block(0.1, 0.36, glow, 0, z, 0.22, 0, NEON, 0.35, 0.05)
		end
		s:disc(0.86, darker(gold, 0.65), 0, 2.4, 0.05, METAL, 0, 0.35)
		s:disc(0.5, gold, 0, 2.4, 0.07, METAL, 0, 0.4)
		-- head: gold ring + four spikes around the orb
		for i = 0, 9 do
			local a = i * math.pi / 5
			local vx, vz = math.cos(a), math.sin(a)
			s:block(0.34, 0.62, gold, vx * 1.5, orbZ + vz * 1.5, 0.12, radialRot(-vz, vx), METAL, 0, 0.3)
		end
		for i = 0, 3 do
			local a = math.rad(45 + i * 90)
			local vx, vz = math.cos(a), math.sin(a)
			s:block(0.24, 1.0, darker(gold, 0.8), vx * 2.0, orbZ + vz * 2.0, 0.1, radialRot(vx, vz), METAL, 0, 0.3)
		end
		-- orb
		local halo = s:disc(3.7, glow, 0, orbZ, 0.04, NEON, 0.86, 0.1)
		local mid = s:disc(2.4, glow, 0, orbZ, 0.15, NEON, 0.45, 0.4)
		local core = s:disc(1.2, C(228, 242, 255), 0, orbZ, 0.4, NEON, 0, 0.3)
		local lt = Instance.new("PointLight")
		lt.Color = glow
		lt.Range = 14
		lt.Brightness = 1
		lt.Shadows = false
		lt.Parent = mid
		-- floating sparks
		local em = Instance.new("ParticleEmitter")
		em.Rate = 10
		em.Lifetime = NumberRange.new(0.7, 1.3)
		em.Speed = NumberRange.new(0.6, 1.8)
		em.SpreadAngle = Vector2.new(180, 180)
		em.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5 * k),
			NumberSequenceKeypoint.new(1, 0),
		})
		em.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		em.Color = ColorSequence.new(C(235, 245, 255), glow)
		em.LightEmission = 1
		em.LightInfluence = 0
		em.Parent = core
		-- gentle idle pulse
		pcall(function()
			TweenService:Create(halo, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.68 }):Play()
		end)
		out.orb = { halo = halo, glow = mid, core = core, light = lt, emitter = em }

	elseif kind == "Club" then
		local wood = pal.wood or C(100, 68, 40)
		s:block(0.55, 4.4, wood, 0, -1.4, 0.05, 0, WOOD, 0, 0.35)
		s:disc(1.9, C(80, 55, 35), 0, -4.0, 0.08, WOOD, 0, 0.45)
		for i = 0, 6 do
			local a = math.rad(i * 51)
			local vx, vz = math.cos(a), math.sin(a)
			s:block(0.3, 0.9, C(170, 170, 180), vx * 1.0, -4.0 + vz * 1.0, 0.2, radialRot(vx, vz), METAL, 0, 0.25)
		end
	end
	return out
end

-- ===================== PLAYER =====================
local SKIN = Color3.fromRGB(242, 200, 160)

local HANDS = {
	Swordsman = CFrame.new(1.9, 0, -0.9) * CFrame.Angles(0, -0.12, 0),
	Archer = CFrame.new(0, 0, -2.7),
	Mage = CFrame.new(2.0, 0, -0.5) * CFrame.Angles(0, -0.05, 0),
}

-- themed (rarity based) weapon models are injected by GameServer: Sprites.themed = require(ReplicatedStorage.WeaponModels)
function Sprites.weaponFor(kind, root, parent, handCF, scale, wdef)
	if wdef and Sprites.themed then
		return Sprites.themed.build(kind, wdef, root, parent, handCF, scale)
	end
	return Sprites.weapon(kind, root, parent, handCF, scale)
end

function Sprites.player(cls, color, root, parent, wdef)
	local base = -2.8
	local s = Sprites.new(root, parent, base, 1)
	local torso = color or Color3.fromRGB(120, 120, 130)
	local dark = Color3.new(torso.R * 0.6, torso.G * 0.6, torso.B * 0.6)
	local hairC = Color3.fromRGB(70, 45, 28)

	s:disc(4.2, BLACK, 0.2, 0.3, 0.05, nil, 0.6, 0.05)
	-- boots
	s:block(0.8, 1.2, Color3.fromRGB(50, 38, 30), -0.6, -0.5, 0.1, 0, nil, 0, 0.3)
	s:block(0.8, 1.2, Color3.fromRGB(50, 38, 30), 0.6, -0.5, 0.1, 0, nil, 0, 0.3)
	-- torso
	s:block(3.0, 1.7, torso, 0, 0.1, 0.5, 0, FABRIC, 0, 0.6)
	s:block(1.2, 1.75, dark, 0, 0.1, 0.84, 0, FABRIC, 0, 0.1)
	s:block(3.05, 0.25, Color3.fromRGB(60, 40, 25), 0, 0.55, 0.86, 0, nil, 0, 0.1)
	-- off hand
	s:disc(0.85, SKIN, -1.7, -0.7, 0.62)
	-- head
	s:disc(1.95, SKIN, 0, -0.05, 1.0, nil, 0, 0.8)
	s:disc(0.5, SKIN, -1.0, 0, 1.0, nil, 0, 0.5)
	s:disc(0.5, SKIN, 1.0, 0, 1.0, nil, 0, 0.5)
	s:disc(0.34, Color3.fromRGB(225, 175, 140), 0, -1.0, 1.0, nil, 0, 0.4)

	local weapon
	if cls == "Swordsman" then
		s:disc(1.8, Color3.fromRGB(172, 178, 192), 0, 0.0, 1.5, METAL, 0, 0.4)
		s:block(0.4, 2.0, Color3.fromRGB(205, 50, 50), 0, 0.15, 1.78, 0, FABRIC, 0, 0.18)
		s:block(1.3, 0.14, Color3.fromRGB(30, 30, 35), 0, -0.7, 1.72, 0, nil, 0, 0.12)
		s:disc(1.45, Color3.fromRGB(150, 156, 170), -1.7, 0.15, 0.85, METAL, 0, 0.35)
		s:disc(1.45, Color3.fromRGB(150, 156, 170), 1.7, 0.15, 0.85, METAL, 0, 0.35)
		s:disc(0.5, Color3.fromRGB(235, 185, 60), -1.7, 0.15, 1.1, METAL, 0, 0.15)
		s:disc(0.5, Color3.fromRGB(235, 185, 60), 1.7, 0.15, 1.1, METAL, 0, 0.15)
		s:disc(0.85, SKIN, 1.9, -0.9, 0.9)
		weapon = Sprites.weaponFor("Swordsman", root, parent, HANDS.Swordsman * CFrame.new(0, base + 1.1, 0), 1, wdef)
	elseif cls == "Archer" then
		s:disc(2.3, Color3.fromRGB(46, 112, 58), 0, 0.15, 1.5, FABRIC, 0, 0.5)
		s:disc(1.3, Color3.fromRGB(34, 86, 44), 0, 0.7, 1.82, FABRIC, 0, 0.2)
		s:disc(1.05, SKIN, 0, -0.75, 1.6, nil, 0, 0.3)
		s:block(0.9, 2.1, Color3.fromRGB(110, 72, 40), 0.8, 1.0, 1.0, 0.25, FABRIC, 0, 0.35)
		for i = 0, 2 do
			s:disc(0.32, Color3.fromRGB(215, 60, 60), 0.55 + i * 0.28, 1.8 - i * 0.12, 1.25, FABRIC, 0, 0.1)
		end
		s:disc(0.85, SKIN, -0.7, -2.0, 0.9)
		s:disc(0.85, SKIN, 0.7, -2.0, 0.9)
		weapon = Sprites.weaponFor("Archer", root, parent, HANDS.Archer * CFrame.new(0, base + 1.0, 0), 1, wdef)
	elseif cls == "Mage" then
		local purple = Color3.fromRGB(100, 58, 170)
		s:disc(3.6, Color3.fromRGB(70, 38, 120), 0, 0.0, 1.45, FABRIC, 0, 0.25)
		s:disc(2.4, purple, 0, 0.0, 1.7, FABRIC, 0, 0.35)
		s:disc(1.5, Color3.fromRGB(125, 80, 200), 0, 0.0, 2.0, FABRIC, 0, 0.3)
		s:disc(0.6, Color3.fromRGB(255, 215, 80), 0, 0.0, 2.25, NEON, 0, 0.2)
		s:disc(3.45, Color3.fromRGB(255, 215, 80), 0, 0.0, 1.58, NEON, 0.55, 0.05)
		s:disc(0.85, SKIN, 2.0, -0.5, 0.9)
		weapon = Sprites.weaponFor("Mage", root, parent, HANDS.Mage * CFrame.new(0, base + 1.0, 0), 1, wdef)
	else
		s:disc(1.85, hairC, 0, 0.25, 1.5, nil, 0, 0.3)
	end
	if cls == nil then
		s:disc(1.85, hairC, 0, 0.25, 1.5, nil, 0, 0.3)
	end
	if wdef and Sprites.themed and wdef.tier >= 4 then
		pcall(Sprites.themed.heroAura, root, parent, wdef, base)
	end
	return weapon
end

-- ===================== ENEMIES =====================
local function shadow(s, r)
	s:disc(r * 2.7, BLACK, 0.1 * r, 0.18 * r, 0.04, nil, 0.6, 0.05)
end

local function zombie(s, def, r)
	local p = def.pal
	local RED = Color3.fromRGB(255, 40, 40)
	shadow(s, r)
	s:block(r * 2.0, r * 1.15, p.cloth, 0, r * 0.25, 0.3, 0, FABRIC, 0, 0.45)
	s:block(r * 0.5, r * 0.45, p.skin, r * 0.5, r * 0.55, 0.56, 0.3, nil, 0, 0.08)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.5, r * 1.7, p.skin, sx * r * 1.05, -r * 0.55, 0.45, sx * 0.12, nil, 0, 0.35)
		s:disc(r * 0.62, p.skin, sx * r * 1.15, -r * 1.45, 0.5, nil, 0, 0.4)
		s:disc(r * 0.2, Color3.fromRGB(200, 200, 190), sx * r * 1.15, -r * 1.7, 0.7, nil, 0, 0.1)
	end
	s:disc(r * 1.2, p.skin, 0, -r * 0.1, 0.55, nil, 0, 0.7)
	s:disc(r * 0.8, p.hair, 0, r * 0.25, 0.95, nil, 0, 0.12)
	s:disc(r * 0.2, RED, -r * 0.28, -r * 0.5, 0.97, NEON, 0, 0.1)
	s:disc(r * 0.2, RED, r * 0.28, -r * 0.5, 0.97, NEON, 0, 0.1)
	s:disc(r * 0.3, Color3.fromRGB(120, 20, 20), r * 0.35, -r * 0.05, 0.98, nil, 0, 0.08)
	if def.variant == "toxic" then
		s:disc(r * 2.6, Color3.fromRGB(110, 255, 60), 0, 0, 0.06, NEON, 0.82, 0.05)
		for i = 0, 3 do
			local a = i * 1.6
			s:disc(r * 0.45, Color3.fromRGB(140, 255, 70), math.cos(a) * r * 0.6, r * 0.55 + math.sin(a) * r * 0.2, 0.62, NEON, 0.1, 0.25)
		end
	elseif def.variant == "brute" then
		local bone = Color3.fromRGB(215, 205, 180)
		for _, sx in ipairs({ -1, 1 }) do
			s:disc(r * 0.95, Color3.fromRGB(120, 120, 125), sx * r * 0.95, r * 0.2, 0.75, SLATE, 0, 0.35)
			for i = 0, 2 do
				s:block(r * 0.18, r * 0.5, bone, sx * (r * 1.1 + i * r * 0.1), r * 0.05 + i * r * 0.22, 0.95, sx * (0.5 + i * 0.3), nil, 0, 0.12)
			end
		end
		s:disc(r * 0.5, bone, 0, r * 0.7, 0.62, nil, 0, 0.2)
	end
end

local function goblin(s, def, r, root, parent)
	local p = def.pal
	local v = def.variant
	local YEL = Color3.fromRGB(255, 230, 60)
	shadow(s, r)
	s:block(r * 1.8, r * 1.0, p.cloth, 0, r * 0.25, 0.3, 0, FABRIC, 0, 0.45)
	s:block(r * 1.85, r * 0.2, Color3.fromRGB(40, 30, 25), 0, r * 0.3, 0.56, 0, nil, 0, 0.1)
	s:disc(r * 0.25, Color3.fromRGB(230, 190, 60), 0, r * 0.3, 0.64, METAL, 0, 0.08)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.4, r * 1.3, p.skin, sx * r * 0.95, -r * 0.3, 0.45, sx * 0.15, nil, 0, 0.3)
		s:disc(r * 0.5, p.skin, sx * r * 1.0, -r * 0.95, 0.5, nil, 0, 0.35)
		local vx, vz = sx * 1.0, 0.35
		s:block(r * 0.3, r * 1.1, p.skin, sx * r * 0.7 + vx * r * 0.5, vz * r * 0.5 - r * 0.05, 0.85, radialRot(vx, vz), nil, 0, 0.1)
		s:disc(r * 0.18, Color3.fromRGB(235, 160, 160), sx * r * 0.7 + vx * r * 0.5, vz * r * 0.5 - r * 0.05, 0.92, nil, 0, 0.05)
	end
	s:disc(r * 1.3, p.skin, 0, -r * 0.1, 0.55, nil, 0, 0.7)
	s:block(r * 0.28, r * 0.9, p.hair, 0, r * 0.15, 0.95, 0, nil, 0, 0.14)
	s:disc(r * 0.34, Color3.new(p.skin.R * 0.8, p.skin.G * 0.8, p.skin.B * 0.8), 0, -r * 0.75, 0.95, nil, 0, 0.15)
	s:disc(r * 0.22, YEL, -r * 0.32, -r * 0.45, 0.97, NEON, 0, 0.08)
	s:disc(r * 0.22, YEL, r * 0.32, -r * 0.45, 0.97, NEON, 0, 0.08)
	local hand = CFrame.new(r * 1.0, 0.75, -r * 0.95)
	if v == "slinger" then
		s:disc(r * 0.8, Color3.fromRGB(110, 75, 45), r * 1.0, -r * 1.0, 0.8, FABRIC, 0, 0.3)
		s:disc(r * 0.4, Color3.fromRGB(130, 130, 135), r * 0.9, -r * 1.1, 1.0, SLATE, 0, 0.2)
		s:disc(r * 0.4, Color3.fromRGB(110, 110, 115), r * 1.15, -r * 0.9, 1.0, SLATE, 0, 0.2)
	elseif v == "brute" then
		s:disc(r * 1.25, Color3.fromRGB(125, 125, 135), 0, r * 0.2, 0.75, METAL, 0, 0.25)
		s:disc(r * 0.55, Color3.fromRGB(95, 95, 105), 0, r * 0.2, 0.92, METAL, 0, 0.12)
		for _, sx in ipairs({ -1, 1 }) do
			s:disc(r * 0.8, Color3.fromRGB(110, 110, 120), sx * r * 1.0, r * 0.1, 0.8, METAL, 0, 0.3)
		end
		return Sprites.weapon("Club", root, parent, hand, r / 2.4)
	elseif v == "sneaker" then
		s:disc(r * 1.9, Color3.fromRGB(30, 30, 45), 0, r * 0.5, 0.7, FABRIC, 0.1, 0.1)
		Sprites.weapon("Swordsman", root, parent, hand * CFrame.Angles(0, -0.1, 0), r / 5, { blade = Color3.fromRGB(170, 180, 190), guard = Color3.fromRGB(80, 60, 40) })
		Sprites.weapon("Swordsman", root, parent, CFrame.new(-r * 1.0, 0.75, -r * 0.95) * CFrame.Angles(0, 0.1, 0), r / 5, { blade = Color3.fromRGB(170, 180, 190), guard = Color3.fromRGB(80, 60, 40) })
	else
		Sprites.weapon("Swordsman", root, parent, hand, r / 4.2, { blade = Color3.fromRGB(150, 140, 130), guard = Color3.fromRGB(110, 80, 40), gem = Color3.fromRGB(110, 80, 40) })
	end
	return nil
end

local function titan(s, def, r)
	local p = def.pal
	local rock = Color3.fromRGB(122, 122, 128)
	shadow(s, r)
	s:disc(r * 2.4, Color3.fromRGB(70, 110, 55), 0, r * 0.15, 0.08, Enum.Material.Grass, 0.3, 0.1)
	s:block(r * 2.1, r * 1.3, p.cloth, 0, r * 0.2, 0.4, 0, FABRIC, 0, 0.6)
	s:disc(r * 1.9, p.skin, 0, r * 0.1, 0.7, SLATE, 0, 0.8)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.7, r * 1.9, p.skin, sx * r * 1.15, -r * 0.55, 0.6, sx * 0.1, SLATE, 0, 0.6)
		s:disc(r * 0.9, rock, sx * r * 1.2, -r * 1.65, 0.9, SLATE, 0, 0.8)
		s:disc(r * 0.4, Color3.fromRGB(95, 95, 100), sx * r * 1.1, -r * 1.7, 1.35, SLATE, 0, 0.3)
		s:disc(r * 1.0, rock, sx * r * 1.0, r * 0.1, 1.15, SLATE, 0, 0.6)
	end
	for i = 0, 5 do
		local a = i * 1.1 + 0.4
		s:disc(r * (0.45 + (i % 3) * 0.12), rock, math.cos(a) * r * 0.55, r * 0.55 + math.sin(a) * r * 0.25, 1.3 + (i % 2) * 0.15, SLATE, 0, 0.5)
	end
	for i = 0, 4 do
		s:disc(r * 0.4, Color3.fromRGB(60 + i * 12, 130, 50), -r * 0.7 + i * r * 0.35, r * 0.1 - (i % 2) * r * 0.3, 1.62, Enum.Material.Grass, 0, 0.2)
	end
	s:disc(r * 1.0, p.skin, 0, -r * 0.4, 1.5, SLATE, 0, 0.9)
	s:block(r * 0.9, r * 0.2, Color3.fromRGB(40, 50, 35), 0, -r * 0.65, 1.97, 0, nil, 0, 0.15)
	s:disc(r * 0.22, Color3.fromRGB(255, 140, 30), -r * 0.25, -r * 0.62, 2.05, NEON, 0, 0.1)
	s:disc(r * 0.22, Color3.fromRGB(255, 140, 30), r * 0.25, -r * 0.62, 2.05, NEON, 0, 0.1)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.14, r * 0.35, Color3.fromRGB(235, 230, 205), sx * r * 0.3, -r * 0.92, 1.9, 0, nil, 0, 0.12)
	end
	s:disc(r * 2.9, Color3.fromRGB(120, 255, 80), 0, 0, 0.06, NEON, 0.9, 0.05)
end

local function king(s, def, r, root, parent)
	local p = def.pal
	local gold = Color3.fromRGB(240, 190, 50)
	shadow(s, r)
	s:block(r * 1.9, r * 1.9, p.cloth, 0, r * 0.95, 0.2, 0, FABRIC, 0, 0.12)
	s:block(r * 1.9, r * 0.2, gold, 0, r * 1.85, 0.3, 0, METAL, 0, 0.1)
	s:block(r * 2.1, r * 1.3, Color3.fromRGB(62, 62, 74), 0, r * 0.2, 0.5, 0, METAL, 0, 0.55)
	s:disc(r * 1.0, gold, 0, r * 0.1, 0.9, METAL, 0, 0.12)
	s:disc(r * 0.5, Color3.fromRGB(220, 40, 60), 0, r * 0.1, 1.0, NEON, 0, 0.1)
	for _, sx in ipairs({ -1, 1 }) do
		s:block(r * 0.5, r * 1.5, p.skin, sx * r * 1.0, -r * 0.4, 0.55, sx * 0.1, nil, 0, 0.4)
		s:disc(r * 0.6, p.skin, sx * r * 1.0, -r * 1.1, 0.6, nil, 0, 0.4)
		s:disc(r * 1.0, gold, sx * r * 1.2, r * 0.05, 0.9, METAL, 0, 0.4)
		for i = 0, 2 do
			local a = math.rad(-30 + i * 60)
			s:block(r * 0.14, r * 0.45, gold, sx * (r * 1.2 + math.sin(a) * r * 0.7), r * 0.05 - math.cos(a) * r * 0.1 + (i - 1) * r * 0.25, 1.15, sx * 1.4, METAL, 0, 0.12)
		end
	end
	s:disc(r * 1.35, p.skin, 0, -r * 0.2, 1.0, nil, 0, 0.8)
	s:disc(r * 0.35, Color3.fromRGB(220, 255, 220), -r * 0.65, -r * 0.1, 1.0, nil, 0, 0.5)
	s:disc(r * 0.35, Color3.fromRGB(220, 255, 220), r * 0.65, -r * 0.1, 1.0, nil, 0, 0.5)
	s:disc(r * 0.4, Color3.new(p.skin.R * 0.8, p.skin.G * 0.8, p.skin.B * 0.8), 0, -r * 0.95, 1.0, nil, 0, 0.2)
	s:disc(r * 1.3, gold, 0, -r * 0.2, 1.5, METAL, 0, 0.2)
	s:disc(r * 0.95, p.skin, 0, -r * 0.2, 1.62, nil, 0, 0.2)
	s:disc(r * 0.7, p.hair, 0, r * 0.05, 1.7, nil, 0, 0.1)
	for i = 0, 5 do
		local a = i * (math.pi * 2 / 6)
		s:disc(r * 0.26, gold, math.cos(a) * r * 0.6, -r * 0.2 + math.sin(a) * r * 0.6, 1.72, METAL, 0, 0.3)
	end
	s:disc(r * 0.3, Color3.fromRGB(230, 40, 70), 0, -r * 0.8, 1.8, NEON, 0, 0.15)
	s:disc(r * 0.2, Color3.fromRGB(255, 60, 60), -r * 0.28, -r * 0.65, 1.75, NEON, 0, 0.1)
	s:disc(r * 0.2, Color3.fromRGB(255, 60, 60), r * 0.28, -r * 0.65, 1.75, NEON, 0, 0.1)
	return Sprites.weapon("Swordsman", root, parent, CFrame.new(r * 1.3, 1.0, -r * 0.5) * CFrame.Angles(0, -0.1, 0), r * 0.55,
		{ blade = Color3.fromRGB(170, 175, 185), fuller = Color3.fromRGB(120, 125, 135), guard = gold, grip = Color3.fromRGB(70, 40, 30), gem = Color3.fromRGB(230, 40, 70) })
end

function Sprites.enemy(def, root, parent)
	local s = Sprites.new(root, parent, 0, 1)
	local r = def.r
	if def.kind == "zombie" then
		zombie(s, def, r)
	elseif def.kind == "goblin" then
		return goblin(s, def, r, root, parent)
	elseif def.kind == "titan" then
		titan(s, def, r)
	elseif def.kind == "king" then
		return king(s, def, r, root, parent)
	end
	return nil
end

return Sprites
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX7">
<Properties>
<string name="Name">MapBuilder</string>
<ProtectedString name="Source"><![CDATA[-- Procedural builders for the lobby and the two dungeon arenas (everything is flat / top-down)
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))
local Sprites = require(script.Parent:WaitForChild("Sprites"))

local M = {}

local CYL = Enum.PartType.Cylinder
local BLK = Enum.PartType.Block
local MAT = Enum.Material
local C3 = Color3.fromRGB

local function part(parent, shape, size, cf, color, mat, trans, collide)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or MAT.SmoothPlastic
	p.Transparency = trans or 0
	p.CanCollide = collide or false
	p.CanQuery = collide or false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function disc(parent, d, color, x, y, z, mat, trans, thick)
	return part(parent, CYL, Vector3.new(thick or 0.2, d, d), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans, false)
end

local function block(parent, sx, sy, sz, color, x, y, z, rot, mat, trans, collide)
	return part(parent, BLK, Vector3.new(sx, sy, sz), CFrame.new(x, y, z) * CFrame.Angles(0, rot or 0, 0), color, mat, trans, collide)
end

local function collider(parent, d, x, z, h)
	h = h or 10
	return part(parent, CYL, Vector3.new(h, d, d), CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.pi / 2), C3(0, 0, 0), nil, 1, true)
end

local function addLight(p, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = p
end

local function label(parent, x, y, z, text, color, w, h, size)
	local a = part(parent, BLK, Vector3.new(1, 1, 1), CFrame.new(x, y, z), C3(255, 255, 255), nil, 1, false)
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(w or 300, h or 60)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 600
	g.Adornee = a
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color or C3(255, 255, 255)
	t.Font = Enum.Font.GothamBlack
	t.TextSize = size or 24
	t.TextStrokeTransparency = 0.2
	t.TextWrapped = true
	t.Parent = g
	g.Parent = a
	return a
end

local function ring(parent, d, thick, color, x, y, z, mat, trans)
	disc(parent, d, color, x, y, z, mat or MAT.Neon, trans, 0.15)
	disc(parent, d - thick * 2, C3(30, 30, 38), x, y + 0.02, z, MAT.Slate, 0, 0.15)
end

local function tree(parent, x, z, r, variant)
	local g
	if variant == 2 then
		g = { C3(24, 66, 58), C3(32, 86, 70), C3(44, 108, 84), C3(66, 140, 104) }
	elseif variant == 3 then
		g = { C3(120, 78, 30), C3(158, 98, 34), C3(190, 124, 40), C3(222, 160, 60) }
	else
		g = { C3(28, 80, 34), C3(40, 104, 44), C3(56, 130, 56), C3(86, 164, 74) }
	end
	disc(parent, r * 2.2, C3(0, 0, 0), x + r * 0.25, 0.08, z + r * 0.3, nil, 0.65, 0.05)
	disc(parent, r * 2.0, g[1], x, 1.6, z, MAT.Grass, 0, 0.6)
	disc(parent, r * 1.62, g[2], x - r * 0.05, 2.2, z - r * 0.05, MAT.Grass, 0, 0.6)
	disc(parent, r * 1.18, g[3], x - r * 0.1, 2.8, z - r * 0.1, MAT.Grass, 0, 0.6)
	disc(parent, r * 0.6, g[4], x - r * 0.15, 3.4, z - r * 0.15, MAT.Grass, 0, 0.6)
	for i = 0, 5 do
		local a = i * 1.05 + (x * 7 % 3)
		disc(parent, r * 0.7, g[3], x + math.cos(a) * r * 0.85, 2.0 + (i % 2) * 0.15, z + math.sin(a) * r * 0.85, MAT.Grass, 0, 0.5)
	end
	collider(parent, r * 1.6, x, z, 8)
end

local function bush(parent, x, z, r)
	disc(parent, r * 2.2, C3(0, 0, 0), x + 0.3, 0.08, z + 0.4, nil, 0.7, 0.05)
	disc(parent, r * 2, C3(40, 100, 44), x, 0.7, z, MAT.Grass, 0, 0.5)
	disc(parent, r * 1.3, C3(60, 130, 56), x - r * 0.2, 1.1, z - r * 0.2, MAT.Grass, 0, 0.4)
	disc(parent, r * 0.5, C3(90, 165, 70), x - r * 0.3, 1.4, z - r * 0.3, MAT.Grass, 0, 0.3)
end

local function rock(parent, x, z, r, collide, dark)
	local base = dark and C3(70, 70, 80) or C3(125, 125, 130)
	disc(parent, r * 2.3, C3(0, 0, 0), x + r * 0.2, 0.08, z + r * 0.3, nil, 0.65, 0.05)
	disc(parent, r * 2, base, x, 1.0, z, MAT.Slate, 0, 1.4)
	disc(parent, r * 1.5, C3(base.R * 255 + 22, base.G * 255 + 22, base.B * 255 + 22), x - r * 0.15, 1.9, z - r * 0.15, MAT.Slate, 0, 0.5)
	disc(parent, r * 0.7, C3(base.R * 255 + 45, base.G * 255 + 45, base.B * 255 + 45), x - r * 0.3, 2.3, z - r * 0.3, MAT.Slate, 0, 0.3)
	block(parent, r * 0.1, 0.1, r * 1.1, C3(40, 40, 46), x + r * 0.3, 2.2, z + r * 0.1, 0.7, nil, 0, false)
	if collide then
		collider(parent, r * 1.7, x, z, 8)
	end
end

local function flower(parent, x, z, rng)
	local cols = { C3(255, 90, 120), C3(255, 220, 70), C3(250, 250, 255), C3(160, 120, 255), C3(255, 150, 60) }
	local c = cols[rng:NextInteger(1, #cols)]
	disc(parent, 0.35, C3(50, 140, 50), x, 0.12, z, nil, 0, 0.05)
	disc(parent, 0.7, c, x, 0.16, z, nil, 0, 0.05)
	disc(parent, 0.28, C3(255, 230, 110), x, 0.2, z, nil, 0, 0.05)
end

local function mushroom(parent, x, z, glow)
	local cap = glow and C3(80, 220, 255) or C3(210, 50, 50)
	disc(parent, 1.3, C3(0, 0, 0), x + 0.2, 0.08, z + 0.2, nil, 0.7, 0.05)
	disc(parent, 1.2, cap, x, 0.5, z, glow and MAT.Neon or MAT.SmoothPlastic, 0, 0.5)
	if not glow then
		disc(parent, 0.28, C3(255, 255, 255), x - 0.2, 0.8, z, nil, 0, 0.05)
		disc(parent, 0.22, C3(255, 255, 255), x + 0.25, 0.8, z + 0.2, nil, 0, 0.05)
	end
end

local function lamp(parent, x, z)
	disc(parent, 1.6, C3(40, 40, 46), x, 0.6, z, MAT.Metal, 0, 1.2)
	disc(parent, 1.0, C3(255, 235, 150), x, 1.4, z, MAT.Neon, 0, 0.3)
	disc(parent, 5, C3(255, 235, 150), x, 0.1, z, MAT.Neon, 0.88, 0.05)
	local top = disc(parent, 0.3, C3(255, 255, 255), x, 1.7, z, nil, 1, 0.1)
	addLight(top, C3(255, 230, 160), 22, 1)
	collider(parent, 1.6, x, z, 4)
end

-- ===================================================== LOBBY
local GATE_COLORS = {
	C3(90, 255, 130), C3(90, 190, 255), C3(200, 120, 255), C3(255, 160, 70),
}

local function glowDisc(parent, d, color, x, y, z, trans)
	return disc(parent, d, color, x, y, z, MAT.Neon, trans or 0.8, 0.08)
end

local function torch(parent, x, z, color)
	color = color or C3(255, 150, 50)
	disc(parent, 1.8, C3(55, 50, 56), x, 0.6, z, MAT.Slate, 0, 1.2)
	disc(parent, 1.2, C3(30, 28, 32), x, 1.4, z, MAT.Metal, 0, 0.4)
	local f = disc(parent, 0.9, color, x, 1.7, z, MAT.Neon, 0.1, 0.3)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 14
	pe.Lifetime = NumberRange.new(0.6, 1.1)
	pe.Speed = NumberRange.new(1.5, 3)
	pe.EmissionDirection = Enum.NormalId.Right
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new(0.1, 1)
	pe.Color = ColorSequence.new(color, C3(255, 70, 30))
	pe.LightEmission = 1
	pe.Parent = f
	addLight(f, color, 18, 1.4)
	collider(parent, 1.6, x, z, 4)
end

local function bench(parent, x, z, rot)
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, rot, 0)
	local function b(sx, sy, sz, ox, oy, oz, col, mat)
		part(parent, BLK, Vector3.new(sx, sy, sz), cf * CFrame.new(ox, oy, oz), col, mat, 0, false)
	end
	b(6, 0.4, 2, 0, 1.2, 0, C3(150, 104, 60), MAT.WoodPlanks)
	b(0.5, 1.2, 1.6, -2.5, 0.6, 0, C3(50, 50, 58), MAT.Metal)
	b(0.5, 1.2, 1.6, 2.5, 0.6, 0, C3(50, 50, 58), MAT.Metal)
	b(6, 0.8, 0.4, 0, 1.9, -0.9, C3(130, 90, 52), MAT.WoodPlanks)
end

local function banner(parent, x, z, color, rot)
	block(parent, 0.5, 6.2, 0.5, C3(60, 44, 34), x, 3.1, z, 0, MAT.Wood, 0, false)
	block(parent, 3.2, 0.2, 5, color, x, 6.4, z + 2.6, rot or 0, MAT.Fabric, 0, false)
	block(parent, 3.6, 0.3, 0.4, C3(255, 214, 90), x, 6.6, z + 0.2, 0, MAT.Metal, 0, false)
end

local function hedge(parent, x, z, sx, sz)
	block(parent, sx, 2.2, sz, C3(38, 104, 46), x, 1.1, z, 0, MAT.Grass, 0, true)
	block(parent, sx - 0.8, 0.4, sz - 0.8, C3(64, 140, 62), x, 2.3, z, 0, MAT.Grass, 0, false)
end

local function pillar(parent, x, z, color)
	disc(parent, 2.6, C3(36, 36, 44), x, 0.45, z, MAT.Slate, 0, 0.9)
	disc(parent, 2.0, C3(92, 92, 106), x, 2.6, z, MAT.Marble, 0, 4.2)
	disc(parent, 2.6, C3(36, 36, 44), x, 4.9, z, MAT.Slate, 0, 0.6)
	local cap = disc(parent, 1.5, color, x, 5.3, z, MAT.Neon, 0.05, 0.4)
	addLight(cap, color, 14, 1)
	return cap
end

-- builds a live label on an invisible anchor and returns the TextLabel
local function liveLabel(parent, x, y, z, text, color, w, h, size)
	local a = label(parent, x, y, z, text, color, w, h, size)
	return a:FindFirstChildOfClass("BillboardGui"):FindFirstChildOfClass("TextLabel")
end

function M.lobby(folder)
	local rng = Random.new(42)
	local H = Config.Lobby.half
	local gates = {}

	-- outer grass with a darker rim
	part(folder, BLK, Vector3.new(520, 1, 520), CFrame.new(0, -0.5, 0), C3(84, 140, 70), MAT.Grass, 0, true)
	for i = 1, 70 do
		local x, z = rng:NextNumber(-250, 250), rng:NextNumber(-250, 250)
		if math.abs(x) > H + 8 or math.abs(z) > H + 8 then
			disc(folder, rng:NextNumber(10, 26), rng:NextNumber() < 0.5 and C3(76, 130, 64) or C3(94, 152, 78), x, 0.04, z, MAT.Grass, 0, 0.04)
		end
	end

	-- stone plaza (checker)
	local tile = 20
	for ix = -5, 4 do
		for iz = -5, 4 do
			local even = (ix + iz) % 2 == 0
			part(folder, BLK, Vector3.new(tile - 0.3, 0.2, tile - 0.3),
				CFrame.new(ix * tile + tile / 2, 0.1, iz * tile + tile / 2),
				even and C3(158, 154, 150) or C3(128, 124, 128), even and MAT.Cobblestone or MAT.Slate, 0, true)
		end
	end
	-- golden border inlay around the plaza
	for _, e in ipairs({ { 0, -H + 2.5, H * 2 - 4, 1 }, { 0, H - 2.5, H * 2 - 4, 1 }, { -H + 2.5, 0, 1, H * 2 - 4 }, { H - 2.5, 0, 1, H * 2 - 4 } }) do
		block(folder, e[3], 0.06, e[4], C3(214, 170, 70), e[1], 0.23, e[2], 0, MAT.Metal, 0, false)
	end

	-- walls with crenellations
	local wallC = C3(112, 80, 60)
	local function wall(sx, sz, x, z)
		block(folder, sx, 7, sz, wallC, x, 3.5, z, 0, MAT.Brick, 0, true)
		block(folder, sx, 0.6, sz + 1, C3(170, 130, 95), x, 7.2, z, 0, MAT.Cobblestone, 0, false)
	end
	wall(H * 2 + 6, 3, 0, -H - 1.5)
	wall(H * 2 + 6, 3, 0, H + 1.5)
	wall(3, H * 2, -H - 1.5, 0)
	wall(3, H * 2, H + 1.5, 0)
	for i = -9, 9 do
		local o = i * 10.5
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), o, 8.2, -H - 1.5, 0, MAT.Cobblestone, 0, false)
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), o, 8.2, H + 1.5, 0, MAT.Cobblestone, 0, false)
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), -H - 1.5, 8.2, o, 0, MAT.Cobblestone, 0, false)
		block(folder, 3.4, 1.8, 3.4, C3(150, 112, 82), H + 1.5, 8.2, o, 0, MAT.Cobblestone, 0, false)
	end
	-- corner towers
	for _, c in ipairs({ { -H - 3, -H - 3 }, { H + 3, -H - 3 }, { -H - 3, H + 3 }, { H + 3, H + 3 } }) do
		disc(folder, 13, C3(136, 100, 76), c[1], 5.5, c[2], MAT.Brick, 0, 11)
		disc(folder, 15, C3(170, 130, 95), c[1], 11.2, c[2], MAT.Cobblestone, 0, 1.2)
		disc(folder, 9, C3(90, 62, 50), c[1], 11.9, c[2], MAT.Slate, 0, 0.3)
		local f = disc(folder, 3, C3(255, 160, 60), c[1], 12.2, c[2], MAT.Neon, 0.2, 0.5)
		addLight(f, C3(255, 170, 80), 30, 1.5)
		collider(folder, 13, c[1], c[2], 12)
	end

	-- outside forest decoration
	for i = 1, 110 do
		local side = rng:NextInteger(1, 4)
		local a, b = rng:NextNumber(-H - 30, H + 30), rng:NextNumber(H + 14, H + 60)
		local x, z
		if side == 1 then x, z = a, -b elseif side == 2 then x, z = a, b elseif side == 3 then x, z = -b, a else x, z = b, a end
		tree(folder, x, z, rng:NextNumber(4, 7), rng:NextInteger(1, 3))
	end

	-- main avenue (spawn -> fountain -> gates street) and gate street
	local avenue = C3(190, 158, 112)
	block(folder, 14, 0.06, H * 2 - 8, avenue, 0, 0.23, 0, 0, MAT.Cobblestone, 0, false)
	block(folder, 15.5, 0.05, H * 2 - 8, C3(120, 90, 62), 0, 0.22, 0, 0, MAT.Slate, 0, false)
	block(folder, H * 2 - 8, 0.06, 12, avenue, 0, 0.23, -60, 0, MAT.Cobblestone, 0, false)
	block(folder, H * 2 - 8, 0.05, 13.5, C3(120, 90, 62), 0, 0.22, -60, 0, MAT.Slate, 0, false)
	-- red carpet to the gates
	block(folder, 5, 0.04, 80, C3(170, 40, 50), 0, 0.3, -20, 0, MAT.Fabric, 0, false)
	block(folder, 5.8, 0.03, 80.8, C3(230, 190, 80), 0, 0.28, -20, 0, MAT.Fabric, 0, false)

	-- fountain (bigger, with outer ring of light)
	disc(folder, 30, C3(120, 118, 128), 0, 0.5, 0, MAT.Slate, 0, 1)
	for i = 0, 23 do
		local a = i * math.pi / 12
		glowDisc(folder, 1.1, i % 2 == 0 and C3(120, 220, 255) or C3(255, 230, 150), math.cos(a) * 14.2, 1.1, math.sin(a) * 14.2, 0.1)
	end
	disc(folder, 24, C3(176, 176, 186), 0, 0.7, 0, MAT.Marble, 0, 1.2)
	collider(folder, 24, 0, 0, 5)
	disc(folder, 20.5, C3(70, 160, 230), 0, 1.0, 0, MAT.Glass, 0.15, 1.0)
	disc(folder, 17, C3(120, 215, 255), 0, 1.35, 0, MAT.Neon, 0.75, 0.1)
	disc(folder, 13, C3(150, 235, 255), 0, 1.4, 0, MAT.Neon, 0.8, 0.1)
	disc(folder, 8.5, C3(200, 200, 210), 0, 1.7, 0, MAT.Marble, 0, 1.4)
	disc(folder, 6.5, C3(70, 160, 230), 0, 2.45, 0, MAT.Glass, 0.15, 0.2)
	disc(folder, 3, C3(235, 245, 255), 0, 2.6, 0, MAT.Marble, 0, 0.3)
	local spout = disc(folder, 1.4, C3(190, 240, 255), 0, 3.0, 0, MAT.Neon, 0.2, 0.3)
	addLight(spout, C3(150, 220, 255), 40, 1.4)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 60
	pe.EmissionDirection = Enum.NormalId.Right
	pe.Lifetime = NumberRange.new(1, 1.6)
	pe.Speed = NumberRange.new(10, 14)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Acceleration = Vector3.new(0, -22, 0)
	pe.Size = NumberSequence.new(0.5, 0.1)
	pe.Transparency = NumberSequence.new(0.2, 1)
	pe.Color = ColorSequence.new(C3(170, 230, 255))
	pe.LightEmission = 0.6
	pe.Parent = spout

	-- spawn runes
	disc(folder, 20, C3(40, 36, 60), 0, 0.31, 32, MAT.Slate, 0, 0.06)
	glowDisc(folder, 18, C3(255, 214, 90), 0, 0.34, 32, 0.8)
	glowDisc(folder, 13, C3(40, 36, 60), 0, 0.36, 32, 0)
	glowDisc(folder, 12, C3(255, 214, 90), 0, 0.38, 32, 0.85)
	for i = 0, 7 do
		local a = i * math.pi / 4
		block(folder, 0.6, 0.1, 2.6, C3(255, 214, 90), math.cos(a) * 7.6, 0.45, 32 + math.sin(a) * 7.6, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0.1, false)
	end

	-- lamps / torches
	for _, p in ipairs({ { -40, -20 }, { 40, -20 }, { -40, 40 }, { 40, 40 }, { -85, -85 }, { 85, -85 }, { -85, 85 }, { 85, 85 }, { -20, 12 }, { 20, 12 } }) do
		lamp(folder, p[1], p[2])
	end
	for _, p in ipairs({ { -8, -88 }, { 8, -88 }, { -8, 88 }, { 8, 88 }, { -88, -30 }, { 88, -30 }, { -88, 30 }, { 88, 30 } }) do
		torch(folder, p[1], p[2])
	end

	-- hedges & benches & banners
	hedge(folder, -50, 2, 2, 24)
	hedge(folder, 50, 2, 2, 24)
	hedge(folder, -50, 40, 2, 12)
	hedge(folder, 50, 40, 2, 12)
	bench(folder, -44, 2, math.pi / 2)
	bench(folder, 44, 2, -math.pi / 2)
	bench(folder, -30, -22, 0)
	bench(folder, 30, -22, math.pi)
	bench(folder, -12, 50, 0)
	bench(folder, 12, 50, 0)
	for i = -3, 3 do
		if i ~= 0 then
			banner(folder, i * 25, -H + 5, GATE_COLORS[(math.abs(i) % 4) + 1], 0)
		end
	end

	-- flowers & bushes
	for i = 1, 200 do
		local x, z = rng:NextNumber(-H + 4, H - 4), rng:NextNumber(-H + 4, H - 4)
		if (math.abs(x) > 56 or math.abs(z) > 82) and (math.abs(x) > 9) and not (z < -48 and z > -72) then
			if i % 3 == 0 then bush(folder, x, z, rng:NextNumber(1.5, 2.4)) else flower(folder, x, z, rng) end
		end
	end
	for i = 1, 6 do
		bush(folder, -92 + i * 3, -93, 2.2)
		bush(folder, 92 - i * 3, -93, 2.2)
	end

	-- fireflies drifting over the whole plaza
	do
		local a = part(folder, BLK, Vector3.new(190, 6, 190), CFrame.new(0, 4, 0), C3(255, 255, 255), nil, 1, false)
		local ff = Instance.new("ParticleEmitter")
		ff.Rate = 28
		ff.Lifetime = NumberRange.new(5, 8)
		ff.Speed = NumberRange.new(0.5, 1.8)
		ff.SpreadAngle = Vector2.new(180, 180)
		ff.Shape = Enum.ParticleEmitterShape.Box
		ff.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		ff.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 0) })
		ff.Transparency = NumberSequence.new(0.1)
		ff.Color = ColorSequence.new(C3(255, 240, 150), C3(170, 255, 170))
		ff.LightEmission = 1
		ff.LightInfluence = 0
		ff.Parent = a
	end

	-- title
	label(folder, 0, 8, 22, "TOP-DOWN HEROES", C3(255, 235, 140), 520, 70, 46)
	label(folder, 0, 8, 12, "Pick a gate  ->  choose a location  ->  survive the waves!", C3(255, 255, 255), 640, 36, 20)
	label(folder, 0, 8, -40, "THE FOUR GATES", C3(255, 255, 255), 360, 30, 20)

	-- ================= THE FOUR GATES =================
	local wlabels = { forest = "Forest", cave = "Cave" }
	for _, zn in ipairs(Config.Lobby.zones) do
		if zn.kind == "gate" then
			local col = GATE_COLORS[zn.n]
			local dark = C3(col.R * 255 * 0.22, col.G * 255 * 0.22, col.B * 255 * 0.22)
			-- stone dais
			disc(folder, zn.r * 2 + 3, C3(52, 50, 62), zn.x, 0.26, zn.z, MAT.Slate, 0, 0.12)
			disc(folder, zn.r * 2 + 1, C3(30, 30, 38), zn.x, 0.3, zn.z, MAT.Slate, 0, 0.1)
			ring(folder, zn.r * 2, 0.9, col, zn.x, 0.34, zn.z)
			disc(folder, zn.r * 1.7, dark, zn.x, 0.5, zn.z, MAT.Marble, 0, 0.3)
			local glow = glowDisc(folder, zn.r * 1.5, col, zn.x, 0.66, zn.z, 0.78)
			glowDisc(folder, zn.r * 1.0, col, zn.x, 0.7, zn.z, 0.7)
			glowDisc(folder, zn.r * 0.5, col, zn.x, 0.74, zn.z, 0.6)
			-- rune dashes
			for i = 0, 15 do
				local a = i * math.pi / 8
				block(folder, 0.5, 0.12, 1.5, col, zn.x + math.cos(a) * zn.r * 0.78, 0.8, zn.z + math.sin(a) * zn.r * 0.78, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0, false)
			end
			-- pillars around
			for i = 0, 5 do
				local a = i * math.pi / 3 + math.pi / 6
				local cap = pillar(folder, zn.x + math.cos(a) * (zn.r + 2.2), zn.z + math.sin(a) * (zn.r + 2.2), col)
				if i == 0 then cap.Name = "GateCap" end
			end
			-- sparkles rising
			local em = disc(folder, 1, col, zn.x, 1.0, zn.z, MAT.Neon, 1, 0.1)
			local pe2 = Instance.new("ParticleEmitter")
			pe2.Rate = 22
			pe2.Lifetime = NumberRange.new(1.2, 2.2)
			pe2.Speed = NumberRange.new(3, 6)
			pe2.SpreadAngle = Vector2.new(35, 35)
			pe2.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
			pe2.Transparency = NumberSequence.new(0, 1)
			pe2.Color = ColorSequence.new(col, C3(255, 255, 255))
			pe2.LightEmission = 1
			pe2.EmissionDirection = Enum.NormalId.Right
			pe2.Parent = em
			addLight(em, col, 26, 1.3)
			-- labels
			label(folder, zn.x, 7, zn.z - 1.5, tostring(zn.n), col, 120, 90, 80)
			label(folder, zn.x, 7, zn.z - zn.r - 4.5, "GATE " .. zn.n, col, 300, 40, 30)
			local sub = liveLabel(folder, zn.x, 7, zn.z - zn.r - 1.2, "FREE - step in to host a run", C3(255, 255, 255), 340, 40, 15)
			gates[zn.id] = { sub = sub, glow = glow, color = col, n = zn.n }
		end
	end

	-- upgrade zone (yellow)
	local uz
	for _, zn in ipairs(Config.Lobby.zones) do
		if zn.id == "upgrade" then uz = zn end
	end
	disc(folder, uz.r * 2 + 3, C3(52, 50, 62), uz.x, 0.26, uz.z, MAT.Slate, 0, 0.12)
	ring(folder, uz.r * 2, 1.0, C3(255, 214, 40), uz.x, 0.34, uz.z)
	disc(folder, uz.r * 1.7, C3(90, 74, 30), uz.x, 0.5, uz.z, MAT.Marble, 0, 0.4)
	disc(folder, uz.r * 1.3, C3(255, 214, 40), uz.x, 0.62, uz.z, MAT.Neon, 0.82, 0.1)
	for i = 0, 15 do
		local a = i * math.pi / 8
		block(folder, 0.5, 0.15, 1.5, C3(255, 214, 40), uz.x + math.cos(a) * uz.r * 0.8, 0.75, uz.z + math.sin(a) * uz.r * 0.8, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0, false)
	end
	-- anvil
	block(folder, 5, 1.2, 3, C3(60, 60, 68), uz.x, 1.4, uz.z, 0, MAT.Metal, 0, false)
	block(folder, 7.5, 0.8, 2.4, C3(90, 90, 100), uz.x, 2.2, uz.z, 0, MAT.Metal, 0, false)
	block(folder, 2.5, 0.8, 2.2, C3(110, 110, 120), uz.x + 4.2, 2.2, uz.z, 0, MAT.Metal, 0, false)
	disc(folder, 1.5, C3(255, 120, 30), uz.x - 1, 2.7, uz.z, MAT.Neon, 0.2, 0.2)
	for i = 0, 5 do
		local a = i * 1.0
		local coin = disc(folder, 1.3, C3(255, 205, 40), uz.x + math.cos(a) * 8, 0.9 + (i % 3) * 0.2, uz.z + math.sin(a) * 6, MAT.Neon, 0.1, 0.2)
		if i == 0 then addLight(coin, C3(255, 214, 40), 20, 1.2) end
	end
	collider(folder, 5, uz.x, uz.z, 4)
	label(folder, uz.x, 7, uz.z - uz.r - 4, "UPGRADES", C3(255, 214, 40), 380, 48, 34)
	label(folder, uz.x, 7, uz.z - uz.r - 0.8, "Spend skill points & coins", C3(255, 255, 255), 380, 28, 16)

	-- ================= WEAPON CHEST STATION (orange) =================
	local cz_
	for _, zn in ipairs(Config.Lobby.zones) do
		if zn.id == "chest" then cz_ = zn end
	end
	if cz_ then
		local ORANGE, GOLD = C3(255, 170, 50), C3(255, 214, 90)
		disc(folder, cz_.r * 2 + 3, C3(52, 50, 62), cz_.x, 0.26, cz_.z, MAT.Slate, 0, 0.12)
		ring(folder, cz_.r * 2, 1.0, ORANGE, cz_.x, 0.34, cz_.z)
		disc(folder, cz_.r * 1.7, C3(86, 52, 26), cz_.x, 0.5, cz_.z, MAT.Marble, 0, 0.4)
		disc(folder, cz_.r * 1.35, ORANGE, cz_.x, 0.62, cz_.z, MAT.Neon, 0.84, 0.1)
		disc(folder, cz_.r * 0.9, GOLD, cz_.x, 0.66, cz_.z, MAT.Neon, 0.8, 0.1)
		for i = 0, 15 do
			local a = i * math.pi / 8
			block(folder, 0.5, 0.15, 1.5, ORANGE, cz_.x + math.cos(a) * cz_.r * 0.82, 0.75, cz_.z + math.sin(a) * cz_.r * 0.82, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0, false)
		end
		-- the chest (seen from above: lid, golden bands, lock)
		local wood, woodDark = C3(142, 88, 44), C3(98, 60, 30)
		block(folder, 8.4, 3, 5.6, woodDark, cz_.x, 2.0, cz_.z, 0, MAT.WoodPlanks, 0, false)
		block(folder, 8.0, 1.8, 5.2, wood, cz_.x, 4.1, cz_.z, 0, MAT.WoodPlanks, 0, false)
		block(folder, 7.4, 0.5, 4.6, C3(170, 108, 52), cz_.x, 5.1, cz_.z, 0, MAT.Wood, 0, false)
		for _, bx in ipairs({ -3.1, 3.1 }) do
			block(folder, 0.8, 5.3, 5.8, GOLD, cz_.x + bx, 3.7, cz_.z, 0, MAT.Metal, 0, false)
			block(folder, 0.5, 0.3, 5.0, C3(255, 240, 170), cz_.x + bx, 5.45, cz_.z, 0, MAT.Neon, 0.2, false)
		end
		block(folder, 8.5, 0.5, 0.7, GOLD, cz_.x, 5.35, cz_.z, 0, MAT.Metal, 0, false)
		disc(folder, 1.9, GOLD, cz_.x, 5.7, cz_.z + 2.4, MAT.Metal, 0, 0.4)
		disc(folder, 0.9, C3(255, 90, 60), cz_.x, 5.95, cz_.z + 2.4, MAT.Neon, 0, 0.3)
		for _, cx2 in ipairs({ -4.1, 4.1 }) do
			for _, cz2 in ipairs({ -2.7, 2.7 }) do
				disc(folder, 1.0, GOLD, cz_.x + cx2, 5.3, cz_.z + cz2, MAT.Metal, 0, 0.5)
			end
		end
		local glowp = disc(folder, 5, GOLD, cz_.x, 5.4, cz_.z, MAT.Neon, 1, 0.1)
		local pe3 = Instance.new("ParticleEmitter")
		pe3.Rate = 30
		pe3.Lifetime = NumberRange.new(1.6, 2.6)
		pe3.Speed = NumberRange.new(5, 9)
		pe3.SpreadAngle = Vector2.new(25, 25)
		pe3.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
		pe3.Transparency = NumberSequence.new(0, 1)
		pe3.Color = ColorSequence.new(GOLD, C3(255, 120, 60))
		pe3.LightEmission = 1
		pe3.EmissionDirection = Enum.NormalId.Right
		pe3.Parent = glowp
		addLight(glowp, ORANGE, 30, 1.6)
		for i = 0, 6 do
			local a = i * 0.9
			local coin = disc(folder, 1.3, C3(255, 205, 40), cz_.x + math.cos(a) * 9, 0.9 + (i % 3) * 0.2, cz_.z + math.sin(a) * 8, MAT.Neon, 0.1, 0.2)
			if i == 0 then addLight(coin, C3(255, 214, 40), 16, 1) end
		end
		collider(folder, 8, cz_.x, cz_.z, 5)
		label(folder, cz_.x, 8, cz_.z - cz_.r - 4, "СУНДУКИ С ОРУЖИЕМ", ORANGE, 460, 48, 34)
		label(folder, cz_.x, 8, cz_.z - cz_.r - 0.8, "Посохи  -  Мечи  -  Луки   |   за монеты", C3(255, 255, 255), 460, 28, 16)
	end

	-- crates
	for _, p in ipairs({ { -88, 60 }, { -84, 66 }, { 88, 60 }, { 85, 67 }, { 90, -20 }, { -90, -20 } }) do
		block(folder, 5, 4, 5, C3(150, 108, 60), p[1], 2.2, p[2], rng:NextNumber(0, 1), MAT.WoodPlanks, 0, true)
		block(folder, 5.2, 0.4, 1, C3(100, 70, 40), p[1], 4.3, p[2], 0, MAT.Wood, 0, false)
	end
	return gates
end

-- ===================================================== ARENAS
local function newPlacer(rng, obstacles, ox, half, spawnZ)
	return function(r, margin)
		for _ = 1, 40 do
			local x = rng:NextNumber(-half + 10, half - 10)
			local z = rng:NextNumber(-half + 10, half - 10)
			local ok = true
			if (x * x + (z - spawnZ) * (z - spawnZ)) < (r + 16) * (r + 16) then ok = false end
			if x * x + (z + 60) * (z + 60) < (r + 12) * (r + 12) then ok = false end
			if ok then
				for _, o in ipairs(obstacles) do
					local dx, dz = x + ox - o.x, z - o.z
					local m = r + o.r + (margin or 3)
					if dx * dx + dz * dz < m * m then ok = false break end
				end
			end
			if ok then
				table.insert(obstacles, { x = x + ox, z = z, r = r * 0.8 })
				return x + ox, z
			end
		end
		return nil
	end
end

local function boundaryWalls(folder, ox, half)
	local c = C3(0, 0, 0)
	block(folder, half * 2 + 30, 40, 6, c, ox, 20, -half - 3, 0, nil, 1, true)
	block(folder, half * 2 + 30, 40, 6, c, ox, 20, half + 3, 0, nil, 1, true)
	block(folder, 6, 40, half * 2, c, ox - half - 3, 20, 0, 0, nil, 1, true)
	block(folder, 6, 40, half * 2, c, ox + half + 3, 20, 0, 0, nil, 1, true)
end

local function buildForest(folder, ox, rng, info)
	local half = info.half
	part(folder, BLK, Vector3.new(half * 2 + 160, 1, half * 2 + 160), CFrame.new(ox, -0.5, 0), C3(34, 76, 40), MAT.Grass, 0, true)
	part(folder, BLK, Vector3.new(half * 2, 1, half * 2), CFrame.new(ox, -0.45, 0), C3(62, 118, 52), MAT.Grass, 0, true)
	-- grass patches
	for i = 1, 55 do
		local d = rng:NextNumber(8, 24)
		local g = rng:NextInteger(0, 28)
		disc(folder, d, C3(52 + g, 108 + g, 44 + math.floor(g / 2)), ox + rng:NextNumber(-half, half), 0.08, rng:NextNumber(-half, half), MAT.Grass, 0.1, 0.05)
	end
	-- dirt path from the spawn to the middle and beyond
	local px, pz = 0, 62
	for i = 1, 11 do
		local nx = px + rng:NextNumber(-12, 12)
		nx = math.clamp(nx, -40, 40)
		local nz = pz - 13
		local dx, dz = nx - px, nz - pz
		local len = math.sqrt(dx * dx + dz * dz)
		block(folder, 8.5, 0.1, len + 3, C3(126, 96, 60), ox + (px + nx) / 2, 0.12, (pz + nz) / 2, math.atan2(dx, dz), MAT.Ground, 0, false)
		for j = 1, 4 do
			disc(folder, rng:NextNumber(0.4, 0.9), C3(150, 140, 125), ox + px + rng:NextNumber(-5, 5), 0.2, pz + rng:NextNumber(-6, 6), MAT.Slate, 0, 0.1)
		end
		px, pz = nx, nz
	end
	local place = newPlacer(rng, info.obstacles, ox, half, 62)
	for i = 1, 40 do
		local r = rng:NextNumber(3.6, 6)
		local x, z = place(r, 4)
		if x then tree(folder, x, z, r, (i % 7 == 0) and 3 or ((i % 3 == 0) and 2 or 1)) end
	end
	for i = 1, 12 do
		local r = rng:NextNumber(1.6, 3.2)
		local x, z = place(r, 2)
		if x then rock(folder, x, z, r, true, false) end
	end
	for i = 1, 6 do -- stumps
		local x, z = place(1.8, 2)
		if x then
			disc(folder, 3.4, C3(0, 0, 0), x + 0.4, 0.08, z + 0.5, nil, 0.7, 0.05)
			disc(folder, 3.2, C3(98, 66, 38), x, 0.8, z, MAT.Wood, 0, 1.4)
			disc(folder, 2.5, C3(176, 134, 82), x, 1.55, z, MAT.Wood, 0, 0.1)
			disc(folder, 1.5, C3(150, 108, 64), x, 1.6, z, MAT.Wood, 0, 0.1)
			disc(folder, 0.6, C3(120, 84, 50), x, 1.65, z, MAT.Wood, 0, 0.1)
			collider(folder, 3, x, z, 3)
		end
	end
	for i = 1, 26 do bush(folder, ox + rng:NextNumber(-half + 6, half - 6), rng:NextNumber(-half + 6, half - 6), rng:NextNumber(1.4, 2.6)) end
	for i = 1, 100 do flower(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half), rng) end
	for i = 1, 16 do mushroom(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half), false) end
	for i = 1, 8 do -- fallen logs
		local x, z = ox + rng:NextNumber(-half + 8, half - 8), rng:NextNumber(-half + 8, half - 8)
		local rot = rng:NextNumber(0, math.pi)
		block(folder, 1.8, 1.6, 9, C3(92, 62, 36), x, 0.8, z, rot, MAT.Wood, 0, false)
		block(folder, 1.2, 0.1, 8, C3(70, 100, 50), x, 1.65, z, rot, MAT.Grass, 0, false)
	end
	-- light shafts
	for i = 1, 9 do
		disc(folder, rng:NextNumber(10, 18), C3(255, 240, 160), ox + rng:NextNumber(-half, half), 0.18, rng:NextNumber(-half, half), MAT.Neon, 0.92, 0.05)
	end
	-- border treeline
	for i = 1, 70 do
		local side = rng:NextInteger(1, 4)
		local a, b = rng:NextNumber(-half - 20, half + 20), rng:NextNumber(half + 5, half + 40)
		local x, z
		if side == 1 then x, z = a, -b elseif side == 2 then x, z = a, b elseif side == 3 then x, z = -b, a else x, z = b, a end
		tree(folder, ox + x, z, rng:NextNumber(4.5, 8), rng:NextInteger(1, 3))
	end
	for i = 0, 15 do -- inside border bushes
		bush(folder, ox - half + 2 + i * 10.5, -half + 3, 2.4)
		bush(folder, ox - half + 2 + i * 10.5, half - 3, 2.4)
	end
end

local function crystal(folder, x, z, r, col, withLight)
	disc(folder, r * 2.6, C3(0, 0, 0), x + 0.3, 0.08, z + 0.4, nil, 0.65, 0.05)
	disc(folder, r * 2.2, C3(50, 46, 66), x, 0.6, z, MAT.Slate, 0, 1.0)
	local c = disc(folder, r * 1.6, col, x, 1.6, z, MAT.Neon, 0.1, 1.0)
	disc(folder, r * 1.0, C3(math.min(255, col.R * 255 + 60), math.min(255, col.G * 255 + 60), math.min(255, col.B * 255 + 60)), x - 0.2, 2.3, z - 0.2, MAT.Neon, 0, 0.5)
	for i = 0, 4 do
		local a = i * 1.26
		local sh = block(folder, r * 0.45, 1.0, r * 1.5, col, x + math.cos(a) * r * 0.9, 1.4, z + math.sin(a) * r * 0.9, math.atan2(math.cos(a), math.sin(a)), MAT.Neon, 0.1, false)
		if i == 0 and withLight then addLight(sh, col, 24, 1.4) end
	end
	collider(folder, r * 1.8, x, z, 8)
end

local function stalagmite(folder, x, z, r)
	disc(folder, r * 2.4, C3(0, 0, 0), x + r * 0.2, 0.08, z + r * 0.3, nil, 0.65, 0.05)
	disc(folder, r * 2.0, C3(58, 56, 66), x, 1.0, z, MAT.Slate, 0, 1.6)
	disc(folder, r * 1.55, C3(76, 74, 88), x - 0.2, 2.0, z - 0.2, MAT.Slate, 0, 0.7)
	disc(folder, r * 1.0, C3(98, 96, 112), x - 0.4, 2.7, z - 0.4, MAT.Slate, 0, 0.7)
	disc(folder, r * 0.45, C3(130, 128, 146), x - 0.5, 3.2, z - 0.5, MAT.Slate, 0, 0.4)
	collider(folder, r * 1.7, x, z, 8)
end

local function torch(folder, x, z)
	disc(folder, 1.2, C3(60, 40, 28), x, 0.7, z, MAT.Wood, 0, 1.3)
	local f = disc(folder, 1.5, C3(255, 140, 30), x, 1.6, z, MAT.Neon, 0.1, 0.3)
	disc(folder, 0.8, C3(255, 230, 120), x, 1.9, z, MAT.Neon, 0, 0.2)
	disc(folder, 9, C3(255, 150, 50), x, 0.15, z, MAT.Neon, 0.9, 0.05)
	addLight(f, C3(255, 150, 60), 28, 1.4)
end

local function skull(folder, x, z)
	local b = C3(225, 218, 195)
	disc(folder, 1.3, b, x, 0.2, z, nil, 0, 0.3)
	disc(folder, 0.28, C3(20, 20, 20), x - 0.25, 0.4, z - 0.15, nil, 0, 0.1)
	disc(folder, 0.28, C3(20, 20, 20), x + 0.25, 0.4, z - 0.15, nil, 0, 0.1)
	block(folder, 0.2, 0.2, 1.8, b, x + 1.2, 0.2, z + 0.4, 0.5, nil, 0, false)
	block(folder, 0.2, 0.2, 1.8, b, x + 1.0, 0.2, z + 0.6, -0.8, nil, 0, false)
end

local function buildCave(folder, ox, rng, info)
	local half = info.half
	part(folder, BLK, Vector3.new(half * 2 + 160, 1, half * 2 + 160), CFrame.new(ox, -0.5, 0), C3(26, 24, 32), MAT.Basalt, 0, true)
	part(folder, BLK, Vector3.new(half * 2, 1, half * 2), CFrame.new(ox, -0.45, 0), C3(66, 62, 78), MAT.Slate, 0, true)
	for i = 1, 50 do
		local g = rng:NextInteger(-14, 18)
		local mats = { MAT.Cobblestone, MAT.Pebble, MAT.Slate, MAT.Basalt }
		disc(folder, rng:NextNumber(8, 22), C3(66 + g, 62 + g, 78 + g), ox + rng:NextNumber(-half, half), 0.08, rng:NextNumber(-half, half), mats[rng:NextInteger(1, 4)], 0.05, 0.05)
	end
	for i = 1, 28 do -- cracks
		local x, z = ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half)
		local rot = rng:NextNumber(0, math.pi)
		block(folder, 0.35, 0.05, rng:NextNumber(6, 16), C3(20, 18, 26), x, 0.14, z, rot, nil, 0, false)
		block(folder, 0.25, 0.05, rng:NextNumber(3, 8), C3(20, 18, 26), x + math.sin(rot) * 5, 0.14, z + math.cos(rot) * 5, rot + 0.8, nil, 0, false)
	end
	-- lava streams (decorative)
	for s = 1, 3 do
		local x = rng:NextNumber(-60, 60)
		local z = -half + 6
		local first = true
		for i = 1, 9 do
			local nx = math.clamp(x + rng:NextNumber(-14, 14), -70, 70)
			local nz = z + 18
			local dx, dz = nx - x, nz - z
			local len = math.sqrt(dx * dx + dz * dz)
			-- keep away from the arena spawn
			if nz < 40 then
				block(folder, 6.5, 0.1, len + 2, C3(40, 20, 16), ox + (x + nx) / 2, 0.13, (z + nz) / 2, math.atan2(dx, dz), MAT.Basalt, 0, false)
				local lv = block(folder, 4.2, 0.1, len + 2, C3(255, 100, 20), ox + (x + nx) / 2, 0.18, (z + nz) / 2, math.atan2(dx, dz), MAT.Neon, 0.05, false)
				block(folder, 1.8, 0.1, len, C3(255, 210, 80), ox + (x + nx) / 2, 0.2, (z + nz) / 2, math.atan2(dx, dz), MAT.Neon, 0.1, false)
				if first then addLight(lv, C3(255, 110, 30), 26, 1.2) first = false end
			end
			x, z = nx, nz
		end
	end
	local place = newPlacer(rng, info.obstacles, ox, half, 62)
	for i = 1, 22 do
		local r = rng:NextNumber(2.2, 4.4)
		local x, z = place(r, 4)
		if x then stalagmite(folder, x, z, r) end
	end
	for i = 1, 12 do
		local r = rng:NextNumber(2.6, 5)
		local x, z = place(r, 3)
		if x then rock(folder, x, z, r, true, true) end
	end
	local ccols = { C3(90, 160, 255), C3(190, 90, 255), C3(80, 255, 200) }
	for i = 1, 11 do
		local r = rng:NextNumber(1.6, 2.6)
		local x, z = place(r, 3)
		if x then crystal(folder, x, z, r, ccols[(i % 3) + 1], i % 2 == 0) end
	end
	for i = 1, 16 do skull(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half)) end
	for i = 1, 20 do mushroom(folder, ox + rng:NextNumber(-half, half), rng:NextNumber(-half, half), true) end
	for i = 1, 4 do -- mine tracks with carts
		local z = -60 + i * 30
		block(folder, 1.0, 0.1, 40, C3(90, 70, 50), ox + (i % 2 == 0 and -62 or 62), 0.16, z, math.pi / 2, MAT.Wood, 0, false)
		block(folder, 0.4, 0.1, 40, C3(130, 130, 140), ox + (i % 2 == 0 and -62 or 62), 0.22, z - 1, math.pi / 2, MAT.Metal, 0, false)
		block(folder, 0.4, 0.1, 40, C3(130, 130, 140), ox + (i % 2 == 0 and -62 or 62), 0.22, z + 1, math.pi / 2, MAT.Metal, 0, false)
	end
	-- torches along the borders
	for i = 0, 7 do
		torch(folder, ox - half + 3, -half + 12 + i * 22)
		torch(folder, ox + half - 3, -half + 12 + i * 22)
	end
	-- border rocks (outside walls)
	for i = 1, 90 do
		local side = rng:NextInteger(1, 4)
		local a, b = rng:NextNumber(-half - 20, half + 20), rng:NextNumber(half + 4, half + 35)
		local x, z
		if side == 1 then x, z = a, -b elseif side == 2 then x, z = a, b elseif side == 3 then x, z = -b, a else x, z = b, a end
		rock(folder, ox + x, z, rng:NextNumber(4, 9), false, true)
	end
	for i = 0, 15 do
		rock(folder, ox - half + 2 + i * 10.5, -half + 1, 4.5, false, true)
		rock(folder, ox - half + 2 + i * 10.5, half - 1, 4.5, false, true)
	end
end

function M.arena(locId, ox, folder, seed)
	local rng = Random.new(seed)
	local info = { half = 80, ox = ox, obstacles = {}, spawn = Vector3.new(ox, 4, 62) }
	boundaryWalls(folder, ox, info.half)
	if locId == "forest" then
		buildForest(folder, ox, rng, info)
	else
		buildCave(folder, ox, rng, info)
	end
	-- spawn marker
	disc(folder, 14, C3(255, 255, 255), ox, 0.2, 62, MAT.Neon, 0.9, 0.05)
	return info
end

return M
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX8">
<Properties>
<string name="Name">TestArea</string>
<ProtectedString name="Source"><![CDATA[-- ===========================================================================================
-- [TESTAREA]  WEAPON TEST PLACE  -  built so it can be removed later in two clicks:
--   1. delete this ModuleScript   (ServerScriptService > GameServer > TestArea)
--   2. delete the LocalScript     (StarterPlayer > StarterPlayerScripts > TestAreaClient)
-- (or just set Config.TestArea.enabled = false in ReplicatedStorage > Config)
-- Nothing else in the game depends on it: GameServer only calls it through "-- [TESTAREA]" hooks that are
-- skipped automatically when this module is missing.
-- ===========================================================================================
local Workspace = game:GetService("Workspace")

local TestArea = {}
local api
local testRun = nil
local C3 = Color3.fromRGB

local ZONE = { id = "testportal", kind = "testportal", x = 52, z = 64, r = 11 }
local SLOT = 40 -- far away arena slot (ox = 3000 + 40 * 400)
local HALF = 80

-- called by GameServer BEFORE the lobby is built: registers the portal zone
function TestArea.preInit(Config)
	table.insert(Config.Lobby.zones, ZONE)
end

-- ============================================================ small part helpers
local function part(parent, shape, size, cf, color, mat, trans, collide)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Transparency = trans or 0
	p.CanCollide = collide or false
	p.CanQuery = collide or false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function disc(parent, d, color, x, y, z, mat, trans, thick)
	return part(parent, Enum.PartType.Cylinder, Vector3.new(thick or 0.2, d, d), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans, false)
end
local function block(parent, sx, sy, sz, color, x, y, z, rot, mat, trans, collide)
	return part(parent, Enum.PartType.Block, Vector3.new(sx, sy, sz), CFrame.new(x, y, z) * CFrame.Angles(0, rot or 0, 0), color, mat, trans, collide)
end
local function label(parent, x, y, z, text, color, w, h, size)
	local a = part(parent, Enum.PartType.Block, Vector3.new(1, 1, 1), CFrame.new(x, y, z), C3(255, 255, 255), nil, 1, false)
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(w or 300, h or 50)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 700
	g.Adornee = a
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color or C3(255, 255, 255)
	t.Font = Enum.Font.GothamBlack
	t.TextSize = size or 22
	t.TextStrokeTransparency = 0.2
	t.TextWrapped = true
	t.Parent = g
	g.Parent = a
	return a
end

-- ============================================================ lobby portal (blue)
function TestArea.buildPortal(folder)
	local col = C3(70, 190, 255)
	local z = ZONE
	disc(folder, z.r * 2 + 3, C3(52, 50, 62), z.x, 0.26, z.z, Enum.Material.Slate, 0, 0.12)
	disc(folder, z.r * 2, col, z.x, 0.34, z.z, Enum.Material.Neon, 0, 0.15)
	disc(folder, z.r * 2 - 1.8, C3(24, 34, 48), z.x, 0.36, z.z, Enum.Material.Slate, 0, 0.15)
	disc(folder, z.r * 1.5, C3(30, 70, 110), z.x, 0.5, z.z, Enum.Material.Marble, 0, 0.3)
	disc(folder, z.r * 1.2, col, z.x, 0.64, z.z, Enum.Material.Neon, 0.8, 0.1)
	disc(folder, z.r * 0.7, C3(190, 240, 255), z.x, 0.7, z.z, Enum.Material.Neon, 0.75, 0.1)
	for i = 0, 11 do
		local a = i * math.pi / 6
		block(folder, 0.5, 0.15, 1.6, col, z.x + math.cos(a) * z.r * 0.8, 0.8, z.z + math.sin(a) * z.r * 0.8, math.atan2(math.cos(a), math.sin(a)), Enum.Material.Neon, 0, false)
	end
	-- two pillars + arch
	for _, sx in ipairs({ -1, 1 }) do
		block(folder, 2, 14, 2, C3(60, 66, 84), z.x + sx * 5, 7, z.z - 3, 0, Enum.Material.Slate, 0, true)
		block(folder, 2.4, 0.6, 2.4, col, z.x + sx * 5, 14.2, z.z - 3, 0, Enum.Material.Neon, 0, false)
	end
	block(folder, 12, 1.4, 2, C3(60, 66, 84), z.x, 14.2, z.z - 3, 0, Enum.Material.Slate, 0, false)
	local sheet = block(folder, 8, 13, 0.3, col, z.x, 7, z.z - 3, 0, Enum.Material.Neon, 0.7, false)
	local em = Instance.new("ParticleEmitter")
	em.Rate = 28
	em.Lifetime = NumberRange.new(1.4, 2.4)
	em.Speed = NumberRange.new(2, 5)
	em.SpreadAngle = Vector2.new(30, 30)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	em.Transparency = NumberSequence.new(0, 1)
	em.Color = ColorSequence.new(col, C3(255, 255, 255))
	em.LightEmission = 1
	em.Parent = sheet
	local l = Instance.new("PointLight")
	l.Color = col
	l.Range = 26
	l.Brightness = 1.4
	l.Parent = sheet
	label(folder, z.x, 19, z.z - 3, "ТЕСТОВАЯ АРЕНА", col, 420, 44, 30)
	label(folder, z.x, 16.5, z.z - 3, "Проверь всё оружие  |  временная зона", C3(255, 255, 255), 420, 26, 15)
end

-- ============================================================ the arena
local DUMMY_PAL = { skin = C3(214, 190, 150), cloth = C3(150, 112, 70), hair = C3(100, 76, 50) }
local DEFS = {
	small = { id = "DummyS", name = "Training Dummy", kind = "zombie", hp = 10, dmg = 0, speed = 0, r = 1.7, atkCd = 9, pal = DUMMY_PAL },
	big = { id = "DummyB", name = "Training Titan", kind = "titan", hp = 10, dmg = 0, speed = 0, r = 5.2, atkCd = 9, pal = DUMMY_PAL },
}

local function buildArena(folder, ox)
	block(folder, HALF * 2 + 30, 1, HALF * 2 + 30, C3(54, 60, 78), ox, -0.5, 0, 0, Enum.Material.Slate, 0, true)
	for i = -8, 8 do
		block(folder, HALF * 2, 0.06, 0.25, C3(90, 104, 140), ox, 0.04, i * 10, 0, Enum.Material.Neon, 0.55, false)
		block(folder, 0.25, 0.06, HALF * 2, C3(90, 104, 140), ox + i * 10, 0.04, 0, 0, Enum.Material.Neon, 0.55, false)
	end
	-- frame
	local frameCol = C3(70, 190, 255)
	block(folder, HALF * 2 + 1, 0.2, 1, frameCol, ox, 0.12, -HALF, 0, Enum.Material.Neon, 0.2, false)
	block(folder, HALF * 2 + 1, 0.2, 1, frameCol, ox, 0.12, HALF, 0, Enum.Material.Neon, 0.2, false)
	block(folder, 1, 0.2, HALF * 2 + 1, frameCol, ox - HALF, 0.12, 0, 0, Enum.Material.Neon, 0.2, false)
	block(folder, 1, 0.2, HALF * 2 + 1, frameCol, ox + HALF, 0.12, 0, 0, Enum.Material.Neon, 0.2, false)
	-- invisible walls
	local c = C3(0, 0, 0)
	block(folder, HALF * 2 + 30, 40, 6, c, ox, 20, -HALF - 3, 0, nil, 1, true)
	block(folder, HALF * 2 + 30, 40, 6, c, ox, 20, HALF + 3, 0, nil, 1, true)
	block(folder, 6, 40, HALF * 2, c, ox - HALF - 3, 20, 0, 0, nil, 1, true)
	block(folder, 6, 40, HALF * 2, c, ox + HALF + 3, 20, 0, 0, nil, 1, true)
	-- spawn pad
	disc(folder, 14, C3(255, 255, 255), ox, 0.2, 62, Enum.Material.Neon, 0.88, 0.05)
	-- distance markers along the middle line (from the spawn pad at z = 62)
	for d = 20, 120, 20 do
		local z = 62 - d
		if z > -HALF + 2 then
			block(folder, 6, 0.1, 0.4, C3(255, 214, 90), ox, 0.1, z, 0, Enum.Material.Neon, 0.1, false)
			label(folder, ox + 6, 1.5, z, d .. " studs", C3(255, 214, 90), 140, 24, 14)
		end
	end
	label(folder, ox, 10, 50, "ТЕСТОВАЯ АРЕНА", C3(70, 190, 255), 520, 52, 36)
	label(folder, ox, 10, 42, "Манекены не бьют в ответ и не умирают. Выбирай оружие слева, пробуй Q / E / Z", C3(255, 255, 255), 640, 30, 16)
	label(folder, ox - 40, 6, 30, "ЦЕЛИ", C3(200, 210, 230), 200, 24, 16)
	label(folder, ox, 6, -2, "ГРУППА (проверка зон)", C3(200, 210, 230), 260, 24, 16)
	label(folder, ox, 12, -45, "БОЛЬШИЕ ЦЕЛИ", C3(200, 210, 230), 260, 24, 16)
	label(folder, ox, 6, -72, "ДАЛЬНЯЯ ЛИНИЯ (дальность)", C3(200, 210, 230), 300, 24, 16)
end

local function dummyLayout(ox)
	local L = {}
	for i = -2, 2 do table.insert(L, { "small", ox + i * 16, 30 }) end
	-- tight group for area abilities
	local ring = { { 0, 0 }, { 6, 0 }, { -6, 0 }, { 0, 6 }, { 0, -6 }, { 12, 4 }, { -12, 4 }, { 12, -4 }, { -12, -4 }, { 6, 10 }, { -6, 10 }, { 6, -10 }, { -6, -10 } }
	for _, o in ipairs(ring) do table.insert(L, { "small", ox + o[1], -10 + o[2] }) end
	for i = -1, 1 do table.insert(L, { "big", ox + i * 34, -45 }) end
	for i = -2, 2 do table.insert(L, { "small", ox + i * 14, -70 }) end
	return L
end

local function spawnDummy(run, spec)
	local def = DEFS[spec.kind]
	local e = api.spawnEnemy(run, def, 1, spec.x, spec.z)
	e.dummy = true
	e.hx, e.hz = spec.x, spec.z
	e.maxHp = 2000000
	e.hp = e.maxHp
	e.nextAtk = math.huge
	e.fill.Size = UDim2.fromScale(1, 1)
	spec.e = e
end

local function ensureRun()
	if testRun and not testRun.destroyed and not testRun.over then return testRun end
	local slot = SLOT
	local ox = 3000 + slot * 400
	local folder = Instance.new("Folder")
	folder.Name = "Run" .. slot
	folder.Parent = Workspace
	buildArena(folder, ox)
	local ef = Instance.new("Folder")
	ef.Name = "Enemies"
	ef.Parent = folder
	local run = {
		cfg = { id = "test", name = "Тестовая арена", enemies = {} },
		dcfg = { name = "Training", hp = 1, dmg = 0, reward = 0, extra = 0, color = "ffffff" },
		diff = 1, slot = slot, folder = folder, enemyFolder = ef,
		info = { half = HALF, ox = ox, obstacles = {}, spawn = Vector3.new(ox, 4, 62) },
		players = {}, enemies = {}, projs = {}, queue = {}, events = {}, targets = {}, gain = {},
		wave = 1, total = 0, waveCounts = { 0, 0, 0 }, cap = 999, nextSpawn = 0, nextHud = 0, over = false, test = true,
	}
	api.slots[slot] = run
	table.insert(api.runs, run)
	testRun = run
	local specs = {}
	for _, d in ipairs(dummyLayout(ox)) do
		local spec = { kind = d[1], x = d[2], z = d[3] }
		table.insert(specs, spec)
		spawnDummy(run, spec)
	end
	run.specs = specs
	-- keep the dummies alive: refill health, bring back killed ones
	task.spawn(function()
		while not run.destroyed and not run.over do
			task.wait(0.5)
			for _, spec in ipairs(specs) do
				local e = spec.e
				if not e or e.dead then
					if spec.respawnAt and os.clock() >= spec.respawnAt then
						spec.respawnAt = nil
						pcall(spawnDummy, run, spec)
					elseif not spec.respawnAt then
						spec.respawnAt = os.clock() + 1.5
					end
				elseif e.hp < e.maxHp * 0.6 then
					e.hp = e.maxHp
					e.fill.Size = UDim2.fromScale(1, 1)
				end
			end
		end
	end)
	return run
end

-- ============================================================ enter / leave / actions
local function enter(p, st)
	if st.run or st.dead then return end
	local run = ensureRun()
	local info = run.info
	st.run = run
	st.zone = nil
	st.party = nil
	st.dead = false
	st.abCd = {}
	st.lockAtk = 0
	st.lockCast = 0
	local d = api.D[p]
	st.testWeapon = (d.class and d.equip[d.class]) or api.Config.StarterWeapons.Swordsman
	table.insert(run.players, p)
	p:SetAttribute("InRun", true)
	api.ToClient:FireClient(p, "Zone", nil)
	api.ToClient:FireClient(p, "Env", "test")
	local c = p.Character
	if c then
		c:PivotTo(CFrame.new(info.spawn + Vector3.new(math.random(-8, 8), 0, math.random(-4, 4))))
		api.applyStats(p, true)
		api.buildSprite(p)
	end
	api.pushData(p)
	api.ToClient:FireClient(p, "TestMode", true)
	api.toast(p, "ТЕСТОВАЯ АРЕНА", "46beff", 3)
end

local function leave(p, st)
	local run = st.run
	if not run or run ~= testRun then return end
	st.testWeapon = nil
	api.returnToLobby(p)
	api.ToClient:FireClient(p, "TestMode", false)
	task.defer(function()
		if api.S[p] then
			api.applyStats(p, true)
			api.buildSprite(p)
			api.pushData(p)
		end
	end)
	if #run.players == 0 then
		api.endRun(run)
		testRun = nil
	end
end

function TestArea.onAction(p, st, action, a)
	if action == "TestEnter" then
		if st.zone == "testportal" then enter(p, st) end
	elseif action == "TestLeave" then
		leave(p, st)
	elseif action == "TestEquip" then
		if st.run ~= testRun or not testRun then return end
		local w = type(a) == "string" and api.Config.Weapons[a]
		if not w then return end
		st.testWeapon = a
		api.applyStats(p, false)
		api.buildSprite(p)
		api.pushData(p)
		st.abCd = {}
		api.toast(p, w.name, api.Config.Rarities[w.tier].color:ToHex(), 2)
	elseif action == "TestCd" then
		if st.run ~= testRun or not testRun then return end
		st.abCd = {}
		st.lockCast = 0
		st.lockAtk = 0
		for _, k in ipairs({ "Q", "E", "Z" }) do
			api.ToClient:FireClient(p, "AbCd", k, 0)
		end
	elseif action == "TestReset" then
		if st.run ~= testRun or not testRun then return end
		for _, spec in ipairs(testRun.specs or {}) do
			local e = spec.e
			if e and not e.dead then
				e.hp = e.maxHp
				e.x, e.z = spec.x, spec.z
				e.burn = nil
				e.stunUntil = nil
				e.slowUntil = nil
				e.fill.Size = UDim2.fromScale(1, 1)
			end
		end
	end
end

function TestArea.init(a)
	api = a
end

return TestArea
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX17">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX15">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="LocalScript" referent="RBX11">
<Properties>
<string name="Name">GameClient</string>
<ProtectedString name="Source"><![CDATA[-- GameClient: top-down camera, controls, HUD, menus and visual effects
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")

local lp = Players.LocalPlayer
local Net = RS:WaitForChild("Net")
local ToServer = Net:WaitForChild("ToServer")
local ToClient = Net:WaitForChild("ToClient")
local Config = require(RS:WaitForChild("Config"))
local cam = workspace.CurrentCamera
local C3 = Color3.fromRGB
local Theme = require(RS:WaitForChild("Theme"))
local WeaponFX = require(RS:WaitForChild("WeaponFX"))
local C3t = function(r, g, b) return Theme.tint(Color3.fromRGB(r, g, b)) end
local projWid = {}

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

-- disable the default movement controls (we move with WASD in world space)
task.spawn(function()
	pcall(function()
		local pm = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		pm:GetControls():Disable()
	end)
end)

-- ============================================================ DATA
local data = { level = 1, xp = 0, need = 100, points = 0, coins = 0, upg = {}, vit = 0, swift = 0, unlocked = {} }
local onData -- forward

local function readData()
	local s = lp:GetAttribute("Data")
	if s then
		local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
		if ok and type(t) == "table" then
			data = t
			data.upg = data.upg or {}
			data.unlocked = data.unlocked or {}
			if onData then onData() end
		end
	end
end

-- ============================================================ UI HELPERS
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
-- ------------------------------------------------------------ THEME (flat, crisp, muted)
local GOLD = C3(214, 178, 98)
local INK = C3(12, 14, 20)
local PANEL = C3(21, 24, 33)
local CARD = C3(30, 34, 46)
local LINE = C3(62, 68, 86)
local TXT = C3(232, 235, 242)
local TXT2 = C3(150, 157, 175)
local DISABLED_TXT = C3(124, 130, 148)

-- keeps hues but caps brightness / saturation so nothing screams
local function tone(c)
	local h, s, v = c:ToHSV()
	if s > 0.3 then s = s * 0.72 end
	if v > 0.62 then v = 0.62 end
	return Color3.fromHSV(h, s, v)
end

local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end
local function stroke(o, color, th, tr) return new("UIStroke", { Color = color or LINE, Thickness = th or 1.5, Transparency = tr or 0 }, o) end
local function mkLabel(parent, text, pos, size, ts, color, align, font)
	return new("TextLabel", {
		Text = text, Position = pos, Size = size, TextSize = ts or 16, TextColor3 = color or TXT,
		BackgroundTransparency = 1, Font = font or Enum.Font.GothamBold, TextXAlignment = align or Enum.TextXAlignment.Left,
		TextWrapped = true, TextStrokeTransparency = 1,
	}, parent)
end
local function mkBar(parent, pos, size, color)
	local bg = new("Frame", { Position = pos, Size = size, BackgroundColor3 = INK, BorderSizePixel = 0 }, parent)
	corner(bg, 5)
	stroke(bg, LINE, 1.5, 0.1)
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = tone(color), BorderSizePixel = 0 }, bg)
	corner(fill, 5)
	new("UIGradient", { Color = ColorSequence.new(C3(255, 255, 255), C3(176, 176, 176)), Rotation = 90 }, fill)
	local txt = mkLabel(bg, "", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 13, nil, Enum.TextXAlignment.Center)
	txt.ZIndex = 3
	txt.TextStrokeColor3 = INK
	txt.TextStrokeTransparency = 0.45
	return { bg = bg, fill = fill, txt = txt }
end

local function setDisabled(b, dis)
	b:SetAttribute("Dis", dis and true or false)
	if dis then b.TextColor3 = DISABLED_TXT end
end

local function markSelected(b)
	local st = b:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = GOLD
		st.Thickness = 2
		st.Transparency = 0
	end
end

local function mkButton(parent, text, pos, size, color, cb)
	local b = new("TextButton", {
		Text = text, Position = pos, Size = size, BackgroundColor3 = tone(color), TextColor3 = TXT,
		Font = Enum.Font.GothamBold, TextSize = 16, AutoButtonColor = false, BorderSizePixel = 0, TextWrapped = true,
	}, parent)
	corner(b, 6)
	-- crisp dark outline
	new("UIStroke", { Color = C3(8, 10, 16), Thickness = 1.5, Transparency = 0.25 }, b)
	-- soft top light (flat bevel)
	local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(255, 255, 255), BorderSizePixel = 0, Active = false }, b)
	corner(shine, 6)
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.5, 0.97), NumberSequenceKeypoint.new(1, 1) }), Rotation = 90 }, shine)
	-- hover / press overlay
	local hov = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(255, 255, 255), BackgroundTransparency = 1, BorderSizePixel = 0, Active = false }, b)
	corner(hov, 6)
	local sc = new("UIScale", {}, b)
	local function over(tr, t) TweenService:Create(hov, TweenInfo.new(t or 0.1), { BackgroundTransparency = tr }):Play() end
	b.MouseEnter:Connect(function()
		if not b:GetAttribute("Dis") then over(0.9) end
	end)
	b.MouseLeave:Connect(function()
		over(1, 0.14)
		TweenService:Create(sc, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		if b:GetAttribute("Dis") then return end
		over(0.8, 0.05)
		TweenService:Create(sc, TweenInfo.new(0.06), { Scale = 0.97 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		if b:GetAttribute("Dis") then return end
		over(0.9, 0.1)
		TweenService:Create(sc, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	if cb then
		b.MouseButton1Click:Connect(function()
			if not b:GetAttribute("Dis") then cb() end
		end)
	end
	return b
end
local function hex(s) return Color3.fromHex(s) end

local gui = new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5 }, lp:WaitForChild("PlayerGui"))

-- ------------------------------------------------------------ HUD
